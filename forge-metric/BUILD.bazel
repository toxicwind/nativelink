load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
)

rust_library(
    name = "forge-metric",
    srcs = [
        "src/lib.rs",
    ],
    proc_macro_deps = [
        "//forge-metric/forge-metric-macro-derive",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:async-lock",
        "@crates//:parking_lot",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":forge-metric",
    proc_macro_deps = [
        "//forge-metric/forge-metric-macro-derive",
    ],
    deps = [
        "@crates//:async-lock",
        "@crates//:parking_lot",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_doc(
    name = "docs",
    crate = ":forge-metric",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":forge-metric",
)
