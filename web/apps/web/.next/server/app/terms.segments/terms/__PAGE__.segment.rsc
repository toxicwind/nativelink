3:["$","h3",null,{"id":"acceptance","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"1. Acceptance of Terms"}]
4:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":["By creating an account, deploying Forge, or otherwise using our service, you confirm that you have read these terms, agree to them, and have the authority to bind your organization where applicable. By agreeing, you also consent to our collection and processing of personal data as described in the"," ",["$","a",null,{"href":"#privacy","className":"text-brand underline-offset-4 hover:underline","children":"Privacy Policy"}]," ","below. Your consent is specific and informed, and you may withdraw it at any time (see"," ",["$","a",null,{"href":"#consent","className":"text-brand underline-offset-4 hover:underline","children":"Consent & withdrawal"}],")."]}]
5:["$","h3",null,{"id":"license","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"2. License & Use"}]
6:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":["Forge is distributed from a monorepo with module-aware licensing. Most modules are licensed under FSL-1.1-Apache-2.0, while some commercial modules, including metrics and remote persistent workers, are licensed under the Business Source License. Developers using Forge for an individual cache do not need a commercial license; team and production usage of commercial modules can be covered by an intentionally very inexpensive separate license. See the ",["$","a",null,{"href":"/license","children":"license page"}]," for details. Forge Enterprise offerings are provided under the separate agreement you accept when you sign up for those services."]}]
7:["$","h3",null,{"id":"accounts","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"3. Accounts"}]
8:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":"You are responsible for safeguarding any credentials issued to your account and for all activity that occurs under those credentials. Notify us promptly of any unauthorized use."}]
9:["$","h3",null,{"id":"acceptable-use","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"4. Acceptable Use"}]
a:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":"You agree not to use the service to violate any law, infringe third-party rights, distribute malware, or interfere with the integrity or performance of the service or its users."}]
b:["$","div",null,{"className":"my-12 h-px w-full bg-border"}]
c:["$","h2",null,{"id":"privacy","className":"scroll-mt-24 text-3xl font-semibold tracking-tight text-foreground","children":"Privacy Policy"}]
d:["$","p",null,{"className":"mt-4 text-[15px] leading-relaxed text-muted-foreground","children":"We treat your data as if it were our own — because if you're running builds on our infrastructure, in a real sense it is. This policy describes what we collect, why, and your rights over that data."}]
e:["$","h3",null,{"id":"data","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"What we collect"}]
f:["$","ul",null,{"className":"mt-3 space-y-2 pl-6 text-[15px] leading-relaxed text-muted-foreground [&_li]:list-disc","children":[["$","li",null,{"children":"Account information (name, email, organization) when you sign up for Cloud or Enterprise."}],["$","li",null,{"children":"Build metadata (action digests, timing, success/failure) for the purpose of running and improving the service. Build artifacts themselves are content-addressed and never inspected by us."}],["$","li",null,{"children":"Anonymous usage telemetry from the source-available release, which can be disabled with a single flag."}],["$","li",null,{"children":"Standard server logs (IP addresses, user agents) retained for 30 days for security and abuse detection."}]]}]
10:["$","h3",null,{"id":"cookies","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"Cookies"}]
11:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":"We use first-party cookies to keep you signed in and to remember your preferences. Analytics is run server-side with no third-party tracking cookies set on this site."}]
12:["$","h3",null,{"id":"rights","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"Your rights"}]
13:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":["You may request access to, correction of, or deletion of personal data we hold about you at any time by emailing"," ",["$","a",null,{"href":"mailto:privacy@tracemachina.com","className":"text-brand underline-offset-4 hover:underline","children":"privacy@tracemachina.com"}],". If you're an EU/UK resident, this includes the rights granted under GDPR / UK GDPR."]}]
14:["$","h3",null,{"id":"consent","className":"mt-10 scroll-mt-24 text-xl font-semibold tracking-tight text-foreground","children":"Consent & withdrawal"}]
15:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":["Where we rely on your consent to process personal data, that consent is freely given, specific, and informed. You give it when you agree to these terms during sign-up, and the processing it covers is the collection and use of the data described in"," ",["$","a",null,{"href":"#data","className":"text-brand underline-offset-4 hover:underline","children":"What we collect"}]," ","for the purposes of providing, securing, and improving the service."]}]
16:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":["You may withdraw your consent at any time, without affecting the lawfulness of processing carried out before withdrawal. To withdraw, request the Data Subject Consent Withdrawal Form by emailing"," ",["$","a",null,{"href":"mailto:privacy@tracemachina.com?subject=Data%20Subject%20Consent%20Withdrawal","className":"text-brand underline-offset-4 hover:underline","children":"privacy@tracemachina.com"}]," ","or write to us at the postal address in"," ",["$","a",null,{"href":"#contact","className":"text-brand underline-offset-4 hover:underline","children":"Contact"}],". We keep a record of the consents we rely on and honor withdrawal requests promptly."]}]
17:["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-muted-foreground","children":"We do not sell your personal information, and we do not share it for cross-context behavioral advertising. California residents may exercise their rights under the CPRA using the same contact methods above."}]
