c:["$","section",null,{"className":"relative overflow-hidden border-t border-border/60","children":[["$","div",null,{"className":"pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgb(var(--nl-color-brand)/0.10),transparent_60%)]"}],["$","section",null,{"className":"relative px-6 py-28","children":["$","div",null,{"className":"mx-auto w-full max-w-[850px]","children":["$","$L2",null,{"children":[["$","p",null,{"className":"font-mono text-xs uppercase tracking-[0.18em] text-brand mb-5","children":"Why we say migrate to Bazel"}],["$","h2",null,{"className":"text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-[52px]","children":"We believe closed systems are dangerous."}],["$","div",null,{"className":"mt-6 space-y-4 text-base leading-relaxed text-muted-foreground md:text-lg","children":[["$","p",null,{"children":"A build system you cannot read is one you cannot audit, cannot reproduce on your own hardware, and cannot leave. Proprietary build tools and closed remote-execution services ask you to take on faith what happens between your source and your binary. When agents write and commit code faster than people can review it, the build is the last checkpoint that has to stay honest: every input named, every action hermetic, every output hashed."}],["$","p",null,{"children":"Bazel is open, and its model of declared inputs, sandboxed actions and content-addressed outputs is what makes a remote cache trustworthy in the first place. Forge's source is public and its protocol is the open Remote Execution API. Together they are a build pipeline with no black box in it."}],["$","p",null,{"className":"text-foreground","children":["So: migrate to Bazel, modernise with migrate-to-bazelmod, and point the result at Forge. Two lines in ",["$","span",null,{"className":"font-mono text-[0.95em]","children":".bazelrc"}]," ","against a local server, then a shared cache, then workers."]}]]}],["$","div",null,{"className":"mt-8 flex flex-wrap gap-3","children":[["$","a",null,{"href":"https://docs.forge.com/getting-started/quickstart","children":"Start the quickstart","ref":null,"className":"inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 min-h-[44px] tracking-[-0.005em] bg-brand text-brand-foreground hover:bg-brand-strong shadow-[0_1px_0_0_rgb(0_0_0_/_0.05),_0_8px_24px_-12px_rgb(var(--nl-color-brand)/0.55)] h-12 rounded-[10px] px-7 text-base"}],["$","a",null,{"href":"/#mcp","children":"See the MCP server","ref":null,"className":"inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 min-h-[44px] tracking-[-0.005em] border border-border bg-surface text-foreground hover:border-foreground hover:bg-foreground hover:text-background h-12 rounded-[10px] px-7 text-base"}]]}],["$","p",null,{"className":"mt-6 text-sm leading-relaxed text-muted","children":"The Forge MCP server, which gives Claude Code, Cursor and Codex five tools for configuring and tuning builds, is part of Forge Enterprise and requires an Enterprise licence. Everything else on this page is free."}]]}]}]}]]}]
