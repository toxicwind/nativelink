3:["$","h1",null,{"children":"Member of Technical Staff"}]
4:["$","p",null,{"children":[["$","strong",null,{"children":"Location:"}]," London, in-office · ",["$","strong",null,{"children":"Type:"}]," Full-time · ",["$","strong",null,{"children":"Team:"}]," Engineering"]}]
5:["$","h2",null,{"children":"About Forge"}]
6:["$","p",null,{"children":"Forge is a high-performance, open source remote build cache and execution platform. We are a small team in London, and we are growing."}]
7:["$","h2",null,{"children":"The role"}]
8:["$","p",null,{"children":"As a Member of Technical Staff you own real systems end to end, from the scheduler and worker fleet to the storage layer clients depend on. You will operate large clusters in production, keep them fast under heavy load, and ship improvements to both our infrastructure and the open source project itself."}]
9:["$","h2",null,{"children":"What you'll do"}]
a:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Operate and scale large Kubernetes clusters in production."}],"\n",["$","li",null,{"children":"Build and harden the services behind remote execution and caching."}],"\n",["$","li",null,{"children":"Diagnose performance problems where they actually live, in the kernel, the network, and the storage layer, and fix them."}],"\n",["$","li",null,{"children":"Work in the open: land changes in the public Forge repository that the whole community runs."}],"\n"]}]
b:["$","h2",null,{"children":"What we're looking for"}]
c:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Experience operating large clusters in production."}],"\n",["$","li",null,{"children":"Strong Kubernetes."}],"\n",["$","li",null,{"children":"Strong Go."}],"\n",["$","li",null,{"children":"A love of build systems, low latency, and getting to the bottom of hard systems problems."}],"\n",["$","li",null,{"children":"An interest in Rust, and experience with Rust or C++."}],"\n"]}]
d:["$","h2",null,{"children":"Nice to have"}]
e:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Experience in safety-critical environments, aerospace especially."}],"\n"]}]
f:["$","h2",null,{"children":"Security and trust responsibilities"}]
10:["$","p",null,{"children":"We run infrastructure our customers' builds — and their source code — depend on, so every engineer here shares responsibility for keeping the platform trustworthy. In this role you will:"}]
11:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Security:"}]," follow our security policies and secure development practices, design and review changes with security in mind, and report and help remediate vulnerabilities promptly."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Availability:"}]," build and operate production systems to meet our availability commitments, including monitoring, capacity planning, and participating in incident response."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Processing integrity:"}]," ensure build, cache, and execution results are processed completely, accurately, and only as authorized."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Confidentiality:"}]," protect confidential customer and company information, and access systems and data only as your role requires, following least privilege."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Privacy:"}]," handle personal data in line with our privacy policy and applicable data-protection law."]}],"\n"]}]
12:["$","h2",null,{"children":"What we offer"}]
13:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Real ownership: you own systems end to end on a small team, and your work ships in the open to everyone who runs Forge."}],"\n",["$","li",null,{"children":"An in-office role in a good part of London, near several tube stations, with lunch covered and an unhurried lunch culture."}],"\n",["$","li",null,{"children":["A ",["$","strong",null,{"children":"£15,000"}]," referral bonus: refer an engineer we hire, and once they thrive for three months, it is yours."]}],"\n"]}]
14:["$","h2",null,{"children":"How to apply"}]
15:["$","p",null,{"children":["Our best hires came to the open source project, found something they wanted to fix, and fixed it. Before you reach out, head to the ",["$","a",null,{"href":"https://github.com/toxicwind/forge","children":"repository"}]," and find something you like. We will help you get started, and improving our contributor onboarding is itself a much appreciated contribution."]}]
16:["$","p",null,{"children":"When you are ready, apply below."}]
