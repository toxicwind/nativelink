pe (one process on a laptop, a sharded\nfleet across three regions) is described by a single JSON5 file. It has\nexactly six top-level keys, and only two of them are required."}],"\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Key"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Shape"}],["$","th",null,{"children":"What it holds"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"stores"}]}],["$","td",null,{"children":"yes"}],["$","td",null,{"children":"array"}],["$","td",null,{"children":"Every storage backend this process can use, each with a name"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"servers"}]}],["$","td",null,{"children":"yes"}],["$","td",null,{"children":"array"}],["$","td",null,{"children":"Listeners, and which services are exposed on each"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"schedulers"}]}],["$","td",null,{"children":"no"}],["$","td",null,{"children":"array"}],["$","td",null,{"children":"Queues that match actions to workers"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"workers"}]}],["$","td",null,{"children":"no"}],["$","td",null,{"children":"array"}],["$","td",null,{"children":"Executors that run actions, in this process"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"global"}]}],["$","td",null,{"children":"no"}],["$","td",null,{"children":"object"}],["$","td",null,{"children":"Process-wide settings: file limits, default digest function"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_origin_events"}]}],["$","td",null,{"children":"no"}],["$","td",null,{"children"