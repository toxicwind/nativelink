f:["$","p",null,{"children":["Every top-level collection is an ",["$","strong",null,{"children":"array of objects"}],", not a map keyed by\nname. Stores and schedulers carry their ",["$","code",null,{"children":"name"}]," beside the type key; workers\ncarry it inside the ",["$","code",null,{"children":"local"}]," block; servers have an optional ",["$","code",null,{"children":"name"}],":"]}]
