b:["$","$L31",null,{"children":"flowchart LR\nclient[Build client] -->|\"gRPC :50051\"| server[servers entry]\nserver --> svc{{services}}\nsvc -->|cas, ac, bytestream| store[(stores entry<br/>by name)]\nsvc -->|execution| sched[schedulers entry<br/>by name]\nsched -->|assigns action| worker[workers entry]\nworker -->|\"worker_api :50061\"| server2[a second servers entry]\nserver2 --> sched\nworker --> store"}]
c:["$","p",null,{"children":["Read that diagram as: ",["$","strong",null,{"children":["the ",["$","code",null,{"children":"servers"}]," array is the only entry point, and\neverything else is reached from it by name."]}]," A service doesn't contain a\nstore, it names one. A worker doesn't contain a scheduler, it dials one over\nthe worker API. The names are the wiring."]}]
d:["$","p",null,{"children":["This is why the config can describe both a single process and a fleet without\nchanging shape. Split the same file into three (one with ",["$","code",null,{"children":"stores"}]," and a CAS\nserver, one with ",["$","code",null,{"children":"schedulers"}]," and an execution server, one with ",["$","code",null,{"children":"workers"}],")\nand the names become network addresses instead of in-process references.\nNothing else changes."]}]
