f:["$","$L17",null,{"toc":[{"depth":2,"url":"#three-names-one-file","title":"Three names, one file"},{"depth":2,"url":"#the-key-space-is-not-just-digests","title":"The key space is not just digests"},{"depth":2,"url":"#the-digest-on-the-wire-is-a-claim-not-a-measurement","title":"The digest on the wire is a claim, not a measurement"},{"depth":3,"url":"#how-the-verify-store-actually-works","title":"How the verify store actually works"},{"depth":2,"url":"#composition-and-the-barriers-in-it","title":"Composition, and the barriers in it"},{"depth":3,"url":"#fast-slow-writes-through-and-deliberately-re-uploads","title":[["$","code",null,{"children":"fast_slow"}]," writes through, and deliberately re-uploads"]},{"depth":3,"url":"#dedup-is-a-chunking-index-and-it-has-opinions","title":[["$","code",null,{"children":"dedup"}]," is a chunking index, and it has opinions"]},{"depth":2,"url":"#two-things-that-are-not-what-their-filenames-say","title":"Two things that are not what their filenames say"},{"depth":2,"url":"#where-the-exact-truth-lives","title":"Where the exact truth lives"},{"depth":2,"url":"#common-questions","title":"Common questions"}],"full":"$undefined","children":[["$","$L18",null,{"children":"The store model"}],["$","$L19",null,{"children":"What a store actually is, how composition behaves, and where a digest stops being a claim and becomes a fact."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone composing stores in a config file and wanting to\npredict the result, and anyone writing a new store backend. ",["$","strong",null,{"children":"What you'll\nhave at the end:"}]," the trait, the key space, the composition rules, and the\none place verification actually happens. ",["$","strong",null,{"children":"Time:"}]," twenty minutes."]}],"\n",["$","p",null,{"children":["A Forge store is not a database binding. It is one small trait\n(eight required methods), and everything you configure as a \"store\" is either\nan implementation of it or a wrapper around other implementations of it. The\n",["$","code",null,{"children":"stores"}]," block in your config is a graph, and its edges have semantics that\nthe JSON5 does not show you."]}],"\n",["$","$L1b",null,{"as":"h2","id":"three-names-one-file","children":"Three names, one file"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"Store"}],", ",["$","code",null,{"children":"StoreLike"}]," and ",["$","code",null,{"children":"StoreDriver"}]," all live in\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/store_trait.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/store_trait.rs","data-source-ref":"v1.6.5","title":"forge-util/src/store_trait.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"store_trait.rs"]}],",\nand the split between them matters when you read the source."]}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"StoreDriver"}]," is the trait a backend implements. ",["$","code",null,{"children":"Store"}]," is a\n",["$","code",null,{"children":"#[repr(transparent)]"}]," newtype around ",["$","code",null,{"children":"Arc<dyn StoreDriver>"}],", the handle\neverything else holds. ",["$","code",null,{"children":"StoreLike"}]," is the ergonomic layer callers use: its\nmethods (",["$","code",null,{"children":"get"}],", ",["$","code",null,{"children":"has"}],", ",["$","code",null,{"children":"update_oneshot"}]," and the rest) accept anything that\nconverts into a ",["$","code",null,{"children":"StoreKey"}]," and forward to the pinned driver, so callers never\ndeal with ","$L1c"," directly."]}],"\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b"]}],"$L4c"]}]
