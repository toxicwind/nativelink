a:["$","p",null,{"children":["The last step is the one worth internalising: the listener accept loops, the\nlocal workers and the origin-event publisher are joined as root futures with\n",["$","code",null,{"children":"try_join_all"}],", and if any of them returns an error the process panics rather\nthan continuing in a degraded state. A Forge whose worker task has died\ndoes not limp; it dies and lets your supervisor restart it. That is a\ndeliberate choice about which failure mode is easier to operate."]}]
b:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Only HTTP listeners exist"}],["$","p",null,{"children":[["$","code",null,{"children":"ListenerConfig"}]," has exactly one variant, ",["$","code",null,{"children":"http"}],", and the startup path\ndestructures it irrefutably. No other listener kind can be configured;\na config naming one fails to parse."]}]]}]]}]
c:["$","$L7",null,{"as":"h2","id":"the-crate-graph","children":"The crate graph"}]
d:["$","p",null,{"children":["Twelve library crates plus the binary, in strict layers. The diagram shows\nthe ten that give the program its shape; the other two are\n",["$","code",null,{"children":"forge-metric-macro-derive"}]," (the proc macro behind ",["$","code",null,{"children":"forge-metric"}],")\nand ",["$","code",null,{"children":"forge-redis-tester"}]," (a fake Redis used by the store crate and by\ntests). ",["$","code",null,{"children":"forge-macro"}]," is a test-only proc macro that no library crate\ndepends on. An arrow points from a crate to a crate that depends on it."]}]
e:["$","$L8",null,{"children":"graph BT\nproto[\"forge-proto\"] --> error[\"forge-error\"]\nmetric[\"forge-metric\"] --> error\nerror --> config[\"forge-config\"]\nconfig --> util[\"forge-util\"]\nutil --> store[\"forge-store\"]\nstore --> scheduler[\"forge-scheduler\"]\nstore --> worker[\"forge-worker\"]\nscheduler --> service[\"forge-service\"]\nservice --> bin[\"src/bin/forge.rs\"]\nworker --> bin\n"}]
f:["$","p",null,{"children":"Two absences carry more information than any of the edges."}]
10:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"forge-worker"}]," does not depend on ",["$","code",null,{"children":"forge-scheduler"}],"."]}]," A worker\nreaches its scheduler over gRPC and nothing else, whether that scheduler is\nin the same process or in another datacentre. No in-process\nfast path exists to accidentally rely on, which is why \"run everything in one\nprocess\" and \"run a worker fleet\" are the same code with different config."]}]
11:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"forge-service"}]," does not depend on ",["$","code",null,{"children":"forge-worker"}],"."]}]," The gRPC\nsurface has no notion of a local worker. The root binary is the only place\nwhere a service and a worker are ever mentioned together."]}]
12:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"forge-proto's library root is not under src/"}],["$","p",null,{"children":["Its ",["$","code",null,{"children":"src/"}]," holds vendored Bazel ",["$","code",null,{"children":".proto"}]," files; the crate's library root is\nchecked-in generated code at\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-proto/genproto/lib.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-proto/genproto/lib.rs","data-source-ref":"v1.6.5","title":"forge-proto/genproto/lib.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"genproto/lib.rs"]}],".\nEditing a ",["$","code",null,{"children":".proto"}]," file does not change the build until that generated tree\nis regenerated with ",["$","code",null,{"children":"bazel run forge-proto:update_protos"}],", which is a\nmanual step, not a build script."]}]]}]]}]
13:["$","$L7",null,{"as":"h2","id":"configuration-is-json5-and-it-is-validated-early","children":"Configuration is JSON5, and it is validated early"}]
14:["$","p",null,{"children":["Config parsing is JSON5, not JSON: comments and trailing commas are legal,\nwhich is why every example in these docs uses them. The entry point is\n",["$","code",null,{"children":"CasConfig::try_from_json5_file"}]," in\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/cas_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/cas_server.rs","data-source-ref":"v1.6.5","title":"forge-config/src/cas_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"CasConfig"]}],"."]}]
15:["$","p",null,{"children":["One cross-field check runs before anything is constructed: ",["$","code",null,{"children":"check_store_conflict"}],"\nrejects a config in which the CAS service and the action cache service for\nthe same instance name point at the same store. The action cache is keyed by\nthe ",["$","code",null,{"children":"Action"}]," digest, and the CAS holds the ",["$","code",null,{"children":"Action"}]," message itself under that\nsame digest, so sharing a store lets an ",["$","code",null,{"children":"ActionResult"}]," overwrite the blob it\ndescribes. Catching it at parse time rather than at first collision is the\nwhole reason the check exists."]}]
16:["$","p",null,{"children":["Everything else about the config file (every field, every default) lives in\nthe ",["$","$L6",null,{"href":"/reference/forge-config","children":"configuration reference"}],", which is\ngenerated from these same Rust types rather than transcribed from them."]}]
17:["$","$L7",null,{"as":"h2","id":"stores-are-built-in-two-phases","children":"Stores are built in two phases"}]
18:["$","p",null,{"children":[["$","code",null,{"children":"store_factory"}]," constructs each configured store, and then a separate\n",["$","code",null,{"children":"run_post_init()"}]," pass runs across all of them. The second pass exists because\na ",["$","code",null,{"children":"ref_store"}]," names another top-level store (possibly one declared later in\nthe file), and a single-pass construction would make declaration order\nload-bearing. Wrappers such as ",["$","code",null,{"children":"fast_slow"}]," and ",["$","code",null,{"children":"verify"}]," do not need it: their\ninner stores are inline specs, built recursively by the same factory call. By\nthe time ",["$","code",null,{"children":"post_init"}]," runs, every store in the config exists and can be\nresolved."]}]
19:["$","p",null,{"children":["The consequence for anyone adding a store: work that needs ",["$","em",null,{"children":"other"}]," stores\nbelongs in ",["$","code",null,{"children":"post_init"}],", not in the constructor. ",["$","$L6",null,{"href":"/explanations/store-model","children":"The store model"}],"\ncovers what a store actually is and how composition behaves."]}]
1a:["$","$L7",null,{"as":"h2","id":"services-come-up-in-a-fixed-order","children":"Services come up in a fixed order"}]
1b:["$","p",null,{"children":["The registration order is: action cache, CAS, execution, ",["$","code",null,{"children":"Operations"}],", Remote\nAsset fetch, Remote Asset push, ByteStream, capabilities, worker API, and the\nexperimental Build Event Protocol service. Each is registered only if the\nconfig asks for it."]}]
1c:["$","p",null,{"children":["Two of those are not gRPC at all. The health endpoint at ",["$","code",null,{"children":"/status"}]," and the\nadmin endpoint at ",["$","code",null,{"children":"/admin"}]," are plain HTTP handlers on the same listener, so\na health check does not need a gRPC client, and an admin call is not\ndiscoverable through reflection. ",["$","$L6",null,{"href":"/reference/protocol-api","children":"Protocol and API surface"}],"\nenumerates every RPC, including the ones that are registered but return\n",["$","code",null,{"children":"unimplemented"}],"."]}]
1d:["$","$L7",null,{"as":"h2","id":"where-an-actions-path-forks","children":"Where an action's path forks"}]
1e:["$","p",null,{"children":["The single most important structural fact about execution is that ",["$","strong",null,{"children":"a cache\nhit never reaches the scheduler"}],". Bazel calls ",["$","code",null,{"children":"GetActionResult"}]," before it\ncalls ",["$","code",null,{"children":"Execute"}],", so on a hit the execution service is never contacted at all."]}]
1f:["$","p",null,{"children":["For clients that skip that step, ",["$","code",null,{"children":"CacheLookupScheduler"}]," (the ",["$","code",null,{"children":"cache_lookup"}],"\nscheduler type) is a decorator, not a stage. It wraps the real scheduler and\nsits in front of it. On a hit it synthesises an\n",["$","code",null,{"children":"ActionStage::CompletedFromCache"}]," and returns; the action is never queued,\nnever assigned a worker, and never appears in any queue-depth metric. On a\nmiss it delegates to the wrapped ",["$","code",null,{"children":"SimpleScheduler"}]," and the action enters the\nworld described in ",["$","$L6",null,{"href":"/explanations/scheduler-internals","children":"scheduler internals"}],".\nNone of the shipped example configs use it; the diagram below shows the\nstack with it present."]}]
20:["$","$L8",null,{"children":"graph LR\nex[\"Execute RPC\"] --> pre[\"Shallow input check\"]\npre --> cl[\"CacheLookupScheduler\"]\ncl -->|hit| done[\"CompletedFromCache<br/>never queued\"]\ncl -->|miss| ss[\"SimpleScheduler\"]\nss --> match[\"Matching engine\"]\nmatch --> w[\"Worker\"]\n"}]
21:["$","p",null,{"children":"This explains a metric shape that otherwise looks broken: on a\nwell-cached build, the scheduler's queue metrics stay near zero while the\nexecution service is extremely busy. Nothing is wrong. The hits are being\nserved in front of the thing that counts."}]
22:["$","$L7",null,{"as":"h3","id":"the-pre-flight-check-is-deliberately-racy","children":"The pre-flight check is deliberately racy"}]
23:["$","p",null,{"children":["Before an ",["$","code",null,{"children":"Execute"}]," is accepted, the execution service does a shallow check\nthat the action's inputs are present: the ",["$","code",null,{"children":"Action"}]," proto itself, its\n",["$","code",null,{"children":"command_digest"}]," and its ",["$","code",null,{"children":"input_root_digest"}],". It is documented in-source as\ndeliberately shallow and deliberately racy: it does not walk the full input\ntree, and a blob can be evicted between the check passing and the worker\nasking for it."]}]
24:["$","p",null,{"children":["That is the right trade. A complete check would mean walking an entire\nMerkle tree on every submission, and it still would not be a guarantee,\nbecause eviction can happen at any point afterwards. The check exists to turn\nthe common client mistake (submitting an action whose inputs were never\nuploaded) into a fast ",["$","code",null,{"children":"FAILED_PRECONDITION"}]," carrying a ",["$","code",null,{"children":"PreconditionFailure"}],"\nthat lists the missing digests, so Bazel re-uploads and retries, instead of\na worker-side failure minutes later. It is a courtesy, not an invariant. See\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/execution_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/execution_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/execution_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ExecutionServer"]}],"."]}]
25:["$","$L7",null,{"as":"h2","id":"two-details-that-surprise-people-reading-the-wire","children":"Two details that surprise people reading the wire"}]
26:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"GetTree"}]," page tokens are ",["$","code",null,{"children":"\"{hash}-{size}\""}],"."]}]," They are constructed and\nparsed by splitting on ",["$","code",null,{"children":"-"}],". They are not opaque, and they are not signed,\nthough the protocol says clients should treat them as opaque, and clients\nthat do will keep working if this ever changes."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":"ByteStream resource names are parsed backwards."}]," A resource name looks\nlike ",["$","code",null,{"children":"{instance}/blobs/{hash}/{size}"}],", and the instance name is allowed to\ncontain slashes. Parsing left to right therefore cannot tell where the\ninstance name ends; parsing from the right can, because the trailing\ncomponents are fixed. See\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/resource_info.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/resource_info.rs","data-source-ref":"v1.6.5","title":"forge-util/src/resource_info.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ResourceInfo"]}],"."]}]
