2b:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/MODULE.bazel","target":"_blank","rel":"noreferrer","data-source-link":"MODULE.bazel","data-source-ref":"v1.6.5","title":"MODULE.bazel at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"module()"]}]
2c:["$","p",null,{"children":["declares ",["$","code",null,{"children":"compatibility_level = 0"}],", which is Bazel's way of saying no\ncompatibility promise is being made across versions. The config schema and\nthe metrics surface have both changed in minor releases; the changelog marks\nsuch entries as breaking."]}]
2d:["$","p",null,{"children":["The wire protocol is the exception, and it is the one that matters for most\ndeployments: Forge implements the Remote Execution API, which is\nversioned upstream and changes slowly. A client that worked against one\nForge release will keep working against the next.\n",["$","$L1b",null,{"href":"/contribute/release-versioning","children":"Release and versioning"}]," is the page for\nthe details."]}]
2e:["$","$L1c",null,{"as":"h2","id":"why-these-docs-were-rewritten","children":"Why these docs were rewritten"}]
2f:["$","p",null,{"children":"The previous documentation accumulated during the period when the project\nwas changing shape weekly. It described commands that no longer existed,\ncomponents that had been renamed, and performance numbers with no source.\nThis rewrite holds every page to the same contract: every command is run or\nschema-checked before it ships, every claim about the code links to the code,\nand pages that cannot meet that bar say what they do not know."}]
30:["$","p",null,{"children":"The source lives in"}]
31:["$","a",null,{"href":"https://github.com/toxicwind/forge/tree/v1.6.5/web/apps/docs/content/docs","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/content/docs","data-source-ref":"v1.6.5","title":"web/apps/docs/content/docs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"content/docs/"]}]
32:["$","p",null,{"children":["and corrections are the most welcome kind of pull request.\n",["$","$L1b",null,{"href":"/contribute/docs","children":"Working on documentation"}]," is the how."]}]
33:["$","$L1c",null,{"as":"h2","id":"common-questions","children":"Common questions"}]
34:["$","$L37",null,{"type":"multiple","children":[["$","$L38",null,{"title":"Is Forge open source?","id":"is-forge-open-source","children":["$","p",null,{"children":"It is source-available today and open source on a timer. The FSL 1.1\ngrant permits everything except offering Forge itself as a\ncompeting commercial service, and each release converts to Apache 2.0\ntwo years after publication. If your concern is \"can I read and modify\nthe code that runs my builds\", the answer is yes, without qualification."}]}],["$","$L38",null,{"title":"Can I use it commercially?","id":"can-i-use-it-commercially","children":["$","p",null,{"children":"Yes. Running it to build your own software is a permitted purpose,\ncommercial or not. The restriction is on reselling Forge as a\ncompeting product or service. The two BUSL modules are the ones to\ncheck with counsel if you plan to redistribute."}]}],["$","$L38",null,{"title":"Why Rust and not Go?","id":"why-rust-and-not-go","children":["$","p",null,{"children":"Predictable tail latency without a garbage collector, and memory safety\nwithout a managed runtime. The cost is compile time and a smaller pool\nof contributors, a real trade, made deliberately, for a component whose\nworst failure mode is silently serving the wrong bytes."}]}],["$","$L38",null,{"title":"Does the version number mean anything?","id":"does-the-version-number-mean-anything","children":["$","p",null,{"children":["Less than it looks like. ",["$","code",null,{"children":"compatibility_level = 0"}]," in ",["$","code",null,{"children":"MODULE.bazel"}],"\nmeans no cross-version compatibility guarantee. Read the changelog\nbefore upgrading, and pin the version in your deployment."]}]}]]}]
35:["$","a",null,{"href":"/explanations/lre","data-next-step":"next","className":"my-4 flex items-start gap-3 rounded-xl border px-5 py-4 no-underline transition-colors border-brand/40 bg-brand-soft/30 hover:border-brand/70","children":[["$","svg",null,{"width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-1 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M5 12h14m-6-6 6 6-6 6"}]}],["$","span",null,{"className":"flex-1","children":[["$","span",null,{"className":"block font-mono text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground","children":"Next"}],["$","span",null,{"className":"block font-semibold text-foreground","children":"Local Remote Execution"}],["$","span",null,{"className":"mt-0.5 block text-sm text-muted-foreground","children":["$","p",null,{"children":"The idea that came out of the rewrite rather than driving it: the same\nhermetic toolchain on your laptop and on the remote workers."}]}]]}]]}]
