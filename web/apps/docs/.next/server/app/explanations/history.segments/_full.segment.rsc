23:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/LICENSE","target":"_blank","rel":"noreferrer","data-source-link":"LICENSE","data-source-ref":"v1.6.5","title":"LICENSE at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"LICENSE"]}]
24:["$","p",null,{"children":["is the ",["$","strong",null,{"children":"Functional Source License 1.1 with an Apache 2.0 future grant"}],"\n(",["$","code",null,{"children":"FSL-1.1-Apache-2.0"}],"). In practice that means two things. You may use, read,\nmodify and deploy the software for any purpose ",["$","em",null,{"children":"except"}]," offering it to others\nas a competing commercial product or service. And each release converts to\nplain Apache 2.0 on the second anniversary of its publication; the grant is\nirrevocable and written into the license itself, not a promise made\nelsewhere."]}]
25:["$","p",null,{"children":["Five files are ",["$","strong",null,{"children":"Business Source License"}]," instead, and they are worth\nknowing by name because they are the ones an internal license review will\nflag:"]}]
26:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"File or module"}],["$","th",null,{"children":"What it is"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"forge-util/src/metrics.rs"}]}],["$","td",null,{"children":"The metrics collection layer"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"forge-worker/src/persistent_worker/"}],": ",["$","code",null,{"children":"mod.rs"}],", ",["$","code",null,{"children":"pool.rs"}],", ",["$","code",null,{"children":"live_worker.rs"}],", ",["$","code",null,{"children":"protocol.rs"}]]}],["$","td",null,{"children":"Remote persistent workers"}]]}]]}]]}]}]
27:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Copy the header, don't recall it"}],["$","p",null,{"children":["When you add a file, copy the license header from the file next to it\nrather than from memory. A new file under ",["$","code",null,{"children":"persistent_worker/"}]," needs the\nBUSL header; a new file in the same crate's ",["$","code",null,{"children":"src/"}]," does not."]}]]}]]}]
28:["$","p",null,{"children":["Nothing in the repository requires a contributor license agreement or a\nDeveloper Certificate of Origin sign-off. What it does require is\ncryptographically signed commits; see\n",["$","$L1b",null,{"href":"/contribute/guidelines","children":"the contribution guidelines"}],"."]}]
