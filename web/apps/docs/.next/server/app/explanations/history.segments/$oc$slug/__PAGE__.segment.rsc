8:["$","p",null,{"children":[["$","strong",null,{"children":"Memory safety without a runtime."}]," A build cache that serves a ",["$","em",null,{"children":"wrong"}],"\nartifact is a far worse incident than one that serves ",["$","em",null,{"children":"no"}]," artifact: it is\nsilent, and it propagates to everyone who pulls from the cache. Rust removes\nthe memory-corruption path to that outcome at compile time, without adding a\nmanaged runtime back in."]}]
9:["$","p",null,{"children":[["$","strong",null,{"children":"One binary, many roles."}]," CAS, action cache, scheduler and worker are the\nsame executable with different configuration. It makes the small deployment\ntrivial and the large deployment a scaling exercise rather than a\nre-architecture. ",["$","$L6",null,{"href":"/explanations/architecture","children":"Architecture"}]," covers what that\nmeans in practice, and\n",["$","$L6",null,{"href":"/explanations/architecture-deep-dive","children":"the deep dive"}]," covers what the binary\ndoes with the config it is handed."]}]
a:["$","p",null,{"children":["A fourth property arrived with the project rather than driving it: because\nthe toolchain definitions could be shared between the local machine and the\nremote workers, the same hermetic build could run in both places. That became\n",["$","$L6",null,{"href":"/explanations/lre","children":"Local Remote Execution"}],", and it is the part of Forge\nwith no real equivalent elsewhere."]}]
