12:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Copy the header, don't recall it"}],["$","p",null,{"children":["When you add a file, copy the license header from the file next to it\nrather than from memory. A new file under ",["$","code",null,{"children":"persistent_worker/"}]," needs the\nBUSL header; a new file in the same crate's ",["$","code",null,{"children":"src/"}]," does not."]}]]}]]}]
13:["$","p",null,{"children":["Nothing in the repository requires a contributor license agreement or a\nDeveloper Certificate of Origin sign-off. What it does require is\ncryptographically signed commits; see\n",["$","$L6",null,{"href":"/contribute/guidelines","children":"the contribution guidelines"}],"."]}]
