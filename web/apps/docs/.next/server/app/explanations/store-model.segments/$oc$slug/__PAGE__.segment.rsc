8:["$","p",null,{"children":["A driver must supply eight methods: ",["$","code",null,{"children":"post_init"}],", ",["$","code",null,{"children":"has_with_results"}],",\n",["$","code",null,{"children":"update"}],", ",["$","code",null,{"children":"get_part"}],", ",["$","code",null,{"children":"inner_store"}],", ",["$","code",null,{"children":"as_any"}],", ",["$","code",null,{"children":"as_any_arc"}],", and\n",["$","code",null,{"children":"register_remove_callback"}],". Only the middle three are the ones you would\nguess. The other five are what makes composition work, and ",["$","code",null,{"children":"inner_store"}]," in\nparticular is where composition either succeeds or silently stops."]}]
9:["$","$L6",null,{"as":"h2","id":"the-key-space-is-not-just-digests","children":"The key space is not just digests"}]
a:["$","p",null,{"children":[["$","code",null,{"children":"StoreKey"}]," has two variants: ",["$","code",null,{"children":"Digest(DigestInfo)"}]," and ",["$","code",null,{"children":"Str(Cow<str>)"}],". Most\nof Forge deals in the first. The second exists because two subsystems\nneed to store things that are not content-addressed at all: the Build Event\nProtocol service, and the scheduler's awaited-action database."]}]
b:["$","p",null,{"children":["This has a consequence people hit and misread. ",["$","code",null,{"children":"StoreKey::into_digest()"}],"\nconverts a ",["$","code",null,{"children":"Str"}]," key to a digest by BLAKE3-hashing the string, with the hash\nfunction hardcoded. That conversion is lossy and irreversible: a store that\nonly understands digests will accept a ",["$","code",null,{"children":"Str"}]," key and file it somewhere\ndeterministic, but the original string is gone. The filesystem store handles\nthis more honestly by keeping the two in separate namespaces on disk (",["$","code",null,{"children":"s/"}],"\nfor string keys, ",["$","code",null,{"children":"d/"}]," for digests) so the two can never collide."]}]
c:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Why a hardcoded hash here is fine"}],["$","p",null,{"children":"Elsewhere, a hardcoded hash function would be a correctness bug, because\nthe client picks the digest function per request. Here it is not: these\nkeys never cross the REAPI wire and are never compared against a\nclient-supplied digest. The hash is an internal placement function, not an\nidentity."}]]}]]}]
d:["$","$L6",null,{"as":"h2","id":"the-digest-on-the-wire-is-a-claim-not-a-measurement","children":"The digest on the wire is a claim, not a measurement"}]
e:["$","p",null,{"children":"This is the single most important thing on this page."}]
f:["$","p",null,{"children":[["$","strong",null,{"children":"Forge does not derive a blob's digest from its bytes on upload."}]," The\nclient declares the digest in the ByteStream resource name, and the server\nstores the bytes under the declared key. See\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/bytestream_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/bytestream_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/bytestream_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ByteStreamServer"]}],".\n(The one exception is a zstd-compressed ByteStream upload, where the decoder\nalready has to read every byte and rejects a decoded stream whose size or\nhash does not match the digest.)"]}]
10:["$","p",null,{"children":["For plain uploads, the only thing that turns a claimed digest into a verified\none is a ",["$","code",null,{"children":"verify"}]," store somewhere in the graph, and both of its checks\ndefault to ",["$","strong",null,{"children":"off"}],":"]}]
11:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"What it costs when on"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"verify_size"}]}],["$","td",null,{"children":["$","code",null,{"children":"false"}]}],["$","td",null,{"children":"Nearly nothing; a running byte count"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"verify_hash"}]}],["$","td",null,{"children":["$","code",null,{"children":"false"}]}],["$","td",null,{"children":"One hash pass over every uploaded byte"}]]}]]}]]}]}]
12:["$","p",null,{"children":["A cache with no ",["$","code",null,{"children":"verify"}]," store in the write path is a cache that will store,\nand later serve, whatever a buggy or hostile client claims. That is not a\nForge-specific hazard (it is how the REAPI is specified), but the\ndefault being ",["$","code",null,{"children":"false"}]," means it is a decision you are making whether or not\nyou know it. ",["$","$L44",null,{"href":"/explanations/correctness-hermeticity","children":"Correctness and hermeticity"}],"\ncovers what to do about it."]}]
13:["$","$L6",null,{"as":"h3","id":"how-the-verify-store-actually-works","children":"How the verify store actually works"}]
14:["$","p",null,{"children":"The implementation in"}]
15:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/verify_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/verify_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/verify_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"VerifyStore"]}]
16:["$","p",null,{"children":"is worth understanding, because three of its properties are not apparent from the config."}]
17:["$","p",null,{"children":[["$","strong",null,{"children":"Size is checked eagerly, before a byte is read."}]," If the declared size is\nalready wrong at the point the request arrives, the upload is rejected\nwithout transferring anything."]}]
18:["$","p",null,{"children":[["$","strong",null,{"children":"The hash function is read per-request from the ambient context"}],", not from\nconfig. This is what lets one store serve both SHA-256 and BLAKE3 clients\nwithout duplicating the graph."]}]
19:["$","p",null,{"children":[["$","strong",null,{"children":"Verification runs concurrently with the write, not before it."}]," The inner\nstore's ",["$","code",null,{"children":"update"}]," and the checker are driven together, so verification adds no\nserialised pass. The cost of that design is that a failing upload has already\nbeen partially written to the inner store when the failure is detected."]}]
1a:["$","p",null,{"children":["Size is enforced along three separate paths (overshoot, an exact hit that\nturns out not to be EOF, and undershoot at EOF), and the hash is compared at\nEOF. Every failure is ",["$","code",null,{"children":"InvalidArgument"}],", which is the correct code: the\nclient sent something that did not match what the client said it was sending."]}]
1b:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Nothing is re-verified on read"}],["$","p",null,{"children":[["$","code",null,{"children":"VerifyStore::get_part"}]," is a bare pass-through. Verification is a\n",["$","strong",null,{"children":"write-side"}]," property only. A blob that entered the store before you added\nthe verify wrapper, or through a path that bypassed it, will be served\nwithout complaint forever."]}]]}]]}]
1c:["$","$L6",null,{"as":"h2","id":"composition-and-the-barriers-in-it","children":"Composition, and the barriers in it"}]
1d:["$","p",null,{"children":[["$","code",null,{"children":"inner_store"}]," is how the system looks ",["$","em",null,{"children":"through"}]," a wrapper to find an\noptimisation opportunity, for example, to discover that the real backing\nstore is a filesystem store and a hardlink is possible."]}]
1e:["$","p",null,{"children":["Most wrappers return ",["$","code",null,{"children":"self"}]," from ",["$","code",null,{"children":"inner_store"}],". That is not laziness; it is a\nstatement that looking through them would be wrong, because they transform\nthe bytes or the key. A ",["$","code",null,{"children":"compression"}]," store cannot let a caller hardlink its\ninner file: the inner file is not the blob, so most wrappers are\n",["$","strong",null,{"children":"optimisation barriers"}],", and only three forward: ",["$","code",null,{"children":"size_partitioning"}],",\n",["$","code",null,{"children":"shard"}],", and ",["$","code",null,{"children":"ref_store"}],", the three that route without transforming."]}]
1f:["$","p",null,{"children":["The practical rule when composing: ",["$","strong",null,{"children":"put transforming wrappers as close to the\nbackend as you can"}],". A ",["$","code",null,{"children":"verify"}]," in front of a ",["$","code",null,{"children":"fast_slow"}]," is a barrier in\nfront of the fast path."]}]
20:["$","$L45",null,{"children":"graph LR\ncaller[\"Caller<br/>(CAS service, worker)\"]\nsubgraph forward[\"Forward inner_store: routing only\"]\n  sp[\"size_partitioning\"]\n  sh[\"shard\"]\n  rs[\"ref_store\"]\nend\nsubgraph barrier[\"Return self: optimisation barriers\"]\n  vf[\"verify\"]\n  cp[\"compression\"]\n  dd[\"dedup\"]\nend\nfs[\"filesystem<br/>hardlink possible here\"]\ncaller --> forward\nforward --> barrier\nbarrier --> fs\nforward -. \"caller can see through\" .-> fs\n"}]
21:["$","p",null,{"children":"A caller reaching through the routing wrappers can discover the filesystem\nstore and hardlink from it. A caller reaching through a transforming wrapper\ncannot, because what is on disk underneath it is not the blob."}]
22:["$","p",null,{"children":[["$","code",null,{"children":"StoreOptimizations"}]," is the vocabulary for the other half of this:\n",["$","code",null,{"children":"FileUpdates"}],", ",["$","code",null,{"children":"NoopUpdates"}],", ",["$","code",null,{"children":"NoopDownloads"}],", ",["$","code",null,{"children":"LazyExistenceOnSync"}],",\n",["$","code",null,{"children":"SubscribesToUpdateOneshot"}],", capabilities a store advertises so callers can\nskip work rather than discovering at runtime that it was unnecessary."]}]
23:["$","$L6",null,{"as":"h3","id":"fast-slow-writes-through-and-deliberately-re-uploads","children":[["$","code",null,{"children":"fast_slow"}]," writes through, and deliberately re-uploads"]}]
24:["$","p",null,{"children":["With the default ",["$","code",null,{"children":"fast_direction"}]," and ",["$","code",null,{"children":"slow_direction"}],", writes go to both\ntiers concurrently and ",["$","strong",null,{"children":"both must succeed"}],". It has no write-behind and no\neventual consistency window: an upload that returns OK is durable in the slow\ntier."]}]
25:["$","p",null,{"children":["The surprising part is existence. ",["$","code",null,{"children":"fast_slow"}],"'s ",["$","code",null,{"children":"has_with_results"}],"\n",["$","strong",null,{"children":"intentionally never consults the fast store"}]," (unless the slow tier is a\n",["$","code",null,{"children":"noop"}]," store, in which case only the fast tier is checked). It asks the slow\ntier, then counts any slow-tier writes still in flight. A blob that is\npresent only in the fast tier is reported absent, which causes the client to\nupload it again, and that upload is what gets it into the slow tier. The\napparent inefficiency is the mechanism that stops the fast tier from becoming\na place where data can be lost."]}]
26:["$","p",null,{"children":"Reads use a leader/follower scheme so that a hundred simultaneous misses for\nthe same blob produce one fetch from the slow tier rather than a hundred.\nFollowers wait up to one minute for the leader before giving up and fetching\nfor themselves; that timeout is what stops a stuck leader from wedging every\nreader behind it."}]
27:["$","$L6",null,{"as":"h3","id":"dedup-is-a-chunking-index-and-it-has-opinions","children":[["$","code",null,{"children":"dedup"}]," is a chunking index, and it has opinions"]}]
28:["$","p",null,{"children":["A ",["$","code",null,{"children":"dedup"}]," store splits blobs with content-defined chunking (FastCDC), stores\nthe chunks, and writes an index under the ",["$","strong",null,{"children":"original"}]," key. Two large blobs\nthat share most of their content share most of their chunks."]}]
29:["$","p",null,{"children":["Two things to know before enabling it. First, chunk hashing is ",["$","strong",null,{"children":"hardcoded to\nBLAKE3"}]," regardless of the digest function the request used, which is\ncorrect for the same reason as ",["$","code",null,{"children":"StoreKey::into_digest"}],", since chunk hashes\nare placement, not identity, but it does mean a ",["$","code",null,{"children":"dedup"}]," store's internal\nlayout is unrelated to your clients' digest function."]}]
2a:["$","p",null,{"children":["Second, a corrupted index reports itself inconsistently: ",["$","code",null,{"children":"has()"}]," returns\n",["$","code",null,{"children":"NotFound"}]," while ",["$","code",null,{"children":"get_part"}]," returns ",["$","code",null,{"children":"Internal"}],". If you are debugging a store\nwhere existence checks and reads disagree, a damaged dedup index is the\nfirst thing to suspect."]}]
