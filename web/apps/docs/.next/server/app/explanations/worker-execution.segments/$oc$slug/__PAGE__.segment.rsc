33:["$","p",null,{"children":["The entire action directory is deleted after every action, with a ",["$","code",null,{"children":"Drop"}],"\nbackstop for the panicking case and a path-canonicalization check so that a\nmalicious or malformed operation ID cannot direct the delete outside the work\ndirectory."]}]
34:["$","p",null,{"children":"Three separate mechanisms get called \"eviction\" in worker discussions, and\nconflating them makes capacity planning impossible:"}]
35:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Domain"}],["$","th",null,{"children":"Governed by"}],["$","th",null,{"children":"Behaviour"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"The action directory"}],["$","td",null,{"children":"nothing"}],["$","td",null,{"children":"Deleted unconditionally after every action"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"The filesystem CAS"}],["$","td",null,{"children":["$","code",null,{"children":"eviction_policy.max_bytes"}]}],["$","td",null,{"children":"LRU over stored blobs"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["The directory cache (only if ",["$","code",null,{"children":"directory_cache"}]," is configured)"]}],["$","td",null,{"children":[["$","code",null,{"children":"max_entries"}]," (1000), ",["$","code",null,{"children":"max_size_bytes"}]," (10 GB)"]}],["$","td",null,{"children":"LRU over materialized input trees"}]]}]]}]]}]}]
36:["$","p",null,{"children":"Only the second is your cache size. The third is a distinct, much smaller\ncache of materialized trees, off by default, and its defaults are not derived\nfrom the second."}]
37:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":"$15:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Persistent workers keep more than you might expect"}],["$","p",null,{"children":["A persistent worker process is spawned once (with the worker's own\nenvironment, and ",["$","strong",null,{"children":"without"}]," namespaces or ",["$","code",null,{"children":"env_clear()"}],") and reused across\nactions. Each action still gets its own materialized input directory, which\nis handed to the process as the request's ",["$","code",null,{"children":"sandbox_dir"}],", but the process\nitself carries whatever state it accumulates from one request to the next.\nThat is the point (it is what makes them fast), but it also means a\npersistent worker is a shared mutable environment across the actions it\nserves. See ",["$","$L7",null,{"href":"/remote-execution/persistent-workers","children":"persistent workers"}],"."]}]]}]]}]
