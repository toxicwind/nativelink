7:["$","$L35",null,{"children":"graph TD\nnix[\"Nix derivation<br/>/nix/store/&lt;hash&gt;-clang\"]\nnix --> gen[\"Generated Bazel toolchain<br/>hardcodes the store path\"]\nnix --> img[\"Worker image<br/>Env/PATH = the same store paths\"]\nnix --> shell[\"nix develop<br/>realizes the closure locally\"]\ngen --> local[\"Local build<br/>invokes /nix/store/&lt;hash&gt;-clang\"]\ngen --> remote[\"Remote action<br/>invokes /nix/store/&lt;hash&gt;-clang\"]\nshell --> local\nimg --> remote\nlocal --> same[\"Same digest → one shared cache\"]\nremote --> same\n"}]
8:["$","p",null,{"children":[["$","strong",null,{"children":"On the remote side"}],", the worker image is built with ",["$","code",null,{"children":"nix2container"}]," and\nits environment is composed entirely of ",["$","code",null,{"children":"/nix/store/…"}]," paths. The image is a\ncarrier for that closure rather than a conventional root filesystem."]}]
9:["$","p",null,{"children":[["$","strong",null,{"children":"On the local side"}],", entering the Nix development shell realizes the same\nderivations into your own ",["$","code",null,{"children":"/nix/store"}],". This is what the commented-out ",["$","code",null,{"children":"PATH"}],"\nlines in the generated ",["$","code",null,{"children":"lre.bazelrc"}]," are for: Bazel ignores them, but Nix\nneeds a reason to fetch the closure, and those lines are it. The"]}]
a:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/local-remote-execution/README.md","target":"_blank","rel":"noreferrer","data-source-link":"local-remote-execution/README.md","data-source-ref":"v1.6.5","title":"local-remote-execution/README.md at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"local-remote-execution/README.md"]}]
b:["$","p",null,{"children":["says so directly: \"all paths printed in ",["$","code",null,{"children":"lre.bazelrc"}]," will be available on\nyour local system.\""]}]
c:["$","p",null,{"children":["What is shared between local and remote is ",["$","strong",null,{"children":"the store paths"}],", not the\nimage. Understanding that explains almost every question people have about\nLRE's edges."]}]
d:["$","$L6",null,{"as":"h2","id":"the-guarantee-with-its-qualifiers-intact","children":"The guarantee, with its qualifiers intact"}]
e:["$","p",null,{"children":"The source states the promise carefully, and the qualifiers are load-bearing:"}]
f:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":["a framework to build, distribute, and rapidly iterate on custom toolchain\nsetups that are transparent, fully hermetic, and reproducible ",["$","strong",null,{"children":"across\nmachines of the same system architecture"}]," […] This lets you reuse build\nartifacts with ",["$","strong",null,{"children":"virtually"}]," perfect cache hit rate."]}],"\n"]}]
10:["$","p",null,{"children":["Both emphases are the source's meaning, not an editorial softening.\nReproducibility is claimed within an architecture, not across them; an\n",["$","code",null,{"children":"aarch64-darwin"}]," laptop and an ",["$","code",null,{"children":"x86_64-linux"}]," worker are not going to share\nC++ artifacts, because they are not running the same binaries. And \"virtually\nperfect\" acknowledges that the toolchain is one input among several, and LRE\nonly pins the toolchain."]}]
11:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$0:data:0:rsc:props:children:0:props:children:2:props:children:7:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"LRE is explicitly experimental"}],["$","p",null,{"children":["The repository's own documentation opens with a warning that LRE is \"highly\nexperimental and can be challenging to set up in downstream projects\", and\na note that at the time of writing it \"only works on ",["$","code",null,{"children":"x86_64-linux"}],"\". The\nRust toolchains have since grown to four systems; the C++ toolchain has\nnot. Treat the setup cost as real."]}]]}]]}]
12:["$","$L6",null,{"as":"h2","id":"what-is-pinned-and-what-is-not","children":"What is pinned, and what is not"}]
13:["$","p",null,{"children":"This is where careful reading pays off."}]
14:["$","p",null,{"children":[["$","strong",null,{"children":"Not the image digest."}]," Every ",["$","code",null,{"children":"container-image"}]," value in the generated\nplatforms is ",["$","code",null,{"children":"name:tag"}],", where the tag is a Nix derivation hash, never a\n",["$","code",null,{"children":"sha256:"}]," content digest. The upstream config generator's digest-resolution\nstep was deliberately patched out, with the in-source justification that\n\"skipping this hash is not a generally safe practice and only works for us\nbecause our images are reproducible.\""]}]
15:["$","p",null,{"children":[["$","strong",null,{"children":"Not a URL that gets pulled."}]," ",["$","code",null,{"children":"container-image"}]," is a ",["$","em",null,{"children":"raw string matched by\nthe scheduler"}]," against what a worker advertises. Forge does not fetch it.\nTwo different conventions coexist in-tree (",["$","code",null,{"children":"docker://lre-cc:<tag>"}]," for C++\nand a ",["$","code",null,{"children":"ghcr.io/..."}]," reference for Rust), and a downstream user has to match\nwhatever string their own workers advertise. See\n",["$","$L36",null,{"href":"/remote-execution/platform-properties","children":"platform properties"}],"."]}]
16:["$","p",null,{"children":[["$","strong",null,{"children":"Not the image you actually deploy."}]," Three distinct images are in play: a\ngenerator image, the image the platform config nominally names, and the\nworker image that actually runs. The repository warns about this in its own\ndeployment manifests. The relationship is maintained by convention and by\ntag propagation, not by any mechanism that would catch a mismatch."]}]
17:["$","p",null,{"children":[["$","strong",null,{"children":"Not a single shared closure."}]," The local closure is whatever the dev shell\nrealizes; the worker image's closure is that plus extras the worker needs.\nThey are compatible by construction, not identical."]}]
