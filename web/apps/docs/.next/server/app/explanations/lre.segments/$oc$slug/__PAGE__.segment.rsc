19:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Language"}],["$","th",null,{"children":"Status"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Rust"}]}],["$","td",null,{"children":"Full toolchains across four Nix systems, stable and nightly"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"C/C++"}]}],["$","td",null,{"children":["Full toolchain, ",["$","strong",null,{"children":[["$","code",null,{"children":"x86_64-linux"}]," only"]}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Java"}]}],["$","td",null,{"children":"An image and a generated runtime exist, but no Bazel toolchain is registered"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Python, Go"}]}],["$","td",null,{"children":"Not provided"}]]}]]}]]}]}]
1a:["$","p",null,{"children":["Windows is not supported. On macOS the C++ path has no local toolchain at\nall (the flake module only emits the C++ platform and toolchain flags on\nLinux), so an ",["$","code",null,{"children":"lre-cc"}]," action can only run on a Linux worker carrying the\nimage; you get hermeticity there, not locality."]}]
1b:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"LRE is not an offline mode"}],["$","p",null,{"children":"It is tempting to read \"local remote execution\" as \"remote execution without\nthe network\". It is not. LRE pins the toolchain; whether a given action\nruns locally or on a remote worker is a separate question decided by\nplatform matching. On the platforms where the toolchain exists locally,\nbuilds are local, but that is a consequence, not the guarantee."}]]}]]}]
1c:["$","$L6",null,{"as":"h2","id":"why-nix-specifically","children":"Why Nix, specifically"}]
1d:["$","p",null,{"children":"Because the design needs every tool the build invokes to be identified by a\nhash of everything that produced it, and to live at a path that encodes that\nhash. That is precisely what a Nix store path is."}]
1e:["$","p",null,{"children":[["$","code",null,{"children":"/usr/bin/clang"}]," cannot be pinned. Its identity is whatever your package\nmanager last installed, it differs across machines that both call themselves\n\"Ubuntu 22.04\", and no amount of hashing the binary recovers the headers and\nlibraries it will reach for. ",["$","code",null,{"children":"/nix/store/<hash>-clang-…"}]," has already answered\nall of those questions by existing."]}]
1f:["$","p",null,{"children":["Everything else about LRE follows from that one property. The container\nimages, the generated Bazel toolchains, the ",["$","code",null,{"children":"lre.bazelrc"}],", all of it is\nplumbing to get those store paths onto both sides of the build."]}]
20:["$","p",null,{"children":["For Nix itself, see ",["$","$L36",null,{"href":"/contribute/nix","children":"Develop with Nix"}],"."]}]
21:["$","$L6",null,{"as":"h2","id":"when-it-is-worth-it","children":"When it is worth it"}]
22:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Situation"}],["$","th",null,{"children":"LRE?"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Cache hits are poor between developers and CI on the same architecture"}],["$","td",null,{"children":"Yes; this is the case it was built for"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"You already build with Bazel and already use Nix"}],["$","td",null,{"children":"Yes; the marginal cost is small"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["You want C++ hermeticity on ",["$","code",null,{"children":"x86_64-linux"}]]}],["$","td",null,{"children":"Yes"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Your fleet is mixed-architecture and you expected cross-arch sharing"}],["$","td",null,{"children":"No; the guarantee does not extend there"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"You need Python or Go toolchains pinned"}],["$","td",null,{"children":"Not yet"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"You are looking for sandboxing or isolation"}],["$","td",null,{"children":["No; different problem, see ",["$","$L36",null,{"href":"/explanations/correctness-hermeticity","children":"correctness and hermeticity"}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"You want a quick win with a low setup cost"}],["$","td",null,{"children":"No; the source calls the setup challenging, and means it"}]]}]]}]]}]}]
