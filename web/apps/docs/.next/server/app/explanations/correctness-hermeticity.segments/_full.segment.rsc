f:["$","$L17",null,{"toc":[{"depth":2,"url":"#what-you-get-for-free","title":"What you get for free"},{"depth":2,"url":"#what-you-do-not-get-by-default","title":"What you do not get by default"},{"depth":3,"url":"#the-digest-is-a-claim-until-you-verify-it","title":"The digest is a claim until you verify it"},{"depth":3,"url":"#verification-is-write-side-only","title":"Verification is write-side only"},{"depth":3,"url":"#hermeticity-is-the-clients-job","title":"Hermeticity is the client's job"},{"depth":3,"url":"#actions-can-run-more-than-once","title":"Actions can run more than once"},{"depth":3,"url":"#some-output-metadata-is-discarded","title":"Some output metadata is discarded"},{"depth":2,"url":"#caching-semantics-that-surprise-people","title":"Caching semantics that surprise people"},{"depth":2,"url":"#a-checklist-for-a-cache-you-can-trust","title":"A checklist for a cache you can trust"},{"depth":2,"url":"#common-questions","title":"Common questions"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Correctness and hermeticity"}],["$","$L19",null,{"children":"What content addressing guarantees, what it doesn't, and which of the gaps are yours to close."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone who needs to know how much to trust a cache hit,\nand anyone chasing a build that is correct on one machine and wrong on\nanother. ",["$","strong",null,{"children":"What you'll have at the end:"}]," an honest inventory of the\nguarantees: the ones you get for free, the ones you have to configure, and\nthe ones nobody is offering. ",["$","strong",null,{"children":"Time:"}]," twenty minutes."]}],"\n",["$","p",null,{"children":["\"Content-addressed\" is often heard as \"therefore correct\". It is not. Content\naddressing gives you one very strong property (",["$","em",null,{"children":"if two things have the same\nhash, they are the same bytes"}],"), and that property is only as useful as the\nprocess that assigned the hash. Most real correctness incidents in a remote\nbuild system happen in the space between \"the hash matches\" and \"the hash\nmeant anything\"."]}],"\n",["$","p",null,{"children":["This page is the inventory. It leans on\n",["$","$L1b",null,{"href":"/explanations/store-model","children":"the store model"}],",\n",["$","$L1b",null,{"href":"/explanations/scheduler-internals","children":"scheduler internals"}]," and\n",["$","$L1b",null,{"href":"/explanations/worker-execution","children":"worker execution"}]," for mechanism, and does not\nrepeat them."]}],"\n",["$","$L1c",null,{"as":"h2","id":"what-you-get-for-free","children":"What you get for free"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Collision resistance."}]," SHA-256 and BLAKE3 are the supported digest\nfunctions. Two different blobs will not share a key."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Immutability by construction."}]," A blob is stored under a key derived from\nits content, so an overwrite is a no-op rather than a mutation. Concurrent\nuploads of the same blob cannot interleave into a corrupt result."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Deduplication across everything."}]," One instance name, one digest function,\none copy, regardless of which repository, which developer, or which CI job\nproduced it."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Action identity."}]," Two actions with the same instance name, digest function\nand action digest are the same action, and the system will merge them rather\nthan run both."]}],"\n",["$","$L1c",null,{"as":"h2","id":"what-you-do-not-get-by-default","children":"What you do not get by default"}],"\n",["$","p",null,{"children":"Five gaps, in rough order of how often they bite."}],"\n",["$","$L1c",null,{"as":"h3","id":"the-digest-is-a-claim-until-you-verify-it","children":"The digest is a claim until you verify it"}],"\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38"]}],"$L39"]}]
3a:I[37010,["/_next/static/chunks/2t9l4l1lvwa73.js","/_next/static/chunks/34pcpfu7ctzp3.js","/_next/static/chunks/0005krlza2_9f.js","/_next/static/chunks/3m6zrppzs7tju.js","/_next/static/chunks/2lzo_w0krhqq7.js","/_next/static/chunks/02rtp5xwp9l87.js"],"Accordions"]
