1d:["$","p",null,{"children":["The server does not hash plain uploaded bytes. The client declares the digest\nand the server files the bytes under it. (Zstd-compressed ByteStream uploads\nare the exception: the decoder checks size and hash as it decodes.) For\neverything else the only thing that checks is a ",["$","code",null,{"children":"verify"}]," store, and both\n",["$","code",null,{"children":"verify_hash"}]," and ",["$","code",null,{"children":"verify_size"}]," default to ",["$","code",null,{"children":"false"}],"."]}]
1e:["$","p",null,{"children":"A cache without one will faithfully store, and forever serve, a blob under a\ndigest that does not describe it. Every downstream consumer that trusts the\ndigest (which is all of them) then gets the wrong bytes with no error\nanywhere. This is the highest-severity, lowest-visibility failure mode in the\nsystem."}]
1f:["$","p",null,{"children":[["$","strong",null,{"children":"What to do:"}]," put a ",["$","code",null,{"children":"verify"}]," store with ",["$","code",null,{"children":"verify_hash: true"}]," in the write\npath of any cache shared between more than one person. The cost is one hash\npass, run concurrently with the write."]}]
20:["$","$L1c",null,{"as":"h3","id":"verification-is-write-side-only","children":"Verification is write-side only"}]
21:["$","p",null,{"children":["Even with a ",["$","code",null,{"children":"verify"}]," store, nothing is re-checked on read. Blobs that entered\nbefore you added the wrapper, or through a path that bypassed it, are served\nwithout complaint."]}]
22:["$","p",null,{"children":[["$","strong",null,{"children":"What to do:"}]," treat adding verification as a change that only protects\nblobs uploaded from that point forward. If you have reason to distrust\nexisting content, the answer is a new instance name, not a config change."]}]
23:["$","$L1c",null,{"as":"h3","id":"hermeticity-is-the-clients-job","children":"Hermeticity is the client's job"}]
24:["$","p",null,{"children":["The action digest covers exactly what the client put into the ",["$","code",null,{"children":"Action"}],"\nmessage: the command, the input tree, the platform properties, the\nenvironment variables it declared. Anything the action reads that is not in\nthere is invisible to the cache, and a cache hit will confidently return a\nresult computed with a different value of it."]}]
25:["$","p",null,{"children":["Forge helps in one significant way: the worker calls ",["$","code",null,{"children":"env_clear()"}]," and\ninjects no ",["$","code",null,{"children":"PATH"}],", ",["$","code",null,{"children":"HOME"}]," or ",["$","code",null,{"children":"TMPDIR"}]," on Linux or macOS, so an action that\ndepends on an undeclared environment variable tends to fail loudly rather\nthan succeed differently."]}]
26:["$","p",null,{"children":["It does not help in the way that matters most: ",["$","strong",null,{"children":"there is no network\nisolation, with or without namespaces enabled."}]," An action that fetches from\nthe network will do so, will succeed, and will produce a result cached under\na digest that says nothing about what it downloaded. That is the classic\npoisoned-cache-entry mechanism, and no server-side setting prevents it."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":"What to do:"}]," pin toolchains and inputs at the client. ",["$","code",null,{"children":"--incompatible_strict_action_env"}],"\nand equivalent flags exist for this. ",["$","$L1b",null,{"href":"/explanations/lre","children":"Local Remote Execution"}],"\nis the toolchain half of the answer."]}]
28:["$","$L1c",null,{"as":"h3","id":"actions-can-run-more-than-once","children":"Actions can run more than once"}]
29:["$","p",null,{"children":["The default ",["$","code",null,{"children":"max_job_retries"}]," of 3 is checked strictly, so an action may\nexecute ",["$","strong",null,{"children":"four"}]," times on its own failures. A lost worker has its own budget,\n",["$","code",null,{"children":"max_worker_loss_retries"}]," (default 10), and a memory escalation its own\n(",["$","code",null,{"children":"memory_escalation.max_steps"}],", default 8), so an action can run more often\nthan four times when workers die under it or it keeps outgrowing its\nreservation; a ",["$","code",null,{"children":"ResourceExhausted"}]," never costs anything."]}]
2a:["$","p",null,{"children":"For a pure function this is invisible. For an action with side effects (one\nthat publishes, deploys, increments, or writes anywhere outside its declared\noutputs) it means the side effect happens up to four times, and Forge\nhas no way to know that it should not."}]
2b:["$","p",null,{"children":[["$","strong",null,{"children":"What to do:"}]," actions with side effects do not belong in a remote execution\nsystem. If one must exist, make it idempotent, and set ",["$","code",null,{"children":"max_job_retries: 0"}],"\nfor the instance that runs it."]}]
2c:["$","$L1c",null,{"as":"h3","id":"some-output-metadata-is-discarded","children":"Some output metadata is discarded"}]
2d:["$","p",null,{"children":[["$","code",null,{"children":"node_properties"}]," is never populated, so output file modes and mtimes do not\nsurvive a round trip. Absolute output symlinks are dereferenced and uploaded\nas content; only relative ones stay symlinks. A declared output that the\naction did not produce is not an error."]}]
2e:["$","p",null,{"children":[["$","strong",null,{"children":"What to do:"}]," do not depend on an output's mode. If an action produces\nsomething that must be executable, the consumer has to set that itself."]}]
2f:["$","$L1c",null,{"as":"h2","id":"caching-semantics-that-surprise-people","children":"Caching semantics that surprise people"}]
30:["$","p",null,{"children":"Three, all of which have bitten someone:"}]
31:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"do_not_cache"}]," does nothing."]}]," Forge parses the REAPI flag and no code\nreads it. Setting it does not prevent a result being written."]}]
32:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"skip_cache_lookup"}]," still writes."]}]," It disables the cache read and disables\nmerging, but the result of the re-execution is written to the cache. This is\nthe correct behaviour for \"re-run this and fix the cache\", and the wrong\nmental model if you thought it meant \"run this without touching the cache\"."]}]
33:["$","p",null,{"children":[["$","strong",null,{"children":"Failures are not cached, by default."}]," A non-zero exit code goes to the\nhistorical results store, not the action cache, so a failing compile is\nre-attempted rather than replayed. That is usually what you want and\noccasionally not; a deterministic failure will be re-run by every client\nthat encounters it."]}]
34:["$","$L1c",null,{"as":"h2","id":"a-checklist-for-a-cache-you-can-trust","children":"A checklist for a cache you can trust"}]
35:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":["Put ",["$","code",null,{"children":"verify_hash: true"}]," in the write path."]}]," Everything below is\ndownstream of this being true."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Pin the toolchain at the client"}],", so the compiler's identity is inside\nthe action digest rather than beside it."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Make undeclared inputs fail rather than succeed."}]," Strict action\nenvironment, strict include checking, no reliance on ambient ",["$","code",null,{"children":"PATH"}],"."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Assume the network is reachable from actions"}],", and design so that no\naction wants it."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":["Set ",["$","code",null,{"children":"max_action_executing_timeout_s"}],"."]}]," It defaults to disabled. The\nworker's own ",["$","code",null,{"children":"max_action_timeout_s"}]," (20 minutes by default) still kills a\nhung process, but an action whose worker is alive and heartbeating yet\nnever reports on it has no ceiling without this."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Separate trust domains with instance names"}],", not with configuration\ninside one. Instance names are the only isolation boundary the protocol\nactually has."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Verify by rebuilding."}]," Build a target twice on different machines and\ncompare. It is the only test that covers the leaks a checklist misses."]}]}]]}]
36:["$","$L1c",null,{"as":"h2","id":"common-questions","children":"Common questions"}]
37:["$","$L3a",null,{"type":"multiple","children":[["$","$L3b",null,{"title":"How do I find a hermeticity leak?","id":"find-a-hermeticity-leak","children":["$","p",null,{"children":"Build the same target on two machines that differ, and compare outputs\nbyte for byte; anything that differs is reading something undeclared.\nAt cluster scale the symptom is subtler: cache misses where you expected\nhits, because a leaked input changed and moved the action digest with it.\nA rising miss rate on unchanged code is the signal."}]}],["$","$L3b",null,{"title":"Someone poisoned a cache entry. What now?","id":"poisoned-cache-entry","children":["$","p",null,{"children":["You cannot selectively invalidate by content, because the key is the\ncontent. The practical answers are to move to a new instance name, which\nis a clean namespace with no migration, or to delete the affected\naction-cache entries if you can identify them. Then add the ",["$","code",null,{"children":"verify"}]," store\nthat would have prevented it, and find the client that was wrong."]}]}],["$","$L3b",null,{"title":"Is a cache hit as trustworthy as a real execution?","id":"is-a-cache-hit-trustworthy","children":["$","p",null,{"children":"It is exactly as trustworthy as the execution that produced it, plus the\nintegrity of the path in between. Content addressing secures the second\npart, once verification is on. The first part is the client's hermeticity\nand nothing else."}]}],["$","$L3b",null,{"title":"Does turning on verification slow uploads down?","id":"does-verification-slow-uploads","children":["$","p",null,{"children":"Marginally. The check runs concurrently with the write rather than as a\nseparate pass, so the cost is CPU for one hash over uploaded bytes, not an\nextra round trip. On any realistic network the transfer dominates."}]}],["$","$L3b",null,{"title":"Do I need namespaces enabled to get correct results?","id":"namespaces-and-correctness","children":["$","p",null,{"children":"No. Namespaces are about isolation between concurrent actions, not about\nresult correctness, and they provide no network, seccomp or cgroup\nisolation in any case. Correct results come from the action declaring\neverything it reads. Enable namespaces to stop actions interfering with\neach other; do not enable them expecting hermeticity."}]}]]}]
38:["$","a",null,{"href":"/explanations/lre","data-next-step":"next","className":"my-4 flex items-start gap-3 rounded-xl border px-5 py-4 no-underline transition-colors border-brand/40 bg-brand-soft/30 hover:border-brand/70","children":[["$","svg",null,{"width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-1 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M5 12h14m-6-6 6 6-6 6"}]}],["$","span",null,{"className":"flex-1","children":[["$","span",null,{"className":"block font-mono text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground","children":"Next"}],["$","span",null,{"className":"block font-semibold text-foreground","children":"Local Remote Execution"}],["$","span",null,{"className":"mt-0.5 block text-sm text-muted-foreground","children":["$","p",null,{"children":"The toolchain-pinning half of hermeticity, and the one piece of it that\nForge ships rather than delegates."}]}]]}]]}]
