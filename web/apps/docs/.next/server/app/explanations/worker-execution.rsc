20:["$","p",null,{"children":["On startup the worker ",["$","strong",null,{"children":["purges and recreates its ",["$","code",null,{"children":"work_directory"}]]}],". Anything\nleft there by a previous run is gone. This is intentional (a worker that\ninherits state is a worker whose actions are not hermetic), but it means the\nwork directory must not be somewhere you also keep things."]}]
21:["$","p",null,{"children":"Each action gets a tree:"}]
22:["$","$L54",null,{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>","children":["$","$L55",null,{"children":["$","code",null,{"children":[["$","span",null,{"className":"line","children":["$","span",null,{"children":"<work_directory>/"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"children":"  <operation_id>/"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"children":"    work/                 <- the action's cwd root"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"children":"      <Command.working_directory>/"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"children":"    <side channel file>   <- sibling of work/, not inside it"}]}]]}]}]}]
23:["$","p",null,{"children":["Input materialization's hot path is a ",["$","strong",null,{"children":"hardlink"}],": no copy, no ",["$","code",null,{"children":"chmod"}],", no\nbyte movement at all. The worker links the file straight out of the\nfilesystem CAS into the action's input tree."]}]
24:["$","p",null,{"children":"This one decision produces four consequences that account for a large share\nof worker bug reports."}]
25:["$","p",null,{"children":[["$","strong",null,{"children":"Inputs are read-only."}]," A hardlink shares the inode, and CAS blobs are\nstored ",["$","code",null,{"children":"0o444"}]," (or ",["$","code",null,{"children":"0o555"}]," when executable). An action that modifies an input\nfile in place gets ",["$","code",null,{"children":"EACCES"}],". Actions that work locally and fail remotely are\nvery often doing exactly this."]}]
26:["$","p",null,{"children":[["$","strong",null,{"children":"Executables cost a second inode."}]," You cannot ",["$","code",null,{"children":"chmod"}]," a hardlink without\n",["$","code",null,{"children":"chmod"}],"-ing the shared CAS blob, so an executable input needs its own copy,\none per digest, not one per action. This also sidesteps ",["$","code",null,{"children":"ETXTBSY"}],", where\nwriting to a file that is currently executing fails."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"work_directory"}]," must be on the same filesystem as the CAS content path."]}],"\nHardlinks cannot cross filesystem boundaries. This is the single most common\nworker misconfiguration, and its symptom (everything works but is\ninexplicably slow, or fails outright) does not visibly point at a mount\ntable."]}]
28:["$","p",null,{"children":[["$","strong",null,{"children":["The fast store must be a ",["$","code",null,{"children":"FilesystemStore"}],"."]}]," The worker downcasts to the\nconcrete type to find the file to link, and ",["$","strong",null,{"children":"refuses to start"}]," if it is\ngiven anything else. It does not degrade to copying."]}]
29:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Output parent directories are created inconsistently"}],["$","p",null,{"children":["Parents of ",["$","code",null,{"children":"output_files"}]," and ",["$","code",null,{"children":"output_paths"}]," are pre-created. Parents of\n",["$","code",null,{"children":"output_directories"}]," are ",["$","strong",null,{"children":"not"}],". An action that expects its output\ndirectory's parent to exist has to create it."]}]]}]]}]
2a:["$","$L1b",null,{"as":"h2","id":"what-isolation-you-actually-get","children":"What isolation you actually get"}]
2b:["$","p",null,{"children":"This section is deliberately blunt, because overclaiming here is dangerous."}]
2c:["$","p",null,{"children":[["$","strong",null,{"children":"With the default configuration, a Forge worker provides no\nOS-level isolation whatsoever."}]," ",["$","code",null,{"children":"use_namespaces"}]," defaults to ",["$","code",null,{"children":"false"}],". The\naction runs as an ordinary child process of the worker, with the worker's\nprivileges, on the worker's network, with access to whatever the worker can\nreach."]}]
2d:["$","p",null,{"children":"Turning namespaces on improves this, but far less than the word \"sandbox\"\nsuggests. Here is the complete list, in both directions:"}]
2e:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Provided when enabled"}],["$","th",null,{"children":[["$","strong",null,{"children":"Not"}]," provided, even when enabled"]}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"PID namespace"}],["$","td",null,{"children":"Network namespace; the action has the host's network"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"IPC namespace"}],["$","td",null,{"children":"seccomp filtering; every syscall is available"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"UTS namespace"}],["$","td",null,{"children":"cgroups; no CPU or memory limit is applied"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"User namespace (identity map only)"}],["$","td",null,{"children":[["$","code",null,{"children":"chroot"}]," / ",["$","code",null,{"children":"pivot_root"}],"; the host filesystem is visible"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"An init-stub reaper, via double fork"}],["$","td",null,{"children":"Any privilege drop; the uid map is identity, range 1"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Optional mount namespace that tmpfs-masks sibling action directories"}],["$","td",null,{"children":"Anything at all on macOS or Windows"}]]}]]}]]}]}]
2f:["$","p",null,{"children":["The user namespace maps one uid to itself. It does not sandbox the action's\nidentity; it exists so the other namespaces can be created without\nprivileges. Namespaces are ",["$","strong",null,{"children":"Linux-only"}]," and hard-error elsewhere; this is\nnot a silent no-op you can leave enabled in a mixed fleet."]}]
30:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$f:props:children:2:props:children:11:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Real isolation is delegated, not provided"}],["$","p",null,{"children":["If you run untrusted actions, the isolation boundary has to come from\nsomewhere else: the ",["$","code",null,{"children":"entrypoint"}]," wrapper, which can invoke whatever sandbox\nyou choose, or the container the worker itself runs in. Forge's\nnamespace support is a hygiene measure (it stops actions tripping over\neach other's processes and mounts), not a security boundary. Note also that\ninside Docker, creating namespaces requires a privileged container, which\ntrades away more than it buys back."]}]]}]]}]
31:["$","$L1b",null,{"as":"h2","id":"the-environment-is-built-from-nothing","children":"The environment is built from nothing"}]
32:["$","p",null,{"children":["The worker calls ",["$","code",null,{"children":"env_clear()"}]," first. Nothing is inherited. Variables are\nthen applied in this order:"]}]
33:["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","code",null,{"children":"additional_environment"}]," from the worker's config"]}],"\n",["$","li",null,{"children":["On Windows only, ",["$","code",null,{"children":"SystemRoot"}]," and ",["$","code",null,{"children":"PATH"}]]}],"\n",["$","li",null,{"children":["The action's own ",["$","code",null,{"children":"Command.environment_variables"}],", ",["$","strong",null,{"children":"last"}]]}],"\n"]}]
34:["$","p",null,{"children":["Two things follow. ",["$","strong",null,{"children":"Action-declared variables override worker config"}],", not\nthe other way round; worker config is a default, not a policy. And on Linux\nand macOS ",["$","strong",null,{"children":["no ",["$","code",null,{"children":"PATH"}],", ",["$","code",null,{"children":"HOME"}]," or ",["$","code",null,{"children":"TMPDIR"}]," is injected at all"]}],". An action that\ndoes not declare them does not have them, which is correct for hermeticity\nand is why toolchains that assume a working ",["$","code",null,{"children":"PATH"}]," fail here. See\n",["$","$L1c",null,{"href":"/remote-execution/toolchains-and-hermeticity","children":"toolchains and hermeticity"}],"."]}]
35:["$","$L1b",null,{"as":"h2","id":"timeouts-signals-and-the-output-you-lose","children":"Timeouts, signals, and the output you lose"}]
36:["$","p",null,{"children":["A requested timeout above ",["$","code",null,{"children":"max_action_timeout_s"}]," (20 minutes if unset) is\n",["$","strong",null,{"children":["rejected with ",["$","code",null,{"children":"InvalidArgument"}],", not clamped"]}],". The client is told its\nrequest was unacceptable rather than silently receiving a shorter deadline\nthan it asked for. That is the right choice, and one worth knowing before you\nset a low ceiling on a cluster whose clients ask for long ones. An action\nthat requests no timeout at all runs under ",["$","code",null,{"children":"max_action_timeout_s"}],"."]}]
37:["$","p",null,{"children":"Three things about failure output are worth internalising:"}]
38:["$","p",null,{"children":[["$","strong",null,{"children":"A timed-out or killed action returns empty stdout and stderr."}]," The\ncaptured bytes are explicitly discarded, not truncated. The single most\nuseful diagnostic for \"why did this hang\" is the one you do not get."]}]
39:["$","p",null,{"children":[["$","strong",null,{"children":"Signal death is reported as exit code 9"}],", indistinguishable from a genuine\n",["$","code",null,{"children":"exit(9)"}],". An OOM kill and a program that chose to exit 9 look identical."]}]
3a:["$","p",null,{"children":[["$","strong",null,{"children":"stdout and stderr are buffered entirely in worker memory"}],", with no cap and\nno streaming. An action that writes a gigabyte to stdout costs a gigabyte of\nworker RAM, and no part of it is visible until the action ends."]}]
3b:["$","$L1b",null,{"as":"h2","id":"uploading-outputs-and-what-is-dropped","children":"Uploading outputs, and what is dropped"}]
3c:["$","p",null,{"children":["The ordering here is subtle and matters for anyone reasoning about\nconsistency. When the command exits, the worker sends ",["$","code",null,{"children":"ExecuteComplete"}]," to\nthe scheduler (the process is done, so a new action can be assigned) and\n",["$","em",null,{"children":"then"}]," uploads outputs, deletes the action directory, and writes the action\ncache entry. The final result update, which is what a client is waiting on,\ncomes after all of that, so a client that observes completion and\nimmediately queries the cache finds the result; but the scheduler knows the\ncommand finished slightly before the bytes exist."]}]
3d:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-worker/src/local_worker.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-worker/src/local_worker.rs","data-source-ref":"v1.6.5","title":"forge-worker/src/local_worker.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"execution_complete"]}]
3e:["$","$L56",null,{"children":"sequenceDiagram\n  participant sched as Scheduler\n  participant w as Worker\n  participant cas as CAS + AC\n  sched->>w: StartExecute (over ConnectWorker)\n  w->>sched: ExecuteAccepted, or ExecuteDeclined and stop here\n  w->>w: create work directory for the operation\n  w->>cas: fetch missing blobs\n  w->>w: hardlink inputs from filesystem CAS\n  w->>w: env_clear(), then run the command\n  w->>sched: ExecuteComplete (the process exited)\n  w->>cas: upload outputs\n  w->>w: delete the action directory\n  w->>cas: write ActionResult to AC\n  w->>sched: final result update\n"}]
3f:["$","p",null,{"children":["The first reply is the worker's admission decision. A dispatch is a\nproposal until the worker answers it: ",["$","code",null,{"children":"ExecuteAccepted"}]," confirms the ledger\ncharge the scheduler made on the send, ",["$","code",null,{"children":"ExecuteDeclined"}]," hands it back. The\nworker declines when it already holds ",["$","code",null,{"children":"max_inflight_tasks"}]," actions, when the\naction's memory reservation is more than the worker currently has free, or\nwhen it is shutting down. A declined action returns to the queue without\ncounting as an attempt, and the worker is paused until its next keepalive,\nor, for a decline for memory, until a keepalive reports that much free. The\nscheduler's channel to each worker is bounded at its concurrency plus a\nmargin; a worker that has stopped reading has its dispatch requeued the same\nway rather than piling up work it will never see. A worker only sends these\nreplies to a scheduler that announced support in its ",["$","code",null,{"children":"ConnectionResult"}],", so\nan older scheduler sees the old behaviour: the worker runs whatever it is\nsent. ",["$","code",null,{"children":"dispatch_ack_timeout_s"}]," on the scheduler adds the converse: a dispatch\nno worker acknowledged within the timeout is taken back, which only makes\nsense once every connected worker acknowledges."]}]
40:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-worker/src/local_worker.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-worker/src/local_worker.rs","data-source-ref":"v1.6.5","title":"forge-worker/src/local_worker.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"Refusal"]}]
41:["$","p",null,{"children":"Four behaviours in the upload path:"}]
42:["$","p",null,{"children":[["$","strong",null,{"children":"A declared-but-missing output is not an error."}]," An action that promises\n",["$","code",null,{"children":"output_files"}]," and does not produce them completes successfully with those\noutputs absent. Bazel will notice; a hand-rolled client may not."]}]
43:["$","p",null,{"children":[["$","strong",null,{"children":"Absolute symlinks are dereferenced and uploaded as content."}]," Only\n",["$","em",null,{"children":"relative"}]," output symlinks are preserved as symlinks. An action that emits an\nabsolute symlink gets a copy of the target instead, which is usually what\nyou want across machines, and occasionally very much not."]}]
44:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"node_properties"}]," is ",["$","code",null,{"children":"None"}],"."]}]," Output file modes and mtimes are dropped. A\nfile that was executable in the action's output tree is not necessarily\nexecutable when a client materialises it."]}]
45:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"server_logs"}]," is not implemented."]}]," The field exists in the protocol; the\nworker never populates it."]}]
