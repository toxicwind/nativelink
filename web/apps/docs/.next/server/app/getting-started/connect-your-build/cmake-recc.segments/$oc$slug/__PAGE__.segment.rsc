0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#prerequisites","title":"Prerequisites"},{"depth":2,"url":"#1-start-forge","title":"1. Start Forge"},{"depth":2,"url":"#2-install-recc","title":"2. Install recc"},{"depth":2,"url":"#3-create-the-example","title":"3. Create the example"},{"depth":2,"url":"#4-point-recc-at-forge","title":"4. Point recc at Forge"},{"depth":2,"url":"#5-build-it","title":"5. Build it"},{"depth":2,"url":"#6-confirm-the-cache-is-live","title":"6. Confirm the cache is live"},{"depth":2,"url":"#teardown","title":"Teardown"},{"depth":2,"url":"#faq","title":"FAQ"},{"depth":2,"url":"#going-further","title":"Going further"}],"children":[["$","$L3",null,{"children":"CMake with recc"}],["$","$L4",null,{"children":"Accelerate CMake builds with Forge as a remote cache, using recc as the bridge."}],["$","$L5",null,{"children":[["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A running Forge instance. If you don't have one, start with the ",["$","$L6",null,{"href":"/getting-started/quickstart","children":"Quickstart"}],"."]}]}]]}],"\n",["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0","aria-hidden":"true"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Inspired by Reid Kleckner"}],["$","p",null,{"children":["This tutorial follows the approach Reid Kleckner laid out in\n",["$","$L6",null,{"href":"https://reidkleckner.dev/posts/llvm-recc-forge/","children":"Distributed builds of LLVM with CMake, recc, and Forge"}],".\nRead his post for the LLVM-scale walkthrough and the reasoning behind\neach piece. This page is the short, hands-on version for your own\nprojects."]}]]}]]}],"\n",["$","p",null,{"children":["$","em",null,{"children":["Read time: ~5 minutes. Hands-on time: another ~5 if you have Docker and a\npackage manager handy; longer on Linux if you build ",["$","code",null,{"children":"recc"}]," from source."]}]}],"\n",["$","p",null,{"children":"This tutorial gets you from zero to a CMake build hitting a Forge\nremote cache. Works on Linux and macOS (tested on macOS Apple Silicon;\nLinux x86_64 follows the exact same commands)."}],"\n",["$","p",null,{"children":["We use ",["$","$L6",null,{"href":"https://buildgrid.gitlab.io/recc","children":["$","code",null,{"children":"recc"}]}],", a small Remote Execution\nv2 client originally from Bloomberg, as a CMake compiler launcher. We run\nit in ",["$","strong",null,{"children":"cache-only mode"}],": compiles still happen on your machine, only the\n",["$","em",null,{"children":"outputs"}]," travel through Forge. That keeps the setup tiny while still\ngiving you cross-machine and cross-branch caching."]}],"\n",["$","$L7",null,{"as":"h2","id":"prerequisites","children":"Prerequisites"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Docker"}],"\n",["$","li",null,{"children":"CMake 3.16+"}],"\n",["$","li",null,{"children":"A C/C++ compiler (clang or gcc)"}],"\n"]}],"\n",["$","$L7",null,{"as":"h2","id":"1-start-forge","children":"1. Start Forge"}],"\n",["$","$L8",null,{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewB