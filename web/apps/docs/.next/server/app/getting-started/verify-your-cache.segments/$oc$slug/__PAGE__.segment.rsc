0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#the-measurement","title":"The measurement"},{"depth":3,"url":"#build-once-cold","title":"Build once, cold"},{"depth":3,"url":"#discard-the-local-results","title":"Discard the local results"},{"depth":3,"url":"#build-again-warm","title":"Build again, warm"},{"depth":2,"url":"#reading-the-number-honestly","title":"Reading the number honestly"},{"depth":2,"url":"#getting-more-detail-than-the-summary-line","title":"Getting more detail than the summary line"},{"depth":2,"url":"#other-build-tools","title":"Other build tools"}],"children":[["$","$L3",null,{"children":"Verify your cache"}],["$","$L4",null,{"children":"Prove the cache is actually serving hits rather than quietly falling back to local work, using your build tool's own accounting, not a status page."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone who has pointed a build at Forge and wants\nevidence it is working, rather than the absence of an error. ",["$","strong",null,{"children":"What you'll\nhave at the end:"}]," a measurement you can repeat, a number you can put in a\nmessage to your team, and the ability to tell a cold cache from a broken one.\n",["$","strong",null,{"children":"Time:"}]," about ten minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A running Forge and a build pointed at it. See the ",["$","$L6",null,{"href":"/getting-started/quickstart","children":"Quickstart"}]," and ",["$","$L6",null,{"href":"/getting-started/connect-your-build","children":"Connect your build"}],"."]}]}]]}],"\n",["$","p",null,{"children":"A misconfigured remote cache almost never fails loudly. Bazel's default is to\ntreat cache errors as soft: if the endpoint is unreachable, the digest function\ndoes not match, or the instance name is wrong, it logs a line you will not\nnotice and builds everything locally. The build succeeds. It is just not\nusing the cache."}],"\n",["$","p",null,{"children":"\"No errors\" proves nothing. What proves something is the client's own\naccounting of where each action's result came from."}],"\n",["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"There is no /metrics endpoint to curl"}],["$","p",null,{"children":["Forge exports telemetry over OTLP and nothing else: there is no HTTP\nmetrics route in the binary, and the ",["$","code",null,{"children":"/status"}]," path a ",["$","code",null,{"children":"health"}]," service\nmounts only reports whether the process is up and its stores pass a\nself-check. It will happily return OK for a server no client is\nsuccessfully talking to. Use it as a liveness check and nothing more; see\n",["$","a",null,{"href":"/operate/observability","children":"Observability"}]," for the real telemetry\npath."]}]]}]]}],"\n",["$","$L7",null,{"as":"h2","id":"the-measurement","children":"The measurement"}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"]}],"$L1d"]}],["$L1e","$L1f"],"$L20"]}],"isPartial":"$@21","staleTime":"$22","varyParams":null},{"rsc":"$L23","isPartial":"$@24","staleTime":"$22","varyParams":null},{"rsc":"$L25","isPartial":"$@26","staleTime":"$22","varyParams":"$27"}],"isUpgradeableISRFallback":false,"a":"$@28","rootVaryParams":null,"needsRuntimeRequest":"$@29"}
