14:["$","p",null,{"children":["The execution log records, for each action, whether it was a cache hit and\nwhat its digest was. It is the tool for answering \"why did ",["$","em",null,{"children":"this specific"}],"\naction miss\": compare the digest for the same action across two runs, and if\nit changed, the action's inputs or command line are not stable."]}]
15:["$","p",null,{"children":["For wire-level questions (is the client even reaching the server, is it\ncalling ",["$","code",null,{"children":"FindMissingBlobs"}],") turn on gRPC logging instead:"]}]
