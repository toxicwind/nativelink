1e:["$","p",null,{"children":["Credentials come from the ambient Google credential chain: a credentials file\nnamed by ",["$","code",null,{"children":"GOOGLE_APPLICATION_CREDENTIALS"}]," (or inline JSON in\n",["$","code",null,{"children":"GOOGLE_APPLICATION_CREDENTIALS_JSON"}],"), the application-default credentials\nwritten by ",["$","code",null,{"children":"gcloud auth application-default login"}],", or otherwise the metadata\nserver on GCE, GKE or Cloud Run. Nothing secret goes in the config file."]}]
1f:["$","p",null,{"children":["The service account needs to read and write objects in the bucket;\n",["$","code",null,{"children":"roles/storage.objectUser"}]," scoped to the bucket covers it (overwriting an\nexisting object in GCS also needs the delete permission that role includes).\nForge itself never deletes objects; expiry is a bucket lifecycle rule."]}]
20:["$","p",null,{"children":[["$","code",null,{"children":"authentication_required"}]," defaults to ",["$","code",null,{"children":"false"}],": if no credential is found, the\nstore starts anyway and issues anonymous requests to ",["$","code",null,{"children":"storage.googleapis.com"}],"\n(there is no endpoint override for an emulator). Set it to ",["$","code",null,{"children":"true"}]," for anything real,\nso a misconfigured credential chain fails loudly at startup rather than as a\npermission error on the first request."]}]
