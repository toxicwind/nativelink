m","children":"filesystem store"}],"."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Run a build twice"}],": once cold, once after clearing the local fast tier."]}]}]]}]
2c:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["Objects appear in the bucket under ",["$","code",null,{"children":"key_prefix"}]," during the first build."]}],"\n",["$","li",null,{"children":["The second build is a cache hit even after the local ",["$","code",null,{"children":"content_path"}]," is\nemptied, which proves reads are falling through to the bucket."]}],"\n",["$","li",null,{"children":"Bucket request counts are far lower than blob counts, which proves the fast\ntier is absorbing repeat reads."}],"\n",["$","li",null,{"children":"No incomplete multipart uploads accumulate between builds."}],"\n"]}]}]]}]
