$L4",null,{"children":"The wrapper vocabulary (fast_slow, verify, dedup, existence_cache, size_partitioning, shard and the rest) and the order the layers have to go in."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone who has picked a backend and now needs it to be\nfast, cheap and trustworthy. ",["$","strong",null,{"children":"What you'll have at the end:"}]," a layered store\nyou can explain line by line, and the vocabulary to read anyone else's config.\n",["$","strong",null,{"children":"Time:"}]," thirty minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A config file with at least one backend in it. See ",["$","$L6",null,{"href":"/how-to/stores","children":"Storage backends"}],"."]}]}]]}],"\n",["$","p",null,{"children":"Most store types in Forge are not places to put bytes. They are wrappers:\neach one takes another store and changes something about how it behaves. A real\nCAS store is four or five of these nested inside each other, and the nesting\norder is the design."}],"\n",["$","p",null,{"children":["The things at the bottom of the nesting are the backends:\n",["$","$L6",null,{"href":"/how-to/stores/filesystem","children":"filesystem"}],",\n",["$","$L6",null,{"href":"/how-to/stores/s3-and-compatible","children":"S3 and compatible"}],",\n",["$","$L6",null,{"href":"/how-to/stores/gcs","children":"GCS"}],", ",["$","$L6",null,{"href":"/how-to/stores/azure","children":"Azure Blob"}],",\n",["$","$L6",null,{"href":"/how-to/stores/oci-object-storage","children":"OCI"}],", ",["$","$L6",null,{"href":"/how-to/stores/redis","children":"Redis"}],",\n",["$","$L6",null,{"href":"/how-to/stores/mongo","children":"Mongo"}],", each with a page of its own under\n",["$","$L6",null,{"href":"/how-to/stores","children":"Storage backends"}],". Everything on this page goes above them."]}],"\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51"]}],"$L52"]}],["$L53","$L54"],"$L55"]}],"isPartial":"$@56","staleTime":"$57","varyParams":null},{"rsc":"$L58","isPartial":"$@59","staleTime":"$57","varyParams":null},{"rsc":"$L5a","isPartial":"$@5b","staleTime":"$57","varyParams":"$5c"}],"isUpgradeableISRFallback":false,"a":"$@5d","rootVaryParams":null,"needsRuntimeRequest":"$@5e"}
