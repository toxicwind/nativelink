3a:["$","p",null,{"children":[["$","code",null,{"children":"memory"}]," takes an ",["$","code",null,{"children":"eviction_policy"}]," and nothing else. It is the right fast half\nfor a short-lived process and the wrong one for anything that must survive a\nrestart."]}]
3b:["$","p",null,{"children":[["$","code",null,{"children":"grpc"}]," points at another REAPI cache upstream, and can attach ",["$","code",null,{"children":"headers"}]," and\nforward selected headers from the incoming request. Use it to front an existing\ncache."]}]
3c:["$","p",null,{"children":["Development builds also support ",["$","code",null,{"children":"grpc.store_type: \"event_sink\""}]," for forwarding\nBEP and origin events to a dedicated receiver. This mode accepts string keys\nwith exact payload sizes and sends uncompressed ",["$","code",null,{"children":"ByteStream.Write"}]," requests.\nThe resource hash identifies the event key, while the size describes the event\nbytes. Configure it only as an event publisher's store: reads, existence checks,\nand digest-key writes are rejected. A normal CAS endpoint cannot receive these\nwrites. The receiver must acknowledge the full payload size only after its\ndurable append completes; Forge rejects a different committed size, and\nits BEP response waits for that acknowledgement. A lost acknowledgement can\ncause a retry after the receiver has already persisted an event. The receiver\nmust use the stable event key to detect and ignore duplicate events, including\nretries that start a new upload; the upload UUID alone is not an event identity.\nOrigin publishing retains its existing bounded retry policy. This transport\nprovides neither exactly-once processing nor a durable publisher recovery ledger."]}]
3d:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/stores.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/stores.rs","data-source-ref":"v1.6.5","title":"forge-config/src/stores.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"StoreType"]}]
3e:["$","p",null,{"children":[["$","code",null,{"children":"noop"}]," takes nothing at all and discards everything written to it, reporting\nevery read as a miss. It is how you deliberately turn a half of something off."]}]
3f:["$","$L5f",null,{"as":"h2","id":"the-order-the-layers-go-in","children":"The order the layers go in"}]
40:["$","p",null,{"children":"Reading a real config outside-in, each layer answers a different question:"}]
41:["$","$L8a",null,{"children":"flowchart TD\nA[\"cache_metrics<br/>what is this layer doing?\"] --> B[\"verify<br/>is this data what it claims?\"]\nB --> C[\"existence_cache<br/>do I have to ask the backend?\"]\nC --> D[\"dedup<br/>have I stored these chunks already?\"]\nD --> E[\"compression<br/>can each chunk be smaller?\"]\nE --> F[\"fast_slow<br/>is it already nearby?\"]\nF --> G[\"backend<br/>filesystem, bucket, redis, mongo\"]"}]
42:["$","p",null,{"children":"Four placements are load-bearing rather than stylistic."}]
43:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"verify"}]," goes outermost."]}]," It checks an upload against the digest the client\nfiled it under. Underneath compression or dedup, the bytes it sees are no\nlonger the bytes the digest describes."]}]
44:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"existence_cache"}]," goes above the expensive store, not below it."]}]," Its whole\npurpose is to avoid a round trip, so anything between it and the backend is\nwork it was meant to skip."]}]
45:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"dedup"}]," goes above ",["$","code",null,{"children":"compression"}],", never below it."]}]," Compressed bytes of\nsimilar inputs are not similar, so a ",["$","code",null,{"children":"dedup"}]," store fed by a ",["$","code",null,{"children":"compression"}],"\nwrapper finds nothing to share. Put ",["$","code",null,{"children":"compression"}]," on the dedup store's\n",["$","code",null,{"children":"content_store"}],", as the full example below does."]}]
46:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"fast_slow"}]," goes innermost, just above the backends."]}]," Layers above it apply\nto both halves once, rather than being paid twice."]}]
