39:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"What it decides"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"key_prefix"}]}],["$","td",null,{"children":"none"}],["$","td",null,{"children":"Namespacing inside one bucket"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"retry"}]}],["$","td",null,{"children":"see below"}],["$","td",null,{"children":"How hard to try before surfacing an error"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"consider_expired_after_s"}]}],["$","td",null,{"children":[["$","code",null,{"children":"0"}]," (never)"]}],["$","td",null,{"children":"How old an object may be and still count as present"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_retry_buffer_per_request"}]}],["$","td",null,{"children":["5 MB (20 MB for ",["$","code",null,{"children":"ontap"}],")"]}],["$","td",null,{"children":"How much of a single-request upload is buffered so it can be retried"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"multipart_max_concurrent_uploads"}]}],["$","td",null,{"children":"10"}],["$","td",null,{"children":["Concurrent ",["$","code",null,{"children":"UploadPart"}]," requests within one multipart upload"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"insecure_allow_http"}]}],["$","td",null,{"children":["$","code",null,{"children":"false"}]}],["$","td",null,{"children":["Permit plain HTTP; local testing only (",["$","code",null,{"children":"aws"}],", ",["$","code",null,{"children":"r2"}],")"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"disable_http2"}]}],["$","td",null,{"children":["$","code",null,{"children":"false"}]}],["$","td",null,{"children":["Fall back to HTTP/1.1 for proxies that mishandle h2 (",["$","code",null,{"children":"aws"}],", ",["$","code",null,{"children":"r2"}],")"]}]]}]]}]]}]}]
3a:["$","p",null,{"children":[["$","code",null,{"children":"retry"}]," is exponential with jitter: up to ",["$","code",null,{"children":"max_retries"}]," retries after the\nfirst attempt, a base ",["$","code",null,{"children":"delay"}]," in seconds that is doubled before the first\nretry and again for each retry after it, and ",["$","code",null,{"children":"jitter"}]," as a fraction of the\ncomputed delay (",["$","code",null,{"children":"0.5"}]," means each wait is randomised within plus or minus 25%).\nThe shipped examples all use ",["$","code",null,{"children":"{ max_retries: 6, delay: 0.3, jitter: 0.5 }"}],":\nwaits of about 0.6, 1.2, 2.4, 4.8, 9.6 and 19.2 seconds, roughly forty seconds\nof retrying across seven attempts."]}]
3b:["$","p",null,{"children":["Objects smaller than 5 MB with a known size are uploaded in one ",["$","code",null,{"children":"PutObject"}],"\nrequest; anything larger, or of unknown size, goes through a multipart upload\nin parts of at least 5 MB, each part held in memory and retried on its own."]}]
