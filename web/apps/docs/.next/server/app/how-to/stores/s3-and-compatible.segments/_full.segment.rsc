30:["$","p",null,{"children":[["$","code",null,{"children":"root_certificates"}]," is optional and points at a PEM bundle for the CA that\nsigned the endpoint's certificate. Without it, the system roots are used and\nan internally-signed endpoint fails TLS verification. Credentials come from\nthe same AWS chain as ",["$","code",null,{"children":"aws"}]," (",["$","code",null,{"children":"AWS_ACCESS_KEY_ID"}]," and ",["$","code",null,{"children":"AWS_SECRET_ACCESS_KEY"}],"\nin practice), and ",["$","code",null,{"children":"vserver_name"}]," doubles as the signing region."]}]
31:["$","p",null,{"children":["The ONTAP implementation differs from ",["$","code",null,{"children":"aws"}]," in three ways: it always uses\npath-style addressing, its default ",["$","code",null,{"children":"max_retry_buffer_per_request"}]," is 20 MB\nrather than 5 MB, and it is HTTPS-only with HTTP/1.1 and HTTP/2 both enabled,\nso ",["$","code",null,{"children":"insecure_allow_http"}]," and ",["$","code",null,{"children":"disable_http2"}]," have no effect on it."]}]
