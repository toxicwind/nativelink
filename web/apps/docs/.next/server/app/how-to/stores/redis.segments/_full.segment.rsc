f:["$","$L17",null,{"toc":[{"depth":2,"url":"#the-recipe","title":"The recipe"},{"depth":2,"url":"#standalone-sentinel-or-cluster","title":"Standalone, sentinel or cluster"},{"depth":2,"url":"#sizing-it-so-it-doesnt-time-out","title":"Sizing it so it doesn't time out"},{"depth":2,"url":"#where-redis-actually-earns-its-place","title":"Where Redis actually earns its place"},{"depth":2,"url":"#steps","title":"Steps"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Redis"}],["$","$L19",null,{"children":"Back the cache with Redis (standalone, sentinel or cluster) and the concurrency, chunking and timeout settings that keep it from timing out under a real build."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone who wants several Forge processes to share one\nlow-latency store, or who needs the scheduler's pub/sub subscriptions.\n",["$","strong",null,{"children":"What you'll have at the end:"}]," a Redis-backed store with concurrency and\ntimeouts set so it survives a burst. ",["$","strong",null,{"children":"Time:"}]," twenty minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A config file you can edit (see ",["$","$L1b",null,{"href":"/configuration","children":"Configuration"}],"), and a reachable Redis instance."]}]}]]}],"\n",["$","p",null,{"children":["Redis sits between the filesystem and object storage: it is shared across\nmachines like a bucket, and roughly a millisecond away like a local disk. What\nit is not is cheap per byte. Use it for small, hot, shared objects (the Action\nCache, scheduler state, the index side of a ",["$","code",null,{"children":"dedup"}]," store) and put the bulk\nCAS somewhere that prices storage by the gigabyte."]}],"\n",["$","$L1c",null,{"as":"h2","id":"the-recipe","children":"The recipe"}],"\n",["$","$L1d",null,{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>","children":["$","$L1e",null,{"children":["$","code",null,{"children":[["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"stores: ["}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"  {"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"    name"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"AC_MAIN_STORE\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"    redis_store"}],["$","span",null,{"style":