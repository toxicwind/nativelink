3e:["$","p",null,{"children":["Blobs under 5 MiB with a known size are uploaded in one request; anything\nlarger, or of unknown size, is staged as blocks of at least 5 MiB and\ncommitted with a block list. ",["$","code",null,{"children":"retry"}]," and ",["$","code",null,{"children":"consider_expired_after_s"}]," behave as\ndescribed in ",["$","$L1b",null,{"href":"/how-to/stores/s3-and-compatible","children":"the shared options section"}],";\n",["$","code",null,{"children":"insecure_allow_http"}]," and ",["$","code",null,{"children":"disable_http2"}]," are accepted but not read by the\nAzure store."]}]
