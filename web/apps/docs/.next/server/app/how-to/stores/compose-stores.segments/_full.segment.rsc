62:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":"The config loads. An unknown field anywhere in the nesting is rejected at\nstartup, so a clean start means every layer name is right."}],"\n",["$","li",null,{"children":"A build is a cache hit on the second run with the fast tier emptied, which\nproves the layers pass through to the slow tier."}],"\n",["$","li",null,{"children":["Backend request counts are far below blob counts once ",["$","code",null,{"children":"existence_cache"}]," is\nin."]}],"\n",["$","li",null,{"children":["Uploading a blob under a digest that does not match its content (for\nexample with a hand-built ByteStream write) is rejected rather than stored.\nThat's ",["$","code",null,{"children":"verify"}]," earning its place."]}],"\n"]}]}]]}]
