39:["$","p",null,{"children":["LZ4 is the only algorithm. ",["$","code",null,{"children":"block_size"}]," defaults to 64 KiB, and\n",["$","code",null,{"children":"max_decode_block_size"}]," defaults to match it. The latter bounds how much a\nmalformed block can ask the decoder to allocate, so raise it only alongside\n",["$","code",null,{"children":"block_size"}],"."]}]
3a:["$","p",null,{"children":["This is store-level compression, on the way to the backend. It is a different\nthing from ",["$","$L1b",null,{"href":"/how-to/stores/compression","children":"remote cache compression"}],", which\ncompresses on the wire between the client and Forge. The two are\nindependent and can both be on."]}]
