21:["$","p",null,{"children":["Both configs describe the same thing. Order in the array does not matter, because\n",["$","code",null,{"children":"ref_store"}]," is resolved after every entry is read, so a store may reference one\ndefined below it. Reach for ",["$","code",null,{"children":"ref_store"}]," when two stores genuinely share one\nbackend, or when nesting has got deep enough to be unreadable."]}]
