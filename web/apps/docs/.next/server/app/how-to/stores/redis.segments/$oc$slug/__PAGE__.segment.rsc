17:["$","p",null,{"children":["The store connects to the sentinel, asks it for the current master, and\nre-resolves the master when a write hits a demoted replica or the connection\ndrops. Passing more than one address in ",["$","code",null,{"children":"standard"}]," or ",["$","code",null,{"children":"sentinel"}]," mode is\nrejected at startup."]}]
