19:["$","p",null,{"children":[["$","code",null,{"children":"key_prefix"}]," namespaces one Redis instance across several stores, and matters\nmore here than with object storage: a Redis instance is much more likely to be\nshared with something else you run. Give the CAS, the AC and the scheduler\ndistinct prefixes."]}]
1a:["$","$L7",null,{"as":"h2","id":"sizing-it-so-it-doesnt-time-out","children":"Sizing it so it doesn't time out"}]
1b:["$","p",null,{"children":"Redis is single-threaded per node, so the settings that matter are the ones\nbounding how much work you can have in flight."}]
1c:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"What it decides"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_client_permits"}]}],["$","td",null,{"children":"500"}],["$","td",null,{"children":"Ceiling on concurrent actions against the store"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"connection_pool_size"}]}],["$","td",null,{"children":"3"}],["$","td",null,{"children":"Accepted but not used by the current client, which holds one multiplexed connection"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"read_chunk_size"}]}],["$","td",null,{"children":"64 KiB"}],["$","td",null,{"children":"Bytes pulled per chunk when streaming a blob out"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_chunk_uploads_per_update"}]}],["$","td",null,{"children":"10"}],["$","td",null,{"children":"Concurrent chunk uploads within one write"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"command_timeout_ms"}]}],["$","td",null,{"children":"10000"}],["$","td",null,{"children":"Per-command ceiling"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"connection_timeout_ms"}]}],["$","td",null,{"children":"3000"}],["$","td",null,{"children":"Ceiling on establishing a connection"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"health_check_timeout_ms"}]}],["$","td",null,{"children":"4000"}],["$","td",null,{"children":["Ceiling on the health-check ",["$","code",null,{"children":"PING"}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"scan_count"}]}],["$","td",null,{"children":"10000"}],["$","td",null,{"children":[["$","code",null,{"children":"COUNT"}]," hint per ",["$","code",null,{"children":"SCAN"}]," iteration"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"key_ttl_s"}]}],["$","td",null,{"children":"0 (never)"}],["$","td",null,{"children":"Expiry set on every key this store writes; must exceed the longest upload"}]]}]]}]]}]}]
1d:["$","p",null,{"children":[["$","code",null,{"children":"max_client_permits"}]," is the most useful lever. It exists precisely to stop\ntimeouts caused by many, many inflight actions: when the ceiling is reached,\nwork queues instead of piling onto Redis and blowing through\n",["$","code",null,{"children":"command_timeout_ms"}],". Lower it if you see timeouts under load; that is almost\nalways the right first move."]}]
1e:["$","p",null,{"children":["Peak memory in the client process is roughly\n",["$","code",null,{"children":"read_chunk_size × max_chunk_uploads_per_update × concurrent uploads"}],". Working\nbackwards from available memory, divide by about ten to leave room for\neverything else the process is doing."]}]
1f:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Raising `read_chunk_size` can cause the timeouts it looks like it should fix"}],["$","p",null,{"children":["A larger chunk means a single command moves more data, so a chunk that is too\nlarge will exceed ",["$","code",null,{"children":"command_timeout_ms"}]," on a busy or distant Redis and fail the\nwhole operation. If large blobs are timing out, lower the chunk size or raise\nthe timeout, don't raise the chunk size."]}]]}]]}]
20:["$","p",null,{"children":[["$","code",null,{"children":"max_count_per_cursor"}]," (default 1500) bounds how many entries one cursor\nreturns; it exists to reduce thundering-herd effects when many workers hit the\nprovisioner at once."]}]
21:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Three fields are deprecated"}],["$","p",null,{"children":[["$","code",null,{"children":"response_timeout_s"}]," is superseded by ",["$","code",null,{"children":"command_timeout_ms"}]," and is ignored\nwith a warning; ",["$","code",null,{"children":"connection_timeout_s"}]," is superseded by\n",["$","code",null,{"children":"connection_timeout_ms"}]," and is still honoured (converted to milliseconds)\nif the millisecond field is unset, but setting both is an error.\n",["$","code",null,{"children":"broadcast_channel_capacity"}]," is unused by the current client.\n",["$","code",null,{"children":"experimental_pub_sub_channel"}]," remains, and is what scheduler\nsubscriptions ride on."]}]]}]]}]
