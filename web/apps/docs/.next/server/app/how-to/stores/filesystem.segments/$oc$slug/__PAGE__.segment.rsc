34:["$","p",null,{"children":["A worker's ",["$","code",null,{"children":"cas_fast_slow_store"}]," must have a ",["$","code",null,{"children":"filesystem"}]," store as its ",["$","code",null,{"children":"fast"}],"\nhalf. The worker builds each action's input tree by hard-linking files out of\nthat store, and hard links require real files on a real filesystem; a memory\nor object store cannot supply them."]}]
35:["$","p",null,{"children":["The worker's ",["$","code",null,{"children":"work_directory"}]," must be on the ",["$","strong",null,{"children":"same filesystem"}]," as that\nstore's ",["$","code",null,{"children":"content_path"}],", for the same reason. See\n",["$","$L6",null,{"href":"/configuration/scheduler-and-workers","children":"Schedulers and workers"}],"."]}]
