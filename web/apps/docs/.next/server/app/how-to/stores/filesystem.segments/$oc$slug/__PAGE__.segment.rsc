3a:["$","$L4a",null,{"children":[["$","$L4b",null,{"title":"The index contains a file that is missing from disk","id":"index-file-missing-from-disk","children":[["$","p",null,{"children":["An upload that encounters a missing file during duplicate comparison removes\nthe stale index entry and stores the uploaded content. A read removes only the\nentry whose file was missing. In a ",["$","code",null,{"children":"fast_slow"}]," composition, that read can fall\nthrough to the slow store and refill the fast tier."]}],["$","p",null,{"children":["Repeated missing-file warnings after recovery suggest that files are still\nbeing removed outside the store. Check for external cleanup of ",["$","code",null,{"children":"content_path"}],"."]}],["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/filesystem_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/filesystem_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/filesystem_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"check_duplicate_files"]}],["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/fast_slow_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/fast_slow_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/fast_slow_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"get_part"]}]]}],["$","$L4b",null,{"title":"The disk filled up","id":"the-disk-filled-up","children":[["$","p",null,{"children":["The store has no ",["$","code",null,{"children":"eviction_policy"}],", or has one with ",["$","code",null,{"children":"max_bytes: 0"}],". Both mean\n\"never evict\". Add a real limit and restart; the boot scan will bring the\nstore back under the limit."]}],["$","p",null,{"children":["If the limit is set and the disk still filled, check ",["$","code",null,{"children":"block_size"}],": on a\nfilesystem with 16 KiB blocks, an accounting ",["$","code",null,{"children":"block_size"}]," of 4 KiB\nunderestimates real usage by up to 4x for small objects."]}]]}],["$","$L4b",null,{"title":"Uploads fail with a cross-device link error","id":"uploads-fail-with-a-cross-device-link-error","children":["$","p",null,{"children":[["$","code",null,{"children":"temp_path"}]," and ",["$","code",null,{"children":"content_path"}]," are on different filesystems. Check with\n",["$","code",null,{"children":"df /var/lib/forge/cas/content /var/lib/forge/cas/tmp"}],". If the\ndevice column differs, move one of them."]}]}],["$","$L4b",null,{"title":"Startup takes minutes","id":"startup-takes-minutes","children":["$","p",null,{"children":["That's the boot scan reading the metadata of every file in ",["$","code",null,{"children":"content_path"}],"\n(name, size, access time). It's proportional to entry count. A tighter ",["$","code",null,{"children":"max_count"}]," or\n",["$","code",null,{"children":"max_seconds"}]," keeps the store smaller; a ",["$","code",null,{"children":"fast_slow"}]," pair with a small fast\ntier over a durable slow tier keeps boot cheap without giving up capacity."]}]}],"$L4c","$L4d"]}]
