1e:["$","p",null,{"children":["Create the parent directory and start Forge. The store scans\n",["$","code",null,{"children":"content_path"}]," on boot and adopts every file whose name parses as a store key\nand generation (",["$","code",null,{"children":"<hash>-<size>-<generation>"}]," under ",["$","code",null,{"children":"d2/"}],", or\n",["$","code",null,{"children":"<key>-<generation>"}]," under ",["$","code",null,{"children":"s2/"}],"); a file whose\nname does not parse is deleted. The scan reads metadata, not content, so it does not check\nthat bytes still match their digest. That scan is what makes the cache survive\nrestarts, and it is also why boot time grows with the number of cached\nobjects."]}]
1f:["$","p",null,{"children":"The generation gives each upload its own file. Eviction of an older upload\ncan finish after a replacement arrives without moving the replacement's file.\nIf several generations survive a shutdown, startup keeps the newest generation\nfor each key, subject to the eviction policy."}]
20:["$","p",null,{"children":["Startup migrates the earlier ",["$","code",null,{"children":"d/"}]," and ",["$","code",null,{"children":"s/"}]," layout, and the older flat digest\nlayout, into the new directories. A file that cannot be moved remains readable\nfrom its original location, and migration is retried on the next startup.\nEarlier Forge versions cannot read the new layout; use a separate cache\ndirectory when rolling back to an earlier version."]}]
