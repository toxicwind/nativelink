26:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`temp_path` must be on the same block device as `content_path`"}],["$","p",null,{"children":"Completing an upload is an atomic rename from the temp path into the content\npath. Across a device boundary a rename becomes a copy, which is neither\natomic nor free. Put both under one parent directory and the problem cannot\narise."}]]}]]}]
27:["$","p",null,{"children":["Everything in ",["$","code",null,{"children":"temp_path"}]," is deleted on every startup. Nothing you care about\nshould ever be written there by hand."]}]
28:["$","$L7",null,{"as":"h2","id":"the-eviction-policy-you-cannot-skip","children":"The eviction policy you cannot skip"}]
29:["$","p",null,{"children":[["$","code",null,{"children":"eviction_policy"}]," is optional in the schema and mandatory in practice. Without\nit, nothing is ever removed and the store grows until the disk is full."]}]
2a:["$","p",null,{"children":["Eviction is LRU: touching an entry refreshes its timestamp, and inserts run the\npolicy until the store fits again. Four independent limits are available, all\ndefaulting to ",["$","code",null,{"children":"0"}],", which means \"don't evict on this axis\":"]}]
2b:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Meaning"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_bytes"}]}],["$","td",null,{"children":"Total size on disk before eviction starts"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"evict_bytes"}]}],["$","td",null,{"children":["Keep evicting until ",["$","code",null,{"children":"max_bytes - evict_bytes"}]," is reached"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_seconds"}]}],["$","td",null,{"children":"Age since last access before an entry is evicted"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_count"}]}],["$","td",null,{"children":"Number of entries before eviction starts"}]]}]]}]]}]}]
2c:["$","p",null,{"children":["Set ",["$","code",null,{"children":"evict_bytes"}]," to something like 10% of ",["$","code",null,{"children":"max_bytes"}],". Without it, the store\nsits exactly at the limit and every single insert triggers an eviction;\na low watermark turns that thrash into one bulk pass per 10%."]}]
2d:["$","p",null,{"children":["Size accounting uses ",["$","code",null,{"children":"block_size"}]," (default 4 KiB), not the byte length of the\nfile, because a one-byte object still consumes a whole block. If your\nfilesystem uses a different block size, set it, or your ",["$","code",null,{"children":"max_bytes"}]," will be a\nsignificant underestimate of real disk use."]}]
2e:["$","$L7",null,{"as":"h2","id":"tuning-that-matters-on-real-hardware","children":"Tuning that matters on real hardware"}]
2f:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"max_concurrent_writes"}]}]," (default ",["$","code",null,{"children":"0"}],", unlimited). Every write streams into\na temp file and calls ",["$","code",null,{"children":"sync_all()"}],". Enough concurrent writes will saturate disk\nI/O and start blocking the async runtime. On a busy shared CAS, set this to\nsomething bounded (a few dozen) rather than leaving it open."]}]
30:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"read_buffer_size"}]}]," (default 32 KiB). Leave it alone unless you are\nbenchmarking."]}]
31:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"evict_page_cache"}]}]," (default ",["$","code",null,{"children":"false"}],"). When true, the store advises the\nkernel to drop the page cache for each blob after it is read or written."]}]
32:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$26:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Leave `evict_page_cache` off unless you know you want it"}],["$","p",null,{"children":"On a real filesystem this takes a globally serialized, all-CPU kernel path\nthat stalls on many-core hosts, and it throws away the page cache that\nmakes a fast tier fast in the first place. It exists for deployments that\nspecifically need this store's I/O kept out of the page cache."}]]}]]}]
