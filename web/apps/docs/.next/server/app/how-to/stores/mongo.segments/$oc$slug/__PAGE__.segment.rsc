2a:["$","$L3a",null,{"children":[["$","$L3b",null,{"title":"Can this store back the scheduler?","id":"workers-never-pick-up-queued-actions","children":["$","p",null,{"children":["Not in v1.6.5. The store implements the scheduler-store interface behind\n",["$","code",null,{"children":"enable_change_streams"}],", but the ",["$","code",null,{"children":"simple"}]," scheduler's ",["$","code",null,{"children":"experimental_backend"}],"\nonly accepts ",["$","code",null,{"children":"memory"}]," and ",["$","code",null,{"children":"redis"}],", so there is nothing to point at it. Use\n",["$","$L6",null,{"href":"/how-to/stores/redis","children":"Redis"}]," for a shared scheduler."]}]}],["$","$L3b",null,{"title":"Connection failures against Atlas","id":"connection-failures-against-atlas","children":["$","p",null,{"children":["Use the ",["$","code",null,{"children":"mongodb+srv://"}]," form, and check that the deployment's IP access list\nincludes wherever Forge runs. An access-list rejection often surfaces as a\nconnection timeout rather than as an authorization error."]}]}],["$","$L3b",null,{"title":"Timeouts under load","id":"timeouts-under-load","children":["$","p",null,{"children":["Set ",["$","code",null,{"children":"max_requests"}]," so concurrency queues in Forge instead of arriving all\nat once, then consider raising ",["$","code",null,{"children":"connection_timeout_ms"}],", which also bounds\nserver selection. Also check the deployment's own connection limit; Atlas\ntiers cap it low."]}]}],["$","$L3b",null,{"title":"Cache entries disappear after a failover","id":"cache-entries-disappear-after-a-failover","children":["$","p",null,{"children":["Write concern. With ",["$","code",null,{"children":"write_concern_w"}]," unset or ",["$","code",null,{"children":"1"}],", a write acknowledged by the\nprimary can be rolled back when that primary is replaced. Set ",["$","code",null,{"children":"\"majority\""}],"."]}]}],["$","$L3b",null,{"title":"Two deployments are seeing each other's entries","id":"two-deployments-are-seeing-each-others-entries","children":["$","p",null,{"children":["They share a database with no ",["$","code",null,{"children":"key_prefix"}],", or the same one. Give each its own\nprefix, or its own database."]}]}]]}]
