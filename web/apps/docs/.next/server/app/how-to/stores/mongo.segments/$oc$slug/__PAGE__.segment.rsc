1c:["$","p",null,{"children":["The Mongo store implements the scheduler-store interface, and\n",["$","code",null,{"children":"enable_change_streams: true"}]," is what that interface needs: the store refuses\nto hand out scheduler subscriptions without it. In v1.6.5, though, the ",["$","code",null,{"children":"simple"}],"\nscheduler's ",["$","code",null,{"children":"experimental_backend"}]," accepts only ",["$","code",null,{"children":"memory"}]," and ",["$","code",null,{"children":"redis"}],", so there\nis no config path that puts a Mongo store behind the scheduler. Treat this\nstore as a CAS and Action Cache backend, and see\n",["$","$L6",null,{"href":"/how-to/stores/redis","children":"Redis"}]," for a shared scheduler."]}]
1d:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/schedulers.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/schedulers.rs","data-source-ref":"v1.6.5","title":"forge-config/src/schedulers.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ExperimentalSimpleSchedulerBackend"]}]
1e:["$","p",null,{"children":["Leave ",["$","code",null,{"children":"enable_change_streams"}]," off for a store used as a CAS. It buys nothing\nthere."]}]
1f:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Change streams require a replica set"}],["$","p",null,{"children":["Mongo only offers change streams on a replica set or sharded cluster; a\nstandalone ",["$","code",null,{"children":"mongod"}]," cannot serve them, no matter what this flag says. Atlas\nis always a replica set; a local single-node deployment needs\n",["$","code",null,{"children":"--replSet"}]," and an initiated set."]}]]}]]}]
