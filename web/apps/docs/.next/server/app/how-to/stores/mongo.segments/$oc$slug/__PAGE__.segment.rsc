18:["$","p",null,{"children":[["$","code",null,{"children":"connection_string"}]," is the only required field and takes either form Mongo\naccepts, ",["$","code",null,{"children":"mongodb://localhost:27017"}]," or\n",["$","code",null,{"children":"mongodb+srv://cluster.mongodb.net"}]," for Atlas. It carries the credentials, so\nkeep it in the environment and reference it with ",["$","code",null,{"children":"$${VAR}"}],"; see\n",["$","$L6",null,{"href":"/configuration/config-file","children":"The config file"}],"."]}]
