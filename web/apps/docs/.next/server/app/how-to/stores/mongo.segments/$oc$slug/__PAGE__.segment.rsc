21:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"What it decides"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"database"}]}],["$","td",null,{"children":["$","code",null,{"children":"forge"}]}],["$","td",null,{"children":"Database name"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"cas_collection"}]}],["$","td",null,{"children":["$","code",null,{"children":"cas"}]}],["$","td",null,{"children":"Collection holding CAS objects"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"scheduler_collection"}]}],["$","td",null,{"children":["$","code",null,{"children":"scheduler"}]}],["$","td",null,{"children":"Collection holding scheduler state"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"key_prefix"}]}],["$","td",null,{"children":"empty"}],["$","td",null,{"children":"Namespacing when several deployments share one database"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"read_chunk_size"}]}],["$","td",null,{"children":"64 KB"}],["$","td",null,{"children":"Bytes pulled per chunk when streaming a blob out"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_requests"}]}],["$","td",null,{"children":"unlimited"}],["$","td",null,{"children":"Ceiling on concurrent requests to the deployment"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"connection_timeout_ms"}]}],["$","td",null,{"children":"3000"}],["$","td",null,{"children":"Applied as both the driver's connect timeout and its server-selection timeout"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"command_timeout_ms"}]}],["$","td",null,{"children":"10000"}],["$","td",null,{"children":"Accepted and defaulted, but not applied to any driver option in v1.6.5"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"enable_change_streams"}]}],["$","td",null,{"children":["$","code",null,{"children":"false"}]}],["$","td",null,{"children":"Required for scheduler subscriptions, which nothing uses yet (see above)"}]]}]]}]]}]}]
22:["$","p",null,{"children":["Write concern is exposed as three separate fields mirroring Mongo's own:\n",["$","code",null,{"children":"write_concern_w"}]," (a number like ",["$","code",null,{"children":"1"}],", or the string ",["$","code",null,{"children":"\"majority\""}],"),\n",["$","code",null,{"children":"write_concern_j"}]," (whether to wait for the journal), and\n",["$","code",null,{"children":"write_concern_timeout_ms"}],". All three are optional and unset means the\ndeployment's own default applies, but ",["$","code",null,{"children":"write_concern_j"}]," or\n",["$","code",null,{"children":"write_concern_timeout_ms"}]," without ",["$","code",null,{"children":"write_concern_w"}]," is rejected at startup.\nFor a CAS, ",["$","code",null,{"children":"\"majority\""}]," is the honest\nsetting, because a cache entry acknowledged by one node and then lost to a failover is\na cache entry a client believes exists."]}]
23:["$","p",null,{"children":[["$","code",null,{"children":"max_requests"}]," is the equivalent of Redis's permit ceiling and is unlimited by\ndefault. Set it if bursts are overwhelming the deployment; queuing in\nForge beats timing out at Mongo. Zero is rejected at startup."]}]
