1e:["$","$L49",null,{"children":[["$","$L4a",null,{"title":"The client falls back to uncompressed transfers","id":"the-client-falls-back-to-uncompressed-transfers","children":["$","p",null,{"children":["Forge only advertises zstd when ",["$","code",null,{"children":"remote_cache_compression"}]," is true on the\ncapabilities service ",["$","strong",null,{"children":"for that instance name"}],". An instance-name mismatch\nbetween the capabilities entry and the CAS or ByteStream entries is the usual\ncause."]}]}],["$","$L4a",null,{"title":"Transfer bytes barely moved","id":"transfer-bytes-barely-moved","children":["$","p",null,{"children":"Your artifacts are already compressed, or the wire wasn't the bottleneck. Both\nare real answers; on a same-rack link there is nothing here to win."}]}],["$","$L4a",null,{"title":"Is it safe to enable with a mixed client fleet?","id":"is-it-safe-to-enable-with-a-mixed-client-fleet","children":["$","p",null,{"children":["Yes. Clients only compress when the server advertises support, so anything that\ndoesn't request ",["$","code",null,{"children":"compressed-blobs/zstd"}]," keeps using identity transfers against\nthe same instance."]}]}],["$","$L4a",null,{"title":"Can I combine this with the dedup store?","id":"can-i-combine-this-with-the-dedup-store","children":["$","p",null,{"children":["Yes, but order matters at the store level: deduplication must operate on raw\ncontent, because identical chunks stop being identical after compression, so a ",["$","code",null,{"children":"dedup"}],"\nstore fed compressed bytes finds no duplicates. Wire compression is fine either\nway; it's undone at the gRPC boundary before any store sees the bytes."]}]}]]}]
