c:["$","p",null,{"children":["Clients only compress when the server advertises it, so enabling the option is\nsafe with a mixed fleet of clients: anything that doesn't request\n",["$","code",null,{"children":"compressed-blobs/zstd"}]," keeps using identity transfers."]}]
d:["$","p",null,{"children":["See ",["$","$L6",null,{"href":"/configuration/servers-and-services","children":"Servers and services"}]," for where the\ncapabilities service sits in the rest of the config."]}]
