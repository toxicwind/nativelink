0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#requirements","title":"Requirements"},{"depth":2,"url":"#enabling-it","title":"Enabling it"},{"depth":3,"url":"#forge-to-forge-transfers","title":"Forge-to-Forge transfers"},{"depth":2,"url":"#semantics-worth-knowing","title":"Semantics worth knowing"},{"depth":2,"url":"#when-it-helps-and-when-it-doesnt","title":"When it helps, and when it doesn't"},{"depth":2,"url":"#steps","title":"Steps"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"}],"children":[["$","$L3",null,{"children":"Remote cache compression"}],["$","$L4",null,{"children":"Cut remote cache transfer bytes for compressible artifacts with REAPI zstd wire compression and Bazel's --remote_cache_compression."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone whose clients reach Forge across a real\nnetwork and whose artifacts compress well. ",["$","strong",null,{"children":"What you'll have at the end:"}],"\nzstd on the wire, with stores still holding raw bytes. ",["$","strong",null,{"children":"Time:"}]," ten minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A config file you can edit (see ",["$","$L6",null,{"href":"/configuration","children":"Configuration"}],"), and a Bazel client you can pass flags to."]}]}]]}],"\n",["$","p",null,{"children":"Build artifacts are often highly compressible (object files, archives, test\nlogs), but a conventional remote cache transfers them byte-for-byte. With wire\ncompression, clients and server exchange blobs as zstd-compressed streams and\nonly the wire bytes shrink: Forge decompresses on upload and compresses on\ndownload at the gRPC boundary, so stores keep raw, uncompressed bytes and every\nexisting read path sees ordinary blobs."}],"\n",["$","p",null,{"children":["Forge implements the server side of the REAPI\n",["$","$L6",null,{"href":"https://github.com/bazelbuild/remote-apis/blob/main/build/bazel/remote/execution/v2/remote_execution.proto","children":["$","code",null,{"children":"compressed-blobs"}]}],"\nextension with ",["$","code",null,{"children":"zstd"}]," as the only supported non-identity compressor, matching\nwhat Bazel's ",["$","code",null,{"children":"--remote_cache_compression"}]," flag speaks: ByteStream reads and\nwrites use ",["$","code",null,{"children":"compressed-blobs/zstd/..."}]," resource names, and the CAS batch RPCs\naccept and serve zstd-compressed payloads."]}],"\n",["$","$L7",null,{"as":"h2","id":"requirements","children":"Requirements"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["A Bazel client with ",["$","code",null,{"children":"--remote_cache_compression"}]," (available since Bazel 5)."]}],"\n",["$","li",null,{"children":["Wire compression is ",["$","strong",null,{"children":"optional and off until it is enabled somewhere in the\nForge process"}],". Without the configuration below or an explicitly\nenabled CAS ",["$","code",null,{"children":"grpc"}]," store, Forge does not advertise zstd, rejects\n",["$","code",null,{"children":"compressed-blobs/zstd"}]," requests with ",["$","code",null,{"children":"InvalidArgument"}],", and keeps its own\noutgoing transfers on the identity path, so clients fall back to identity\ntransfers."]}],"\n"]}],"\n",["$","$L7",null,{"as":"h2","id":"enabling-it","children":"Enabling it"}],"\n",["$","p",null,{"children":["Set ",["$","code",null,{"children":"remote_cache_compression: true"}]," on the capabilities service for the\ninstance. The capabilities service advertises zstd to clients, and the\nByteStream and CAS services accept and serve compressed payloads for that\ninstance:"]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20"]}],"$L21"]}],["$L22","$L23"],"$L24"]}],"isPartial":"$@25","staleTime":"$26","varyParams":null},{"rsc":"$L27","isPartial":"$@28","staleTime":"$26","varyParams":null},{"rsc":"$L29","isPartial":"$@2a","staleTime":"$26","varyParams":"$2b"}],"isUpgradeableISRFallback":false,"a":"$@2c","rootVaryParams":null,"needsRuntimeRequest":"$@2d"}
