12:["$","p",null,{"children":["To keep one link uncompressed (an older Forge, or a third-party cache\nwithout ",["$","code",null,{"children":"compressed-blobs"}]," support), set ",["$","code",null,{"children":"experimental_remote_cache_compression: false"}]," on that store. Forge logs a startup warning for a CAS ",["$","code",null,{"children":"grpc"}]," store\nthat opts out while zstd is enabled elsewhere, and a warning for\n",["$","code",null,{"children":"experimental_remote_cache_compression: true"}]," on an ",["$","code",null,{"children":"ac"}]," store, where the\nsetting has no effect: ",["$","code",null,{"children":"ac"}]," stores are never eligible and never inherit."]}]
