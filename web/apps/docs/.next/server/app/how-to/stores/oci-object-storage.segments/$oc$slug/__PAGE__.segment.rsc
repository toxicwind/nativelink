0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#how-it-works","title":"How it works"},{"depth":2,"url":"#before-you-start","title":"Before you start"},{"depth":2,"url":"#authentication","title":"Authentication"},{"depth":2,"url":"#the-recipe","title":"The recipe"},{"depth":3,"url":"#fields","title":"Fields"},{"depth":2,"url":"#steps","title":"Steps"},{"depth":2,"url":"#operational-notes","title":"Operational notes"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"}],"children":[["$","$L3",null,{"children":"Oracle Cloud (OCI) Object Storage"}],["$","$L4",null,{"children":"Back the cache with OCI Object Storage through its S3 Compatibility API: Customer Secret Keys, the two adjustments the store makes for you, and what has actually been verified."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone running Forge on Oracle Cloud who wants the\ndurable tier to be an OCI bucket. ",["$","strong",null,{"children":"What you'll have at the end:"}]," a\nbucket-backed CAS and Action Cache authenticated with a Customer Secret Key.\n",["$","strong",null,{"children":"Time:"}]," thirty minutes, most of it namespace and policy setup."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A config file you can edit (see ",["$","$L6",null,{"href":"/configuration","children":"Configuration"}],"), and an OCI tenancy you can create a bucket in."]}]}]]}],"\n",["$","p",null,{"children":["OCI is one ",["$","code",null,{"children":"provider"}]," value of the same cloud object store used by\n",["$","$L6",null,{"href":"/how-to/stores/s3-and-compatible","children":"S3 and compatible"}],",\n",["$","$L6",null,{"href":"/how-to/stores/gcs","children":"GCS"}]," and ",["$","$L6",null,{"href":"/how-to/stores/azure","children":"Azure Blob"}],": six\nproviders over one store type, sharing the same multipart, retry and streaming\ncode paths."]}],"\n",["$","$L7",null,{"as":"h2","id":"how-it-works","children":"How it works"}],"\n",["$","p",null,{"children":[["$","$L6",null,{"href":"https://www.oracle.com/cloud/storage/object-storage/","children":"OCI Object Storage"}],"\nexposes an ",["$","$L6",null,{"href":"https://docs.oracle.com/en-us/iaas/Content/Object/Tasks/s3compatibleapi.htm","children":"S3 Compatibility\nAPI"}],",\nand the ",["$","code",null,{"children":"oci"}]," provider is a thin adapter pointing the S3 store at it. Two\nOCI-specific adjustments are applied automatically, and you do not configure\neither:"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Path-style addressing."}]," OCI requires ",["$","code",null,{"children":"endpoint/bucket/key"}]," rather than\nvirtual-hosted ",["$","code",null,{"children":"bucket.endpoint/key"}]," URLs. The endpoint is derived as\n",["$","code",null,{"children":"https://{namespace}.compat.objectstorage.{region}.oci.customer-oci.com"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Checksums downgraded to \"when required\"."}]," The AWS SDK otherwise adds a\ndefault trailing checksum that forces ",["$","code",null,{"children":"Content-Encoding: aws-chunked"}],", which\nOCI rejects with ",["$","code",null,{"children":"501 NotImplemented: AWS chunked encoding not supported"}],".\nWithout the downgrade, small single-",["$","code",null,{"children":"PUT"}]," objects (notably Action Cache\nentries) fail."]}],"\n"]}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/oci_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/oci_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/oci_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":["$L8","OciStore"]}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27"]}],"$L28"]}],["$L29","$L2a"],"$L2b"]}],"isPartial":"$@2c","staleTime":"$2d","varyParams":null},{"rsc":"$L2e","isPartial":"$@2f","staleTime":"$2d","varyParams":null},{"rsc":"$L30","isPartial":"$@31","staleTime":"$2d","varyParams":"$32"}],"isUpgradeableISRFallback":false,"a":"$@33","rootVaryParams":null,"needsRuntimeRequest":"$@34"}
