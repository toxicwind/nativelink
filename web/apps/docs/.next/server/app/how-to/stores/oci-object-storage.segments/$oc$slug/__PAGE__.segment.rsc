20:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["Objects appear under both ",["$","code",null,{"children":"cas/"}]," and ",["$","code",null,{"children":"ac/"}]," in the bucket during the first\nbuild."]}],"\n",["$","li",null,{"children":"The second build is a cache hit, which proves the Action Cache round trip\nworks. That is the path the checksum adjustment exists for."}],"\n",["$","li",null,{"children":"A large artifact uploads and downloads intact, which exercises multipart."}],"\n",["$","li",null,{"children":"No incomplete multipart uploads accumulate between builds."}],"\n"]}]}]]}]
