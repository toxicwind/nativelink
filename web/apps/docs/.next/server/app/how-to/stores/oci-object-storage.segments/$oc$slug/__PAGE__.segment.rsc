f:["$","p",null,{"children":["The S3 Compatibility API authenticates with Customer Secret Keys, a static\naccess-key and secret-key pair used as ",["$","code",null,{"children":"access_key_id"}]," and\n",["$","code",null,{"children":"secret_access_key"}],", signed with AWS SigV4."]}]
10:["$","p",null,{"children":["Generate one in the Console under ",["$","em",null,{"children":"Profile → User settings → Customer secret\nkeys → Generate secret key"}],". The secret is shown ",["$","strong",null,{"children":"only once"}]," at generation time, so copy it\nimmediately; the access key stays listed in the table and can be copied\nwhenever you like. OCI has no way to retrieve a secret after generation, so if\nyou lose it you rotate rather than recover."]}]
