25:["$","$L49",null,{"children":[["$","$L4a",null,{"title":"Small objects fail with 501 NotImplemented: AWS chunked encoding not supported","id":"small-objects-fail-with-501-notimplemented-aws-chunked-encoding-not-supported","children":["$","p",null,{"children":["Something is re-adding the default trailing checksum the store removes. This is\nthe failure the checksum downgrade exists to prevent, and it shows up first on\nAction Cache entries because they are small single-",["$","code",null,{"children":"PUT"}]," objects. Confirm you\nare on a Forge version that carries the ",["$","code",null,{"children":"oci"}]," provider rather than\npointing the ",["$","code",null,{"children":"aws"}]," provider at an OCI endpoint by hand."]}]}],["$","$L4a",null,{"title":"Every request fails to authenticate","id":"every-request-fails-to-authenticate","children":["$","p",null,{"children":["The S3 Compatibility API takes Customer Secret Keys only. An API signing key,\nan instance principal or a resource principal will not work here. Check also\nthat ",["$","code",null,{"children":"region"}]," matches the bucket's region. It is the SigV4 signing region as\nwell as part of the endpoint."]}]}],["$","$L4a",null,{"title":"The endpoint cannot be resolved","id":"the-endpoint-cannot-be-resolved","children":["$","p",null,{"children":[["$","code",null,{"children":"namespace"}]," is wrong. It is the tenancy's Object Storage namespace from\n",["$","code",null,{"children":"oci os ns get"}],", not the tenancy name and not the compartment."]}]}],["$","$L4a",null,{"title":"You lost the secret key","id":"you-lost-the-secret-key","children":["$","p",null,{"children":"It cannot be retrieved; OCI shows it once. Generate a new Customer Secret Key\nand delete the old one."}]}],["$","$L4a",null,{"title":"Can the CAS and Action Cache share one bucket?","id":"can-the-cas-and-action-cache-share-one-bucket","children":["$","p",null,{"children":["Yes, and they should. Segment them with ",["$","code",null,{"child