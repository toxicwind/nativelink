31:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Pin, don't float."}]," If anything in your deployment says ",["$","code",null,{"children":":latest"}],", fix that\nfirst. You cannot control an upgrade you did not choose, and you cannot roll\nback to a tag that means something different now."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Rehearse every config file"}]," against the new image as above, and fix whatever\nfails."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Upgrade the CAS servers first."}]," They hold the data, they serve the most\ntraffic, and they are the piece other processes depend on. A filesystem store\nrescans its ",["$","code",null,{"children":"content_path"}]," at startup to rebuild its index, so a restart with a\nlarge cache is not instant. Expect a pause proportional to the number of\nobjects, and do not interpret it as a hang."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Upgrade the scheduler and the workers together."}]," The worker API between them\nis internal. With a ",["$","code",null,{"children":"simple"}]," scheduler the queue is in memory, so restarting it\ndrops queued actions. Clients retry, but do it when a retry storm is cheap."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Run a real build"}],", then run it again. The first proves the new version works;\nthe second proves it can still read what the old version wrote, which is the\nquestion that actually matters."]}]}]]}]
32:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":"Every process is running the intended tag, and you can prove it rather than\nassume it."}],"\n",["$","li",null,{"children":"A build run before the upgrade gets cache hits after it. This is the\ndata-compatibility check."}],"\n",["$","li",null,{"children":"Remote execution actions complete on upgraded workers."}],"\n",["$","li",null,{"children":"Nothing in any process log mentions an unknown or deprecated config field."}],"\n",["$","li",null,{"children":"The previous image tag plus the previous config file are still somewhere you\ncan reach in under a minute."}],"\n"]}]}]]}]
33:["$","$L3c",null,{"as":"h2","id":"rolling-back","children":"Rolling back"}]
34:["$","p",null,{"children":"Rollback is the same operation in reverse, with one asymmetry worth internalizing."}]
35:["$","p",null,{"children":["Config is not backward compatible in the direction you need it to be. If you\nadded a field that only exists in the new version, the old binary rejects that\nfile, because ",["$","code",null,{"children":"deny_unknown_fields"}]," cuts both ways. ",["$","strong",null,{"children":"Roll back the config and the\nimage together, as a pair."}]," Keeping the two versions of each config file next\nto each other for a release or two costs nothing and turns a rollback into a\nsingle decision."]}]
36:["$","p",null,{"children":"Data written by the newer version stays readable by the older one in the normal\ncase, because content addressing does not change. If the changelog mentioned a\nstore layout change, that is the case where it does not, and it is also the case\nwhere rolling back means accepting a cold cache. Reading for that in advance is\nwhat makes the difference between a rollback and an incident."}]
37:["$","$L3c",null,{"as":"h2","id":"when-it-doesnt-work","children":"When it doesn't work"}]
38:["$","$L40",null,{"children":[["$","$L41",null,{"title":"`unknown field` at startup","id":"unknown-field-at-startup","children":["$","p",null,{"children":"Exactly the failure this design intends. The message names the field. Find it in\nthe new version's config reference. Usually it was renamed, occasionally it\nmoved under a different parent, rarely it is gone because the feature it\ncontrolled is. Fix the file, do not try to make the parser lenient."}]}],["$","$L41",null,{"title":"Everything starts but the cache is cold","id":"everything-starts-but-the-cache-is-cold","children":["$","p",null,{"children":["The new version is not finding the old data. Check first that ",["$","code",null,{"children":"content_path"}],",\nthe bucket, or the Redis instance is genuinely the same one. A changed volume\nmount or a changed key prefix looks exactly like a format incompatibility. If\nthe paths are identical, re-read the changelog for the intervening releases with\nstore layout in mind."]}]}],["$","$L41",null,{"title":"Workers connect but actions fail after upgrading only the scheduler","id":"workers-connect-but-actions-fail-after-upgrading-only-the-scheduler","children":["$","p",null,{"children":"Version skew across the worker API. Bring the workers to the same version. This\nis why the two upgrade together rather than independently."}]}],["$","$L41",null,{"title":"The CAS takes a long time to start","id":"the-cas-takes-a-long-time-to-start","children":["$","p",null,{"children":["A filesystem store walks ",["$","code",null,{"children":"content_path"}]," at startup to rebuild its in-memory\nindex, and that scales with object count. It is not stuck. If the pause is long\nenough to matter operationally, that is a signal about cache size rather than\nabout the upgrade, and ",["$","$L3d",null,{"href":"/operate/tuning","children":"Tuning"}]," has the storage levers."]}]}],["$","$L41",null,{"title":"How far behind can I safely get?","id":"how-far-behind-can-i-safely-get","children":["$","p",null,{"children":"Being several releases behind is not itself dangerous. The risk is that the\nupgrade becomes several config migrations at once with no way to tell which one\nbroke. If you are many versions back, step through in two or three hops and run\na build at each, rather than making one jump you cannot bisect."}]}],["$","$L41",null,{"title":"Do clients need to upgrade too?","id":"do-clients-need-to-upgrade-too","children":["$","p",null,{"children":"Usually no. Bazel and Forge talk the Remote Execution API, which is stable\nacross these releases. Client upgrades matter when you want a client-side\nfeature, not because the server moved."}]}]]}]
