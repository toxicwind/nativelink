26:["$","p",null,{"children":["Changes to ",["$","strong",null,{"children":"default values"}],", which do not fail loudly and are the reason to\nset explicitly anything you actually care about."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":"Store layout or serialization"}]," changes, which determine whether existing\ncached data is still reachable."]}]
28:["$","p",null,{"children":["Anything about the ",["$","strong",null,{"children":"worker protocol"}],", which decides whether you can upgrade\nworkers and scheduler independently."]}]
29:["$","p",null,{"children":"Skip several versions and you must read every intervening release's entries, not\njust the newest, because the breaking change may be three releases back."}]
