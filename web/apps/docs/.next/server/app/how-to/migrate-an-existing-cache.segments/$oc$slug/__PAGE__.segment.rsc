:"Move developers"}],", then wait. Give it long enough that a full build's worth of\nactions has passed through, typically a week or two of normal work."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Remove the diode"}]," once misses are no longer being answered by the old cache,\nthen decommission it."]}]}]]}]
1f:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":"A build that got hits from the old cache gets hits from Forge on the\nfirst run against it."}],"\n",["$","li",null,{"children":["Forge's ",["$","code",null,{"children":"content_path"}]," grows during that run, because it is keeping what it\nreads."]}],"\n",["$","li",null,{"children":"A second identical build is served entirely by Forge, with no traffic to\nthe old cache."}],"\n",["$","li",null,{"children":"The old cache's storage stops growing, confirming nothing is writing to it."}],"\n",["$","li",null,{"children":"Turning the old cache off entirely, at the end, changes nothing."}],"\n"]}]}]]}]
