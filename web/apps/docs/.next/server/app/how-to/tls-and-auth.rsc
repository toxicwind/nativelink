24:["$","p",null,{"children":["Both paths are PEM files read at startup. The certificate file may hold a full\nchain. The key may be PKCS8, SEC1 or PKCS1 (all three are accepted), but it\nmust contain ",["$","strong",null,{"children":"exactly one"}]," key, and a file with two will fail startup rather\nthan pick one."]}]
25:["$","p",null,{"children":["Once TLS is on, the listener negotiates ALPN ",["$","code",null,{"children":"h2"}],", and clients must address it\nas ",["$","code",null,{"children":"grpcs://"}]," rather than ",["$","code",null,{"children":"grpc://"}],". That scheme change is the single most\ncommon reason a first TLS rollout fails: a ",["$","code",null,{"children":"grpc://"}]," client sends plaintext\ninto the handshake, the server logs ",["$","code",null,{"children":"Failed to accept tls stream"}]," and drops the\nconnection, and the client sees a connection error that says nothing about\nTLS."]}]
