null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Run a build with high parallelism"}]," (",["$","code",null,{"children":"--jobs=50"}]," or so) and confirm the\nactions land across all three."]}]}]]}]
1d:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["Each worker logs ",["$","code",null,{"children":"Worker registered with scheduler"}]," at startup, and the\nscheduler's ",["$","code",null,{"children":"worker.connected.count"}]," metric reads three rather than one."]}],"\n",["$","li",null,{"children":["A build with high ",["$","code",null,{"children":"--jobs"}]," shows actions executing on more than one worker."]}],"\n",["$","li",null,{"children":"Stopping one worker mid-build does not fail the build. Its actions are\nretried elsewhere."}],"\n",["$","li",null,{"children":["Each worker's local ",["$","code",null,{"children":"content_path"}]," grows and then plateaus at its\n",["$","code",null,{"children":"max_bytes"}],", rather than growing without bound."]}],"\n"]}]}]]}]
