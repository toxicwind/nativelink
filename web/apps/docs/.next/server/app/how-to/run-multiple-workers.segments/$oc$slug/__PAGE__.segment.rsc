15:["$","p",null,{"children":[["$","$L6",null,{"href":"/remote-execution/platform-properties","children":"Platform properties"}]," is the page for\nthat contract; this page only needs you to know that every worker in a pool\nshould advertise the same keys."]}]
16:["$","$L7",null,{"as":"h2","id":"scaling-the-pool","children":"Scaling the pool"}]
17:["$","p",null,{"children":"Workers are stateless, so growing the pool is adding processes. Three things\nscale with them and are worth watching before you double the count."}]
18:["$","p",null,{"children":["The CAS server is now serving every input to every worker. It is the first\nthing to saturate, and ",["$","$L6",null,{"href":"/operate/tuning","children":"Tuning"}]," has the storage levers for it.\nGive each worker a large enough local ",["$","code",null,{"children":"fast"}]," tier and most reads never reach\nit."]}]
19:["$","p",null,{"children":"The scheduler holds one queue and matches against every connected worker. It is\nCPU-cheap but not free, and it is a single point of failure until you give it a\nshared store."}]
1a:["$","p",null,{"children":["Disk on each worker host is consumed by the ",["$","code",null,{"children":"fast"}]," tier plus the work\ndirectory of every action in flight. ",["$","code",null,{"children":"max_bytes"}]," bounds the first and nothing\nbounds the second, so leave headroom."]}]
1b:["$","$L7",null,{"as":"h2","id":"steps","children":"Steps"}]
