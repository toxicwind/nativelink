1c:["$","$L2a",null,{"type":"multiple","children":[["$","$L2b",null,{"title":"Is Forge free?","id":"is-forge-free","children":["$","p",null,{"children":["For permitted use, yes. Most of the repository is ",["$","code",null,{"children":"FSL-1.1-Apache-2.0"}],",\nwhich allows internal use, modification, and redistribution for\nnon-competing purposes, and converts to Apache 2.0 two years after each\nversion ships. Two modules, metrics and persistent workers, carry a\nBusiness Source License instead, and using those in shared, production or\ncommercial settings needs a separate agreement. Nothing in the binary\nenforces any of that, which is exactly why\n",["$","$L6",null,{"href":"/reference/oss-and-enterprise","children":"Open source and Enterprise"}]," exists."]}]}],["$","$L2b",null,{"title":"Which build tools work with Forge?","id":"which-build-tools-work-with-forge","children":["$","p",null,{"children":["Any client that speaks the Remote Execution API. The ones with a page here\nare ",["$","$L6",null,{"href":"/getting-started/quickstart","children":"Bazel"}],",\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/buck2","children":"Buck2"}],",\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/siso","children":"Siso"}],",\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/chromium","children":"Chromium's build"}],",\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/pants","children":"Pants"}],",\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/buildstream","children":"BuildStream"}],", and\n",["$","$L6",null,{"href":"/getting-started/connect-your-build/cmake-recc","children":"CMake via recc"}],". None of\nthem needs build-file rewrites."]}]}],["$","$L2b",null,{"title":"What platforms does the server run on?","id":"what-platforms-does-the-server-run-on","children":["$","p",null,{"children":["Linux and Windows on x86_64 and ARM64 via the multi-arch Docker image\n(",["$","code",null,{"children":"ghcr.io/tracemachina/forge"}],", v1.6.0+), and macOS on Apple Silicon\nand Intel via the Docker image or a from-source Nix build. See\n",["$","$L6",null,{"href":"/getting-started/quickstart","children":"Quickstart"}],"."]}]}],["$","$L2b",null,{"title":"Do I need remote execution to get value from this?","id":"do-i-need-remote-execution-to-get-value-from-this","children":["$","p",null,{"children":["No, and most teams shouldn't start there. A shared cache is the smaller\nchange and usually the larger win: it needs no toolchain work, no\nhermeticity audit, and no worker fleet. Remote execution is the second\nsection for a reason: it's what you add once your cache is hitting and the\nmisses are what's slow. ",["$","$L6",null,{"href":"/use-cases","children":"Why Forge"}]," works through which of\nthe two your build actually needs."]}]}]]}]
