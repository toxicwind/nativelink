0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#the-ladder","title":"The reading path"},{"depth":2,"url":"#start-where-you-are","title":"Start where you are"},{"depth":3,"url":"#im-deciding-whether-this-is-for-us","title":"I'm deciding whether this is for us"},{"depth":3,"url":"#i-want-to-get-something-running","title":"I want to get something running"},{"depth":3,"url":"#i-want-to-configure-it","title":"I want to configure it"},{"depth":3,"url":"#i-want-to-run-it-in-production","title":"I want to run it in production"},{"depth":3,"url":"#i-want-to-understand-how-it-works","title":"I want to understand how it works"},{"depth":3,"url":"#i-need-to-look-something-up","title":"I need to look something up"},{"depth":3,"url":"#i-want-to-contribute","title":"I want to contribute"},{"depth":2,"url":"#faq","title":"FAQ"}],"children":[["$","$L3",null,{"children":"Introduction"}],["$","$L4",null,{"children":"Forge is a remote build cache and execution service in one Rust binary. This is the documentation for running it yourself."}],["$","$L5",null,{"children":[["$","p",null,{"children":["Forge is a ",["$","strong",null,{"children":"remote build cache"}]," and a ",["$","strong",null,{"children":"remote execution"}]," service in\none program. Your build tool asks it \"have you already built this?\" and, when\nthe answer is no, \"can you build it for me over there?\" Your source code\ndoesn't change and your build files don't change: you point your build tool\nat a URL, and work that used to happen on your machine stops happening on your\nmachine."]}],"\n",["$","p",null,{"children":["It's written in Rust and ships as a single binary that plays every role in the\nsystem: cache, scheduler, and worker are the same executable started with\ndifferent configuration. It speaks the\n",["$","$L6",null,{"href":"https://github.com/bazelbuild/remote-apis","children":"Remote Execution API"}],", an open\nprotocol rather than a Forge invention, which is why ",["$","strong",null,{"children":"Bazel, Buck2,\nSiso, Pants"}]," and ",["$","strong",null,{"children":"BuildStream"}]," connect to it without a plugin, and why\nplain CMake projects can via ",["$","$L6",null,{"href":"/getting-started/connect-your-build/cmake-recc","children":"recc"}],"."]}],"\n",["$","p",null,{"children":"This site documents the open-source distribution: setting it up, configuring\nit, deploying it, operating it when other people depend on it, and\ncontributing to it."}],"\n",["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Working with agents"}],["$","p",null,{"children":["If you're pointing a coding agent at Forge, at these docs or at the\ncodebase, ",["$","$L6",null,{"href":"/agents","children":"For agents"}]," has the three entry points and what each\nguarantees. If you're here because your ",["$","em",null,{"children":"agents"}]," are the ones waiting on\nbuilds, start with ",["$","$L6",null,{"href":"/use-cases/ai-coding-agents","children":"AI coding agents"}],"."]}]]}]]}],"\n",["$","$L7",null,{"as":"h2","id":"the-ladder","children":"The reading path"}],"\n",["$","p",null,{"children":"The first four sections are ordered, and each one assumes the last. You can\nskip ahead, but the pages will tell you what they expected you to have."}],"\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":"$L8"}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"]}],"$L1d"]}],["$L1e","$L1f"],"$L20"]}],"isPartial":"$@21","staleTime":"$22","varyParams":null},{"rsc":"$L23","isPartial":"$@24","staleTime":"$22","varyParams":null},{"rsc":"$L25","isPartial":"$@26","staleTime":"$22","varyParams":"$27"}],"isUpgradeableISRFallback":false,"a":"$@28","rootVaryParams":null,"needsRuntimeRequest":"$@29"}
