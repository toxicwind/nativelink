f:["$","$L17",null,{"toc":[{"depth":2,"url":"#start-here-there-is-no-authentication","title":"Start here: there is no authentication"},{"depth":2,"url":"#the-port-inventory","title":"The port inventory"},{"depth":2,"url":"#the-worker-api-has-no-authentication","title":"The worker API has no authentication"},{"depth":2,"url":"#the-admin-endpoint-has-no-authentication","title":"The admin endpoint has no authentication"},{"depth":2,"url":"#the-committed-certificates-are-not-usable","title":"The committed certificates are not usable"},{"depth":2,"url":"#configure-tls","title":"Configure TLS"},{"depth":3,"url":"#outbound-tls","title":"Outbound TLS"},{"depth":2,"url":"#the-sandbox-is-not-a-security-boundary","title":"The sandbox is not a security boundary"},{"depth":2,"url":"#what-to-do-in-order","title":"What to do, in order"},{"depth":2,"url":"#troubleshooting","title":"Troubleshooting"},{"depth":2,"url":"#whats-next","title":"What's next"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Security hardening"}],["$","$L19",null,{"children":"Open-source Forge has no inbound authentication on any service. What that means for your network, which ports must never be routable, how to configure mTLS, and why the worker sandbox is not a security boundary."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," you are about to put Forge somewhere more than one\nperson can reach it. ",["$","strong",null,{"children":"What you'll have at the end:"}]," a network layout where\nthe dangerous ports are unreachable, mTLS on the ports that must be reachable,\nand an accurate picture of the trust you are extending to anyone who can submit\nan action. ",["$","strong",null,{"children":"Time:"}]," 45 minutes, plus however long your certificate authority\ntakes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":"A deployment reachable by something other than your laptop."}]}]]}],"\n",["$","$L1b",null,{"as":"h2","id":"start-here-there-is-no-authentication","children":"Start here: there is no authentication"}],"\n",["$","p",null,{"children":"Open-source Forge authenticates no inbound request, on any service, in any\ndeployment. Not the CAS. Not the Action Cache. Not the Execution service. Not\nthe worker API. Not the admin endpoint. No bearer-token check, no API\nkey, no mTLS-identity-to-permission mapping; the code that would do it does\nnot exist in the tree."}],"\n",["$","p",null,{"children":["This is not a gap you close in the configuration file. The one server option\nthat looks like it might, ",["$","code",null,{"children":"experimental_identity_header"}]," with ",["$","code",null,{"children":"required: true"}],",\nonly rejects requests that arrive without an OpenTelemetry ",["$","code",null,{"children":"Baggage: enduser.id=..."}]," header; the value is a telemetry label and is never checked\nagainst anything. ",["$","strong",null,{"children":"Your network is the authorization layer."}]," Everything below\nfollows from that one fact."]}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/telemetry.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/telemetry.rs","data-source-ref":"v1.6.5","title":"forge-util/src/telemetry.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":["$L1c","OtlpLayer"]}],"\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b","\n","$L5c","\n","$L5d","\n","$L5e"]}],"$L5f"]}]
