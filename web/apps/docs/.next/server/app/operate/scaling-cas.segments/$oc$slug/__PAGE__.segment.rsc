9:["$","p",null,{"children":["When a client asks ",["$","code",null,{"children":"QueryWriteStatus"}]," to resume an interrupted upload, the\nserver looks the UUID up in that map. If the request lands on a replica that\nnever saw the upload, the lookup misses, the fallback checks whether the blob is\nalready complete in the store, and on a miss the client is told to start over\nfrom byte zero. The source comment at that branch says so in as many words. A\nlarge blob interrupted at 90% and resumed against a different replica is\nre-uploaded in full."]}]
a:["$","p",null,{"children":[["$","strong",null,{"children":"LRU state is per process."}]," The eviction index (recency ordering, running\nsize total, entry count) belongs to the process that built it."]}]
b:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/evicting_map.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/evicting_map.rs","data-source-ref":"v1.6.5","title":"forge-util/src/evicting_map.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"EvictingMap"]}]
c:["$","p",null,{"children":"Two replicas over the same logical dataset make independent eviction decisions\nand diverge."}]
d:["$","p",null,{"children":[["$","strong",null,{"children":"The existence cache produces stale positives."}]," An ",["$","code",null,{"children":"existence_cache"}]," store\nremembers \"this digest exists\" in memory and is invalidated by its backend's\nremove callbacks. Those callbacks are in-process for a filesystem or memory\nbackend, and there is no cross-process path at all for S3, GCS or Azure, so\na blob removed underneath one replica (an object lifecycle rule, another\nreplica's eviction, an operator) leaves the other replicas answering \"present\".\nThe client skips the upload, and a later fetch fails. The one backend with a\ncross-process signal is Redis: with ",["$","code",null,{"children":"notify-keyspace-events"}]," set to include\n",["$","code",null,{"children":"K"}]," and ",["$","code",null,{"children":"A"}],", every process subscribed to the store hears Redis-side\nevictions and TTL expiries and drops the entry."]}]
e:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/existence_cache_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/existence_cache_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/existence_cache_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ExistenceCacheStore"]}]
f:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/redis_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/redis_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/redis_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"notify-keyspace-events"]}]
10:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Do not put `existence_cache` behind a load balancer"}],["$","p",null,{"children":"It is the most dangerous wrapper to replicate. It is safe on a single process\nand safe in front of a backend nothing else removes from; it is unsafe the\nmoment anything other than that process deletes from the shared backing\nstore, unless the backing store is Redis with keyspace notifications on. The\nfailure mode is a build that skips an upload and then can't find its own\nartifact."}]]}]]}]
11:["$","p",null,{"children":[["$","strong",null,{"children":"A filesystem store cannot share a directory."}]," Two processes pointed at the\nsame ",["$","code",null,{"children":"content_path"}]," each build their own index at boot and each unlink files the\nother believes it owns. This is not a supported configuration."]}]
12:["$","p",null,{"children":[["$","strong",null,{"children":"Read deduplication is intra-process only."}]," ",["$","code",null,{"children":"fast_slow"}]," collapses concurrent\nreads of the same digest into a single fetch from the slow tier, but only within one\nprocess. Three replicas asking for the same cold blob at once make three\nrequests to S3."]}]
13:["$","p",null,{"children":"It has no leader election, no gossip, no Raft or quorum protocol, no etcd and\nno ZooKeeper anywhere in Forge. Replicas are independent processes, and any\ncoordination between them has to come from the semantics of the shared backing\nstore you point them at."}]
14:["$","$L7",null,{"as":"h2","id":"scale-vertically-first-by-composing","children":"Scale vertically first, by composing"}]
15:["$","p",null,{"children":["The store graph is where most capacity problems are solved, and it is cheaper\nthan adding processes because it changes nothing about consistency.\n",["$","$L6",null,{"href":"/how-to/stores/compose-stores","children":"Compose stores"}]," is the reference for the\nwrappers; what follows is which one relieves which pressure."]}]
16:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Pressure"}],["$","th",null,{"children":"Layer"}],["$","th",null,{"children":"What it buys"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Disk is full"}],["$","td",null,{"children":["$","code",null,{"children":"compression"}]}],["$","td",null,{"children":["LZ4 on the slow tier. It is the only algorithm the ",["$","code",null,{"children":"compression"}]," store offers (zstd exists only as REAPI wire compression on the ",["$","code",null,{"children":"grpc"}]," store)."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Disk is full, inputs are similar"}],["$","td",null,{"children":["$","code",null,{"children":"dedup"}]}],["$","td",null,{"children":"Content-defined chunking, 64 KiB to 512 KiB, so near-identical blobs share chunks."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Reads are slow"}],["$","td",null,{"children":["$","code",null,{"children":"fast_slow"}]}],["$","td",null,{"children":"A local hot tier in front of object storage or Redis."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Small blobs dominate request count"}],["$","td",null,{"children":["$","code",null,{"children":"size_partitioning"}]}],["$","td",null,{"children":"Route small objects to memory, large ones elsewhere."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"One backend is the ceiling"}],["$","td",null,{"children":["$","code",null,{"children":"shard"}]}],["$","td",null,{"children":"Spread keys across several backends by hash."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"FindMissingBlobs"}]," is hot"]}],["$","td",null,{"children":["$","code",null,{"children":"existence_cache"}]}],["$","td",null,{"children":"Answer existence without touching the backend; single process only."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"AC hits point at missing blobs"}],["$","td",null,{"children":["$","code",null,{"children":"completeness_checking"}]}],["$","td",null,{"children":"Re-check the CAS on every AC read."}]]}]]}]]}]}]
