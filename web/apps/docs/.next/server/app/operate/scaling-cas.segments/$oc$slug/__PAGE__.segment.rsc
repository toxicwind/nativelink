n":"  max_seconds"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"2592000"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  max_count"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"0"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"}"}]}]]}]}]}]
20:["$","p",null,{"children":[["$","code",null,{"children":"max_bytes"}]," is the ceiling. ",["$","code",null,{"children":"evict_bytes"}]," is the low watermark: when eviction\ntriggers, keep going until the store is down to ",["$","code",null,{"children":"max_bytes - evict_bytes"}],".\n",["$","code",null,{"children":"max_seconds"}]," expires entries by age since last access. ",["$","code",null,{"children":"max_count"}]," caps the\nnumber of entries."]}]
21:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$10:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`evict_bytes: 0` makes eviction run on nearly every write"}],["$","p",null,{"children":["With no low watermark configured, eviction evicts the bare minimum: it pops\nLRU entries only until the store is back under ",["$","code",null,{"children":"max_bytes"}],", then stops. The\nstore sits pinned at its high-water mark, and the next write puts it over\nagain. Every example config in the repository leaves ",["$","code",null,{"children":"evict_bytes"}]," unset.\nSetting it to some fraction of ",["$","code",null,{"children":"max_bytes"}]," is the single cheapest tuning\nchange available on this page."]}]]}]]}]
22:["$","p",null,{"children":"Two more behaviours to plan around:"}]
23:["$","p",null,{"children":[["$","strong",null,{"children":"No background eviction timer exists."}]," Eviction runs on inserts and\nremovals (and when a worker releases a lease on an input it was using). Reads\nperform a lazy per-key expiry check on the key being read and nothing else. The consequence is that ",["$","strong",null,{"children":"an idle store never shrinks"}],"; a CAS\nthat goes over quota and then stops receiving writes stays over quota, and\n",["$","code",null,{"children":"max_seconds"}]," only takes effect on entries someone happens to ask for."]}]
24:["$","p",null,{"children":[["$","strong",null,{"children":"Eviction is whole entries, one at a time."}]," It does no partial or chunked\neviction; the unit is one blob, or one file for a filesystem store."]}]
25:["$","$L7",null,{"as":"h3","id":"size-the-ac-and-the-cas-together","children":"Size the AC and the CAS together"}]
26:["$","p",null,{"children":["The Action Cache is just another store with its own ",["$","code",null,{"children":"EvictionPolicy"}],"; there is\nno separate mechanism. The shipped examples give it roughly a twentieth of the\nCAS budget, which is a reasonable starting ratio because AC entries are tiny."]}]
27:["$","p",null,{"children":["That asymmetry creates the hazard. AC entries are small and survive eviction\nreadily; the CAS blobs they ",["$","em",null,{"children":"point at"}]," are large and get evicted first. The\nresult is an AC hit that resolves to missing content. ",["$","code",null,{"children":"completeness_checking"}],"\nexists precisely for this: it re-queries the CAS on every AC read and treats an\nincomplete result as a miss. It costs a CAS round trip per AC hit, and on a\nshared production cache it is worth it."]}]
28:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/completeness_checking_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/completeness_checking_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/completeness_checking_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"CompletenessCheckingStore"]}]
