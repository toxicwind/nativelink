1e:["$","p",null,{"children":["Four fields, all on ",["$","code",null,{"children":"EvictionPolicy"}],", all defaulting to ",["$","code",null,{"children":"0"}],", and ",["$","code",null,{"children":"0"}]," means\n",["$","em",null,{"children":"disabled"}]," in every case. A policy with no fields set is an unbounded store."]}]
