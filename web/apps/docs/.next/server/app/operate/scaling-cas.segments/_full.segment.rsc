n":"  max_seconds"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"2592000"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  max_count"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"0"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"}"}]}]]}]}]}]
35:["$","p",null,{"children":[["$","code",null,{"children":"max_bytes"}]," is the ceiling. ",["$","code",null,{"children":"evict_bytes"}]," is the low watermark: when eviction\ntriggers, keep going until the store is down to ",["$","code",null,{"children":"max_bytes - evict_bytes"}],".\n",["$","code",null,{"children":"max_seconds"}]," expires entries by age since last access. ",["$","code",null,{"children":"max_count"}]," caps the\nnumber of entries."]}]
36:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$25:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`evict_bytes: 0` makes eviction run on nearly every write"}],["$","p",null,{"children":["With no low watermark configured, eviction evicts the bare minimum: it pops\nLRU entries only until the store is back under ",["$","code",null,{"children":"max_bytes"}],", then stops. The\nstore sits pinned at its high-water mark, and the next write puts it over\nagain. Every example config in the repository leaves ",["$","code",null,{"children":"evict_bytes"}]," unset.\nSetting it to some fraction of ",["$","code",null,{"children":"max_bytes"}]," is the single cheapest tuning\nchange available on this page."]}]]}]]}]
37:["$","p",null,{"children":"Two more behaviours to plan around:"}]
38:["$","p",null,{"children":[["$","strong",null,{"children":"No background eviction timer exists."}]," Eviction runs on inserts and\nremovals (and when a worker releases a lease on an input it was using). Reads\nperform a lazy per-key expiry check on the key being read and nothing else. The consequence is that ",["$","strong",null,{"children":"an idle store never shrinks"}],"; a CAS\nthat goes over quota and then stops receiving writes stays over quota, and\n",["$","code",null,{"children":"max_seconds"}]," only takes effect on entries someone happens to ask for."]}]
39:["$","p",null,{"children":[["$","strong",null,{"children":"Eviction is whole entries, one at a time."}]," It does no partial or chunked\neviction; the unit is one blob, or one file for a filesystem store."]}]
3a:["$","$L1c",null,{"as":"h3","id":"size-the-ac-and-the-cas-together","children":"Size the AC and the CAS together"}]
3b:["$","p",null,{"children":["The Action Cache is just another store with its own ",["$","code",null,{"children":"EvictionPolicy"}],"; there is\nno separate mechanism. The shipped examples give it roughly a twentieth of the\nCAS budget, which is a reasonable starting ratio because AC entries are tiny."]}]
3c:["$","p",null,{"children":["That asymmetry creates the hazard. AC entries are small and survive eviction\nreadily; the CAS blobs they ",["$","em",null,{"children":"point at"}]," are large and get evicted first. The\nresult is an AC hit that resolves to missing content. ",["$","code",null,{"children":"completeness_checking"}],"\nexists precisely for this: it re-queries the CAS on every AC read and treats an\nincomplete result as a miss. It costs a CAS round trip per AC hit, and on a\nshared production cache it is worth it."]}]
3d:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/completeness_checking_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/completeness_checking_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/completeness_checking_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"CompletenessCheckingStore"]}]
3e:["$","$L1c",null,{"as":"h2","id":"sharding-and-what-changing-it-costs","children":"Sharding, and what changing it costs"}]
3f:["$","p",null,{"children":[["$","code",null,{"children":"shard"}]," distributes keys across several backends by hash, with an optional\ninteger ",["$","code",null,{"children":"weight"}]," per shard. The weights are turned into a cumulative table over\nthe ",["$","code",null,{"children":"u32"}]," space at startup and the key is binary-searched into it."]}]
40:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/shard_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/shard_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/shard_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ShardStore"]}]
41:["$","p",null,{"children":"Two properties decide whether it fits."}]
42:["$","p",null,{"children":[["$","strong",null,{"children":"Placement includes the blob's size."}]," The hash folds the digest ",["$","em",null,{"children":"and"}]," its\ndeclared size, so the same content at a different declared size lands in a\ndifferent shard. This is fine (it's still deterministic), but it means you\ncannot reason about placement from the hash alone."]}]
43:["$","p",null,{"children":[["$","strong",null,{"children":"Nothing rebalances."}]," No migration, no virtual-node consistent hashing,\nno read repair, no re-shard command. Adding, removing, or reweighting a shard\nmoves the boundaries and remaps a large fraction of keys. The data is still\nphysically where it was written; lookups just go somewhere else and never find\nit."]}]
44:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$25:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Treat any shard change as a cache flush"}],["$","p",null,{"children":"Plan a shard-list change the way you would plan wiping the cache: during a\nquiet window, with the expectation that the next build is cold. Size the shard\ncount for where you expect to be in a year rather than for today."}]]}]]}]
45:["$","p",null,{"children":"Sharding is the right tool when one backend is genuinely the ceiling: a single\nRedis instance's memory, one filesystem's IOPS. It is the wrong tool for\ncapacity you could have bought by pointing at object storage instead."}]
46:["$","$L1c",null,{"as":"h2","id":"going-horizontal","children":"Going horizontal"}]
47:["$","p",null,{"children":"Everything above scales one process. If you have exhausted that, here is the\norder to add replicas in."}]
48:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Move the backing store off local disk first."}]," Replicas only make sense over\nstorage they can share: S3 or a compatible object store, GCS, Azure, or Redis.\nA filesystem store cannot be shared between processes at all, so this is a\nprerequisite rather than an optimisation. ",["$","$L1b",null,{"href":"/how-to/stores/s3-and-compatible","children":"S3 and\ncompatible"}]," and ",["$","$L1b",null,{"href":"/how-to/stores/redis","children":"Redis"}],"\nare the recipes."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Keep the per-replica fast tier local and private."}]," Each replica gets its own\n",["$","code",null,{"children":"fast_slow"}]," hot tier on its own disk, pointed at the shared slow store. This is\nthe topology that works: shared truth underneath, independent caches above.\nAccept that the hot tiers diverge; they are caches of a cache."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":["Remove ",["$","code",null,{"children":"existence_cache"}]," from the replicated path"]}],", or accept that it will\nserve stale positives. No cross-process invalidation exists except for a\nRedis backend with keyspace notifications enabled. If\n",["$","code",null,{"children":"FindMissingBlobs"}]," latency is why you wanted it, a ",["$","code",null,{"children":"fast_slow"}]," hot tier gets you\nmost of the same benefit without the correctness hazard."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Make ByteStream uploads sticky."}]," Configure your load balancer for session\naffinity so a client's upload stream and its ",["$","code",null,{"children":"QueryWriteStatus"}]," resume reach the\nsame replica. Without it, every interrupted large upload restarts from zero.\nThis is the single most common way a horizontally scaled CAS gets slower rather\nthan faster."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Set readiness to account for the startup scan."}]," A filesystem store scans its\nentire ",["$","code",null,{"children":"content_path"}]," at boot and builds its index ",["$","em",null,{"children":"before the process binds any\nsocket"}],". During that window there is nothing to connect to: not a degraded\nservice, an absent one. The window grows with the number of files on disk, so\ngive readiness and liveness probes an initial delay that reflects a full cache,\nnot an empty one."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Scale in slowly, and prefer fewer larger replicas."}]," Removing a replica throws\naway a warm fast tier that took hours to fill, and the actions that would have\nhit it now go to the slow store. The CAS is the opposite of the worker pool\nhere: generous, patient, and biased toward vertical growth."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":["Only then consider ","$L6b"]}],", and only if a single shared backend is provably\nthe ceiling. Re-read the cache-flush warning above before you commit to a shard\ncount."]}]}]]}]
49:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["Store size levels off below ",["$","code",null,{"children":"max_bytes"}]," and stays there, rather than sawing up\nto the limit on every write; that saw is ",["$","code",null,{"children":"evict_bytes"}]," being unset."]}],"\n",["$","li",null,{"children":"A cold build populates the fast tier and the next identical build reads almost\nentirely from it."}],"\n",["$","li",null,{"children":"Interrupting a large upload and resuming it resumes from where it stopped,\nnot from zero. If it restarts, affinity isn't working."}],"\n",["$","li",null,{"children":["An AC hit never resolves to a missing blob. If it does, add\n",["$","code",null,{"children":"completeness_checking"}],"."]}],"\n",["$","li",null,{"children":"Restarting a replica does not fail client requests; it fails readiness first,\nand the load balancer takes it out before it stops answering."}],"\n",["$","li",null,{"children":"Disk usage on each replica's fast tier is bounded and roughly equal."}],"\n"]}]}]]}]
