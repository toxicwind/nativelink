6e:["$","$L6d",null,{"title":"Cache dashboards are empty even though the CAS is busy","id":"cache-dashboards-are-empty-even-though-the-cas-is-busy","children":["$","p",null,{"children":["The OpenTelemetry cache instruments only fire from inside the ",["$","code",null,{"children":"cache_metrics"}],"\nwrapper store, and no shipped config uses it. Wrap the store you want to observe\nand give it a ",["$","code",null,{"children":"cache_type"}],". The recording rules will start evaluating against\nreal series immediately afterwards."]}]}]
6f:["$","$L6d",null,{"title":"A memory fast tier never seems to hold anything","id":"a-memory-fast-tier-never-seems-to-hold-anything","children":["$","p",null,{"children":["A memory store skips any write at or above its own ",["$","code",null,{"children":"max_bytes"}],", logging rather\nthan erroring, and the blob is served from the backing store instead. If your\nblobs are larger than the tier, raise ",["$","code",null,{"children":"max_bytes"}]," or put a ",["$","code",null,{"children":"size_partitioning"}],"\nstore in front so only small objects are routed there."]}]}]
70:["$","$L6d",null,{"title":"Throughput to a remote gRPC store plateaus well below the network","id":"throughput-to-a-remote-grpc-store-plateaus-well-below-the-network","children":["$","p",null,{"children":[["$","code",null,{"children":"connections_per_endpoint"}]," defaults to 1, so everything multiplexes over one\nHTTP/2 connection. Raise it, and check ",["$","code",null,{"children":"max_concurrent_requests"}],"; a value of\nzero is unlimited, but a low non-zero value queues requests silently."]}]}]
