4b:["$","p",null,{"children":[["$","strong",null,{"children":"File descriptors, at 80% of what you configured."}]," ",["$","code",null,{"children":"global.max_open_files"}],"\ndefaults to 24576, and the process reserves a fifth of it for sockets and pipes,\nso the effective permit budget is about 19660."]}]
4c:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/fs.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/fs.rs","data-source-ref":"v1.6.5","title":"forge-util/src/fs.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"DEFAULT_OPEN_FILE_LIMIT"]}]
4d:["$","p",null,{"children":["Every filesystem operation that goes through the store's file helpers takes a\npermit, including metadata-only ones such as ",["$","code",null,{"children":"metadata"}],", ",["$","code",null,{"children":"read_dir"}]," and\n",["$","code",null,{"children":"rename"}],". (The startup scan is the exception: it holds one permit for the\ndirectory handle and runs its 200-way parallel ",["$","code",null,{"children":"stat"}]," outside the semaphore.)\nNetwork sockets are ",["$","em",null,{"children":"not"}]," counted by this semaphore but ",["$","em",null,{"children":"are"}]," counted by the\nkernel, so the kernel's limit must exceed ",["$","code",null,{"children":"max_open_files"}]," plus your expected\nconnection count."]}]
4e:["$","p",null,{"children":[["$","strong",null,{"children":"One connection per gRPC endpoint."}]," A ",["$","code",null,{"children":"grpc"}]," store's\n",["$","code",null,{"children":"connections_per_endpoint"}]," defaults to ",["$","code",null,{"children":"1"}],", so all traffic to a remote store\nmultiplexes over a single HTTP/2 connection. On a busy CAS-of-a-CAS topology\nthis is usually the first thing to raise."]}]
4f:["$","p",null,{"children":[["$","strong",null,{"children":"Redis permits and pool size."}]," ",["$","code",null,{"children":"max_client_permits"}]," defaults to 500 in-flight\noperations and ",["$","code",null,{"children":"connection_pool_size"}]," to 3. The permit cap exists specifically\nto stop timeouts from unbounded in-flight work, so raise it deliberately rather\nthan reflexively."]}]
50:["$","p",null,{"children":[["$","strong",null,{"children":"Object-store upload concurrency."}]," ",["$","code",null,{"children":"multipart_max_concurrent_uploads"}],"\ndefaults to 10 per request, with a 5 MB retry buffer per request."]}]
51:["$","p",null,{"children":[["$","strong",null,{"children":"Message size, which is not a blob size limit."}]," The HTTP listener's\n",["$","code",null,{"children":"max_decoding_message_size"}]," defaults to 4 MiB and bounds a single decoded gRPC\nmessage, so it caps ",["$","code",null,{"children":"BatchUpdateBlobs"}],", not ByteStream. No\nconfiguration anywhere caps how large a blob a CAS will accept over\nByteStream. Capacity is bounded by eviction and disk, not by an upload check."]}]
