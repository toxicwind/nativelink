2a:["$","p",null,{"children":["The store graph is where most capacity problems are solved, and it is cheaper\nthan adding processes because it changes nothing about consistency.\n",["$","$L1b",null,{"href":"/how-to/stores/compose-stores","children":"Compose stores"}]," is the reference for the\nwrappers; what follows is which one relieves which pressure."]}]
2b:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Pressure"}],["$","th",null,{"children":"Layer"}],["$","th",null,{"children":"What it buys"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Disk is full"}],["$","td",null,{"children":["$","code",null,{"children":"compression"}]}],["$","td",null,{"children":["LZ4 on the slow tier. It is the only algorithm the ",["$","code",null,{"children":"compression"}]," store offers (zstd exists only as REAPI wire compression on the ",["$","code",null,{"children":"grpc"}]," store)."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Disk is full, inputs are similar"}],["$","td",null,{"children":["$","code",null,{"children":"dedup"}]}],["$","td",null,{"children":"Content-defined chunking, 64 KiB to 512 KiB, so near-identical blobs share chunks."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Reads are slow"}],["$","td",null,{"children":["$","code",null,{"children":"fast_slow"}]}],["$","td",null,{"children":"A local hot tier in front of object storage or Redis."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Small blobs dominate request count"}],["$","td",null,{"children":["$","code",null,{"children":"size_partitioning"}]}],["$","td",null,{"children":"Route small objects to memory, large ones elsewhere."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"One backend is the ceiling"}],["$","td",null,{"children":["$","code",null,{"children":"shard"}]}],["$","td",null,{"children":"Spread keys across several backends by hash."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"FindMissingBlobs"}]," is hot"]}],["$","td",null,{"children":["$","code",null,{"children":"existence_cache"}]}],["$","td",null,{"children":"Answer existence without touching the backend; single process only."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"AC hits point at missing blobs"}],["$","td",null,{"children":["$","code",null,{"children":"completeness_checking"}]}],["$","td",null,{"children":"Re-check the CAS on every AC read."}]]}]]}]]}]}]
