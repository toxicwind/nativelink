\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"    backend"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": {"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#6A737D","--shiki-dark":"#6A737D"},"children":"      // the composition you would otherwise have written here"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"    },"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"  },"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"},"}]}]]}]}]}]
59:["$","p",null,{"children":["Wrap the layer whose behaviour you want to see, and give each one a distinct\n",["$","code",null,{"children":"cache_type"}],"; the recording rules group by it."]}]
5a:["$","p",null,{"children":[["$","code",null,{"children":"deployment-examples/metrics/prometheus-recording-rules.yml"}]," defines a\n",["$","code",null,{"children":"forge_cache"}]," group that is genuinely useful once metrics are flowing:\n",["$","code",null,{"children":"forge:cache_hit_rate"}],", latency at p50/p95/p99,\n",["$","code",null,{"children":"forge:cache_eviction_rate"}],", read and write throughput, and\n",["$","code",null,{"children":"forge:cache_error_rate"}],". The same group also defines\n",["$","code",null,{"children":"forge:cache_size_bytes"}]," and ",["$","code",null,{"children":"forge:cache_entry_count"}],", which are\nbuilt on the two instruments nothing emits and will stay empty."]}]
5b:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Recording rules exist; alerts on them do not"}],["$","p",null,{"children":["The shipped alert rules cover cache miss rate and eviction rate only. Nothing\nalerts on read latency, on throughput collapse, or on\n",["$","code",null,{"children":"forge:cache_error_rate"}],"; write those yourself. No emitted\nsize metric exists to alert on at all, so size-approaching-",["$","code",null,{"children":"max_bytes"}]," has to come\nfrom disk usage on the host rather than from Forge."]}]]}]]}]
5c:["$","p",null,{"children":[["$","$L1b",null,{"href":"/operate/observability","children":"Observability"}]," covers getting the telemetry out of the\nprocess at all, which is the prerequisite for any of this."]}]
5d:["$","$L1c",null,{"as":"h2","id":"what-the-repository-actually-ships","children":"What the repository actually ships"}]
5e:["$","p",null,{"children":"Being explicit, because the gap between the examples and a production CAS is\nwide."}]
5f:["$","p",null,{"children":[["$","strong",null,{"children":"Every shipped deployment runs exactly one CAS process."}]," The docker-compose\nsingle-node example, the multi-worker compose example, and the Kubernetes\nmanifest all have one. ",["$","code",null,{"children":"docker-compose-multi-worker.yml"}]," replicates ",["$","em",null,{"children":"workers"}],"\nagainst one ",["$","code",null,{"children":"cas-server"}],"; the only thing replicated anywhere in the repository\nis the worker pool."]}]
60:["$","p",null,{"children":[["$","strong",null,{"children":"No multi-replica CAS example exists"}],", no load balancer or Service fronting\nseveral CAS pods, no HPA for the CAS, and no readiness gate accounting for the\nstartup scan. Anyone scaling the CAS horizontally is operating outside every\npath this repository exercises."]}]
61:["$","p",null,{"children":[["$","strong",null,{"children":"The Kubernetes example stores the CAS in the container."}],"\n",["$","code",null,{"children":"kubernetes/forge/forge.yaml"}]," is a single Deployment with\n",["$","code",null,{"children":"replicas: 1"}],", and its filesystem store points at a path under ",["$","code",null,{"children":"/tmp"}]," inside the\ncontainer: no PersistentVolumeClaim, no StatefulSet, not even an ",["$","code",null,{"children":"emptyDir"}],".\nEvery pod restart wipes the CAS and the AC. It is a demo topology, and the\ncomposition inside its config is worth reading even though the storage isn't."]}]
62:["$","p",null,{"children":[["$","strong",null,{"children":"Sharding has no deployment example."}]," The only ",["$","code",null,{"children":"shard"}]," block in the tree is a\nsingle-shard entry in a config-parser coverage fixture, which exercises no\ndistribution behaviour at all."]}]
63:["$","p",null,{"children":[["$","strong",null,{"children":["The ",["$","code",null,{"children":"cas-data"}]," volume in the multi-worker compose file is vestigial."]}]," It is\nmounted into the CAS server and into all three workers at the same path, but the\nworkers' config points their fast tier somewhere else entirely and reaches the\nCAS over gRPC. Don't read that mount as an endorsement of sharing a filesystem\nstore directory between processes; it isn't one."]}]
64:["$","$L1c",null,{"as":"h2","id":"when-it-doesnt-work","children":"When it doesn't work"}]
65:["$","$L6c",null,{"children":[["$","$L6d",null,{"title":"Disk usage sits exactly at max_bytes and write latency is spiky","id":"disk-usage-sits-exactly-at-max_bytes-and-write-latency-is-spiky","children":["$","p",null,{"children":["That's the ",["$","code",null,{"children":"evict_bytes: 0"}]," thrash. With no low watermark, every write pushes\nthe store over the limit and re-enters the eviction loop to remove the minimum.\nSet ",["$","code",null,{"children":"evict_bytes"}]," to a real fraction of ",["$","code",null,{"children":"max_bytes"}],", enough that a burst of\nwrites fits under the headroom it creates."]}]}],["$","$L6d",null,{"title":"The store is over quota but nothing is being evicted","id":"the-store-is-over-quota-but-nothing-is-being-evicted","children":["$","p",null,{"children":["Eviction is triggered by inserts and removals; there is no background timer. A\nstore that went over quota and then went idle stays over quota. Writes will\nbring it back down. If the store is idle because clients moved elsewhere, the\nspace is only reclaimed by restarting with a lower ",["$","code",null,{"children":"max_bytes"}]," or by clearing\nthe path directly."]}]}],["$","$L6d",null,{"title":"Large uploads restart from the beginning","id":"large-uploads-restart-from-the-beginning","children":["$","p",null,{"children":["The upload registry is per process. If a client's ByteStream write and its\n",["$","code",null,{"children":"QueryWriteStatus"}]," resume land on different replicas, the second one has never\nheard of the upload and tells the client to start over. Enable session affinity\non the load balancer, keyed so a single client's stream stays on one replica."]}]}],["$","$L6d",null,{"title":"Bazel says a blob exists, then a later fetch can't find it","id":"bazel-says-a-blob-exists-then-a-later-fetch-cant-find-it","children":["$","p",null,{"children":["An ",["$","code",null,{"children":"existence_cache"}]," served a stale positive. It caches \"digest present\" in\nmemory, and unless the backend is Redis with keyspace notifications on there\nis no cross-process invalidation, so it will keep answering yes after the blob\nwas removed underneath it. Remove the wrapper from any replicated\ndeployment, or accept the failure mode. ",["$","code",null,{"children":"completeness_checking"}]," on the AC path\ncatches the related case where an AC hit points at an evicted CAS blob."]}]}],["$","$L6d",null,{"title":"A restarted CAS refuses connections for minutes","id":"a-restarted-cas-refuses-connections-for-minutes","children":["$","p",null,{"children":["The filesystem store scans ",["$","code",null,{"children":"content_path"}]," and builds its eviction index before\nthe process binds a socket. The scan is O(files) (200-way parallel ",["$","code",null,{"children":"stat"}],", then\na serialized index build), so a large cache means a long window with nothing\nlistening. Raise your probes' initial delay to cover a full cache, and expect\nthe window to grow as the cache does."]}]}],["$","$L6d",null,{"title":"Two CAS processes point at the same content_path and files keep disappearing","id":"two-cas-processes-point-at-the-same-content_path-and-files-keep-disappearing","children":["$","p",null,{"children":"Each process builds an independent index at boot and each evicts against its\nown view, unlinking files the other still has indexed. No locking and\nno coordination exist. Give each process its own directory and share a slow tier\nunderneath instead."}]}],["$","$L6d",null,{"title":"Entries went missing after changing the shard list","id":"entries-went-missing-after-changing-the-shard-list","children":["$","p",null,{"children":"Shard placement is a hash into a cumulative weight table. Changing the number of\nshards or any weight moves the boundaries, so keys resolve to different shards\nthan the ones they were written to. The data is still on disk; nothing looks for\nit there. Treat the change as a cache flush."}]}],"$L6e","$L6f","$L70"]}]
66:["$","a",null,{"href":"/operate/autoscaling-reference","data-next-step":"next","className":"my-4 flex items-start gap-3 rounded-xl border px-5 py-4 no-underline transition-colors border-brand/40 bg-brand-soft/30 hover:border-brand/70","children":[["$","svg",null,{"width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-1 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M5 12h14m-6-6 6 6-6 6"}]}],["$","span",null,{"className":"flex-1","children":[["$","span",null,{"className":"block font-mono text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground","children":"Next"}],["$","span",null,{"className":"block font-semibold text-foreground","children":"An autoscaling reference deployment"}],["$","span",null,{"className":"mt-0.5 block text-sm text-muted-foreground","children":["$","p",null,{"children":"Both scaling axes assembled into one deployment: the manifests, the probes,\nthe drain path, and the reaction-time budget behind them."}]}]]}]]}]
