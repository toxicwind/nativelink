25:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Do not put `existence_cache` behind a load balancer"}],["$","p",null,{"children":"It is the most dangerous wrapper to replicate. It is safe on a single process\nand safe in front of a backend nothing else removes from; it is unsafe the\nmoment anything other than that process deletes from the shared backing\nstore, unless the backing store is Redis with keyspace notifications on. The\nfailure mode is a build that skips an upload and then can't find its own\nartifact."}]]}]]}]
26:["$","p",null,{"children":[["$","strong",null,{"children":"A filesystem store cannot share a directory."}]," Two processes pointed at the\nsame ",["$","code",null,{"children":"content_path"}]," each build their own index at boot and each unlink files the\nother believes it owns. This is not a supported configuration."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":"Read deduplication is intra-process only."}]," ",["$","code",null,{"children":"fast_slow"}]," collapses concurrent\nreads of the same digest into a single fetch from the slow tier, but only within one\nprocess. Three replicas asking for the same cold blob at once make three\nrequests to S3."]}]
28:["$","p",null,{"children":"It has no leader election, no gossip, no Raft or quorum protocol, no etcd and\nno ZooKeeper anywhere in Forge. Replicas are independent processes, and any\ncoordination between them has to come from the semantics of the shared backing\nstore you point them at."}]
