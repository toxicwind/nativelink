f:["$","$L17",null,{"toc":[{"depth":2,"url":"#start-here-a-cas-process-is-not-stateless","title":"Start here: a CAS process is not stateless"},{"depth":2,"url":"#scale-vertically-first-by-composing","title":"Scale vertically first, by composing"},{"depth":2,"url":"#eviction-is-your-capacity-control-and-its-default-thrashes","title":"Eviction is your capacity control, and its default thrashes"},{"depth":3,"url":"#size-the-ac-and-the-cas-together","title":"Size the AC and the CAS together"},{"depth":2,"url":"#sharding-and-what-changing-it-costs","title":"Sharding, and what changing it costs"},{"depth":2,"url":"#going-horizontal","title":"Going horizontal"},{"depth":2,"url":"#the-ceilings-you-hit-before-you-expect-to","title":"The ceilings you hit before you expect to"},{"depth":2,"url":"#metrics-nothing-is-on-by-default","title":"Metrics: nothing is on by default"},{"depth":2,"url":"#what-the-repository-actually-ships","title":"What the repository actually ships"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Scaling the CAS"}],["$","$L19",null,{"children":"How to grow the content-addressable store: composing tiers, sizing eviction, sharding, and the specific reasons a second CAS replica is harder than a second worker."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," you run a CAS that real builds depend on, and it is\nrunning out of disk, running out of throughput, or both. ",["$","strong",null,{"children":"What you'll have at\nthe end:"}]," a store composition sized for your load, an eviction policy that\ndoesn't thrash, and a clear-eyed view of what running more than one CAS process\ncosts. ",["$","strong",null,{"children":"Time:"}]," an afternoon to size and tune; longer if you go horizontal."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":"A CAS that real builds depend on."}]}]]}],"\n",["$","p",null,{"children":[["$","$L1b",null,{"href":"/operate/scaling-workers","children":"Scaling workers"}]," is the straightforward half of capacity. This\nis the other half, and it is a different problem: a worker holds nothing, so\nadding one is free. The CAS holds everything, so adding one is a design\ndecision."]}],"\n",["$","$L1c",null,{"as":"h2","id":"start-here-a-cas-process-is-not-stateless","children":"Start here: a CAS process is not stateless"}],"\n",["$","p",null,{"children":"Most guidance about scaling services assumes replicas are interchangeable. For\nForge's CAS that assumption is wrong in five specific places, and every\nhorizontal-scaling decision on this page follows from them."}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"In-flight resumable uploads live in one process."}]," The ByteStream service\nkeeps a registry of active uploads keyed by the upload's UUID, in memory, per\nprocess."]}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/bytestream_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/bytestream_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/bytestream_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":"$L1d"}],"ByteStreamServer"]}],"\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b","\n","$L5c","\n","$L5d","\n","$L5e","\n","$L5f","\n","$L60","\n","$L61","\n","$L62","\n","$L63","\n","$L64","\n","$L65","\n","$L66","\n","$L67"]}],"$L68"]}]
