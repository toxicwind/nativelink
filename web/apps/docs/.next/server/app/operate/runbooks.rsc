34:["$","p",null,{"children":["Writes start failing with an OS-level message wrapped in a Forge err_tip:\n",["$","code",null,{"children":"Failed to write data into filesystem store"}],", ",["$","code",null,{"children":"Failed to flush in filesystem store"}],", ",["$","code",null,{"children":"Failed to sync in filesystem store"}],"."]}]
35:["$","p",null,{"children":["The gRPC code will be ",["$","code",null,{"children":"Unknown"}],", ",["$","strong",null,{"children":"not"}]," anything storage-shaped. ",["$","code",null,{"children":"ENOSPC"}],"\narrives as ",["$","code",null,{"children":"ErrorKind::StorageFull"}],", which Forge's ",["$","code",null,{"children":"io::ErrorKind"}]," to\ngRPC-code map does not name, so it falls to the catch-all arm. No\nENOSPC-specific handling exists anywhere in the tree."]}]
