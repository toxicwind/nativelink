30:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Change"}],["$","th",null,{"children":"Where"}],["$","th",null,{"children":"Effect"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["Lower ",["$","code",null,{"children":"max_inflight_tasks"}]]}],["$","td",null,{"children":"worker config"}],["$","td",null,{"children":["Caps concurrent actions per worker. Defaults to ",["$","code",null,{"children":"0"}],", which means ",["$","strong",null,{"children":"infinite"}],"; one worker will happily run every action you send it. This is the single most effective knob."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Raise the container memory limit"}],["$","td",null,{"children":["Kubernetes ",["$","code",null,{"children":"resources.limits.memory"}],", or the host"]}],["$","td",null,{"children":"Named explicitly by the worker's own warning."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Reduce per-action concurrency"}],["$","td",null,{"children":"Your build's toolchain flags"}],["$","td",null,{"children":["A single ",["$","code",null,{"children":"-j"}]," in a wrapped compiler multiplies with ",["$","code",null,{"children":"max_inflight_tasks"}],"."]}]]}]]}]]}]}]
31:["$","p",null,{"children":["Forge itself has ",["$","strong",null,{"children":"no memory configuration"}],". No ",["$","code",null,{"children":"max_memory"}],", no\nper-action memory cap, nothing. Memory is bounded only indirectly, by store\neviction policies and by whatever the container runtime enforces. Do not go\nlooking for a config field; it does not exist."]}]
