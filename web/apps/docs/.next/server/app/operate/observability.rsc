rape path)"]}],["$","td",null,{"children":["$","$L1d",null,{"href":"#what-happens-if-you-skip-the-collector","children":"Skip the collector"}]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"No execution or worker metrics, cache metrics fine"}],["$","td",null,{"children":"The collector endpoint is set on the CAS but not on the scheduler process"}],["$","td",null,{"children":["Set ",["$","code",null,{"children":"NL_OTEL_ENDPOINT"}]," on the scheduler; those families are emitted from it alone"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"forge_worker_*"}]," or ",["$","code",null,{"children":"forge_rpc_*"}]," series missing entirely"]}],["$","td",null,{"children":"The binary is older than the release these families were added in"}],["$","td",null,{"children":["Upgrade to v1.6.5; the ",["$","$L1d",null,{"href":"/reference/metrics#every-instrument-at-a-glance","children":"metrics reference"}]," is generated from the version it names"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Cache-size panels flat at zero"}],["$","td",null,{"children":"Those instruments are never emitted"}],["$","td",null,{"children":["$","$L1d",null,{"href":"/reference/metrics#declared-but-never-emitted","children":"Declared but never emitted"}]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"out of order sample"}]," in Prometheus logs"]}],["$","td",null,{"children":["Multiple processes with restart-fresh ",["$","code",null,{"children":"service.instance.id"}]]}],["$","td",null,{"children":["Raise ",["$","code",null,{"children":"storage.tsdb.out_of_order_time_window"}]," in ",["$","code",null,{"children":"prometheus.yml"}]," (the shipped Kubernetes config sets 30m)"]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Metrics stop when a worker OOMs and returns"}],["$","td",null,{"children":["Expected; the new process gets a new ",["$","code",null,{"children":"service.instance.id"}]]}],["$","td",null,{"children":["Aggregate away from ",["$","code",null,{"children":"service_instance_id"}]," in your queries"]}]]}]]}]]}]}]
