5d:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":[["$","p",null,{"children":[["$","code",null,{"children":"curl http://localhost:13133/health"}]," returns healthy. The collector's\npipeline check is on, so this also fails when its exporters are failing."]}],["$","p",null,{"children":[["$","code",null,{"children":"curl -s http://localhost:8888/metrics | grep otelcol_receiver_accepted_metric_points"}],"\nis non-zero and climbing. If it is zero, Forge is not reaching the\ncollector."]}],["$","p",null,{"children":[["$","code",null,{"children":"curl -s http://localhost:9090/metrics | grep forge_execution"}]," shows\nseries on the collector's exporter, with the ",["$","code",null,{"children":"forge_"}]," prefix present."]}],["$","p",null,{"children":["In Prometheus at ",["$","code",null,{"children":"http://localhost:9091"}],", ",["$","code",null,{"children":"forge_execution_queue_time_bucket"}],"\nreturns data after one build."]}],["$","p",null,{"children":["If the ",["$","code",null,{"children":"forge_cache_*"}]," series are missing but ",["$","code",null,{"children":"forge_execution_*"}],"\nare present, no store is wrapped in ",["$","code",null,{"children":"cache_metrics"}],"."]}]]}]]}]
