,null,{"children":["Applies to the stdout layer ",["$","strong",null,{"children":"and"}]," to all three OTLP layers. ",["$","code",null,{"children":"hyper"}],", ",["$","code",null,{"children":"tonic"}],", ",["$","code",null,{"children":"h2"}],", ",["$","code",null,{"children":"reqwest"}]," and ",["$","code",null,{"children":"tower"}]," are forced off afterwards and cannot be re-enabled."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"NL_LOG"}]}],["$","td",null,{"children":["$","code",null,{"children":"pretty"}]}],["$","td",null,{"children":["Stdout log format. ",["$","code",null,{"children":"compact"}]," and ",["$","code",null,{"children":"json"}]," are recognised; any other value silently falls back to ",["$","code",null,{"children":"pretty"}],"."]}]]}]]}]]}]}]
