l,{"children":[["$","td",null,{"children":["$","code",null,{"children":"TimeoutStopSec"}]}],["$","td",null,{"children":"worker unit"}],["$","td",null,{"children":["On ",["$","code",null,{"children":"SIGTERM"}]," the worker rejects new actions, waits for in-flight ones to finish, then tells the scheduler it is going away and exits. If this timer fires first, systemd ",["$","code",null,{"children":"SIGKILL"}],"s it and every in-flight action fails and re-queues."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"NL_LOG"}]}],["$","td",null,{"children":"environment"}],["$","td",null,{"children":[["$","code",null,{"children":"json"}]," if anything is ingesting these logs. Any unrecognised value silently falls back to ",["$","code",null,{"children":"pretty"}],"; see ",["$","$L6",null,{"href":"/reference/cli-and-env","children":"CLI and environment"}],"."]}]]}]]}]]}]}]
