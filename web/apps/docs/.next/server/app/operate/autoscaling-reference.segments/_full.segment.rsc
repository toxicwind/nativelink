1f:["$","p",null,{"children":["Everything on this page is written by these docs against the shipped\nconfiguration schema and the shipped recording rules. It is a worked reference,\nnot a file you can point ",["$","code",null,{"children":"kubectl apply"}]," at from a checkout. Treat the YAML as\na starting shape you adapt, and read the ",["$","$L1b",null,{"href":"#five-gaps-you-close-first","children":"prerequisites"}],"\nsection before you assume any of it drops onto the shipped manifests unchanged."]}]
20:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Read the reaction-time budget before you tune thresholds"}],["$","p",null,{"children":"The default pipeline puts up to two and a half minutes between a queue spike\nand an HPA that can see it. Most of that is fixable, and none of it is\ndocumented anywhere else. It is the next section, and it is the single thing\nmost likely to make a correct-looking autoscaler behave badly."}]]}]]}]
21:["$","$L1c",null,{"as":"h2","id":"the-reaction-time-budget","children":"The reaction-time budget"}]
22:["$","p",null,{"children":"The signal an autoscaler reads is not emitted by Forge. It is derived,\nseveral hops downstream, and each hop adds staleness. Here is the whole chain\nwith its shipped defaults."}]
23:["$","$L4e",null,{"children":"flowchart LR\nA[\"Forge<br/>OTLP periodic export<br/><b>60s default</b>\"] --> B[\"OTel collector<br/>batch processor<br/><b>up to 10s</b>\"]\nB --> C[\"Prometheus<br/>scrape_interval<br/><b>15s</b>\"]\nC --> D[\"recording rule<br/>forge:queue_depth<br/><b>60s group interval</b>\"]\nD --> E[\"HPA sync loop<br/><b>15s default</b>\"]"}]
24:["$","p",null,{"children":"Worst case, an action that queues right after an export window closes is\ninvisible to the HPA for about two and a half minutes. Then the HPA's own\nstabilization window applies on top."}]
25:["$","p",null,{"children":"Three of those five hops are yours to fix and two are not worth fixing."}]
26:["$","p",null,{"children":[["$","strong",null,{"children":"The export interval is the big one, and it is an environment variable."}]," The\nbinary builds its meter provider with a periodic exporter and never sets an\ninterval, so it takes the OpenTelemetry SDK default of 60 seconds. Set\n",["$","code",null,{"children":"OTEL_METRIC_EXPORT_INTERVAL"}]," on the scheduler pod to bring it down."]}]
27:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/telemetry.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/telemetry.rs","data-source-ref":"v1.6.5","title":"forge-util/src/telemetry.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"init_tracing"]}]
28:["$","p",null,{"children":[["$","strong",null,{"children":"The recording-rule interval is the second."}]," ",["$","code",null,{"children":"forge:queue_depth"}]," lives in\nthe ",["$","code",null,{"children":"forge_performance"}]," group in\n",["$","code",null,{"children":"deployment-examples/metrics/prometheus-recording-rules.yml"}],", and that group is\ndeclared ",["$","code",null,{"children":"interval: 60s"}],". The execution group next to it uses 30s. Either move\nthe rule into a group with a short interval, or skip the recording rule for\nscaling and point the adapter at the raw series."]}]
29:["$","p",null,{"children":[["$","strong",null,{"children":"The collector batch timeout"}]," is 10 seconds in the shipped collector config\nand is not worth chasing; it overlaps the scrape interval anyway."]}]
2a:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$20:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Do not simply drop the export interval to a few seconds"}],["$","p",null,{"children":"Every export is a full OTLP push of every instrument. At 5 seconds you are\nmultiplying collector ingest and Prometheus sample volume by twelve for a\nsignal you are going to smooth with a stabilization window regardless. Fifteen\nseconds is a good default and the point of diminishing returns for most pools."}]]}]]}]
2b:["$","$L1c",null,{"as":"h2","id":"five-gaps-you-close-first","children":"Five gaps you close first"}]
2c:["$","p",null,{"children":"The shipped Kubernetes manifests cannot support an HPA as they stand. Not\nbecause of anything subtle, but because of five specific absences. Each one is a\nshort fix and all five are prerequisites."}]
2d:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Gap"}],["$","th",null,{"children":"Where"}],["$","th",null,{"children":"Why it blocks autoscaling"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["No ",["$","code",null,{"children":"resources:"}]," block on the worker container"]}],["$","td",null,{"children":["$","code",null,{"children":"kubernetes/components/worker/worker.yaml"}]}],["$","td",null,{"children":["A ",["$","code",null,{"children":"Resource"}],"-type HPA metric cannot compute utilization without requests. Scheduling is also unbounded."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"servers: []"}]," in every worker config"]}],["$","td",null,{"children":[["$","code",null,{"children":"kubernetes/components/worker/worker.json5"}],", both compose worker configs"]}],["$","td",null,{"children":"A worker process listens on nothing, so there is no port and no path for a readiness or liveness probe."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["No ",["$","code",null,{"children":"admin: {}"}]," in any ",["$","code",null,{"children":"kubernetes/"}]," config"]}],["$","td",null,{"children":["$","code",null,{"children":"kubernetes/forge/forge-config.json5"}]}],["$","td",null,{"children":"The drain endpoint is never registered. Scale-in has no graceful path."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"No probes on any Forge pod"}],["$","td",null,{"children":"all shipped manifests"}],["$","td",null,{"children":"Traffic reaches a CAS that is still doing its startup scan, and rollouts have nothing to gate on."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["No PDB, ",["$","code",null,{"children":"preStop"}],", or ",["$","code",null,{"children":"terminationGracePeriodSeconds"}]]}],["$","td",null,{"children":"all shipped manifests"}],["$","td",null,{"children":"A scale-in or node drain kills workers mid-action on the default 30-second grace."}]]}]]}]]}]}]
2e:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/cas_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/cas_server.rs","data-source-ref":"v1.6.5","title":"forge-config/src/cas_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"AdminConfig"]}]
2f:["$","$L1c",null,{"as":"h2","id":"the-health-endpoint-does-less-than-you-expect","children":"The health endpoint does less than you expect"}]
30:["$","p",null,{"children":["Before you write a readiness probe, understand what ",["$","code",null,{"children":"/status"}]," actually\nmeasures, because the answer is surprising in both directions."]}]
31:["$","p",null,{"children":["Health indicators are registered ",["$","strong",null,{"children":"only by leaf stores"}],": memory, filesystem,\nS3, GCS, Azure, Redis, and Mongo. Every composing store (",["$","code",null,{"children":"existence_cache"}],",\n",["$","code",null,{"children":"verify"}],", ",["$","code",null,{"children":"fast_slow"}],", ",["$","code",null,{"children":"size_partitioning"}],", ",["$","code",null,{"children":"compression"}],", ",["$","code",null,{"children":"dedup"}],", ",["$","code",null,{"children":"shard"}],",\n",["$","code",null,{"children":"completeness_checking"}],", ",["$","code",null,{"children":"ref_store"}],") inherits the trait's default\n",["$","code",null,{"children":"register_health"}],", which does nothing and does ",["$","strong",null,{"children":"not"}]," recurse into its\nchildren. The single exception is ",["$","code",null,{"children":"cache_metrics"}],", which forwards registration\nto its backend."]}]
32:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/store_trait.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/store_trait.rs","data-source-ref":"v1.6.5","title":"forge-util/src/store_trait.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"StoreDriver"]}]
33:["$","p",null,{"children":["That has a sharp consequence. In the shipped Kubernetes config, ",["$","code",null,{"children":"CAS_MAIN_STORE"}],"\nis an ",["$","code",null,{"children":"existence_cache"}]," at the top and ",["$","code",null,{"children":"AC_MAIN_STORE"}]," is a\n",["$","code",null,{"children":"completeness_checking"}]," at the top. Neither registers anything. The health\nregistry is empty, ",["$","code",null,{"children":"/status"}]," serialises an empty list, and the endpoint returns\n",["$","code",null,{"children":"200 OK"}]," unconditionally, including when the filesystem underneath is gone."]}]
34:["$","p",null,{"children":["Now the other direction. When a leaf store ",["$","em",null,{"children":"is"}]," at the top of a composition,\nwhat the check costs depends on which leaf it is. The filesystem store (the\ncompose example's ",["$","code",null,{"children":"AC_MAIN_STORE"}]," is a bare ",["$","code",null,{"children":"filesystem"}],") only ",["$","code",null,{"children":"stat"}],"s its\n",["$","code",null,{"children":"content_path"}],", with a two-second ceiling. GCS does a single ",["$","code",null,{"children":"object_exists"}],"\non a fixed never-present key, Redis sends ",["$","code",null,{"children":"PING"}]," under\n",["$","code",null,{"children":"health_check_timeout_ms"}],", and Mongo pings the database. Memory, S3 and Azure\nfall back to the trait's default, which is a full round trip: it generates\none megabyte of deterministic data, writes it with ",["$","code",null,{"children":"update_oneshot"}],", calls\n",["$","code",null,{"children":"has"}],", reads it back, and compares."]}]
35:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/store_trait.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/store_trait.rs","data-source-ref":"v1.6.5","title":"forge-util/src/store_trait.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"check_health"]}]
36:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-store/src/filesystem_store.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-store/src/filesystem_store.rs","data-source-ref":"v1.6.5","title":"forge-store/src/filesystem_store.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"check_health"]}]
37:["$","p",null,{"children":"The digest is seeded from the store name, so it is the same blob every time and\nthe store does not grow. But against S3 or Azure that is a PUT, a HEAD and a\nGET of a megabyte on every probe, per store, per replica. At a ten-second\nprobe period on three replicas that is eighteen megabytes a minute of pure\nprobe traffic and a billable request count to match."}]
38:["$","p",null,{"children":[["$","code",null,{"children":"global.default_digest_size_health_check"}]," lowers the payload. The round trip\nitself you cannot turn off short of not enabling the health service. Whatever\nthe probe, the endpoint returns ",["$","code",null,{"children":"503"}]," if any registered indicator reports\n",["$","code",null,{"children":"failed"}]," or ",["$","code",null,{"children":"timeout"}]," (",["$","code",null,{"children":"HealthConfig.timeout_seconds"}],", default 5 s, bounds\neach check) and ",["$","code",null,{"children":"200"}]," otherwise."]}]
39:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":"$f:props:children:2:props:children:7:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"What to actually do"}],["$","p",null,{"children":["Enable ",["$","code",null,{"children":"health: {}"}]," and probe it, but size the probe honestly: a period of 30\nseconds or more on any process whose top-level store does the round trip,\nand ",["$","code",null,{"children":"default_digest_size_health_check"}]," reduced to something like 65536\nunless you specifically want the megabyte to exercise multipart paths. And\ndo not read a ",["$","code",null,{"children":"200"}]," from a composed store as \"the store works\"; it means\n\"nothing objected,\" which for most compositions is vacuous."]}]]}]]}]
3a:["$","$L1c",null,{"as":"h2","id":"readiness-is-a-different-question","children":"Readiness is a different question"}]
3b:["$","p",null,{"children":[["$","code",null,{"children":"/status"}]," answers whether the components that registered a health indicator\nhave failed. It stays ",["$","code",null,{"children":"200"}]," while a component is still initializing, which is\nthe right answer for a liveness probe and the wrong one for readiness. The\n",["$","code",null,{"children":"health"}]," service therefore also serves ",["$","code",null,{"children":"/ready"}]," (",["$","code",null,{"children":"readiness_path"}],", default\n",["$","code",null,{"children":"/ready"}],"), which answers ",["$","code",null,{"children":"503"}]," while anything is initializing or failed and\n",["$","code",null,{"children":"200"}]," otherwise."]}]
3c:["$","p",null,{"children":["For a worker, the component that matters is its registration with the\nscheduler. Each worker registers a ",["$","code",null,{"children":"workers/<name>"}]," indicator that reads\n",["$","code",null,{"children":"Initializing"}]," until the scheduler has answered its ",["$","code",null,{"children":"connect_worker"}]," with a\n",["$","code",null,{"children":"ConnectionResult"}],", ",["$","code",null,{"children":"Ok"}]," while that connection holds, and ",["$","code",null,{"children":"Initializing"}],"\nagain after it is lost and the worker is reconnecting, so only ",["$","code",null,{"children":"/ready"}],"\ndrops: a liveness probe on ",["$","code",null,{"children":"/status"}]," stays green through a scheduler roll\ninstead of restarting every worker. A Kubernetes readiness probe on the\nworker's ",["$","code",null,{"children":"/ready"}]," turns the pod Ready when the worker can take work rather\nthan when its container started, and turns it not Ready again if it loses\nthe scheduler. Anything that reads pod readiness, an autoscaler's idle clock\nincluded, then counts from registration."]}]
