45:["$","p",null,{"children":[["$","strong",null,{"children":"It does not scale the CAS or the scheduler."}]," Both are single-replica in this\nreference. The scheduler's default backend is in-memory, so a second scheduler\nis a second independent queue, not a bigger one."]}]
46:["$","p",null,{"children":[["$","strong",null,{"children":"It does not do predictive or scheduled scaling."}]," Queue depth is reactive by\nconstruction: pods start after work is already waiting. If your builds arrive on\na known schedule, a ",["$","code",null,{"children":"CronJob"}]," that raises ",["$","code",null,{"children":"minReplicas"}]," before the wave beats any\nmetric-driven policy."]}]
