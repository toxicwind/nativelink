rker node evicts at most half the pool at once."]}],"\n",["$","li",null,{"children":["Restarting the CAS produces a pod that stays ",["$","code",null,{"children":"NotReady"}]," for the duration of\nits scan and then goes ",["$","code",null,{"children":"Ready"}]," once, not a ",["$","code",null,{"children":"CrashLoopBackOff"}],"."]}],"\n"]}]}]]}]
