b:["$","p",null,{"children":[["$","strong",null,{"children":"The scheduler owns no storage."}]," It reaches the CAS through ",["$","code",null,{"children":"grpc"}]," stores, the\nsame way a client would. That is why you can restart it without losing blobs, and\nwhy it needs no volume."]}]
c:["$","p",null,{"children":[["$","strong",null,{"children":"The worker also owns no durable storage."}]," Its local disk is a read cache in\nfront of the CAS, not a source of truth. A worker can be deleted mid-action; the\nscheduler retries the action elsewhere."]}]
d:["$","p",null,{"children":[["$","strong",null,{"children":"Only the CAS process is stateful."}]," It is the one thing you back up, size for\ngrowth, and think carefully about before restarting."]}]
