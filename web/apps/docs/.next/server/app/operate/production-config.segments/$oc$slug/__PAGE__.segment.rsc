0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#the-shape","title":"The shape"},{"depth":2,"url":"#process-1--the-cas-and-action-cache","title":"Process 1: the CAS and Action Cache"},{"depth":3,"url":"#moving-off-local-disk","title":"Moving off local disk"},{"depth":2,"url":"#process-2--the-scheduler","title":"Process 2: the scheduler"},{"depth":2,"url":"#process-3--the-workers","title":"Process 3: the workers"},{"depth":2,"url":"#which-ports-are-public","title":"Which ports are public"},{"depth":2,"url":"#whats-durable-and-whats-disposable","title":"What's durable and what's disposable"},{"depth":2,"url":"#before-you-go-live","title":"Before you go live"},{"depth":3,"url":"#raise-the-file-descriptor-limit","title":"Raise the file-descriptor limit"},{"depth":3,"url":"#turn-on-namespaces-on-linux-workers","title":"Turn on namespaces on Linux workers"},{"depth":3,"url":"#put-tls-on-the-client-facing-listeners","title":"Put TLS on the client-facing listeners"},{"depth":3,"url":"#point-telemetry-somewhere","title":"Point telemetry somewhere"},{"depth":3,"url":"#opt-in-to-cache-metrics-if-you-want-them","title":"Opt in to cache metrics, if you want them"},{"depth":2,"url":"#what-to-watch","title":"What to watch"},{"depth":2,"url":"#what-to-tune","title":"What to tune"},{"depth":2,"url":"#what-to-do-when-it-breaks","title":"What to do when it breaks"},{"depth":2,"url":"#faq","title":"FAQ"}],"children":[["$","$L3",null,{"children":"Production configuration"}],["$","$L4",null,{"children":"The shape a real Forge cluster runs in: three processes, a split port surface, and what to turn on before other people depend on it."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," you have Forge working and now other people are going\nto depend on it. ",["$","strong",null,{"children":"What you'll have at the end:"}]," a three-process deployment\nwhose ports, state, and failure behaviour you can explain to someone else.\n",["$","strong",null,{"children":"Time:"}]," an afternoon, plus however long your change process takes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":"A working deployment that only you depend on."}]}]]}],"\n",["$","p",null,{"children":["A production configuration is not the quickstart configuration with bigger\nnumbers. It differs in one structural way: ",["$","strong",null,{"children":"the CAS, the scheduler, and the\nworkers become three separate processes."}]," Everything else on this page (the\nport split, the store composition, the hardening checklist) follows from that\none decision."]}],"\n",["$","p",null,{"children":["Every config on this page is adapted (paths and hostnames changed) from\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/tree/v1.6.5/deployment-examples/docker-compose","target":"_blank","rel":"noreferrer","data-source-link":"deployment-examples/docker-compose","data-source-ref":"v1.6.5","title":"deployment-examples/docker-compose at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"deployment-examples/docker-compose/"]}],",\nwhich CI builds and runs end to end on every pull request: ","$L6","\nbrings the three processes up with ","$L7"," and then drives real Bazel\nbuilds through them."]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c"]}],"$L3d"]}],["$L3e","$L3f"],"$L40"]}],"isPartial":"$@41","staleTime":"$42","varyParams":null},{"rsc":"$L43","isPartial":"$@44","staleTime":"$42","varyParams":null},{"rsc":"$L45","isPartial":"$@46","staleTime":"$42","varyParams":"$47"}],"isUpgradeableISRFallback":false,"a":"$@48","rootVaryParams":null,"needsRuntimeRequest":"$@49"}
