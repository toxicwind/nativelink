13:["$","p",null,{"children":["Each entry in ",["$","code",null,{"children":"cas"}],", ",["$","code",null,{"children":"ac"}],", ",["$","code",null,{"children":"bytestream"}],", and ",["$","code",null,{"children":"capabilities"}]," carries an optional\n",["$","code",null,{"children":"instance_name"}]," (default: the empty string, which is also what Bazel sends by\ndefault). If you set a non-empty one, every client has to pass it too\n(",["$","code",null,{"children":"--remote_instance_name="}]," for Bazel). An empty ",["$","code",null,{"children":"capabilities: []"}]," still answers\n",["$","code",null,{"children":"GetCapabilities"}]," with cache capabilities for any instance name; an entry with\n",["$","code",null,{"children":"remote_execution"}]," is only needed to advertise remote execution."]}]
