25:["$","p",null,{"children":[["$","code",null,{"children":"stores"}]," is an ",["$","strong",null,{"children":"array of named stores"}],", not an object map; every store carries\nits own ",["$","code",null,{"children":"name"}],", and other parts of the config refer to it by that name.\n",["$","code",null,{"children":"filesystem"}]," requires both ",["$","code",null,{"children":"content_path"}]," and ",["$","code",null,{"children":"temp_path"}],"; the config parser uses\n",["$","code",null,{"children":"deny_unknown_fields"}],", so a typo or an invented key is a startup failure rather\nthan a silently ignored line."]}]
