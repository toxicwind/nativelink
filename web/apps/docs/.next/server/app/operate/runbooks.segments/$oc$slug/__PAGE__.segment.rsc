63:["$","p",null,{"children":"A queued or executing record is left alone; only completed ones get the\nsixty seconds a fresh completion would."}]
64:["$","$L80",null,{"as":"h2","id":"restarting-the-scheduler","children":"Restarting the scheduler"}]
65:["$","p",null,{"children":"Not an incident so much as a procedure that behaves worse than you expect."}]
66:["$","p",null,{"children":["Worker reconnect is a ",["$","strong",null,{"children":"flat 0.5-second retry with no exponential backoff, no\njitter, no cap and no configuration field"}],". A scheduler outage therefore\nproduces a 2 Hz reconnect storm from every worker, for the whole outage."]}]
67:["$","p",null,{"children":["Worse, on reconnect each worker calls ",["$","code",null,{"children":"kill_all()"}]," and destroys every action it\nhad in flight, to avoid resource-locking itself against the new work the\nscheduler will send. A scheduler restart is disruptive to in-flight builds by\ndesign."]}]
68:["$","p",null,{"children":["Before restarting a scheduler with running work, drain each worker (see\n",["$","$L6",null,{"href":"#a-worker-is-oom-killed","children":"above"}],") and wait for ",["$","code",null,{"children":"inflight=0"}],"."]}]
69:["$","p",null,{"children":"Log lines to grep for during a restart:"}]
