":"/operate/security-hardening#the-worker-api-has-no-authentication","children":"Security hardening"}],"\nbefore running this on anything with a routable address."]}],["$","p",null,{"children":["The shipped ",["$","code",null,{"children":"worker-shared-cas.json5"}]," keeps the worker's fast tier under\n",["$","code",null,{"children":"/root/.cache/forge/"}],", not under the ",["$","code",null,{"children":"/data/cas"}]," mount, so the three\nworkers do not actually share the volume the compose file mounts for them.\nPoint ",["$","code",null,{"children":"content_path"}]," and ",["$","code",null,{"children":"temp_path"}]," at ",["$","code",null,{"children":"/data/cas/..."}]," if you want the\nsharing the README describes."]}]]]}]]}]
