en":["$","code",null,{"children":"worker.json5"}]}],["$","td",null,{"children":["The worker's advertised capabilities. Whatever you add here must also appear in the scheduler's ",["$","code",null,{"children":"supported_platform_properties"}],", or the scheduler rejects the worker's registration with ",["$","code",null,{"children":"Unknown platform property"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ADDITIONAL_SETUP_WORKER_CMD"}]}],["$","td",null,{"children":"build arg"}],["$","td",null,{"children":"A bash string run inside the final image. This is the hook for installing whatever toolchain your actions need."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_chunking"}]}],["$","td",null,{"children":["$","code",null,{"children":"local-storage-cas.json5"}]}],["$","td",null,{"children":["Enabled and pointed at a separate ",["$","code",null,{"children":"CHUNK_INDEX_STORE"}],", for Bazel's ",["$","code",null,{"children":"--experimental_remote_cache_chunking"}],". Remove both if you are not using that flag."]}]]}]]}]]}]}]
