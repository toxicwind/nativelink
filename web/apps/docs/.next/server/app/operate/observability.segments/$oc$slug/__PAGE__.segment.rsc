a:["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Metrics are Business Source Licensed"}],["$","p",null,{"children":["Individual developer cache use does not need a commercial licence. Teams\nusing metrics in shared, production or commercial settings can use Forge\nEnterprise or a separate licence. Note that instrumentation cannot be\nswitched off (see\n",["$","$L8",null,{"href":"/reference/oss-and-enterprise#metrics-are-always-on","children":"Open source and Enterprise"}],"), and\nthe operative text is the ",["$","$L8",null,{"href":"https://forge.com/license","children":"licence page"}],"."]}]]}]
