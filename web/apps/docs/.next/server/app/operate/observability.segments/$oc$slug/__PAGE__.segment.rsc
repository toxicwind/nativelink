e:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"NL_OTEL_ENDPOINT needs a scheme and an explicit port"}],[["$","p",null,{"children":["The value is parsed as a URL and the host and port are pulled out\nindividually, and each step ",["$","code",null,{"children":"unwrap"}],"s. A value with no scheme, or with no\nexplicit port, yields ",["$","code",null,{"children":"None"}]," for the port and ",["$","strong",null,{"children":"panics the process during\nstartup"}],", before it binds a socket."]}],["$","p",null,{"children":[["$","code",null,{"children":"http://otel-collector:4317"}]," is correct. ",["$","code",null,{"children":"otel-collector:4317"}]," and\n",["$","code",null,{"children":"http://otel-collector"}]," both crash the binary."]}]]]}]]}]
f:["$","p",null,{"children":[["$","code",null,{"children":"NL_OTEL_ENDPOINT"}]," builds one client-side load-balanced gRPC channel shared by\nall three exporters. Leave it unset and each exporter falls back to the\nOpenTelemetry SDK's own resolution: ",["$","code",null,{"children":"OTEL_EXPORTER_OTLP_ENDPOINT"}]," (or the\nper-signal ",["$","code",null,{"children":"OTEL_EXPORTER_OTLP_METRICS_ENDPOINT"}]," and friends), defaulting\nto ",["$","code",null,{"children":"http://localhost:4317"}],". Both work; the explicit channel is what you want in\na cluster, because it re-resolves the collector's DNS as pods move. Either way\nthe transport is OTLP over gRPC: the binary is built with only the gRPC\nexporter, so ",["$","code",null,{"children":"OTEL_EXPORTER_OTLP_PROTOCOL"}]," cannot switch it to HTTP."]}]
10:["$","p",null,{"children":"The rest of the surface is small enough to state in full:"}]
11:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Variable"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"What it does here"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"NL_OTEL_ENDPOINT"}]}],["$","td",null,{"children":"unset"}],["$","td",null,{"children":"One shared gRPC channel for logs, traces and metrics. Panics on a malformed value."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"OTEL_EXPORTER_OTLP_ENDPOINT"}]}],["$","td",null,{"children":["$","code",null,{"children":"http://localhost:4317"}]}],["$","td",null,{"children":["Used only when ",["$","code",null,{"children":"NL_OTEL_ENDPOINT"}]," is unset."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"OTEL_EXPORTER_OTLP_COMPRESSION"}]}],["$","td",null,{"children":"unset"}],["$","td",null,{"children":[["$","code",null,{"children":"gzip"}]," or ",["$","code",null,{"children":"zstd"}]," on the gRPC exporters; the shipped Kubernetes manifests set ",["$","code",null,{"children":"zstd"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"OTEL_METRIC_EXPORT_INTERVAL"}]}],["$","td",null,{"children":[["$","code",null,{"children":"60000"}]," (ms)"]}],["$","td",null,{"children":["How often metrics flush. Forge sets no interval, so the SDK default of one minute applies. This is the first hop in the ",["$","$L8",null,{"href":"/operate/autoscaling-reference#the-reaction-time-budget","children":"reaction-time budget"}],"; lower it to 10000 before you scale on anything."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"RUST_LOG"}]}],["$","td",null,{"children":["$","code",null,{"children":"info"}]}],["$","td",null,{"children":["Applies to the stdout layer ",["$","strong",null,{"children":"and"}]," to all three OTLP layers. ",["$","code",null,{"children":"hyper"}],", ",["$","code",null,{"children":"tonic"}],", ",["$","code",null,{"children":"h2"}],", ",["$","code",null,{"children":"reqwest"}]," and ",["$","code",null,{"children":"tower"}]," are forced off afterwards and cannot be re-enabled."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"NL_LOG"}]}],["$","td",null,{"children":["$","code",null,{"children":"pretty"}]}],["$","td",null,{"children":["Stdout log format. ",["$","code",null,{"children":"compact"}]," and ",["$","code",null,{"children":"json"}]," are recognised; any other value silently falls back to ",["$","code",null,{"children":"pretty"}],"."]}]]}]]}]]}]}]
