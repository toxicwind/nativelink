a:["$","p",null,{"children":["Every listener Forge opens, what it serves, and who may reach it. Ports\nare the ones the shipped examples use; nothing in the binary reserves them;\n",["$","$L58",null,{"href":"/operate/production-config","children":"Production configuration"}]," covers how the three\nprocesses divide these listeners between them."]}]
b:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Port"}],["$","th",null,{"children":"Services on it"}],["$","th",null,{"children":"Who should reach it"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"50051"}]}],["$","td",null,{"children":"CAS, Action Cache, ByteStream, Capabilities"}],["$","td",null,{"children":"Developers and CI. Everything on it is a cache read or write."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"50052"}]}],["$","td",null,{"children":"Execution, Capabilities, AC frontend"}],["$","td",null,{"children":"Developers and CI. Submitting an action means running code on a worker."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"50061"}]}],["$","td",null,{"children":[["$","strong",null,{"children":"worker API"}],", ",["$","code",null,{"children":"admin"}],", ",["$","code",null,{"children":"health"}]]}],["$","td",null,{"children":["Workers and your operators. ",["$","strong",null,{"children":"Never routable from a developer network."}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"50071"}]}],["$","td",null,{"children":["The TLS variant of ",["$","code",null,{"children":"50051"}]," in the shipped examples"]}],["$","td",null,{"children":"Developers and CI."}]]}]]}]]}]}]
c:["$","p",null,{"children":"The configuration crate says this itself, in the doc comment on the field:"}]
d:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":["This is the service used for workers to connect and communicate through.\nNOTE: This service should be served on a different, non-public port. In other\nwords, ",["$","code",null,{"children":"worker_api"}]," configuration should not have any other services that are\nserved on the same port. Doing so is a security risk, as workers have a\ndifferent permission set than a client that makes the remote execution/cache\nrequests."]}],"\n"]}]
e:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/cas_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/cas_server.rs","data-source-ref":"v1.6.5","title":"forge-config/src/cas_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ServicesConfig::worker_api"]}]
