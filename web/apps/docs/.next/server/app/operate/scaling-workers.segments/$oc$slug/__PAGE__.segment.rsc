a:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/cas_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/cas_server.rs","data-source-ref":"v1.6.5","title":"forge-config/src/cas_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"LocalWorkerConfig"]}]
b:["$","p",null,{"children":"Three things about it are not what most people assume, and each has bitten\nsomebody."}]
c:["$","p",null,{"children":[["$","strong",null,{"children":["The default is ",["$","code",null,{"children":"0"}],", and ",["$","code",null,{"children":"0"}]," means unlimited."]}]," An unconfigured worker will\naccept as many concurrent actions as the scheduler sends it. That is fine on a\nsmall pool and a genuinely bad time on a large one, because the failure mode is\nnot a queue; it's memory exhaustion or an out-of-file-descriptors error partway\nthrough a build. Set it explicitly."]}]
d:["$","p",null,{"children":[["$","strong",null,{"children":"It is enforced on the scheduler, not on the worker."}]," The worker sends the\nnumber when it registers; the scheduler tracks how many actions each worker is\nholding and stops assigning past the limit. The worker itself has no admission\ncheck and will run whatever it is handed. In normal operation this distinction\nis invisible. It matters if you ever run two schedulers against one worker, or\nif you're reasoning about what protects the host: the answer is the scheduler's\nbookkeeping, and nothing else."]}]
e:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-scheduler/src/worker.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-scheduler/src/worker.rs","data-source-ref":"v1.6.5","title":"forge-scheduler/src/worker.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"Worker"]}]
f:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"cpu_count"}]," does not limit anything on the worker."]}]," This is the one that\nsurprises people most. The ",["$","code",null,{"children":"cpu_count"}]," platform property, usually populated\nwith ",["$","code",null,{"children":"query_cmd: \"nproc\""}]," in the shipped examples, is ",["$","em",null,{"children":"advertising"}],". It tells\nthe scheduler what to match against. It does not throttle execution, and the\nworker derives no concurrency from the host's CPU count at all. Declare\n",["$","code",null,{"children":"cpu_count: 64"}]," on a four-core box and the scheduler will happily route\n64-core actions to it."]}]
10:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`cpu_count` and `max_inflight_tasks` are unrelated"}],["$","p",null,{"children":["One is what the scheduler matches on; the other is what the scheduler counts.\nIf your actions declare ",["$","code",null,{"children":"cpu_count"}]," as a ",["$","code",null,{"children":"minimum"}]," requirement, that number is\nconsumable (the scheduler subtracts it on assignment and restores it on\ncompletion), so it does bound concurrency indirectly. But it does so only for\nactions that declare it. ",["$","code",null,{"children":"max_inflight_tasks"}]," is the bound that applies to\neverything."]}]]}]]}]
11:["$","p",null,{"children":["A reasonable starting point is ",["$","code",null,{"children":"max_inflight_tasks"}]," at roughly the host's core\ncount for compile-shaped work, then adjusted by observation: if per-action\ndurations climb as the number in flight rises, you're oversubscribed; if the\nhost sits at half its CPU with a deep queue, you're undersubscribed."]}]
12:["$","$L7",null,{"as":"h2","id":"the-ceilings-you-hit-before-you-expect-to","children":"The ceilings you hit before you expect to"}]
13:["$","p",null,{"children":"A worker sized generously runs into limits that are not on the worker config,\nand they're worth knowing before you go hunting."}]
14:["$","p",null,{"children":[["$","strong",null,{"children":"File descriptors."}]," Forge holds a process-wide semaphore over open files,\ndefaulting to ",["$","strong",null,{"children":"24,576"}],". Every action materializing inputs and writing outputs\ndraws from it. Raise it with ",["$","code",null,{"children":"max_open_files"}]," under ",["$","code",null,{"children":"global"}]," (the shipped\nKubernetes worker config sets 524,288) and raise the OS limit to match, or the\nsemaphore will let through more than the kernel allows."]}]
15:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/fs.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/fs.rs","data-source-ref":"v1.6.5","title":"forge-util/src/fs.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"DEFAULT_OPEN_FILE_LIMIT"]}]
16:["$","p",null,{"children":[["$","strong",null,{"children":"gRPC connections to the CAS."}]," The ",["$","code",null,{"children":"grpc"}]," store's ",["$","code",null,{"children":"connections_per_endpoint"}],"\ndefaults to ",["$","strong",null,{"children":"1"}],". One HTTP/2 connection multiplexes streams well up to a point\nand then becomes the bottleneck, and on a worker running dozens of actions\nagainst a remote CAS that point arrives early. This is the first knob to reach\nfor when a worker's CPU is idle and its actions are slow."]}]
17:["$","p",null,{"children":[["$","strong",null,{"children":"Store-level concurrency caps."}]," ",["$","code",null,{"children":"max_concurrent_writes"}],",\n",["$","code",null,{"children":"max_concurrent_requests"}],", and Redis's ",["$","code",null,{"children":"connection_pool_size"}]," (default 3) all\nsit between the worker and its bytes. A worker that scales up without these\nscaling with it just queues internally."]}]
18:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/stores.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/stores.rs","data-source-ref":"v1.6.5","title":"forge-config/src/stores.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"StoreSpec"]}]
19:["$","p",null,{"children":[["$","strong",null,{"children":["One ",["$","code",null,{"children":"work_directory"}]," per worker process, always."]}]," The worker ",["$","strong",null,{"children":"purges its\nwork directory on startup"}],". Two workers pointed at the same path means the\nsecond one to start deletes the first one's in-flight state. On a shared host,\ngive each worker its own path; in containers this is free."]}]
1a:["$","$L7",null,{"as":"h2","id":"the-signal-to-scale-on","children":"The signal to scale on"}]
1b:["$","p",null,{"children":"Not CPU. Worker CPU tells you whether a machine is busy; it cannot tell you\nwhether there is work waiting that nobody is doing, and that's the only question\nan autoscaler needs answered."}]
1c:["$","p",null,{"children":["The signal is ",["$","strong",null,{"children":"queue depth"}],": actions in the ",["$","code",null,{"children":"queued"}]," stage rather than\n",["$","code",null,{"children":"executing"}],". Forge emits ",["$","code",null,{"children":"execution.active.count"}]," as an up-down counter\nattributed by ",["$","code",null,{"children":"execution.stage"}],", which reaches Prometheus as\n",["$","code",null,{"children":"forge_execution_active_count"}]," after the OTLP collector's Prometheus\nexporter adds its ",["$","code",null,{"children":"forge"}]," namespace."]}]
