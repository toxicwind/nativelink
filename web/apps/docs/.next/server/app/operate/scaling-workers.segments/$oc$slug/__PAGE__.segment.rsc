29:["$","p",null,{"children":"Being explicit, because the gap is larger than the docs elsewhere imply."}]
2a:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"deployment-examples/docker-compose/docker-compose-multi-worker.yml"}]}]," defines\nthree worker services. They are copy-pasted and identical apart from a\n",["$","code",null,{"children":"WORKER_NAME"}]," and a private data volume each: same config file, same shared\nCAS volume, two CPUs and 2 GB each. It has no ",["$","code",null,{"children":"deploy.replicas"}]," and no\nheterogeneity. A fourth worker means pasting a fourth block."]}]
2b:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"deployment-examples/docker-compose/test-multi-worker-simple.json5"}]}]," is a\ngenuinely different pattern worth knowing about: ",["$","strong",null,{"children":"three workers inside one\nprocess"}],", as three entries in the ",["$","code",null,{"children":"workers"}]," array of a single config. One\nbinary, one config file, three registrations with the scheduler. It's a useful\nshape for a machine you want to subdivide, and it is not the same thing as three\ncontainers."]}]
2c:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"kubernetes/components/worker/worker.yaml"}]}]," sets ",["$","code",null,{"children":"replicas: 3"}],". The ",["$","code",null,{"children":"lre-cc"}],"\nand ",["$","code",null,{"children":"lre-rs"}]," overlays patch it to 1. The ",["$","code",null,{"children":"siso-chromium"}]," overlay does not patch\nit, so it inherits 3, which looks unintentional."]}]
2d:["$","p",null,{"children":[["$","strong",null,{"children":["No HorizontalPodAutoscaler, KEDA ",["$","code",null,{"children":"ScaledObject"}],", or VPA exists anywhere in\nthe repository for Forge."]}]," The single HPA in the tree scales the\nOpenTelemetry collector. No heterogeneous-pool example exists in\n",["$","code",null,{"children":"forge-config/examples/"}]," either; every shipped worker example is a single\nhomogeneous pool. The autoscaling path on this page is one you assemble from\nstandard Kubernetes parts; the recording rules are the raw material, not a\nfinished artifact."]}]
2e:["$","$L7",null,{"as":"h2","id":"backpressure-when-a-worker-needs-to-stop","children":"Backpressure, when a worker needs to stop"}]
2f:["$","p",null,{"children":["One mechanism lets a worker refuse work without being removed:\n",["$","code",null,{"children":"experimental_precondition_script"}],". It runs before every action, and a non-zero\nexit produces a ",["$","code",null,{"children":"ResourceExhausted"}]," error. The scheduler requeues the action\nwithout counting it as an attempt, and marks the worker ",["$","code",null,{"children":"is_paused"}]," ",["$","strong",null,{"children":"only if\nthat worker still has other actions in flight"}],"; the pause clears as soon as\none of them completes. An idle worker whose script fails is never paused: it\nkeeps its registration and is handed the action again on the next\nmatching pass, and rejects it again."]}]
