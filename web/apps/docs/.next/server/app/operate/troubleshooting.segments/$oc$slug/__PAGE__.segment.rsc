5a:["$","p",null,{"children":["The code and message you see are the ",["$","em",null,{"children":"cause"}],", and the suffix tells you it\nhad been happening repeatedly."]}]
5b:["$","p",null,{"children":["Non-retryable codes: ",["$","code",null,{"children":"InvalidArgument"}],", ",["$","code",null,{"children":"FailedPrecondition"}],", ",["$","code",null,{"children":"OutOfRange"}],",\n",["$","code",null,{"children":"Unimplemented"}],", ",["$","code",null,{"children":"NotFound"}],", ",["$","code",null,{"children":"AlreadyExists"}],", ",["$","code",null,{"children":"PermissionDenied"}],",\n",["$","code",null,{"children":"Unauthenticated"}],". Everything else retries, which is why a full disk, arriving\nas ",["$","code",null,{"children":"Unknown"}]," or ",["$","code",null,{"children":"Internal"}],", burns the whole retry budget before failing."]}]
5c:["$","p",null,{"children":["Two other retry strings: ",["$","code",null,{"children":"Retry stream ended abruptly on attempt N"}],", and\n",["$","code",null,{"children":"Not retrying permanent error"}],"."]}]
