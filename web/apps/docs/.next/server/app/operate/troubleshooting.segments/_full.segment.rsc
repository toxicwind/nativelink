sting-guide.mdx"},{"$id":"contribute/release-versioning.mdx","type":"page","name":"Releases and versioning","description":"How a Forge version becomes a signed tag, what the tag triggers, and what compatibility the project does and does not promise.","icon":"$undefined","url":"/contribute/release-versioning","$ref":"contribute/release-versioning.mdx"},{"$id":"contribute/docs.mdx","type":"page","name":"Working on documentation","description":"How these docs are built: the four page archetypes, the components, the anchor and snippet lints, and what a docs PR is reviewed against.","icon":"$undefined","url":"/contribute/docs","$ref":"contribute/docs.mdx"}],"$id":"contribute","$ref":{"folder":"contribute","meta":"contribute/meta.json"},"icon":"$undefined"},{"$id":"agents.mdx","type":"page","name":"For agents","description":"How an AI agent should read these docs end to end, where every entry point is, how to cite and verify a claim, and what the docs guarantee to a machine reader.","icon":"$undefined","url":"/agents","$ref":"agents.mdx"}],"fallback":{"type":"root","$ref":{"folder":"","meta":"$undefined"},"$id":"fallback:root","name":"Docs","description":"$undefined","children":[{"$id":"fallback:weave.mdx","type":"page","name":"Weave","description":"Entity-level merge driver that pairs with Forge","icon":"$undefined","url":"/weave","$ref":"weave.mdx"},{"type":"folder","name":"Reference","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"type":"folder","name":"Forge config","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"fallback:reference/forge-config/main.mdx","type":"page","name":"Configuration reference","description":"Every knob in the Forge JSON5 configuration — types, defaults, and links to source, autogenerated from the Rust config crate.","icon":"$undefined","url":"/reference/forge-config/main","$ref":"reference/forge-config/main