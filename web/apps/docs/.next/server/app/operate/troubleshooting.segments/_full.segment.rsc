3a:["$","p",null,{"children":["A scheduler key configured as ",["$","code",null,{"children":"priority"}]," when it should be ",["$","code",null,{"children":"exact"}]," or ",["$","code",null,{"children":"minimum"}],"\nis the classic version of this bug, and it fails in the ",["$","em",null,{"children":"opposite"}]," direction:\nactions get scheduled onto workers that cannot run them. See\n",["$","$L1b",null,{"href":"/operate/scaling-workers","children":"Scaling workers"}]," for the fleet-shaped version of\nthis problem and ",["$","$L1b",null,{"href":"/remote-execution/platform-properties","children":"Platform properties"}],"\nfor the full matching semantics."]}]
3b:["$","p",null,{"children":["The converse hazard is documented in the config itself: if a worker fails to\nadvertise a property the scheduler requires (",["$","code",null,{"children":"cpu_arch"}],", say), the scheduler\nwill never send it any work at all."]}]
