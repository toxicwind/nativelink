37:["$","p",null,{"children":["All of those lines, and the property mismatch lines below, are only written\nduring the periodic full-logging pass, which is controlled by\n",["$","code",null,{"children":"worker_match_logging_interval_s"}],", default 10 seconds. ",["$","code",null,{"children":"-1"}]," or ",["$","code",null,{"children":"0"}]," disables\nit; anything invalid logs an error and disables it. The same pass emits\n",["$","code",null,{"children":"Oldest actions in state"}],", capped at five per stage, the intended \"why is my\nqueue stuck\" tool."]}]
