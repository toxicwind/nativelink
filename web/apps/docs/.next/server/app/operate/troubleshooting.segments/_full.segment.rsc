54:["$","p",null,{"children":["The timeout defaults that matter: ",["$","code",null,{"children":"max_action_timeout_s"}]," 20 minutes,\n",["$","code",null,{"children":"max_upload_timeout_s"}]," 10 minutes, ",["$","code",null,{"children":"max_cleanup_wait_s"}]," 30 seconds,\n",["$","code",null,{"children":"worker_timeout_s"}]," 10 seconds, ",["$","code",null,{"children":"client_action_timeout_s"}]," 60 seconds,\n",["$","code",null,{"children":"retain_completed_for_s"}]," 60 seconds."]}]
55:["$","p",null,{"children":[["$","code",null,{"children":"retain_completed_for_s"}]," is not an execution timeout; it is how long a\ncompleted action stays findable. Set it too low and a client reconnecting after\na network blip cannot find its own finished action."]}]
