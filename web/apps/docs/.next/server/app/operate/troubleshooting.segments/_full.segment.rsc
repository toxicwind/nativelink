62:["$","p",null,{"children":"If the symptom is \"everything got slow and nothing errored\", you are probably\nsitting on one of these:"}]
63:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Limit"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Behaviour"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Open file descriptors"}],["$","td",null,{"children":"24576"}],["$","td",null,{"children":["Blocks on a semaphore. ",["$","strong",null,{"children":["Never produces ",["$","code",null,{"children":"EMFILE"}],"."]}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"max_concurrent_requests"}]," (gRPC)"]}],["$","td",null,{"children":"unlimited"}],["$","td",null,{"children":"Queues rather than rejecting."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"max_client_permits"}]," (Redis)"]}],["$","td",null,{"children":"500"}],["$","td",null,{"children":"Blocks."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"max_concurrent_writes"}]," (filesystem)"]}],["$","td",null,{"children":"unlimited"}],["$","td",null,{"children":"Blocks when set."}]]}]]}]]}]}]
64:["$","p",null,{"children":["The FD limit deserves special attention. Forge uses only ",["$","strong",null,{"children":"80% of the\nlimit it actually achieved"}],", not 80% of what you configured. In a container\nwith a hard ",["$","code",null,{"children":"nofile"}]," cap, the semaphore silently shrinks and the only evidence\nis a startup warning:"]}]
