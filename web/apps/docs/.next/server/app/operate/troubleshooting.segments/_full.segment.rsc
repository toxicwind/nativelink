6c:["$","p",null,{"children":["Config parsing uses ",["$","code",null,{"children":"deny_unknown_fields"}],", so a misspelled key is a startup\nerror naming the key, not a silently ignored setting. That is a feature; trust\nthe message."]}]
6d:["$","p",null,{"children":["One string that looks like a startup failure and is not:\n",["$","code",null,{"children":"Could not parse the value of precondition_script: '<v>'"}],". The\n",["$","code",null,{"children":"experimental_precondition_script"}]," value is split with ",["$","code",null,{"children":"shlex"}]," before every\naction, not at startup, so an unparseable value fails each action as it\narrives and the worker stays up."]}]
6e:["$","$L1c",null,{"as":"h2","id":"retries","children":"Retries"}]
6f:["$","p",null,{"children":["Retry exhaustion is ",["$","strong",null,{"children":"not"}]," a distinct error. It is the last underlying error\nwith a suffix appended:"]}]
