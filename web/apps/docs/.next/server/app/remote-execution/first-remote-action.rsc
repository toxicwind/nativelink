29:["$","$L37",null,{"type":"multiple","children":[["$","$L38",null,{"title":"The build hangs at \"0s remote\" and never progresses","id":"the-build-hangs-at-0s-remote-and-never-progresses","children":[["$","p",null,{"children":"Your action's platform properties don't match any registered worker, so the\nscheduler is holding it in the queue. This is the single most common\nfirst-run failure and it is silent by design: the scheduler keeps waiting\nin case a suitable worker shows up later."}],["$","p",null,{"children":["Check the server log for the scheduler's periodic match logging: ",["$","code",null,{"children":"Property mismatch"}],", ",["$","code",null,{"children":"No candidate workers due to a lack of key"}],", or ",["$","code",null,{"children":"No workers available to match!"}]," (that last one means the worker never registered).\nEither way,\n",["$","$L1b",null,{"href":"/remote-execution/platform-properties","children":"Platform properties"}]," walks through\nreading the scheduler's own matching diagnostics."]}]]}],["$","$L38",null,{"title":"FAILED_PRECONDITION: Action ... is missing from CAS","id":"failed-precondition-action-is-missing-from-cas","children":[["$","p",null,{"children":["The execution service looked up the action digest in its ",["$","code",null,{"children":"cas_store"}]," and\ndid not find it, so the store Bazel uploaded to is not the store the\n",["$","code",null,{"children":"execution"}]," service reads. The usual causes are ",["$","code",null,{"children":"--remote_cache"}]," and\n",["$","code",null,{"children":"--remote_executor"}]," pointing at different deployments, or an ",["$","code",null,{"children":"execution"}],"\nentry whose ",["$","code",null,{"children":"cas_store"}]," is not the same store (or a ",["$","code",null,{"children":"ref_store"}]," to it) as\nthe ",["$","code",null,{"children":"cas"}]," and ",["$","code",null,{"children":"bytestream"}]," services on the client listener. Forge\nreturns the error with a ",["$","code",null,{"children":"PreconditionFailure"}]," detail so Bazel can re-upload\nthe missing blobs and retry; if it keeps repeating, the two stores are not\nthe same store."]}],["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/execution_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/execution_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/execution_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"missing_blobs_failed_precondition"]}]]}],["$","$L38",null,{"title":"The action runs but fails with \"command not found\" or a missing header","id":"the-action-runs-but-fails-with-command-not-found","children":[["$","p",null,{"children":["The worker executed your action in a sandbox that doesn't have something\nyour local environment provides implicitly. This is remote execution doing\nits job: it converted an unstated dependency into a visible failure. It's\nalso out of scope for this page:\n",["$","$L1b",null,{"href":"/remote-execution/toolchains-and-hermeticity","children":"Toolchains and hermeticity"}],"\nis the fix."]}],["$","p",null,{"children":["Note that on this config the worker runs as ",["$","em",null,{"children":"you"}],", on ",["$","em",null,{"children":"your"}]," machine, with\nyour ",["$","code",null,{"children":"PATH"}],". If a command isn't found even here, the action is depending on\nsomething Bazel isn't declaring at all."]}]]}],["$","$L38",null,{"title":"Bazel reports strategy as \"local\" even though the flags are set","id":"bazel-reports-strategy-as-local","children":"$L39"}],"$L3a"]}]
2a:["$","$L1c",null,{"as":"h2","id":"faq","children":"FAQ"}]
2b:["$","$L37",null,{"type":"multiple","children":[["$","$L38",null,{"title":"Why does this run the worker in the same process as the CAS?","id":"why-does-this-run-the-worker-in-the-same-process-as-the-cas","children":["$","p",null,{"children":["Because it's the fewest moving parts that still exercises the real code\npaths: the worker here uses the same gRPC worker API, the same scheduler,\nand the same store implementations a production cluster does. Splitting into\nseparate processes changes the deployment, not the protocol. See\n",["$","$L1b",null,{"href":"/operate/production-config","children":"Production configuration"}]," for the split\nversion."]}]}],["$","$L38",null,{"title":"Can I keep using this for day-to-day local builds?","id":"can-i-keep-using-this-for-day-to-day-local-builds","children":["$","p",null,{"children":["You can, and some people do; a single-process cluster is a reasonable way\nto get sandboxed, cached builds on one machine. But it gives you no\nparallelism beyond one worker's ",["$","code",null,{"children":"cpu_count"}],", and the filesystem stores are\npointed at ",["$","code",null,{"children":"/tmp"}],". ",["$","$L1b",null,{"href":"/remote-execution/local-testing","children":"Local testing"}]," covers\nthe longer-lived version of this setup."]}]}],["$","$L38",null,{"title":"What if I'm not using Bazel?","id":"what-if-im-not-using-bazel","children":["$","p",null,{"children":["The cluster is build-tool agnostic: it speaks the Remote Execution API, and\nBuck2, Siso, Pants, and recc all connect to the same endpoints.\n",["$","$L1b",null,{"href":"/getting-started/connect-your-build","children":"Connect your build"}]," has the flag\nequivalents. The verification step differs per tool; look for whatever your\ntool calls its execution strategy in its own logs."]}]}],["$","$L38",null,{"title":"Where did my data go, and how do I clean it up?","id":"where-did-my-data-go-and-how-do-i-clean-it-up","children":["$","p",null,{"children":["Everything this config writes lives under\n",["$","code",null,{"children":"/tmp/forge-local-rbe-test/"}],": CAS content, action cache, the worker's\nfast store, and its work directory. Stop the server and delete that tree to\nstart clean."]}]}]]}]
