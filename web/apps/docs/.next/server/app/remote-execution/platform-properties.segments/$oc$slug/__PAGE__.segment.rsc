e:["$","$L7",null,{"as":"h3","id":"why-priority-is-not-the-escape-hatch-people-assume","children":["Why ",["$","code",null,{"children":"priority"}]," is not the escape hatch people assume"]}]
f:["$","p",null,{"children":["The matching loop checks key presence ",["$","em",null,{"children":"before"}]," it checks value\ncompatibility. For every property the action requests, the scheduler looks\nthe key up on the worker; if it isn't there, the worker is rejected,\nregardless of type. ",["$","code",null,{"children":"priority"}]," only tells the scheduler to stop caring about\nthe ",["$","em",null,{"children":"value"}],"."]}]
10:["$","p",null,{"children":["A worker that omits ",["$","code",null,{"children":"OSFamily"}]," entirely will never receive an action that\nrequests ",["$","code",null,{"children":"OSFamily"}],", even though the scheduler declares ",["$","code",null,{"children":"OSFamily"}]," as\n",["$","code",null,{"children":"priority"}],". This is why the example configs advertise ",["$","code",null,{"children":"OSFamily: { values: [\"\"] }"}],": an empty string is still a value, and presence is what's being\ntested. Only ",["$","code",null,{"children":"ignore"}]," skips the presence check."]}]
11:["$","$L7",null,{"as":"h3","id":"minimum-is-a-consumable-resource-not-a-filter","children":[["$","code",null,{"children":"minimum"}]," is a consumable resource, not a filter"]}]
12:["$","p",null,{"children":"This is the most consequential and least visible behaviour in the system."}]
13:["$","p",null,{"children":["When the scheduler assigns an action to a worker, it ",["$","strong",null,{"children":"subtracts"}]," every\n",["$","code",null,{"children":"minimum"}]," value the action requested from the worker's advertised value. When\nthe action completes, it adds them back."]}]
14:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-scheduler/src/worker.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-scheduler/src/worker.rs","data-source-ref":"v1.6.5","title":"forge-scheduler/src/worker.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"reduce_platform_properties"]}]
15:["$","p",null,{"children":["A worker advertising ",["$","code",null,{"children":"cpu_count: 16"}]," that receives four actions each asking\nfor ",["$","code",null,{"children":"cpu_count=4"}]," is, at that moment, advertising ",["$","code",null,{"children":"cpu_count: 0"}],", and will\nmatch nothing further until one of them finishes. ",["$","code",null,{"children":"minimum"}]," properties are\ntherefore your real concurrency control, and ",["$","code",null,{"children":"cpu_count"}]," in particular is the\nknob that governs how many actions a worker runs at once."]}]
16:["$","p",null,{"children":"Two consequences worth internalising:"}]
17:["$","ul",null,{"children":["\n",["$","li",null,{"children":["An action requesting ",["$","code",null,{"children":"cpu_count=32"}]," against workers that advertise ",["$","code",null,{"children":"16"}],"\nwill never be scheduled. Not slowly; never. No bin-packing across\nworkers happens, and no error is raised."]}],"\n",["$","li",null,{"children":["Setting ",["$","code",null,{"children":"cpu_count=1"}]," on every action, as the getting-started examples do,\nmeans a 16-core worker runs 16 concurrent actions. That's usually what you\nwant; it is a decision you're making either way."]}],"\n"]}]
18:["$","p",null,{"children":[["$","code",null,{"children":"max_inflight_tasks"}]," on the worker is the separate, blunter cap: it counts\ntasks rather than resources, and ",["$","code",null,{"children":"0"}]," means unlimited."]}]
19:["$","$L7",null,{"as":"h2","id":"what-happens-when-it-doesnt-match","children":"What happens when it doesn't match"}]
1a:["$","p",null,{"children":"The two failure modes are asymmetric, and knowing which one you're in tells\nyou where to look."}]
1b:["$","p",null,{"children":[["$","strong",null,{"children":"An unknown key on a worker is a hard failure at registration."}]," Worker\nproperties go through the same type map as action properties, so a worker\nadvertising a key that isn't in ",["$","code",null,{"children":"supported_platform_properties"}]," is rejected\nwith ",["$","code",null,{"children":"Bad Property during connect_worker()"}]," and never joins the pool. You'll\nsee this in the worker's log at startup, and the effect is a fleet that looks\nsmaller than you provisioned."]}]
1c:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/worker_api_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/worker_api_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/worker_api_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"connect_worker"]}]
1d:["$","p",null,{"children":[["$","strong",null,{"children":"An unknown key on an action queues forever."}]," The scheduler types an\naction's properties at match time, not at submission time. When that typing\nfails, the scheduler logs ",["$","code",null,{"children":"Error while running do_try_match"}]," (wrapping\n",["$","code",null,{"children":"Unknown platform property 'x'"}],"), moves on to the other queued actions, and\nleaves this one where it is; the action is not errored out and the client\nis not told anything. Because the pass ended in an error, the scheduler\nre-runs it after 100 ms, failing identically each time. From the build's\nside this is indistinguishable from a busy queue."]}]
