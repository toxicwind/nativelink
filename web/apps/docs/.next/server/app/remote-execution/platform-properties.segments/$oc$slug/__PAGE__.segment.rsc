43:["$","$L57",null,{"type":"multiple","children":[["$","$L58",null,{"title":"Should I use exact or priority for OSFamily?","id":"should-i-use-exact-or-priority-for-osfamily","children":["$","p",null,{"children":[["$","code",null,{"children":"priority"}]," if you have one OS in the fleet, ",["$","code",null,{"children":"exact"}]," the moment you have two.\nThe example configs use ",["$","code",null,{"children":"priority"}]," with an empty value because a homogeneous\nfleet gains nothing from enforcing it, but that's a default for a tutorial,\nnot a recommendation for a mixed fleet. With ",["$","code",null,{"children":"exact"}]," you get a real routing\nguarantee; with ",["$","code",null,{"children":"priority"}]," you get a label."]}]}],["$","$L58",null,{"title":"Can an action request a property the scheduler declares but no worker has?","id":"can-an-action-request-a-property-no-worker-has","children":["$","p",null,{"children":["Yes, and it will queue indefinitely. Declaring a key in\n",["$","code",null,{"children":"supported_platform_properties"}]," makes it ",["$","em",null,{"children":"legal"}],", not ",["$","em",null,{"children":"satisfiable"}],". This is\nthe usual shape of the mistake when a new capability is half-rolled-out:\nbuilds start requesting it before the fleet advertises it."]}]}],["$","$L58",null,{"title":"How do I set properties per target instead of for the whole build?","id":"how-do-i-set-properties-per-target","children":["$","p",null,{"children":[["$","code",null,{"children":"exec_properties"}]," on the target, or on a platform definition the target\nresolves to. ",["$","code",null,{"children":"--remote_default_exec_properties"}]," is a fallback that applies\nonly where nothing more specific was set, which makes it right for\n",["$","code",null,{"children":"cpu_count"}]," and wrong for anything that varies."]}]}],["$","$L58",null,{"title":"Does the worker enforce what it advertises?","id":"does-the-worker-enforce-what-it-advertises","children":["$","p",null,{"children":["No. ",["$","code",null,{"children":"cpu_count: 16"}]," is an assertion the scheduler believes; nothing pins the\naction to 16 cores or stops it using 64. Properties are for ",["$","em",null,{"children":"routing"}]," and\nfor accounting, not for isolation. If you need enforcement, that's the\nworker's sandboxing configuration, not this."]}]}],["$","$L58",null,{"title":"Why not just error out an action that can't be matched?","id":"why-not-just-error-out-an-unmatched-action","children":["$","p",null,{"children":["Because a worker fleet is dynamic: the machine that satisfies an action may\nbe thirty seconds from registering. Holding the action is the right default\nfor autoscaling clusters, and it's why the diagnostic logging exists as the\ncounterweight. In practice, treat \"queued longer than your autoscaler's warm-up\ntime\" as a failure and alert on it. ",["$","$L6",null,{"href":"/operate/tuning","children":"Tuning"}]," has the\nqueue-depth signals."]}]}]]}]
