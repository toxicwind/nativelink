b:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Type"}],["$","th",null,{"children":"What the action's value means"}],["$","th",null,{"children":"What it takes to match"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"minimum"}]}],["$","td",null,{"children":["A numeric floor. Parsed as ",["$","code",null,{"children":"u64"}],"."]}],["$","td",null,{"children":["The worker's value must be ",["$","strong",null,{"children":"≥"}]," the action's."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"exact"}]}],["$","td",null,{"children":"A literal string."}],["$","td",null,{"children":["The worker's value must be ",["$","strong",null,{"children":"byte-for-byte identical"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"priority"}]}],["$","td",null,{"children":"Informational; passed through to the worker."}],["$","td",null,{"children":["Any value matches, but the worker must still ",["$","strong",null,{"children":"have the key"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ignore"}]}],["$","td",null,{"children":"Requestable but unenforced."}],["$","td",null,{"children":"Always matches, and the worker need not have the key at all."}]]}]]}]]}]}]
