20:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Type"}],["$","th",null,{"children":"What the action's value means"}],["$","th",null,{"children":"What it takes to match"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"minimum"}]}],["$","td",null,{"children":["A numeric floor. Parsed as ",["$","code",null,{"children":"u64"}],"."]}],["$","td",null,{"children":["The worker's value must be ",["$","strong",null,{"children":"≥"}]," the action's."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"exact"}]}],["$","td",null,{"children":"A literal string."}],["$","td",null,{"children":["The worker's value must be ",["$","strong",null,{"children":"byte-for-byte identical"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"priority"}]}],["$","td",null,{"children":"Informational; passed through to the worker."}],["$","td",null,{"children":["Any value matches, but the worker must still ",["$","strong",null,{"children":"have the key"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ignore"}]}],["$","td",null,{"children":"Requestable but unenforced."}],["$","td",null,{"children":"Always matches, and the worker need not have the key at all."}]]}]]}]]}]}]
21:["$","p",null,{"children":["Most documentation you'll find elsewhere describes three of these. ",["$","code",null,{"children":"ignore"}],"\nexists and is the only one that exempts a worker from carrying the key."]}]
22:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/platform_properties.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/platform_properties.rs","data-source-ref":"v1.6.5","title":"forge-util/src/platform_properties.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"is_satisfied_by"]}]
23:["$","$L1c",null,{"as":"h3","id":"why-priority-is-not-the-escape-hatch-people-assume","children":["Why ",["$","code",null,{"children":"priority"}]," is not the escape hatch people assume"]}]
24:["$","p",null,{"children":["The matching loop checks key presence ",["$","em",null,{"children":"before"}]," it checks value\ncompatibility. For every property the action requests, the scheduler looks\nthe key up on the worker; if it isn't there, the worker is rejected,\nregardless of type. ",["$","code",null,{"children":"priority"}]," only tells the scheduler to stop caring about\nthe ",["$","em",null,{"children":"value"}],"."]}]
25:["$","p",null,{"children":["A worker that omits ",["$","code",null,{"children":"OSFamily"}]," entirely will never receive an action that\nrequests ",["$","code",null,{"children":"OSFamily"}],", even though the scheduler declares ",["$","code",null,{"children":"OSFamily"}]," as\n",["$","code",null,{"children":"priority"}],". This is why the example configs advertise ",["$","code",null,{"children":"OSFamily: { values: [\"\"] }"}],": an empty string is still a value, and presence is what's being\ntested. Only ",["$","code",null,{"children":"ignore"}]," skips the presence check."]}]
26:["$","$L1c",null,{"as":"h3","id":"minimum-is-a-consumable-resource-not-a-filter","children":[["$","code",null,{"children":"minimum"}]," is a consumable resource, not a filter"]}]
27:["$","p",null,{"children":"This is the most consequential and least visible behaviour in the system."}]
28:["$","p",null,{"children":["When the scheduler assigns an action to a worker, it ",["$","strong",null,{"children":"subtracts"}]," every\n",["$","code",null,{"children":"minimum"}]," value the action requested from the worker's advertised value. When\nthe action completes, it adds them back."]}]
29:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-scheduler/src/worker.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-scheduler/src/worker.rs","data-source-ref":"v1.6.5","title":"forge-scheduler/src/worker.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"reduce_platform_properties"]}]
2a:["$","p",null,{"children":["A worker advertising ",["$","code",null,{"children":"cpu_count: 16"}]," that receives four actions each asking\nfor ",["$","code",null,{"children":"cpu_count=4"}]," is, at that moment, advertising ",["$","code",null,{"children":"cpu_count: 0"}],", and will\nmatch nothing further until one of them finishes. ",["$","code",null,{"children":"minimum"}]," properties are\ntherefore your real concurrency control, and ",["$","code",null,{"children":"cpu_count"}]," in particular is the\nknob that governs how many actions a worker runs at once."]}]
2b:["$","p",null,{"children":"Two consequences worth internalising:"}]
2c:["$","ul",null,{"children":["\n",["$","li",null,{"children":["An action requesting ",["$","code",null,{"children":"cpu_count=32"}]," against workers that advertise ",["$","code",null,{"children":"16"}],"\nwill never be scheduled. Not slowly; never. No bin-packing across\nworkers happens, and no error is raised."]}],"\n",["$","li",null,{"children":["Setting ",["$","code",null,{"children":"cpu_count=1"}]," on every action, as the getting-started examples do,\nmeans a 16-core worker runs 16 concurrent actions. That's usually what you\nwant; it is a decision you're making either way."]}],"\n"]}]
2d:["$","p",null,{"children":[["$","code",null,{"children":"max_inflight_tasks"}]," on the worker is the separate, blunter cap: it counts\ntasks rather than resources, and ",["$","code",null,{"children":"0"}]," means unlimited."]}]
2e:["$","$L1c",null,{"as":"h2","id":"what-happens-when-it-doesnt-match","children":"What happens when it doesn't match"}]
2f:["$","p",null,{"children":"The two failure modes are asymmetric, and knowing which one you're in tells\nyou where to look."}]
30:["$","p",null,{"children":[["$","strong",null,{"children":"An unknown key on a worker is a hard failure at registration."}]," Worker\nproperties go through the same type map as action properties, so a worker\nadvertising a key that isn't in ",["$","code",null,{"children":"supported_platform_properties"}]," is rejected\nwith ",["$","code",null,{"children":"Bad Property during connect_worker()"}]," and never joins the pool. You'll\nsee this in the worker's log at startup, and the effect is a fleet that looks\nsmaller than you provisioned."]}]
31:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-service/src/worker_api_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-service/src/worker_api_server.rs","data-source-ref":"v1.6.5","title":"forge-service/src/worker_api_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"connect_worker"]}]
32:["$","p",null,{"children":[["$","strong",null,{"children":"An unknown key on an action queues forever."}]," The scheduler types an\naction's properties at match time, not at submission time. When that typing\nfails, the scheduler logs ",["$","code",null,{"children":"Error while running do_try_match"}]," (wrapping\n",["$","code",null,{"children":"Unknown platform property 'x'"}],"), moves on to the other queued actions, and\nleaves this one where it is; the action is not errored out and the client\nis not told anything. Because the pass ended in an error, the scheduler\nre-runs it after 100 ms, failing identically each time. From the build's\nside this is indistinguishable from a busy queue."]}]
33:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-scheduler/src/simple_scheduler.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-scheduler/src/simple_scheduler.rs","data-source-ref":"v1.6.5","title":"forge-scheduler/src/simple_scheduler.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"do_try_match"]}]
34:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"A queued build is a configuration bug until proven otherwise"}],["$","p",null,{"children":["If a build sits at ",["$","code",null,{"children":"0s remote"}]," for more than a few seconds on an idle\ncluster, do not wait it out. The scheduler is not going to time out and\ntell you. Read the match logging described below; it is on by default."]}]]}]]}]
