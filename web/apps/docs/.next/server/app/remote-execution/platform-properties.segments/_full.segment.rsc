f:["$","$L17",null,{"toc":[{"depth":2,"url":"#the-three-places-a-property-appears","title":"The three places a property appears"},{"depth":2,"url":"#the-four-property-types","title":"The four property types"},{"depth":3,"url":"#why-priority-is-not-the-escape-hatch-people-assume","title":["Why ",["$","code",null,{"children":"priority"}]," is not the escape hatch people assume"]},{"depth":3,"url":"#minimum-is-a-consumable-resource-not-a-filter","title":[["$","code",null,{"children":"minimum"}]," is a consumable resource, not a filter"]},{"depth":2,"url":"#what-happens-when-it-doesnt-match","title":"What happens when it doesn't match"},{"depth":2,"url":"#reading-the-schedulers-own-diagnostics","title":"Reading the scheduler's own diagnostics"},{"depth":2,"url":"#a-worked-example-routing-to-a-gpu-pool","title":"A worked example: routing to a GPU pool"},{"depth":2,"url":"#about-container-image","title":["About ",["$","code",null,{"children":"container-image"}]]},{"depth":2,"url":"#troubleshooting","title":"Troubleshooting"},{"depth":2,"url":"#faq","title":"FAQ"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Platform properties"}],["$","$L19",null,{"children":"How the scheduler decides which worker gets an action, why a mismatch queues forever instead of failing, and how to read the matching diagnostics it already emits."}],["$","$L1a",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone whose actions are queueing, and anyone about to\nrun more than one kind of worker. ",["$","strong",null,{"children":"What you'll have at the end:"}]," an\naccurate model of the matching rules, plus the log lines that tell you which\nrule you tripped. ",["$","strong",null,{"children":"Time:"}]," fifteen minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A cache serving hits to your build. If you don't have one yet, start with ",["$","$L1b",null,{"href":"/getting-started","children":"Getting started"}],"."]}]}]]}],"\n",["$","p",null,{"children":["Platform properties are the only vocabulary a build tool and a worker fleet\nshare. The action says ",["$","em",null,{"children":"I need this"}],"; the worker says ",["$","em",null,{"children":"I have this"}],"; the\nscheduler decides whether those two statements are compatible. No\ntype checking happens across that boundary beyond what you configure, and no\nnegotiation, which is why a typo produces a build that waits rather than a\nbuild that fails."]}],"\n",["$","$L1c",null,{"as":"h2","id":"the-three-places-a-property-appears","children":"The three places a property appears"}],"\n",["$","p",null,{"children":"A property key has to be declared in all three, and they have to agree."}],"\n",["$","$L1d",null,{"children":"flowchart TD\n  A[\"action<br/>--remote_default_exec_properties=cpu_count=1\"]\n  S[\"scheduler<br/>supported_platform_properties: { cpu_count: minimum }\"]\n  W[\"worker<br/>platform_properties: { cpu_count: { values: [16] } }\"]\n\n  A -->|\"Execute()\"| S\n  W -->|\"connect_worker()\"| S\n  S -->|\"assign if satisfied\"| W"}],"\n",["$","p",null,{"children":["The scheduler's ",["$","code",null,{"children":"supported_platform_properties"}]," is the schema. It maps each\nkey to a ",["$","strong",null,{"children":"type"}],", and that type decides how the value on the action is\ncompared against the value on the worker. A key that isn't in this map is\nnot a valid key anywhere, for either side."]}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/schedulers.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/schedulers.rs","data-source-ref":"v1.6.5","title":"forge-config/src/schedulers.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":["$L1e","PropertyType"]}],"\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a"]}],"$L5b"]}]
