hildren":"Every worker needs every key the actions request"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"No candidate workers due to a lack of key 'OSFamily'"}]}],["$","td",null,{"children":["Worker omits a ",["$","code",null,{"children":"priority"}]," or ",["$","code",null,{"children":"minimum"}]," key"]}],["$","td",null,{"children":["Add it with an empty value, or make it ",["$","code",null,{"children":"ignore"}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"No candidate workers due to a lack of matching 'x' = Exact(...)"}]}],["$","td",null,{"children":"No worker carries that exact value"}],["$","td",null,{"children":["Compare against the ",["$","code",null,{"children":"Workers have:"}]," list in the same line"]}]]}]]}]]}]}]
