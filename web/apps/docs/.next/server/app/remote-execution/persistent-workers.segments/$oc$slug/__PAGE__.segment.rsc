33:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Confirm the tool is actually a worker."}]," It must accept ",["$","code",null,{"children":"--persistent_worker"}],",\nread framed ",["$","code",null,{"children":"WorkRequest"}]," messages from stdin, and write framed ",["$","code",null,{"children":"WorkResponse"}],"\nmessages to stdout. Most JVM compilers have a worker wrapper already; a plain\ncompiler binary does not become one by being declared as one."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Declare the execution requirements"}]," on the action, with an ",["$","code",null,{"children":"@argfile"}]," holding\neverything that varies per action so that the pooling key stays stable."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Audit the tool for cross-request state."}]," Anything cached in memory between\nrequests must be keyed on inputs the request actually carries. Anything written\nto disk must go under ",["$","code",null,{"children":"sandbox_dir"}],"."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Run a build and read the worker's log."}]," You are looking for one process\nstart serving many actions, not one start per action."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Compare compile durations"}]," against the same build with the execution\nrequirements removed. The first action of each key should be unchanged; the\nrest should drop sharply."]}]}]]}]
34:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":"The action-duration distribution for that mnemonic becomes bimodal: a few slow\nfirst-of-key actions, the rest much faster."}],"\n",["$","li",null,{"children":"Process count on the worker host stays flat during a build instead of churning\nonce per action."}],"\n",["$","li",null,{"children":"Building the same targets twice in a row, cache disabled, is faster the second\ntime within a single build: the pool is warm."}],"\n",["$","li",null,{"children":"Nothing in the Forge worker log says it fell back to one-shot execution."}],"\n",["$","li",null,{"children":"Outputs are byte-identical to the same build without persistent workers. This\nis the one that matters."}],"\n"]}]}]]}]
35:["$","$L46",null,{"as":"h2","id":"when-it-doesnt-work","children":"When it doesn't work"}]
36:["$","$L50",null,{"children":[["$","$L51",null,{"title":"Nothing changes: actions still start a process each time","id":"nothing-changes--actions-still-start-a-process-each-time","children":["$","p",null,{"children":["Either the properties are not reaching the action's ",["$","code",null,{"children":"Platform"}],", or every action\nis getting its own key. Check ",["$","code",null,{"children":"supports-workers"}]," is exactly ",["$","code",null,{"children":"\"1\""}]," and is sent as\na platform property (see the callout above), and that the scheduler declares\nboth keys; an undeclared key leaves the action queued forever. Then check the\ncommand line has an ",["$","code",null,{"children":"@argfile"}],": without one, every distinct command line is a\ndistinct key, and you get a warm process per action, which is no process reuse\nat all."]}]}],["$","$L51",null,{"title":"Outputs are wrong, but only sometimes","id":"outputs-are-wrong-but-only-sometimes","children":["$","p",null,{"children":["Stop and disable persistent workers for that mnemonic. This is the signature of\nstate leaking between requests: a cache in the tool keyed on something the\nrequest no longer determines, or output written relative to the process's cwd\ninstead of ",["$","code",null,{"children":"sandbox_dir"}],". Wrong outputs get cached, so also consider what needs\ninvalidating."]}]}],["$","$L51",null,{"title":"Builds get slower under high parallelism","id":"builds-get-slower-under-high-parallelism","children":["$","p",null,{"children":["More than ",["$","code",null,{"children":"max_workers_per_key"}]," concurrent actions for one key (four by\ndefault) wait up to ",["$","code",null,{"children":"acquire_timeout_s"}]," for a process to come back and then\nfall back to one-shot execution, and one-shot execution of a worker-wrapped\ntool can be slower than the plain tool. Raise the cap, or reduce concurrency\nfor that mnemonic. The CPU time reported for a pooled action is what the\nprocess spent on it; its peak memory is the whole process, including what\nearlier requests left resident."]}]}],["$","$L51",null,{"title":"The tool can't find its inputs","id":"the-tool-cant-find-its-inputs","children":["$","p",null,{"children":["It is resolving paths relative to its own working directory, which is the\nworker's root directory rather than the action's. Every path must be resolved\nagainst the ",["$","code",null,{"children":"sandbox_dir"}]," the request carries. Tools written for local Bazel\nworkers usually get this right; wrappers written in-house usually do not, at\nfirst."]}]}],["$","$L51",null,{"title":"`Unsupported requires-worker-protocol value`","id":"unsupported-requires-worker-protocol-value","children":["$","p",null,{"children":["The property must be exactly ",["$","code",null,{"children":"proto"}]," or ",["$","code",null,{"children":"json"}],". Anything else is rejected and\nthe action falls back to one-shot execution."]}]}],["$","$L51",null,{"title":"Where did the tool's output go?","id":"where-did-the-tools-output-go","children":["$","p",null,{"children":["A persistent worker's stderr is discarded, because it belongs to the process\nrather than to any one action and cannot be attributed safely. What surfaces as\nthe action's stderr is the ",["$","code",null,{"children":"output"}]," field of the ",["$","code",null,{"children":"WorkResponse"}],", and the\naction's stdout is always empty. If a tool reports errors on its real stderr\ninstead of in the response, those errors are invisible; that is a bug in the\nworker wrapper."]}]}],["$","$L51",null,{"title":"Memory on the worker host keeps climbing","id":"memory-on-the-worker-host-keeps-climbing","children":["$","p",null,{"children":"Warm JVMs are the point and they are not free: up to four live processes per\ndistinct key, each holding a heap. The 200-request cap recycles them eventually,\nbut the steady state is higher than one-shot execution. Size worker hosts for\nthe pool, not for one compiler."}]}]]}]
