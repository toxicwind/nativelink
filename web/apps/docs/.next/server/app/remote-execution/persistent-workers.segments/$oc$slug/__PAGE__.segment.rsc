a:["$","p",null,{"children":[["$","strong",null,{"children":"Little needs configuring in Forge."}]," The pool is on by default and\nthe protocol is chosen by two platform properties on each action. The\nworker's ",["$","code",null,{"children":"persistent_workers"}]," block (v1.7.3 and later) sizes it: how many\nprocesses per key, how long an idle one lives, how many requests one serves,\nhow long an action at the cap waits for a process to come back, and\n",["$","code",null,{"children":"enabled: false"}]," to run every such action one-shot.\nThe one thing Forge does need from you is on the scheduler: those two\nkeys must be listed in ",["$","code",null,{"children":"supported_platform_properties"}],", because a scheduler\nolder than v1.6.6 rejects an action that carries a key it does not know."]}]
b:["$","p",null,{"children":[["$","strong",null,{"children":"The module is licensed separately."}]," Most of the repository is\n",["$","code",null,{"children":"FSL-1.1-Apache-2.0"}],". Every file under ",["$","code",null,{"children":"forge-worker/src/persistent_worker/"}],"\ninstead carries a Business Source License 1.1 header stating that use of the\nmodule requires an enterprise license agreement. That is a different obligation\nfrom the rest of the binary, and nothing in the binary enforces it; the module\nis compiled in and activates from the action, not from a flag you set. Read\n",["$","$L6",null,{"href":"/reference/oss-and-enterprise#persistent-workers-activate-from-the-action-not-from-your-config","children":"Open source and Enterprise"}],"\nfor what that means in practice, and\n",["$","$L6",null,{"href":"https://forge.com/license","children":"the license"}]," against your intended use, before\nyou build on this."]}]
c:["$","$L46",null,{"as":"h2","id":"opt-an-action-in","children":"Opt an action in"}]
d:["$","p",null,{"children":["The worker looks at two of the action's platform properties (the REAPI\n",["$","code",null,{"children":"Platform"}]," on the ",["$","code",null,{"children":"Action"}],"): ",["$","code",null,{"children":"supports-workers"}]," must be exactly ",["$","code",null,{"children":"1"}],", and\n",["$","code",null,{"children":"requires-worker-protocol"}]," picks the wire format. Nothing on the worker's own\n",["$","code",null,{"children":"platform_properties"}]," is involved."]}]
e:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-worker/src/running_actions_manager.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-worker/src/running_actions_manager.rs","data-source-ref":"v1.6.5","title":"forge-worker/src/running_actions_manager.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"action_supports_persistent_workers"]}]
f:["$","p",null,{"children":["Because the scheduler fails to match any action carrying a platform property\nkey it has not been told about (",["$","code",null,{"children":"Unknown platform property"}],"), declare both keys\non the scheduler. ",["$","code",null,{"children":"ignore"}]," lets actions request a key without any worker having\nto advertise it:"]}]
