0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#two-things-to-know-before-you-start","title":"Two things to know before you start"},{"depth":2,"url":"#opt-an-action-in","title":"Opt an action in"},{"depth":2,"url":"#what-makes-two-actions-share-a-process","title":"What makes two actions share a process"},{"depth":2,"url":"#the-isolation-you-give-up","title":"The isolation you give up"},{"depth":2,"url":"#the-pools-actual-behaviour","title":"The pool's actual behaviour"},{"depth":2,"url":"#steps","title":"Steps"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"}],"children":[["$","$L3",null,{"children":"Persistent workers"}],["$","$L4",null,{"children":"Keep a JVM or Node compiler process warm across actions instead of paying its startup cost every time, and understand exactly what Forge gives up to do it."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone whose remote builds are dominated by JVM or\nTypeScript compile actions. ",["$","strong",null,{"children":"What you'll have at the end:"}]," compile actions\nreusing a warm process, and a clear-eyed view of the isolation you trade for it.\n",["$","strong",null,{"children":"Time:"}]," an hour, most of it in your build rules rather than in Forge."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["Remote execution working end to end. See ",["$","$L6",null,{"href":"/remote-execution/first-remote-action","children":"Your first remote action"}],"."]}]}]]}],"\n",["$","p",null,{"children":["A ",["$","code",null,{"children":"javac"}]," invocation spends a large fraction of its wall time before it compiles\nanything: start a JVM, load the compiler, warm the JIT. Locally you amortize\nthat across a build because Bazel keeps the process alive. Under\n",["$","$L6",null,{"href":"/remote-execution","children":"remote execution"}]," the default is one process per action, so\nevery single compile pays the full tax, and a thousand-target Java build pays it\na thousand times."]}],"\n",["$","p",null,{"children":"Persistent workers remove that. The tool is started once, told it is a\npersistent worker, and then fed one request per action over stdin while staying\nalive between them."}],"\n",["$","$L7",null,{"children":"flowchart TB\nsubgraph OS[\"Default: one process per action\"]\n  A1[\"action 1\"] --> P1[\"start JVM → compile → exit\"]\n  A2[\"action 2\"] --> P2[\"start JVM → compile → exit\"]\n  A3[\"action 3\"] --> P3[\"start JVM → compile → exit\"]\nend\nsubgraph PW[\"Persistent: one process, many actions\"]\n  B1[\"action 1\"] --> W[\"javac_worker --persistent_worker\"]\n  B2[\"action 2\"] --> W\n  B3[\"action 3\"] --> W\n  W --> WW[\"JVM started once, stays warm\"]\nend"}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-worker/src/persistent_worker/pool.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-worker/src/persistent_worker/pool.rs","data-source-ref":"v1.6.5","title":"forge-worker/src/persistent_worker/pool.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":"$L8"}],"PersistentWorkerPool"]}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38"]}],"$L39"]}],["$L3a","$L3b"],"$L3c"]}],"isPartial":"$@3d","staleTime":"$3e","varyParams":null},{"rsc":"$L3f","isPartial":"$@40","staleTime":"$3e","varyParams":null},{"rsc":"$L41","isPartial":"$@42","staleTime":"$3e","varyParams":"$43"}],"isUpgradeableISRFallback":false,"a":"$@44","rootVaryParams":null,"needsRuntimeRequest":"$@45"}
