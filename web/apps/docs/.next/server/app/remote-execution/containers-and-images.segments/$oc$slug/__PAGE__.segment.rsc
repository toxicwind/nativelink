1a:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["The build reports actions as ",["$","code",null,{"children":"remote"}]," rather than sitting at ",["$","code",null,{"children":"0s remote"}],"."]}],"\n",["$","li",null,{"children":"Stopping the pool that advertises the requested image makes builds queue,\nand starting it drains them. That's the proof the routing is real rather\nthan everything falling through to one pool."}],"\n",["$","li",null,{"children":["With ",["$","code",null,{"children":"exact"}],", requesting a ",["$","em",null,{"children":"wrong"}]," image string queues indefinitely. If it\nsucceeds instead, the key is still declared ",["$","code",null,{"children":"priority"}]," somewhere."]}],"\n"]}]}]]}]
