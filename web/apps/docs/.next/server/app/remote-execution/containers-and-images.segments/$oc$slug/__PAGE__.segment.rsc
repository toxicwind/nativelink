f:["$","p",null,{"children":["A Forge worker image is any image that contains your toolchain and can\nrun the ",["$","code",null,{"children":"forge"}]," binary with a worker config. The repo's Nix helper,\n",["$","code",null,{"children":"createWorker"}],", turns a toolchain image into a ",["$","code",null,{"children":"forge-worker-*"}]," image:"]}]
