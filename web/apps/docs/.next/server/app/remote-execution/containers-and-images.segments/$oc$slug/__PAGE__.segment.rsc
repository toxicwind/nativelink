1d:["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Bring up the new pool first"}],", advertising the new image string, while\nthe old pool keeps running and advertising the old one. Both are now\nsatisfiable."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Switch what builds request."}]," New builds land on the new pool;\nin-flight ones finish on the old."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Drain and remove the old pool"}]," once nothing requests it."]}],"\n"]}]
1e:["$","p",null,{"children":"Doing this in the other order (changing the request before the pool exists,\nor removing the pool before builds stop asking for it) produces a queue that\nnever clears and no error anywhere."}]
