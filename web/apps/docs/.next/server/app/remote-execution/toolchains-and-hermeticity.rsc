ts.mdx","type":"page","name":"AI coding agents","description":"An agent's edit-build-test loop runs far more often than a human's, so build time sets both its wall clock and a large part of its token bill, and a shared cache turns most of those iterations into downloads.","icon":"$undefined","url":"/use-cases/ai-coding-agents","$ref":"use-cases/ai-coding-agents.mdx"},{"$id":"use-cases/autonomous-operation.mdx","type":"page","name":"Autonomous operation","description":"What it takes for a build farm to grow and shrink with demand without anyone watching it: which properties Forge gives you, which pieces you assemble yourself, and where the seams are.","icon":"$undefined","url":"/use-cases/autonomous-operation","$ref":"use-cases/autonomous-operation.mdx"},{"$id":"use-cases/silicon-and-large-builds.mdx","type":"page","name":"Silicon and large builds","description":"EDA flows, large C++ and LLVM trees, and ML graphs are the workloads remote execution was invented for: thousands of actions, hardware that differs from action to action, and a long tail that decides the wall clock.","icon":"$undefined","url":"/use-cases/silicon-and-large-builds","$ref":"use-cases/silicon-and-large-builds.mdx"}],"$id":"use-cases","$ref":{"folder":"use-cases","meta":"use-cases/meta.json"},"index":{"$id":"use-cases/index.mdx","type":"page","name":"Why Forge","description":"What Forge is, what a remote cache and remote execution actually do, and a 30-second check for whether your build is one that benefits.","icon":"$undefined","url":"/use-cases","$ref":"use-cases/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"Getting started","root":"$undefined","defaultOpen":true,"description":"$undefined","collapsible":"$undefined","children":[{"$id":"getting-started/quickstart.mdx","type":"page","name":"Quickstart","description":"Install Forge and point your build system at it in under 10 minutes.","icon":"$undefined","url":"/getting-started/quickstart","$ref":"getting-started/quickstart.mdx"},{"$id":"getting-started/verify-your-cache.mdx","type":"page","name":"Verify your cache","description":"Prove the cache is actually serving hits rather than quietly falling back to local work, using your build tool's own accounting, not a status page.","icon":"$undefined","url":"/getting-started/verify-your-cache","$ref":"getting-started/verify-your-cache.mdx"},{"type":"folder","name":"Connect your build","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"getting-started/connect-your-build/buck2.mdx","type":"page","name":"Buck2","description":"Configure Buck2 to use Forge for remote cache and execution.","icon":"$undefined","url":"/getting-started/connect-your-build/buck2","$ref":"getting-started/connect-your-build/buck2.mdx"},{"$id":"getting-started/connect-your-build/siso.mdx","type":"page","name":"Siso","description":"Point Siso at Forge for Chromium-style remote caching and execution.","icon":"$undefined","url":"/getting-started/connect-your-build/siso","$ref":"getting-started/connect-your-build/siso.mdx"},{"$id":"getting-started/connect-your-build/chromium.mdx","type":"page","name":"Chromium","description":"Building Chromium with Forge as the Siso backend, a worked example for the largest public consumer.","icon":"$undefined","url":"/getting-started/connect-your-build/chromium","$ref":"getting-started/connect-your-build/chromium.mdx"},{"$id":"getting-started/connect-your-build/pants.mdx","type":"page","name":"Pants","description":"Enable Pants remote caching with Forge.","icon":"$undefined","url":"/getting-started/connect-your-build/pants","$ref":"getting-started/connect-your-build/pants.mdx"},{"$id":"getting-started/connect-your-build/buildstream.mdx","type":"page","name":"BuildStream","description":"Configure BuildStream to use Forge for artifact storage and remote execution.","icon":"$undefined","url":"/getting-started/connect-your-build/buildstream","$ref":"getting-started/connect-your-build/buildstream.mdx"},{"$id":"getting-started/connect-your-build/cmake-recc.mdx","type":"page","name":"CMake with recc","description":"Accelerate CMake builds with Forge as a remote cache, using recc as the bridge.","icon":"$undefined","url":"/getting-started/connect-your-build/cmake-recc","$ref":"getting-started/connect-your-build/cmake-recc.mdx"}],"$id":"getting-started/connect-your-build","$ref":{"folder":"getting-started/connect-your-build","meta":"getting-started/connect-your-build/meta.json"},"index":{"$id":"getting-started/connect-your-build/index.mdx","type":"page","name":"Connect your build tool","description":"Use Forge without Bazel: Buck2, Siso, Pants, BuildStream, and CMake with recc.","icon":"$undefined","url":"/getting-started/connect-your-build","$ref":"getting-started/connect-your-build/index.mdx"},"icon":"$undefined"},{"$id":"getting-started/shared-cache.mdx","type":"page","name":"Shared cache","description":"Self-host Forge on hardware you control, with the operational checklist a team rollout actually needs.","icon":"$undefined","url":"/getting-started/shared-cache","$ref":"getting-started/shared-cache.mdx"}],"$id":"getting-started","$ref":{"folder":"getting-started","meta":"getting-started/meta.json"},"index":{"$id":"getting-started/index.mdx","type":"page","name":"Getting started","description":"The first section of the reading path: a cache running, connected to your build, proven to be hitting.","icon":"$undefined","url":"/getting-started","$ref":"getting-started/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"Remote execution","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"remote-execution/from-cache-to-execution.mdx","type":"page","name":"From cache to execution","description":"You have a cache serving hits. This is what changes when the misses stop running on your laptop: in the deployment, in the build invocation, and in what breaks first.","icon":"$undefined","url":"/remote-execution/from-cache-to-execution","$ref":"remote-execution/from-cache-to-execution.mdx"},{"$id":"remote-execution/first-remote-action.mdx","type":"page","name":"Your first remote action","description":"Run a scheduler and a worker on your own machine, point Bazel at them, and watch a build action execute somewhere other than where you typed the command.","icon":"$undefined","url":"/remote-execution/first-remote-action","$ref":"remote-execution/first-remote-action.mdx"},{"$id":"remote-execution/platform-properties.mdx","type":"page","name":"Platform properties","description":"How the scheduler decides which worker gets an action, why a mismatch queues forever instead of failing, and how to read the matching diagnostics it already emits.","icon":"$undefined","url":"/remote-execution/platform-properties","$ref":"remote-execution/platform-properties.mdx"},{"$id":"remote-execution/toolchains-and-hermeticity.mdx","type":"page","name":"Toolchains and hermeticity","description":"Your action ran on a worker and failed on a missing compiler. Here is why that happens, and how to pin the toolchain so local and remote builds hash identically.","icon":"$undefined","url":"/remote-execution/toolchains-and-hermeticity","$ref":"remote-execution/toolchains-and-hermeticity.mdx"},{"$id":"remote-execution/containers-and-images.mdx","type":"page","name":"Containers and images","description":"What the container-image property actually does (and doesn't), plus how to build worker images and keep what your build requests in sync with what your fleet advertises.","icon":"$undefined","url":"/remote-execution/containers-and-images","$ref":"remote-execution/containers-and-images.mdx"},{"$id":"remote-execution/persistent-workers.mdx","type":"page","name":"Persistent workers","description":"Keep a JVM or Node compiler process warm across actions instead of paying its startup cost every time, and understand exactly what Forge gives up to do it.","icon":"$undefined","url":"/remote-execution/persistent-workers","$ref":"remote-execution/persistent-workers.mdx"},{"$id":"remote-execution/local-testing.mdx","type":"page","name":"Local testing","description":"Keep a Forge cluster on your own machine to test config changes, reproduce scheduler behaviour, and prove a client works, in the two shapes the repo itself uses.","icon":"$undefined","url":"/remote-execution/local-testing","$ref":"remote-execution/local-testing.mdx"},{"$id":"remote-execution/examples-and-templates.mdx","type":"page","name":"Examples and templates","description":"Runnable configs, deployment topologies, and project scaffolds you can copy, plus the three client-side patterns most teams actually adopt.","icon":"$undefined","url":"/remote-execution/examples-and-templates","$ref":"remote-execution/examples-and-templates.mdx"}],"$id":"remote-execution","$ref":{"folder":"remote-execution","meta":"remote-execution/meta.json"},"index":{"$id":"remote-execution/index.mdx","type":"page","name":"Remote execution","description":"Workers that run the actions your cache misses.","icon":"$undefined","url":"/remote-execution","$ref":"remote-execution/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"Configuration","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"configuration/config-file.mdx","type":"page","name":"The config file","description":"JSON5 mechanics, environment substitution, how the binary is pointed at a config, and how to find out a config is wrong before it takes a cluster down with it.","icon":"$undefined","url":"/configuration/config-file","$ref":"configuration/config-file.mdx"},{"$id":"configuration/stores.mdx","type":"page","name":"Stores","description":"Declaring stores, naming them, and the idea that unlocks the rest of the config: stores compose, and one store refers to another by name.","icon":"$undefined","url":"/configuration/stores","$ref":"configuration/stores.mdx"},{"$id":"configuration/servers-and-services.mdx","type":"page","name":"Servers and services","description":"Listeners, the eleven services, instance names, and the port split that keeps the worker API off your public interface.","icon":"$undefined","url":"/configuration/servers-and-services","$ref":"configuration/servers-and-services.mdx"},{"$id":"configuration/scheduler-and-workers.mdx","type":"page","name":"Schedulers and workers","description":"The minimum config for each, the properties contract between them, and the fields that decide what happens when something goes wrong.","icon":"$undefined","url":"/configuration/scheduler-and-workers","$ref":"configuration/scheduler-and-workers.mdx"},{"$id":"configuration/your-first-full-config.mdx","type":"page","name":"Your first full config","description":"An empty file to a running cache-and-execution cluster, one block at a time, checking after each.","icon":"$undefined","url":"/configuration/your-first-full-config","$ref":"configuration/your-first-full-config.mdx"}],"$id":"configuration","$ref":{"folder":"configuration","meta":"configuration/meta.json"},"index":{"$id":"configuration/index.mdx","type":"page","name":"Configuration","description":"The config model on one page, so you can read and write a Forge config instead of copying one.","icon":"$undefined","url":"/configuration","$ref":"configuration/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"How-to guides","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"type":"folder","name":"Storage backends","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"how-to/stores/filesystem.mdx","type":"page","name":"Filesystem store","description":"Put the cache on local disk: the two paths that must share a block device, the eviction policy you cannot skip, and the tuning knobs that matter on real hardware.","icon":"$undefined","url":"/how-to/stores/filesystem","$ref":"how-to/stores/filesystem.mdx"},{"$id":"how-to/stores/s3-and-compatible.mdx","type":"page","name":"S3 and compatible","description":"Back the cache with Amazon S3, Cloudflare R2 or NetApp ONTAP S3: one store type, three providers, and the shared options that decide cost and failure behaviour.","icon":"$undefined","url":"/how-to/stores/s3-and-compatible","$ref":"how-to/stores/s3-and-compatible.mdx"},{"$id":"how-to/stores/gcs.mdx","type":"page","name":"Google Cloud Storage","description":"Back the cache with a GCS bucket: authentication, the resumable-upload chunk size, and the timeout fields whose names disagree with their units.","icon":"$undefined","url":"/how-to/stores/gcs","$ref":"how-to/stores/gcs.mdx"},{"$id":"how-to/stores/azure.mdx","type":"page","name":"Azure Blob Storage","description":"Back the cache with an Azure Blob container: account and container naming, the endpoint override for Azurite, and when a SAS URL replaces everything else.","icon":"$undefined","url":"/how-to/stores/azure","$ref":"how-to/stores/azure.mdx"},{"$id":"how-to/stores/redis.mdx","type":"page","name":"Redis","description":"Back the cache with Redis (standalone, sentinel or cluster) and the concurrency, chunking and timeout settings that keep it from timing out under a real build.","icon":"$undefined","url":"/how-to/stores/redis","$ref":"how-to/stores/redis.mdx"},{"$id":"how-to/stores/mongo.mdx","type":"page","name":"MongoDB","description":"Back the cache with MongoDB: collections, write concern, timeouts, and what the change-streams flag is for.","icon":"$undefined","url":"/how-to/stores/mongo","$ref":"how-to/stores/mongo.mdx"},{"$id":"how-to/stores/oci-object-storage.mdx","type":"page","name":"Oracle Cloud (OCI) Object Storage","description":"Back the cache with OCI Object Storage through its S3 Compatibility API: Customer Secret Keys, the two adjustments the store makes for you, and what has actually been verified.","icon":"$undefined","url":"/how-to/stores/oci-object-storage","$ref":"how-to/stores/oci-object-storage.mdx"},{"$id":"how-to/stores/compose-stores.mdx","type":"page","name":"Compose stores","description":"The wrapper vocabulary (fast_slow, verify, dedup, existence_cache, size_partitioning, shard and the rest) and the order the layers have to go in.","icon":"$undefined","url":"/how-to/stores/compose-stores","$ref":"how-to/stores/compose-stores.mdx"},{"$id":"how-to/stores/compression.mdx","type":"page","name":"Remote cache compression","description":"Cut remote cache transfer bytes for compressible artifacts with REAPI zstd wire compression and Bazel's --remote_cache_compression.","icon":"$undefined","url":"/how-to/stores/compression","$ref":"how-to/stores/compression.mdx"},{"$id":"how-to/stores/chunking-and-dedup.mdx","type":"page","name":"Content-defined chunking","description":"Cut remote cache transfer bytes by 80-90% for incrementally changing artifacts with the REAPI SplitBlob/SpliceBlob extension and Bazel's --experimental_remote_cache_chunking.","icon":"$undefined","url":"/how-to/stores/chunking-and-dedup","$ref":"how-to/stores/chunking-and-dedup.mdx"}],"$id":"how-to/stores","$ref":{"folder":"how-to/stores","meta":"how-to/stores/meta.json"},"index":{"$id":"how-to/stores/index.mdx","type":"page","name":"Storage backends","description":"Every place Forge can put bytes, compared on durability, latency and cost, and the composition almost every real deployment lands on.","icon":"$undefined","url":"/how-to/stores","$ref":"how-to/stores/index.mdx"},"icon":"$undefined"},{"$id":"how-to/run-multiple-workers.mdx","type":"page","name":"Run multiple workers","description":"Add workers to a running Forge: how they share the CAS, how the scheduler matches them, and the two things about the shipped compose example that will mislead you.","icon":"$undefined","url":"/how-to/run-multiple-workers","$ref":"how-to/run-multiple-workers.mdx"},{"$id":"how-to/tls-and-auth.mdx","type":"page","name":"TLS and authentication","description":"Put TLS on the listeners clients reach, use mutual TLS as the access control, and understand exactly what Forge does and does not authenticate.","icon":"$undefined","url":"/how-to/tls-and-auth","$ref":"how-to/tls-and-auth.mdx"},{"$id":"how-to/upgrade-versions.mdx","type":"page","name":"Upgrade to a newer version","description":"Read the changelog for the things that actually break, upgrade the three process types in the right order, and know what happens to the cache you already have.","icon":"$undefined","url":"/how-to/upgrade-versions","$ref":"how-to/upgrade-versions.mdx"},{"$id":"how-to/migrate-an-existing-cache.mdx","type":"page","name":"Migrate from another REAPI cache","description":"Put Forge in front of your existing cache as a read-only diode, let real builds warm it, and cut over when the hit rate says you can.","icon":"$undefined","url":"/how-to/migrate-an-existing-cache","$ref":"how-to/migrate-an-existing-cache.mdx"}],"$id":"how-to","$ref":{"folder":"how-to","meta":"how-to/meta.json"},"index":{"$id":"how-to/index.mdx","type":"page","name":"How-to guides","description":"Pick the task you're doing, not the artifact you're reading about.","icon":"$undefined","url":"/how-to","$ref":"how-to/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"Operate","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"operate/production-config.mdx","type":"page","name":"Production configuration","description":"The shape a real Forge cluster runs in: three processes, a split port surface, and what to turn on before other people depend on it.","icon":"$undefined","url":"/operate/production-config","$ref":"operate/production-config.mdx"},{"$id":"operate/tuning.mdx","type":"page","name":"Tuning","description":"The lever table: the signal you observe, the knob that moves it, the direction to turn it, and what turning it costs.","icon":"$undefined","url":"/operate/tuning","$ref":"operate/tuning.mdx"},{"$id":"operate/deploy-docker-compose.mdx","type":"page","name":"Deploy with Docker Compose","description":"Bring up a complete CAS, scheduler and worker on one host with the compose files in the repository: what each service is, which ports it publishes, and the four things that make this a development setup rather than a production one.","icon":"$undefined","url":"/operate/deploy-docker-compose","$ref":"operate/deploy-docker-compose.mdx"},{"$id":"operate/deploy-bare-metal.mdx","type":"page","name":"Deploy on bare metal","description":"Run Forge as systemd services on hosts you own: writing the units, sizing the machines, placing the disks, and rolling an upgrade without dropping in-flight actions.","icon":"$undefined","url":"/operate/deploy-bare-metal","$ref":"operate/deploy-bare-metal.mdx"},{"$id":"operate/observability.mdx","type":"page","name":"Observability","description":"Forge pushes OTLP and nothing else. Wire it to a collector, get the series into Prometheus under the names the shipped rules expect, and know which environment variables actually do something.","icon":"$undefined","url":"/operate/observability","$ref":"operate/observability.mdx"},{"$id":"operate/security-hardening.mdx","type":"page","name":"Security hardening","description":"Open-source Forge has no inbound authentication on any service. What that means for your network, which ports must never be routable, how to configure mTLS, and why the worker sandbox is not a security boundary.","icon":"$undefined","url":"/operate/security-hardening","$ref":"operate/security-hardening.mdx"},{"$id":"operate/scaling-workers.mdx","type":"page","name":"Scaling workers","description":"How much work one worker should take, how many workers you need, which signal tells you, and how to let something else make the decision, including the parts Forge does not enforce for you.","icon":"$undefined","url":"/operate/scaling-workers","$ref":"operate/scaling-workers.mdx"},{"$id":"operate/scaling-cas.mdx","type":"page","name":"Scaling the CAS","description":"How to grow the content-addressable store: composing tiers, sizing eviction, sharding, and the specific reasons a second CAS replica is harder than a second worker.","icon":"$undefined","url":"/operate/scaling-cas","$ref":"operate/scaling-cas.mdx"},{"$id":"operate/autoscaling-reference.mdx","type":"page","name":"An autoscaling reference deployment","description":"The complete Kubernetes deployment that scales workers on queue depth without a human in the loop: every manifest, the reaction-time budget nobody publishes, and the five gaps in the shipped examples you have to close first.","icon":"$undefined","url":"/operate/autoscaling-reference","$ref":"operate/autoscaling-reference.mdx"},{"$id":"operate/runbooks.mdx","type":"page","name":"Runbooks","description":"What to do when a Forge deployment is on fire: Redis failover, a worker OOM-killed, the disk full, and the queue backpressured. Each entry is a symptom, the signal that confirms it, the immediate action, and the change that stops it recurring.","icon":"$undefined","url":"/operate/runbooks","$ref":"operate/runbooks.mdx"},{"$id":"operate/troubleshooting.mdx","type":"page","name":"Troubleshooting","description":"A symptom-to-cause-to-fix index for Forge, anchored on the error strings the system actually emits, including the ones that say nothing useful, and the failures that produce no error at all.","icon":"$undefined","url":"/operate/troubleshooting","$ref":"operate/troubleshooting.mdx"}],"$id":"operate","$ref":{"folder":"operate","meta":"operate/meta.json"},"index":{"$id":"operate/index.mdx","type":"page","name":"Operate","description":"What to watch, what to tune, and what to do at 3am, once other people depend on your cluster.","icon":"$undefined","url":"/operate","$ref":"operate/index.mdx"},"icon":"$undefined"},{"type":"folder","name":"Concepts","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"explanations/architecture.mdx","type":"page","name":"Architecture","description":"The four roles, who actually writes to the action cache, and which parts of the system hold state you can lose.","icon":"$undefined","url":"/explanations/architecture","$ref":"explanations/architecture.mdx"},{"$id":"explanations/architecture-deep-dive.mdx","type":"page","name":"Architecture deep dive","description":"The crate graph, the startup sequence, and the path an action actually takes through the binary.","icon":"$undefined","url":"/explanations/architecture-deep-dive","$ref":"explanations/architecture-deep-dive.mdx"},{"$id":"explanations/store-model.mdx","type":"page","name":"The store model","description":"What a store actually is, how composition behaves, and where a digest stops being a claim and becomes a fact.","icon":"$undefined","url":"/explanations/store-model","$ref":"explanations/store-model.mdx"},{"$id":"explanations/scheduler-internals.mdx","type":"page","name":"Scheduler internals","description":"Action merging, the awaited-action database, how a worker is chosen, and what happens when an action fails.","icon":"$undefined","url":"/explanations/scheduler-internals","$ref":"explanations/scheduler-internals.mdx"},{"$id":"explanations/worker-execution.mdx","type":"page","name":"Worker execution","description":"How an action becomes a running process: input materialization, what isolation you actually get, and what the worker throws away.","icon":"$undefined","url":"/explanations/worker-execution","$ref":"explanations/worker-execution.mdx"},{"$id":"explanations/correctness-hermeticity.mdx","type":"page","name":"Correctness and hermeticity","description":"What content addressing guarantees, what it doesn't, and which of the gaps are yours to close.","icon":"$undefined","url":"/explanations/correctness-hermeticity","$ref":"explanations/correctness-hermeticity.mdx"},{"$id":"explanations/lre.mdx","type":"page","name":"Local Remote Execution","description":"What LRE actually is: a way to make your local toolchain and your remote workers the same toolchain, so both sides share one cache.","icon":"$undefined","url":"/explanations/lre","$ref":"explanations/lre.mdx"},{"$id":"explanations/history.mdx","type":"page","name":"History and licensing","description":"What Forge was built to replace, the three properties that drove the rewrite, and exactly how the source is licensed.","icon":"$undefined","url":"/explanations/history","$ref":"explanations/history.mdx"}],"$id":"explanations","$ref":{"folder":"explanations","meta":"explanations/meta.json"},"icon":"$undefined"},{"type":"folder","name":"Reference","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"type":"folder","name":"Forge config","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"reference/forge-config/store-overview.mdx","type":"page","name":"Store overview","description":"The mental model behind every store in the configuration reference: what holds data, what wraps another store, and how they compose.","icon":"$undefined","url":"/reference/forge-config/store-overview","$ref":"reference/forge-config/store-overview.mdx"}],"$id":"reference/forge-config","$ref":{"folder":"reference/forge-config","meta":"reference/forge-config/meta.json"},"index":{"$id":"reference/forge-config/index.mdx","type":"page","name":"Configuration reference","description":"Every knob in the Forge JSON5 configuration — types, defaults, and links to source, autogenerated from the Rust config crate.","icon":"$undefined","url":"/reference/forge-config","$ref":"reference/forge-config/index.mdx"},"icon":"$undefined"},{"$id":"reference/protocol-api.mdx","type":"page","name":"Protocol and API surface","description":"Every gRPC service Forge serves, which RPCs are implemented, and the values it advertises.","icon":"$undefined","url":"/reference/protocol-api","$ref":"reference/protocol-api.mdx"},{"$id":"reference/metrics.mdx","type":"page","name":"Metrics reference","description":"Every OpenTelemetry instrument Forge declares, with its type, unit, attributes, Prometheus series, and whether the binary actually emits it. Autogenerated from the Rust source and its call sites.","icon":"$undefined","url":"/reference/metrics","$ref":"reference/metrics.mdx"},{"$id":"reference/cli-and-env.mdx","type":"page","name":"CLI and environment","description":"Every command-line argument the forge binary accepts and every environment variable it reads: the telemetry variables, the ones the configuration expands, and the ones it passes through to actions.","icon":"$undefined","url":"/reference/cli-and-env","$ref":"reference/cli-and-env.mdx"},{"$id":"reference/oss-and-enterprise.mdx","type":"page","name":"Open source and Enterprise","description":"What the open-source distribution actually contains, which two modules are licensed differently, why nothing in the binary enforces that, and what the paid tiers are for.","icon":"$undefined","url":"/reference/oss-and-enterprise","$ref":"reference/oss-and-enterprise.mdx"},{"$id":"reference/glossary.mdx","type":"page","name":"Glossary","description":"The vocabulary you need to read the rest of the docs.","icon":"$undefined","url":"/reference/glossary","$ref":"reference/glossary.mdx"},{"$id":"reference/changelog.md","type":"page","name":"Changelog","description":"Notable changes per release. Latest first.","icon":"$undefined","url":"/reference/changelog","$ref":"reference/changelog.md"}],"$id":"reference","$ref":{"folder":"reference","meta":"reference/meta.json"},"icon":"$undefined"},{"type":"folder","name":"Contribute","root":"$undefined","defaultOpen":"$undefined","description":"$undefined","collapsible":"$undefined","children":[{"$id":"contribute/guidelines.mdx","type":"page","name":"Contribution guidelines","description":"What Forge accepts, the git setup it requires, and the commit and review conventions a PR is held to.","icon":"$un