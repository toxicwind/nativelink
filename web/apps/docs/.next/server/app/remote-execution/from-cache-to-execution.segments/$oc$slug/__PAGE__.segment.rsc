b:["$","$L30",null,{"children":"flowchart LR\n  C[your build tool]\n  S[scheduler]\n  W[worker]\n  CAS[(\"CAS + Action Cache\\n(already yours from Getting started)\")]\n\n  C -->|\"Execute()\"| S\n  C -->|\"read / write blobs\"| CAS\n  S -->|\"worker API :50061\"| W\n  W -->|\"fetch inputs\\nupload outputs\"| CAS\n  S -.->|reads action digests| CAS"}]
c:["$","p",null,{"children":[["$","strong",null,{"children":"A scheduler."}]," It owns the queue and the matching engine. It holds no\nblobs of its own; it reads the CAS through a ",["$","code",null,{"children":"grpc"}]," store pointed at the\nCAS process, and its whole job is deciding which worker gets which action."]}]
d:["$","p",null,{"children":[["$","strong",null,{"children":"At least one worker."}]," It connects ",["$","em",null,{"children":"outward"}]," to the scheduler, announces\nwhat it can do, and then pulls actions. Workers do not listen for client\ntraffic; a worker config has an empty ",["$","code",null,{"children":"servers"}]," array."]}]
e:["$","p",null,{"children":[["$","strong",null,{"children":["The ",["$","code",null,{"children":"execution"}]," service on a server."]}]," This is the client-facing half:\nthe ",["$","code",null,{"children":"Execute"}]," and ",["$","code",null,{"children":"WaitExecution"}]," RPCs your build tool calls. It sits\nalongside the ",["$","code",null,{"children":"cas"}]," and ",["$","code",null,{"children":"ac"}]," services you already have, and it needs a\n",["$","code",null,{"children":"scheduler"}]," reference."]}]
f:["$","p",null,{"children":["And one port that is genuinely new in a way that matters: the ",["$","strong",null,{"children":"worker API"}],"\nlistener, ",["$","code",null,{"children":"50061"}]," in every example config in the repo that has one. Workers register\nthere. It is a backend port with a completely different permission set from\nthe client port, and it must not be reachable from where your clients are.\n",["$","$L6",null,{"href":"/operate/production-config#which-ports-are-public","children":"Production configuration"}],"\nis blunt about why."]}]
10:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"The worker API is not a client port"}],[["$","p",null,{"children":"Anything that can reach the worker API can register as a worker and\nreceive actions to execute, which means arbitrary commands, from your\nbuild, running on its machine, with your CAS credentials. Bind it to a\nprivate network. The repo's own example config says so in a comment."}],["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/examples/local_rbe_self_test.json5","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/examples/local_rbe_self_test.json5","data-source-ref":"v1.6.5","title":"forge-config/examples/local_rbe_self_test.json5 at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"local_rbe_self_test.json5"]}]]]}]]}]
