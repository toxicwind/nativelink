11:["$","ol",null,{"children":["\n",["$","li",null,{"children":["Bazel uploaded the action's inputs to the ",["$","strong",null,{"children":"CAS"}]," and asked the\n",["$","strong",null,{"children":"execution service"}]," to run it."]}],"\n",["$","li",null,{"children":["The execution service handed the action to the ",["$","strong",null,{"children":"scheduler"}],", which\ncompared what the action asked for (",["$","code",null,{"children":"cpu_count=1"}],") against what the\nregistered worker advertised (",["$","code",null,{"children":"cpu_count: 1"}],") and found a match."]}],"\n",["$","li",null,{"children":["The ",["$","strong",null,{"children":"worker"}]," fetched the inputs from the CAS by digest, hardlinked them\ninto a sandbox under its ",["$","code",null,{"children":"work_directory"}],", and ran the command."]}],"\n",["$","li",null,{"children":["The worker uploaded the outputs back to the CAS and the result to the\n",["$","strong",null,{"children":"action cache"}],", and the scheduler streamed completion back to Bazel."]}],"\n"]}]
