d:["$","div",null,{"data-verify-block":"","className":"my-6 rounded-xl border border-success/40 bg-success-soft/50 px-5 py-4","children":[["$","p",null,{"className":"mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-foreground","children":[["$","svg",null,{"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.25","strokeLinecap":"round","strokeLinejoin":"round","className":"shrink-0 text-success","aria-hidden":"true","children":["$","path",null,{"d":"M20 6 9 17l-5-5"}]}],"You did it right if"]}],["$","div",null,{"className":"[&>p]:my-0 [&>p+p]:mt-2 [&>ul]:my-0","children":["$","ul",null,{"children":["\n",["$","li",null,{"children":["The server's log shows ",["$","code",null,{"children":"Worker registered with scheduler"}]," before you run\nthe build."]}],"\n",["$","li",null,{"children":["The build event log reports ",["$","code",null,{"children":"strategy"}]," as ",["$","code",null,{"children":"remote"}],", not ",["$","code",null,{"children":"local"}]," or\n",["$","code",null,{"children":"worker"}],"."]}],"\n",["$","li",null,{"children":["The server's log shows ",["$","code",null,{"children":"Executing command"}]," from the in-process worker, so\nthe action left the queue rather than sitting in it."]}],"\n",["$","li",null,{"children":["Running the same build again ",["$","em",null,{"children":"without"}]," ",["$","code",null,{"children":"--nocache_test_results"}]," completes\nnear-instantly: the worker's output went into your action cache, so the\nsecond run is a cache hit."]}],"\n"]}]}]]}]
e:["$","p",null,{"children":["That last one is the point of the whole reading path in miniature: remote execution\ndoesn't replace your cache, it ",["$","em",null,{"children":"fills"}]," it. Every action a worker completes\nbecomes a hit for whoever asks next."]}]
