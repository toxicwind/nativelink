0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#get-the-config","title":"Get the config"},{"depth":3,"url":"#start-the-cluster","title":"Start the cluster"},{"depth":3,"url":"#confirm-the-worker-registered","title":"Confirm the worker registered"},{"depth":3,"url":"#point-a-build-at-it","title":"Point a build at it"},{"depth":3,"url":"#read-the-result","title":"Read the result"},{"depth":2,"url":"#what-just-happened","title":"What just happened"},{"depth":2,"url":"#when-it-doesnt-work","title":"When it doesn't work"},{"depth":2,"url":"#faq","title":"FAQ"}],"children":[["$","$L3",null,{"children":"Your first remote action"}],["$","$L4",null,{"children":"Run a scheduler and a worker on your own machine, point Bazel at them, and watch a build action execute somewhere other than where you typed the command."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone with a working cache who wants to see remote\nexecution actually run. ",["$","strong",null,{"children":"What you'll have at the end:"}]," a build whose\nactions Bazel reports as ",["$","code",null,{"children":"remote"}],", running against a scheduler and worker\nyou started yourself. ",["$","strong",null,{"children":"Time:"}]," about fifteen minutes."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A cache serving hits to your build. If you don't have one yet, start with ",["$","$L6",null,{"href":"/getting-started","children":"Getting started"}],"."]}]}]]}],"\n",["$","p",null,{"children":["The goal here is deliberately small: prove the ",["$","em",null,{"children":"protocol"}]," works before you\ntouch anything else. Everything runs on your machine, in one process, using\nthe toolchain already on your ",["$","code",null,{"children":"PATH"}],". No containers to build, no fleet to\nprovision, no hermeticity questions yet; those come next, and they're much\neasier to debug once you know the wiring is sound."]}],"\n",["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-brand/40 bg-brand-soft/40 text-foreground","role":"note","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-brand","aria-hidden":"true","children":["$","path",null,{"d":"M12 16v-4M12 8h.01M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"What you need"}],["$","p",null,{"children":["A Bazel workspace you can build (any one will do; the Forge repo\nitself works), and either Docker or Nix. Up to about 4 GB of free disk\nunder ",["$","code",null,{"children":"/tmp"}]," for the caches this creates (the three filesystem stores in\nthe config cap at 2 GB, 200 MB, and 2 GB)."]}]]}]]}],"\n",["$","$L7",null,{"as":"h2","id":"get-the-config","children":"Get the config"}],"\n",["$","p",null,{"children":"The repo ships a config that is exactly this tutorial: CAS, action cache,\nscheduler, and one worker, all in a single process on localhost."}],"\n",["$","$L8",null,{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"m 4,4 a 1,1 0 0 0 -0.7070312,0.2929687 1,1 0 0 0 0,1.