33:["$","p",null,{"children":["Not every field is expanded; the wrapper is applied per field, so whether a\ngiven key supports substitution depends on how its struct member is annotated.\nNumeric, boolean, duration and data-size fields have their own expanding\ndeserializers, which is why ",["$","code",null,{"children":"max_bytes"}]," above accepts the ",["$","em",null,{"children":"string"}]," ",["$","code",null,{"children":"\"100mb\""}],"\nrather than a number. When in doubt, the\n",["$","$L1e",null,{"href":"/reference/forge-config","children":"configuration reference"}]," records the type each\nfield actually deserializes from."]}]
