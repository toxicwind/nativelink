21:["$","p",null,{"children":["A worker does not forward its own environment to the commands it runs: the\nchild is spawned with ",["$","code",null,{"children":"env_clear()"}],". An action sees exactly two things: the\n",["$","code",null,{"children":"environment_variables"}]," its own ",["$","code",null,{"children":"Command"}]," message carries, and whatever the\nworker's ",["$","code",null,{"children":"additional_environment"}]," map (on the ",["$","code",null,{"children":"local"}]," worker configuration)\nnames explicitly."]}]
