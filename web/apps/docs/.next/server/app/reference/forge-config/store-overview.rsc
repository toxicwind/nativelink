n":"MongoDB"}],["$","td",null,{"children":"Supports CAS and scheduler data, with optional change streams for scheduler subscriptions."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"grpc"}]}],["$","td",null,{"children":"Another Forge-compatible gRPC endpoint"}],["$","td",null,{"children":"Proxies calls upstream. Useful for a regional cache in front of a central cluster."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ref_store"}]}],["$","td",null,{"children":"Nothing itself; points at another store by name"}],["$","td",null,{"children":"Lets two composition trees share one underlying store instance (see below)."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"noop"}]}],["$","td",null,{"children":"Nothing"}],["$","td",null,{"children":"Reads 404. Writes vanish. Used to explicitly discard a partition of data."}]]}]]}]]}]}]
