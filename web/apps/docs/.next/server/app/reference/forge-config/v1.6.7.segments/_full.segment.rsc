1ed:["$","td",null,{"children":["Optional and experimental: coalesce small-blob reads into ",["$","code",null,{"children":"BatchReadBlobs"}]," RPCs instead of issuing one ",["$","code",null,{"children":"ByteStream"}]," ",["$","code",null,{"children":"Read"}]," stream per blob. Each ",["$","code",null,{"children":"ByteStream"}]," read carries a fixed per-RPC cost, so batching many small reads into a single ",["$","code",null,{"children":"BatchReadBlobs"}]," request can dramatically reduce read latency for small blobs."]}]
