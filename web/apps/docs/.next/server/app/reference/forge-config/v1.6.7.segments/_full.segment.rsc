88:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Content is mostly the same (inserts, updates, deletes are ok)"}],"\n",["$","li",null,{"children":"Content is not compressed or encrypted"}],"\n",["$","li",null,{"children":["Uploading or downloading from ",["$","code",null,{"children":"content_store"}]," is the bottleneck."]}],"\n"]}]
89:["$","p",null,{"children":["Note: This store pairs well when used with ",["$","code",null,{"children":"CompressionSpec"}]," as\nthe ",["$","code",null,{"children":"content_store"}],", but never put ",["$","code",null,{"children":"DedupSpec"}]," as the backend of\n",["$","code",null,{"children":"CompressionSpec"}]," as it will negate all the gains."]}]
