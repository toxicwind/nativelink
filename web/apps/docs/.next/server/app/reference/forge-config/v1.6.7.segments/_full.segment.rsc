14c:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","code",null,{"children":"property"}],": string — The name of the platform property in the action to get the value from."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"value"}],": string — The raw value to set."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"from_environment\""}]," — Take the value from the local environment corresponding to the name key"]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"timeout_millis\""}]," — The max amount of time in milliseconds the command is allowed to run (requested by the client)."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"side_channel_file\""}]," — A special file path will be provided that can be used to communicate with the parent process about out-of-band information. This file will be read after the command has finished executing. Based on the contents of the file, the behavior of the result may be modified."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"action_directory\""}]," — A \"root\" directory for the action. This directory can be used to store temporary files that are not needed after the action has completed. This directory will be purged after the action has completed."]}],"\n"]}]
