}]}],["$","td",null,{"children":["$","$L57",null,{"href":"#uploadcacheresultsstrategy","children":"UploadCacheResultsStrategy"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"FailuresOnly"}]}],["$","td",null,{"children":["In which situations should the results be published to the historical CAS. The historical CAS is where failures are published. These messages conform to the CAS key-value lookup format and are always a ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," serialized message."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"success_message_template"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"\"\" (no message)"}],["$","td",null,{"children":["Template to use for the ",["$","code",null,{"children":"ExecuteResponse.message"}]," property. This message is attached to the response before it is sent to the client. The following special variables are supported:; ",["$","code",null,{"children":"digest_function"}],": Digest function used to calculate the action digest: ",["$","code",null,{"children":"action_digest_hash"}],": Action digest hash: ",["$","code",null,{"children":"action_digest_size"}],": Action digest size: ",["$","code",null,{"children":"historical_results_hash"}],": ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," digest hash: ",["$","code",null,{"children":"historical_results_size"}],": ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," digest size."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"failure_message_template"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"\"\" (no message)"}],["$","td",null,{"children":["Same as ",["$","code",null,{"children":"success_message_template"}]," but for failure case."]}]]}]]}]]}]}]
