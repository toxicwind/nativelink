1f8:["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_precondition_script"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"An optional script to run before every action is processed on the worker. The value should be the full path to the script to execute and will pause all actions on the worker if it returns an exit code other than 0. If not set, then the worker will never pause and will continue to accept jobs according to the scheduler configuration. This is useful, for example, if the worker should not take any more actions until there is enough resource available on the machine to handle them."}]]}]
