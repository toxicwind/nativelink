14e:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_entries"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"1000"}],["$","td",null,{"children":"Maximum number of cached directories."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_size_bytes"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"10737418240 (10 GB)"}],["$","td",null,{"children":"Maximum total size in bytes for all cached directories (0 = unlimited)."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"cache_root"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"{work_directory}/../directory_cache"}]}],["$","td",null,{"children":["Base directory for cache storage. This directory will be managed by the worker and should be on the same filesystem as ",["$","code",null,{"children":"work_directory"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_subtree_caching"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"false (only root directories are cached; existing behavior)"}],["$","td",null,{"children":["Optional and experimental: additionally cache every subdirectory by its own ",["$","code",null,{"children":"Directory"}]," digest, not just the root directory. REAPI Merkle nodes are content-addressed, so a subtree that is byte-identical between two different roots has the same digest and can be materialized with a single hardlink pass instead of being rebuilt from the CAS. This makes the common \"one input file changed out of thousands\" case reuse every unchanged subtree."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_concurrent_fetches"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"64"}],["$","td",null,{"children":"Maximum number of concurrent slow-store fetches across ALL directory constructions of this cache. This bound protects backing stores from RPC storms: per-level construction concurrency compounds multiplicatively across tree levels and concurrent actions."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_get_tree_prefetch"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"false"}],["$","td",null,{"children":["On a directory-cache miss, prefetch every ",["$","code",null,{"children":"Directory"}]," proto of the tree with one logical ",["$","code",null,{"children":"GetTree"}]," traversal instead of fetching protos level by level (which costs one round trip per tree DEPTH). The [REAPI request contract] permits servers to impose their own limit even when no page size is specified, and the [REAPI response contract] requires clients to continue with the returned page token. A paginated traversal may therefore use multiple RPCs. Only takes effect when the slow tier is a ",["$","code",null,{"children":"grpc"}]," store; any prefetch failure falls back to the per-level path. Worthwhile when worker-to-CAS latency is non-trivial and trees are deep; measured 5-34x on the proto phase at 5-25ms RTT. Note the serving CAS pays the tree walk against its own backend, so its directory protos should be served from a fast tier."]}]]}]]}]]}]}]
