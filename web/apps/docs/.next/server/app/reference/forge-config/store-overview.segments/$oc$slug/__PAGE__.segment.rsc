12:["$","p",null,{"children":["Every store type is either ",["$","strong",null,{"children":"terminal"}]," (it actually holds or fetches\nbytes) or a ",["$","strong",null,{"children":"wrapper"}]," (it adds behavior in front of another store,\nwhich it embeds as a nested ",["$","code",null,{"children":"StoreSpec"}],"). Wrappers nest arbitrarily\ndeep: a ",["$","code",null,{"children":"verify"}]," can wrap a ",["$","code",null,{"children":"compression"}],", which wraps a ",["$","code",null,{"children":"fast_slow"}],",\nwhich wraps two more terminal stores:"]}]
13:["$","$L37",null,{"children":"flowchart LR\n  V[\"verify\\n(hash + size check)\"] --> C[\"compression\\n(lz4)\"]\n  C --> F[\"fast_slow\"]\n  F -->|fast| M[(\"memory\")]\n  F -->|slow| D[(\"filesystem\")]"}]
14:["$","p",null,{"children":"Reads and writes flow through every wrapper in order. Nothing about the\nclient changes; it still speaks plain CAS/AC RPCs against whatever\nstore name the server exposes."}]
