ren":"—"}],["$","td",null,{"children":["$","code",null,{"children":"memory_kb"}]}],["$","td",null,{"children":"Platform property carrying the action's memory reservation in KiB, as the scheduler sends it. An action without the property is not enforced."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"memory_headroom_percent"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"20"}],["$","td",null,{"children":"Percent above the reservation an action may reach before it is killed."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"disk_headroom_percent"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"20"}],["$","td",null,{"children":["Percent above its disk reservation an action's own files may reach before it is killed, with ",["$","code",null,{"children":"disk: soft"}],"."]}]]}]]}]]}]}]
