238:["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_job_retries"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"3"}],["$","td",null,{"children":["If a job returns an internal error or times out this many times the scheduler completes it with ",["$","code",null,{"children":"FailedPrecondition"}]," carrying the last error, a code clients do not retry. This is to help prevent one rogue job from infinitely retrying and taking up a lot of resources when the task itself is the one causing the server to go into a bad state. A lost worker and a memory escalation are not the action's failures and have their own budgets: ",["$","code",null,{"children":"max_worker_loss_retries"}]," and ",["$","code",null,{"children":"memory_escalation.max_steps"}],"."]}]]}]
