14a:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"enabled"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"true"}],["$","td",null,{"children":["Run an action whose platform properties carry ",["$","code",null,{"children":"supports-workers=1"}]," in a pooled worker process that outlives it and serves the next action with the same executable, startup arguments and environment. Off, every such action runs as a one-shot process like any other."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_workers_per_key"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"4"}],["$","td",null,{"children":["Most worker processes kept per key (executable, startup arguments, environment, protocol). An action whose key is at the cap and has no idle process waits ",["$","code",null,{"children":"acquire_timeout_s"}]," for one to come back, then runs one-shot. 0 takes the default."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"idle_timeout_s"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"300"}],["$","td",null,{"children":"Seconds an idle worker process is kept before the sweeper shuts it down. 0 takes the default."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_requests_per_worker"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"200"}],["$","td",null,{"children":"Requests a worker process serves before it is retired and replaced, which bounds what a long-lived process accumulates. 0 takes the default."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"shutdown_grace_ms"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"5000"}],["$","td",null,{"children":"Milliseconds a worker process being shut down gets to exit on its own (its stdin is closed) before SIGKILL. 0 takes the default."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"acquire_timeout_s"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"30"}],["$","td",null,{"children":["Seconds an action waits for a worker process to come back when its key is at ",["$","code",null,{"children":"max_workers_per_key"}]," with none idle, before it runs one-shot instead. 0 takes the default."]}]]}]]}]]}]}]
