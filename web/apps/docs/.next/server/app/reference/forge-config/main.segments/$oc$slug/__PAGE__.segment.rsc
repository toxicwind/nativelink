{"children":"30 seconds"}],["$","td",null,{"children":"HTTP/2 keepalive interval (seconds): PING frames on the scheduler connection, so one that has gone dead underneath fails instead of hanging every message on it."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"http2_keepalive_timeout_s"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"20 seconds"}],["$","td",null,{"children":"HTTP/2 keepalive timeout (seconds): a PING unanswered for this long ends the connection, and the worker reconnects."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"tls_config"}]}],["$","td",null,{"children":["$","$L59",null,{"href":"#clienttlsconfig","children":"ClientTlsConfig"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"The TLS configuration to use to connect to the endpoint."}]]}]]}]]}]}]
