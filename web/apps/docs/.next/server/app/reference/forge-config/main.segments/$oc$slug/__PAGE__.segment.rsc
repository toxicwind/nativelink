sults to CAS after execution completes. If upload takes longer than this, the action fails with ",["$","code",null,{"children":"DeadlineExceeded"}]," and may be retried by the scheduler. Value in seconds."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_download_timeout_s"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"10 minutes"}],["$","td",null,{"children":["Maximum time allowed for fetching an action's inputs into the worker's store and its directory before the command runs. A fetch that hangs (a store that never answers) otherwise holds the action's slot for good while the worker looks healthy; past this the action fails with ",["$","code",null,{"children":"DeadlineExceeded"}]," and may be retried by the scheduler, and a warning names the action every minute before that. Value in seconds."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_cleanup_wait_s"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"30 seconds"}],["$","td",null,{"children":"Maximum time to wait for action directory cleanup before timing out. Value in seconds."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_cleanup_backoff_ms"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"500 milliseconds"}],["$","td",null,{"children":"Maximum backoff duration for exponential backoff when waiting for cleanup. Value in milliseconds."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_inflight_tasks"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"0 (infinite tasks)"}],["$","td",null,{"children":"Maximum number of inflight tasks this worker can cope with."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"single_use"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"false"}],["$","td",null,{"children":"Accept one action, upload its results, and exit the worker process. The worker advertises one execution slot and never accepts a second action, including after a scheduler disconnect. A launcher must create a fresh container and fresh writable volumes for its replacement. Use one local worker per process, with no scheduler or services other than health checks. Reusing the container or its writable volumes does not provide isolation from the previous action."}]]}],"$L21f","$L220","$L221","$L222","$L223","$L224","$L225","$L226","$L227","$L228","$L229","$L22a","$L22b","$L22c","$L22d","$L22e","$L22f","$L230","$L231","$L232","$L233","$L234","$L235"]}]]}]}]
