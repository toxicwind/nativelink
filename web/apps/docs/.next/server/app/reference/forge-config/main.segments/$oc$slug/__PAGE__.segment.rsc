159:["$","p",null,{"children":"One of:"}]
15a:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","code",null,{"children":"property"}],": string — The name of the platform property in the action to get the value from."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"value"}],": string — The raw value to set."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"from_environment\""}]," — Take the value from the local environment corresponding to the name key"]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"timeout_millis\""}]," — The max amount of time in milliseconds the command is allowed to run (requested by the client)."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"side_channel_file\""}]," — A special file path will be provided that can be used to communicate with the parent process about out-of-band information. This file will be read after the command has finished executing. Based on the contents of the file, the behavior of the result may be modified."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"action_directory\""}]," — A \"root\" directory for the action. This directory can be used to store temporary files that are not needed after the action has completed. This directory will be purged after the action has completed."]}],"\n"]}]
15b:["$","$L5a",null,{"as":"h2","id":"directorycacheconfig","children":"DirectoryCacheConfig"}]
15c:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_entries"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"1000"}],["$","td",null,{"children":"Maximum number of cached directories."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_size_bytes"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"10737418240 (10 GB)"}],["$","td",null,{"children":"Maximum total size in bytes for all cached directories (0 = unlimited)."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"cache_root"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"{work_directory}/../directory_cache"}]}],["$","td",null,{"children":["Base directory for cache storage. This directory will be managed by the worker and should be on the same filesystem as ",["$","code",null,{"children":"work_directory"}],"."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_subtree_caching"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"false (only root directories are cached; existing behavior)"}],["$","td",null,{"children":["Optional and experimental: additionally cache every subdirectory by its own ",["$","code",null,{"children":"Directory"}]," digest, not just the root directory. REAPI Merkle nodes are content-addressed, so a subtree that is byte-identical between two different roots has the same digest and can be materialized with a single hardlink pass instead of being rebuilt from the CAS. This makes the common \"one input file changed out of thousands\" case reuse every unchanged subtree."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_concurrent_fetches"}]}],["$","td",null,{"children":"integer (uint)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"64"}],["$","td",null,{"children":"Maximum number of concurrent slow-store fetches across ALL directory constructions of this cache. This bound protects backing stores from RPC storms: per-level construction concurrency compounds multiplicatively across tree levels and concurrent actions."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"experimental_get_tree_prefetch"}]}],["$","td",null,{"children":"boolean"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"false"}],["$","td",null,{"children":["On a directory-cache miss, prefetch every ",["$","code",null,{"children":"Directory"}]," proto of the tree with one logical ",["$","code",null,{"children":"GetTree"}]," traversal instead of fetching protos level by level (which costs one round trip per tree DEPTH). The [REAPI request contract] permits servers to impose their own limit even when no page size is specified, and the [REAPI response contract] requires clients to continue with the returned page token. A paginated traversal may therefore use multiple RPCs. Only takes effect when the slow tier is a ",["$","code",null,{"children":"grpc"}]," store; any prefetch failure falls back to the per-level path. Worthwhile when worker-to-CAS latency is non-trivial and trees are deep; measured 5-34x on the proto phase at 5-25ms RTT. Note the serving CAS pays the tree walk against its own backend, so its directory protos should be served from a fast tier."]}]]}]]}]]}]}]
15d:["$","$L5a",null,{"as":"h2","id":"propertytype","children":"PropertyType"}]
15e:["$","p",null,{"children":"When the scheduler matches tasks to workers that are capable of running\nthe task, this value will be used to determine how the property is treated."}]
15f:["$","p",null,{"children":"One of:"}]
160:["$","ul",null,{"children":["\n",["$","li",null,{"children":"string"}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"minimum\""}]," — Requires the platform property to be a u64 and when the scheduler looks for appropriate worker nodes that are capable of executing the task, the task will not run on a node that has less than this value."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"exact\""}]," — Requires the platform property to be a string and when the scheduler looks for appropriate worker nodes that are capable of executing the task, the task will not run on a node that does not have this property set to the value with exact string match."]}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"\"priority\""}]," — Does not restrict on this value and instead will be passed to the worker as an informational piece. In the future this will be used by the scheduler and worker to cause the scheduler to prefer certain workers over others, but not restrict them based on these values."]}],"\n"]}]
161:["$","$L5a",null,{"as":"h2","id":"workerallocationstrategy","children":"WorkerAllocationStrategy"}]
162:["$","p",null,{"children":"When a worker is being searched for to run a job, this will be used\non how to choose which worker should run the job when multiple\nworkers are able to run the task."}]
163:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Value"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"\"least_recently_used\""}]}],["$","td",null,{"children":"Prefer workers that have been least recently used to run a job."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"\"most_recently_used\""}]}],["$","td",null,{"children":"Prefer workers that have been most recently used to run a job."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"\"least_loaded\""}]}],["$","td",null,{"children":"Prefer the worker running the fewest actions, least recently used among equals. A worker that just joined has nothing running, so it takes the next action instead of waiting for every older worker to be used once more, and a burst spreads across the fleet instead of filling one worker to its concurrency cap."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"\"best_fit\""}]}],["$","td",null,{"children":["Prefer the worker the action fits most tightly: among the workers that can take it, the one whose remaining ",["$","code",null,{"children":"minimum"}]," properties (memory, CPU) would be smallest afterwards, as a share of what it advertises. Big actions are kept for the workers with big room and small ones fill the gaps, so a fleet of mixed sizes wastes the least. A ",["$","code",null,{"children":"priority"}]," property on the action that a worker carries with the same value prefers that worker before the fit is judged, which is what such a property is for (a zone, a cache locality). Ties go to the fewest running actions, then least recently used."]}]]}]]}]]}]}]
