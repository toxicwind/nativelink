14c:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ac_store"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"{No uploading is done}"}],["$","td",null,{"children":"Underlying AC store that the worker will use to publish execution results into. Objects placed in this store should be reachable from the scheduler/client-cas after they have finished updating."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"upload_ac_results_strategy"}]}],["$","td",null,{"children":["$","$L59",null,{"href":"#uploadcacheresultsstrategy","children":"UploadCacheResultsStrategy"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"SuccessOnly"}]}],["$","td",null,{"children":["In which situations should the results be published to the ",["$","code",null,{"children":"ac_store"}],", if set to ",["$","code",null,{"children":"SuccessOnly"}]," then only results with an exit code of 0 will be uploaded, if set to Everything all completed results will be uploaded."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"historical_results_store"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"{CAS store of parent}"}],["$","td",null,{"children":"Store to upload historical results to. This should be a CAS store if set."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"upload_historical_results_strategy"}]}],["$","td",null,{"children":["$","$L59",null,{"href":"#uploadcacheresultsstrategy","children":"UploadCacheResultsStrategy"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"FailuresOnly"}]}],["$","td",null,{"children":["In which situations should the results be published to the historical CAS. The historical CAS is where failures are published. These messages conform to the CAS key-value lookup format and are always a ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," serialized message."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"success_message_template"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"\"\" (no message)"}],["$","td",null,{"children":["Template to use for the ",["$","code",null,{"children":"ExecuteResponse.message"}]," property. This message is attached to the response before it is sent to the client. The following special variables are supported:; ",["$","code",null,{"children":"digest_function"}],": Digest function used to calculate the action digest: ",["$","code",null,{"children":"action_digest_hash"}],": Action digest hash: ",["$","code",null,{"children":"action_digest_size"}],": Action digest size: ",["$","code",null,{"children":"historical_results_hash"}],": ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," digest hash: ",["$","code",null,{"children":"historical_results_size"}],": ",["$","code",null,{"children":"HistoricalExecuteResponse"}]," digest size."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"failure_message_template"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"\"\" (no message)"}],["$","td",null,{"children":["Same as ",["$","code",null,{"children":"success_message_template"}]," but for failure case."]}]]}]]}]]}]}]
