156:["$","p",null,{"children":["Advertise CPU and memory from what the worker can actually see. The\nworker reads ",["$","code",null,{"children":"cpu.max"}]," and ",["$","code",null,{"children":"memory.max"}]," from its own cgroup v2 directory\n(found through ",["$","code",null,{"children":"/proc/self/cgroup"}],", so a privileged container that sees\nthe host's tree still finds its own) up to the nearest limited ancestor,\nthe pod's limits on Kubernetes; with no limit at any level the configured\nproperties stand. It takes off what it needs for itself, divides\nthe memory by the enforcement headroom, and sets the two properties to\nthe result at registration. What the scheduler packs against is then\nderived from the one number that is enforced, instead of typed in twice."]}]
157:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"cpu_property_name"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"cpu_count"}]}],["$","td",null,{"children":["Property that carries CPU, on the scale ",["$","code",null,{"children":"cpu_unit"}]," names."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"memory_property_name"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"memory_kb"}]}],["$","td",null,{"children":"Property that carries memory, in KiB."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"cpu_unit"}]}],["$","td",null,{"children":["$","$L59",null,{"href":"#cpuunit","children":"CpuUnit"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"cores"}],["$","td",null,{"children":["The scale the CPU property is advertised on. Whole cores by default, the scale every other example in this configuration uses; a fleet that advertises and requests thousandths of a core sets ",["$","code",null,{"children":"millicores"}],". Getting this wrong is a thousandfold error in how many actions the scheduler packs onto the worker."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"overhead_cpu_millicores"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"1000"}],["$","td",null,{"children":["CPU the worker keeps for itself, in thousandths of a core whatever ",["$","code",null,{"children":"cpu_unit"}]," says."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"overhead_memory_kb"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"2097152 (2 GiB)"}],["$","td",null,{"children":"Memory the worker keeps for itself (the process, its directory cache, output buffers), in KiB."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"memory_headroom_percent"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"unset"}],["$","td",null,{"children":["Percent the advertised memory is reduced by, so that actions at their enforcement ceiling (reservation plus headroom) still fit the limit. Unset, it follows ",["$","code",null,{"children":"resource_enforcement.memory_headroom_percent"}]," while memory enforcement is on, and is 0 otherwise, so the two cannot drift apart by being typed twice."]}]]}]]}]]}]}]
