1b7:["$","p",null,{"children":"Note: Compressing data in the cloud rarely has a benefit, since most\ncloud providers have very high bandwidth backplanes. However, for\nclients not inside the data center, it might be a good idea to\ncompress data to and from the cloud. This will however come at a high\nCPU and performance cost. If you are making remote execution share the\nsame CAS/AC servers as client's remote cache, you can create multiple\nservices with different compression settings that are served on\ndifferent ports. Then configure the non-cloud clients to use one port\nand cloud-clients to use another."}]
1b8:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"send_compression_algorithm"}]}],["$","td",null,{"children":["$","$L59",null,{"href":"#httpcompressionalgorithm","children":"HttpCompressionAlgorithm"}]}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["$","code",null,{"children":"HttpCompressionAlgorithm::None"}]}],["$","td",null,{"children":["The compression algorithm that the server will use when sending responses to clients. Enabling this will likely save a lot of data transfer, but will consume a lot of CPU and add a lot of latency. see: ",["$","$L59",null,{"href":"https://github.com/tracemachina/forge/issues/109","children":"https://github.com/tracemachina/forge/issues/109"}]]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"accepted_compression_algorithms"}]}],["$","td",null,{"children":["array of ",["$","$L59",null,{"href":"#httpcompressionalgorithm","children":"HttpCompressionAlgorithm"}]]}],["$","td",null,{"children":"Yes"}],["$","td",null,{"children":"{no supported compression}"}],["$","td",null,{"children":["The compression algorithm that the server will accept from clients. The server will broadcast the supported compression algorithms to clients and the client will choose which compression algorithm to use. Enabling this will likely save a lot of data transfer, but will consume a lot of CPU and add a lot of latency. see: ",["$","$L59",null,{"href":"https://github.com/tracemachina/forge/issues/109","children":"https://github.com/tracemachina/forge/issues/109"}]]}]]}]]}]]}]}]
