96:["$","p",null,{"children":[["$","code",null,{"children":"FastSlow"}]," store will first try to fetch the data from the ",["$","code",null,{"children":"fast"}],"\nstore and then if it does not exist try the ",["$","code",null,{"children":"slow"}]," store.\nWhen the object does exist in the ",["$","code",null,{"children":"slow"}]," store, it will copy\nthe data to the ",["$","code",null,{"children":"fast"}]," store while returning the data.\nThis store should be thought of as a store that \"buffers\"\nthe data to the ",["$","code",null,{"children":"fast"}]," store.\nOn uploads it will mirror data to both ",["$","code",null,{"children":"fast"}]," and ",["$","code",null,{"children":"slow"}]," stores."]}]
97:["$","p",null,{"children":["WARNING: If you need data to always exist in the ",["$","code",null,{"children":"slow"}]," store\nfor something like remote execution, be careful because this\nstore will never check to see if the objects exist in the\n",["$","code",null,{"children":"slow"}]," store if it exists in the ",["$","code",null,{"children":"fast"}]," store (i.e. it assumes\nthat if an object exists in the ",["$","code",null,{"children":"fast"}]," store it will exist in\nthe ",["$","code",null,{"children":"slow"}]," store)."]}]
