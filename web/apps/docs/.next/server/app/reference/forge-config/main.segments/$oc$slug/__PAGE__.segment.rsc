88:["$","p",null,{"children":["A dedup store will take the inputs and run a rolling hash\nalgorithm on them to slice the input into smaller parts then\nrun a sha256 algorithm on the slice and if the object doesn't\nalready exist, upload the slice to the ",["$","code",null,{"children":"content_store"}]," using\na new digest of just the slice. Once all parts exist, an\nAction-Cache-like digest will be built and uploaded to the\n",["$","code",null,{"children":"index_store"}]," which will contain a reference to each\nchunk/digest of the uploaded file. Downloading a request will\nfirst grab the index from the ",["$","code",null,{"children":"index_store"}],", and forward the\ndownload content of each chunk as if it were one file."]}]
89:["$","p",null,{"children":"This store is exceptionally good when the following conditions\nare met:"}]
8a:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Content is mostly the same (inserts, updates, deletes are ok)"}],"\n",["$","li",null,{"children":"Content is not compressed or encrypted"}],"\n",["$","li",null,{"children":["Uploading or downloading from ",["$","code",null,{"children":"content_store"}]," is the bottleneck."]}],"\n"]}]
8b:["$","p",null,{"children":["Note: This store pairs well when used with ",["$","code",null,{"children":"CompressionSpec"}]," as\nthe ",["$","code",null,{"children":"content_store"}],", but never put ",["$","code",null,{"children":"DedupSpec"}]," as the backend of\n",["$","code",null,{"children":"CompressionSpec"}]," as it will negate all the gains."]}]
8c:["$","p",null,{"children":["Note: When running ",["$","code",null,{"children":".has()"}]," on this store, it will only check\nto see if the entry exists in the ",["$","code",null,{"children":"index_store"}]," and not check\nif the individual chunks exist in the ",["$","code",null,{"children":"content_store"}],"."]}]
