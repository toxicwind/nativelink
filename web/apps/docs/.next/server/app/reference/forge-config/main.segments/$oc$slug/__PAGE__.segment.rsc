143:["$","p",null,{"children":["Opt-in file capture for the actual container executing a Buck2 action.\nRequires a fresh single-use container with no outer execution wrapper or\nseparate action mount namespace. For nested runtimes, run ",["$","code",null,{"children":"Forge"}]," and the\ncapture helper inside the execution container. Other build tools never start\ncapture. The helper uploads an archive before ",["$","code",null,{"children":"Forge"}]," cleans up the action."]}]
144:["$","p",null,{"children":["The operator supplies the helper executable and its authenticated ingest\nservice. ",["$","code",null,{"children":"Forge"}]," sends one JSON record on stdin and expects ",["$","code",null,{"children":"ready\\n"}],"\non stdout within 30 seconds. Closing stdin requests final capture; the helper\nmust exit only after durable acknowledgement, or exit unsuccessfully if the\narchive is partial. See ",["$","code",null,{"children":"forge-worker/README.md"}]," for the control protocol."]}]
145:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"executable"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"Yes"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["Absolute path to the compatible ",["$","code",null,{"children":"buck2-file-capture"}]," executable."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"gateway"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"Yes"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"Authenticated ingest endpoint understood by the capture helper."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"token_file"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"Yes"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"Private token file. The helper excludes its path and hard-link aliases. The token is never included in the action environment or command line."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"state_directory"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"Yes"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"Private directory for the helper's bounded on-disk metadata index. Mount a fresh empty volume here for each single-use container."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"container_id"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"Yes"}],["$","td"