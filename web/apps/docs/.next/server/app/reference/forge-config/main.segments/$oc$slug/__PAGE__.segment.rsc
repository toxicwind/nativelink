1c0:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Type"}],["$","th",null,{"children":"Required"}],["$","th",null,{"children":"Default"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"index_store"}]}],["$","td",null,{"children":"string"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":["The store name referenced in the ",["$","code",null,{"children":"stores"}]," map in the main config used to persist blob-to-chunks layouts. Keys are the digests of the original blobs and values are serialized chunk layouts (which do not hash to those digests), so this store MUST NOT perform content digest verification and MUST NOT be the same store as ",["$","code",null,{"children":"cas_store"}]," — writing layouts into the CAS would overwrite blob content. Using the same store name as ",["$","code",null,{"children":"cas_store"}]," is rejected at startup."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"avg_chunk_size_bytes"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"524288 (512 KiB)"}],["$","td",null,{"children":["The average chunk size in bytes advertised to clients through the ",["$","code",null,{"children":"FastCDC"}]," 2020 capability parameters and used for server-side chunking in ",["$","code",null,{"children":"SplitBlob"}],". Clients derive the minimum and maximum chunk sizes from this value (avg / 4 and avg * 4). The value must be between 1 KiB and 1 MiB."]}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"max_chunk_count"}]}],["$","td",null,{"children":"integer (uint64)"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"50000"}],["$","td",null,{"children":["Maximum number of chunks accepted in a ",["$","code",null,{"children":"SpliceBlob"}]," request or produced by on-demand chunking in ",["$","code",null,{"children":"SplitBlob"}],". Blobs that would produce more chunks are served without chunking (",["$","code",null,{"children":"SplitBlob"}]," returns ",["$","code",null,{"children":"NOT_FOUND"}]," and clients fall back to a regular download). This bounds the size of stored chunk layouts and of ",["$","code",null,{"children":"SplitBlobResponse"}]," messages (roughly 80-140 bytes per chunk). At the default average chunk size the default cap supports blobs up to ~25 GiB; note that values above ~50000 may produce responses that exceed default gRPC message size limits on clients."]}]]}]]}]]}]}]
