51:["$","$L2d",null,{"as":"h2","id":"how-an-instrument-becomes-a-prometheus-series","children":"How an instrument becomes a Prometheus series"}]
52:["$","p",null,{"children":"Forge speaks OTLP only; there is no Prometheus scrape endpoint in the\nbinary. The names in the middle column above are what the shipped OpenTelemetry\ncollector produces after two transformations:"}]
53:["$","ol",null,{"children":["\n",["$","li",null,{"children":["The Prometheus exporter in\n",["$","$L2c",null,{"href":"https://github.com/toxicwind/forge/blob/v1.7.2/deployment-examples/metrics/otel-collector-config.yaml","children":["$","code",null,{"children":"otel-collector-config.yaml"}]}],"\nis configured with ",["$","code",null,{"children":"namespace: forge"}],", which prefixes every series with\n",["$","code",null,{"children":"forge_"}],"."]}],"\n",["$","li",null,{"children":["The exporter rewrites the OTLP name into Prometheus form: dots become\nunderscores, and monotonic counters gain a ",["$","code",null,{"children":"_total"}]," suffix. Histograms fan out\ninto ",["$","code",null,{"children":"_bucket"}],", ",["$","code",null,{"children":"_sum"}]," and ",["$","code",null,{"children":"_count"}]," series."]}],"\n"]}]
54:["$","p",null,{"children":[["$","code",null,{"children":"cache.operations"}]," (a counter) is therefore scraped as ",["$","code",null,{"children":"forge_cache_operations_total"}],",\nand ",["$","code",null,{"children":"cache.operation.duration"}]," (a histogram) as ",["$","code",null,{"children":"forge_cache_operation_duration_bucket"}],"\nand friends. Change the collector's ",["$","code",null,{"children":"namespace"}]," and every name on this page changes\nwith it."]}]
55:["$","p",null,{"children":["Where a name in the ",["$","strong",null,{"children":"Prometheus series"}]," column is unmarked, it is not a\nprediction: it is the name that actually appears in the shipped rules,\ndashboards and alerts under ",["$","code",null,{"children":"deployment-examples/metrics/"}]," and ",["$","code",null,{"children":"kubernetes/"}],".\nA name marked ",["$","em",null,{"children":"(unreferenced)"}]," is derived from the two rules above, because no\nshipped artifact mentions that metric at all: nothing has ever queried it, so\nnothing has confirmed the exporter's spelling of it."]}]
