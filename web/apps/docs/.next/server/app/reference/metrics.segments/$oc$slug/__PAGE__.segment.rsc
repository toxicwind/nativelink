1b:["$","$L2b",null,{"children":["\n",["$","p",null,{"children":["Forge ",["$","strong",null,{"children":"v1.7.2"}]," declares 40 OpenTelemetry instruments. This page is\ngenerated from the declarations in\n",["$","$L2c",null,{"href":"https://github.com/toxicwind/forge/blob/v1.7.2/forge-util/src/metrics.rs","children":["$","code",null,{"children":"forge-util/src/metrics.rs"}]}],"\nand from every ",["$","code",null,{"children":".add()"}]," and ",["$","code",null,{"children":".record()"}]," call site across the workspace, so the\n",["$","strong",null,{"children":"Emitted"}]," column is not a claim, it is the result of looking."]}],"\n",["$","p",null,{"children":"That column is the reason this page is generated rather than written. Declaring\nan instrument costs nothing and emits nothing; the instrument only produces a\nseries when some code path calls it. A catalogue written by hand cannot tell\nthose two states apart, and the gap between them is where dashboards go quietly\nwrong."}],"\n",["$","$L2d",null,{"as":"h2","id":"every-instrument-at-a-glance","children":"Every instrument at a glance"}],"\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Instrument"}],["$","th",null,{"children":"Prometheus series"}],["$","th",null,{"children":"Kind"}],["$","th",null,{"children":"Emitted"}],["$","th",null,{"children":"Under what conditions"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","$L2c",null,{"href":"#cache-operation-duration","children":["$","code",null,{"children":"cache.operation.duration"}]}]}],["$","td",null,{"children":["$","code",null,{"children":"forge_cache_operation_duration"}]}],["$","td",null,{"children":"Histogram"}],["$","td",null,{"children":"Conditionally"}],["$","td",null,{"children":["only for stores explicitly wrapped in a ",["$","code",null,{"chil