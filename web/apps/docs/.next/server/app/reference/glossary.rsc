32:["$","p",null,{"children":["A store that remembers which digests it has already confirmed exist, so\nrepeated ",["$","$L1c",null,{"href":"#findmissingblobs","children":["$","code",null,{"children":"FindMissingBlobs"}]}]," calls stop re-querying the\nbackend. It answers the existence question only; reads pass through."]}]
