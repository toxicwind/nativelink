2c:["$","p",null,{"children":["The hash a client and server agree on for ",["$","$L1c",null,{"href":"#digest","children":"digests"}],": SHA-256 or\nBLAKE3, negotiated per request rather than fixed at build time\n(",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/digest_hasher.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/digest_hasher.rs","data-source-ref":"v1.6.5","title":"forge-util/src/digest_hasher.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"DigestHasherFunc"]}],").\nTwo clients using different functions produce different keys for the same\nbytes, so they do not share cache entries."]}]
2d:["$","$L1b",null,{"as":"h2","id":"eviction-policy","children":"Eviction policy"}]
2e:["$","p",null,{"children":["The limits a store evicts against: ",["$","code",null,{"children":"max_bytes"}],", ",["$","code",null,{"children":"max_seconds"}],", ",["$","code",null,{"children":"max_count"}],",\nand the ",["$","code",null,{"children":"evict_bytes"}]," low watermark that stops eviction thrashing right at the\nlimit. Each defaults to ",["$","code",null,{"children":"0"}],", which means ",["$","em",null,{"children":"never evict on that dimension"}],": a\nstore configured without a policy grows until the disk does."]}]
