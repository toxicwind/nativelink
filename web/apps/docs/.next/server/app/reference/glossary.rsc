54:["$","p",null,{"children":["A store that routes each key to one of several backends by digest hash, with\na ",["$","code",null,{"children":"weight"}]," per backend. It spreads capacity; it is not replication, so losing\none backend loses that backend's share of the data rather than none of it."]}]
55:["$","$L1b",null,{"as":"h2","id":"store","children":"Store"}]
56:["$","p",null,{"children":["Forge's unit of storage configuration: a named thing that gets and puts\nbytes under a key. Stores compose, because a store's backend is another store,\nso the CAS a server serves is usually a stack of wrappers over one real\nbackend. See ",["$","$L1c",null,{"href":"/explanations/store-model","children":"the store model"}],"."]}]
57:["$","$L1b",null,{"as":"h2","id":"toolchain","children":"Toolchain"}]
58:["$","p",null,{"children":["The bundle of binaries an action needs to run: compiler, linker,\nstandard library, etc. See\n",["$","$L1c",null,{"href":"/remote-execution/toolchains-and-hermeticity#faq","children":"how toolchains are provided"}],"."]}]
59:["$","$L1b",null,{"as":"h2","id":"verify-store","children":"Verify store"}]
5a:["$","p",null,{"children":["A wrapper that, depending on ",["$","code",null,{"children":"verify_size"}]," and ",["$","code",null,{"children":"verify_hash"}],", checks a\nblob's size and re-hashes it on write, failing the upload when the bytes do\nnot match the ",["$","$L1c",null,{"href":"#digest","children":"digest"}]," they were offered under. It turns silent corruption into a write error. Both checks\nbelong on CAS stores and neither belongs on an ",["$","$L1c",null,{"href":"#action-cache-ac","children":"AC"}]," store."]}]
5b:["$","$L1b",null,{"as":"h2","id":"worker","children":"Worker"}]
5c:["$","p",null,{"children":"The process that runs an action. Fetches inputs from CAS, runs the\ncommand, uploads outputs to CAS."}]
5d:["$","$L1b",null,{"as":"h2","id":"worker-api","children":"Worker API"}]
5e:["$","p",null,{"children":["Forge's own gRPC service, not part of the RE-API, over which a worker\nregisters with a scheduler and receives work\n(",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-proto/com/github/trace_machina/forge/remote_execution/worker_api.proto","target":"_blank","rel":"noreferrer","data-source-link":"forge-proto/com/github/trace_machina/forge/remote_execution/worker_api.proto","data-source-ref":"v1.6.5","title":"forge-proto/com/github/trace_machina/forge/remote_execution/worker_api.proto at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"worker_api.proto"]}],").\nOne bidirectional ",["$","code",null,{"children":"ConnectWorker"}]," stream carries the whole conversation, which\nis what keeps a worker talking to the same scheduler instance even behind a\nload balancer."]}]
