d:["$","p",null,{"children":["The RE-API service a client calls first, to learn which\n",["$","$L7",null,{"href":"#digest-function","children":"digest functions"}]," the server accepts and what its size\nlimits are rather than assuming. See\n",["$","$L7",null,{"href":"/reference/protocol-api","children":"protocol and API surface"}],"."]}]
e:["$","$L6",null,{"as":"h2","id":"cas--content-addressable-storage","children":"CAS: Content-Addressable Storage"}]
f:["$","p",null,{"children":"Stores every blob (source file, intermediate output, final binary)\nunder the digest of its contents. The same byte sequence stored from anywhere\ncollapses to one entry."}]
10:["$","$L6",null,{"as":"h2","id":"completeness-checking-store","children":"Completeness-checking store"}]
11:["$","p",null,{"children":["An ",["$","$L7",null,{"href":"#action-cache-ac","children":"Action Cache"}]," wrapper that checks every output\n",["$","$L7",null,{"href":"#digest","children":"digest"}]," still exists in the CAS before serving a hit. Without it a\nCAS eviction turns old cache entries into hits that reference blobs nobody can\ndownload, and the build fails while fetching outputs instead of quietly\nmissing the cache. Valid only on AC stores."]}]
12:["$","$L6",null,{"as":"h2","id":"dedup-store","children":"Dedup store"}]
13:["$","p",null,{"children":["A store that splits blobs into content-defined chunks with FastCDC\n(",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/fastcdc.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/fastcdc.rs","data-source-ref":"v1.6.5","title":"forge-util/src/fastcdc.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"fastcdc.rs"]}],") and stores each chunk\nonce, so two versions of a large file that differ in the middle share\neverything else. The cost is an index lookup per read. See\n",["$","$L7",null,{"href":"/explanations/store-model","children":"the store model"}],"."]}]
14:["$","$L6",null,{"as":"h2","id":"digest","children":"Digest"}]
15:["$","p",null,{"children":"A content hash plus a size. Used everywhere instead of file paths."}]
16:["$","$L6",null,{"as":"h2","id":"digest-function","children":"Digest function"}]
17:["$","p",null,{"children":["The hash a client and server agree on for ",["$","$L7",null,{"href":"#digest","children":"digests"}],": SHA-256 or\nBLAKE3, negotiated per request rather than fixed at build time\n(",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/digest_hasher.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/digest_hasher.rs","data-source-ref":"v1.6.5","title":"forge-util/src/digest_hasher.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"DigestHasherFunc"]}],").\nTwo clients using different functions produce different keys for the same\nbytes, so they do not share cache entries."]}]
18:["$","$L6",null,{"as":"h2","id":"eviction-policy","children":"Eviction policy"}]
19:["$","p",null,{"children":["The limits a store evicts against: ",["$","code",null,{"children":"max_bytes"}],", ",["$","code",null,{"children":"max_seconds"}],", ",["$","code",null,{"children":"max_count"}],",\nand the ",["$","code",null,{"children":"evict_bytes"}]," low watermark that stops eviction thrashing right at the\nlimit. Each defaults to ",["$","code",null,{"children":"0"}],", which means ",["$","em",null,{"children":"never evict on that dimension"}],": a\nstore configured without a policy grows until the disk does."]}]
1a:["$","$L6",null,{"as":"h2","id":"execution-stage","children":"Execution stage"}]
1b:["$","p",null,{"children":["Where an action is in its life: ",["$","code",null,{"children":"CacheCheck"}],", ",["$","code",null,{"children":"Queued"}],", ",["$","code",null,{"children":"Executing"}],", then\n",["$","code",null,{"children":"Completed"}]," or ",["$","code",null,{"children":"CompletedFromCache"}],"\n(",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/action_messages.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/action_messages.rs","data-source-ref":"v1.6.5","title":"forge-util/src/action_messages.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"ActionStage"]}],").\nAn action stuck in ",["$","code",null,{"children":"Queued"}]," has no free ",["$","$L7",null,{"href":"#worker","children":"worker"}]," whose\n",["$","$L7",null,{"href":"#platform-properties","children":"platform properties"}]," match what it asked for.\n",["$","code",null,{"children":"CacheCheck"}]," is declared but the scheduler never reports it, because the\ncache lookup happens in a wrapper in front of the scheduler."]}]
1c:["$","$L6",null,{"as":"h2","id":"existence-cache-store","children":"Existence cache store"}]
1d:["$","p",null,{"children":["A store that remembers which digests it has already confirmed exist, so\nrepeated ",["$","$L7",null,{"href":"#findmissingblobs","children":["$","code",null,{"children":"FindMissingBlobs"}]}]," calls stop re-querying the\nbackend. It answers the existence question only; reads pass through."]}]
1e:["$","$L6",null,{"as":"h2","id":"fast-slow-store","children":[["$","code",null,{"children":"fast_slow"}]," store"]}]
1f:["$","p",null,{"children":"A two-tier store. Reads try the fast backend, fall back to the slow one, and\ncopy what they find into the fast tier on the way back; writes mirror to both.\nIts one sharp edge: it never checks the slow tier for something the fast tier\nalready has, so a blob that reached the fast tier without reaching the slow one\nstays invisible to everything reading the slow tier directly."}]
20:["$","$L6",null,{"as":"h2","id":"findmissingblobs","children":"FindMissingBlobs"}]
21:["$","p",null,{"children":["The CAS call that makes uploads incremental: the client offers a list of\n",["$","$L7",null,{"href":"#digest","children":"digests"}],", the server returns the ones it does not have, and the\nclient uploads only those. On a warm cache this and the ",["$","$L7",null,{"href":"#action-cache-ac","children":"AC"}],"\nlookup are most of what a client does."]}]
22:["$","$L6",null,{"as":"h2","id":"hermetic-build","children":"Hermetic build"}]
23:["$","p",null,{"children":["A build whose outputs depend only on its declared inputs. Same\ninputs → same outputs, on any machine, any time. What Forge does\nand does not guarantee here is in\n",["$","$L7",null,{"href":"/explanations/correctness-hermeticity","children":"correctness and hermeticity"}],"."]}]
24:["$","$L6",null,{"as":"h2","id":"input-root","children":"Input root"}]
25:["$","p",null,{"children":["The complete file tree an action is allowed to see, encoded as a Merkle tree\nof ",["$","code",null,{"children":"Directory"}]," messages that reference their files and each other by\n",["$","$L7",null,{"href":"#digest","children":"digest"}],". Its root digest is part of the ",["$","$L7",null,{"href":"#action","children":"action"}]," hash, so\nchanging one input file changes the cache key."]}]
