31:["$","p",null,{"children":["The handle a client holds on a running action, from\n",["$","code",null,{"children":"google.longrunning.Operation"}],". ",["$","code",null,{"children":"Execute"}]," returns one immediately and the\nclient watches it for ",["$","$L7",null,{"href":"#execution-stage","children":"stage"}]," changes; ",["$","code",null,{"children":"WaitExecution"}],"\nre-attaches to it after a disconnect, which is what stops a dropped connection\nfrom re-running the work."]}]
