10:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Three directories are excluded from the workspace and build on their\nown: ",["$","code",null,{"children":"forge-config/generate-stores-config"}],", ",["$","code",null,{"children":"forge-test/fuzz"}],",\nand ",["$","code",null,{"children":"tools/generate-bazel-rc"}],". The LRE flake outputs are Nix, not Cargo."]}],"\n",["$","li",null,{"children":["Regenerating protos goes through Bazel\n(",["$","code",null,{"children":"bazel run forge-proto:update_protos"}],"), not Cargo."]}],"\n",["$","li",null,{"children":["CI runs Bazel, and ",["$","code",null,{"children":"bazel test"}]," attaches rustfmt and clippy aspects that\na Cargo run does not. A green ",["$","code",null,{"children":"cargo test"}]," does not guarantee a green CI.\nRun ",["$","code",null,{"children":"bazel test //..."}]," before submitting."]}],"\n"]}]
