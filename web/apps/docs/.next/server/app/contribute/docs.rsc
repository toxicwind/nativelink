56:["$","p",null,{"children":["Each MDX page among them opens with an ",["$","code",null,{"children":"AUTOGENERATED"}]," comment, which is\nalso how the anchor lint knows to skip it. Fix the generator or the source doc comment; an edit to the\noutput is overwritten on the next run."]}]
57:["$","p",null,{"children":[["$","code",null,{"children":"gen:llms"}]," is the one to remember when you add a page: it builds the machine\nreader's index from ",["$","code",null,{"children":"meta.json"}]," and frontmatter, so a page missing from a\n",["$","code",null,{"children":"meta.json"}]," is invisible to agents even if it renders fine."]}]
