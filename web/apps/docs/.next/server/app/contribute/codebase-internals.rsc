3f:["$","p",null,{"children":["with three priorities: ",["$","code",null,{"children":"P0"}],", ",["$","code",null,{"children":"P1"}],", ",["$","code",null,{"children":"LeastImportant"}],". Awaiting ",["$","code",null,{"children":"wait_for"}]," at\na given priority blocks until everything less important has drained. ",["$","code",null,{"children":"SIGTERM"}],"\ndrains and then exits ",["$","code",null,{"children":"143"}],"; ",["$","code",null,{"children":"SIGINT"}]," is a hard exit ",["$","code",null,{"children":"130"}],"."]}]
