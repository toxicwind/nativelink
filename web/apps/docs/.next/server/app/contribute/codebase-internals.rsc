49:["$","p",null,{"children":["Suppress a lint with ",["$","code",null,{"children":"#[expect(lint, reason = \"…\")]"}]," rather than a bare\n",["$","code",null,{"children":"#[allow]"}],"; ",["$","code",null,{"children":"expect"}]," fails the build once the suppression is no longer\nneeded, which is how they get cleaned up. ",["$","code",null,{"children":"#[allow]"}]," still appears where the\nlint only fires on some targets or feature sets, and it should carry a\n",["$","code",null,{"children":"reason"}]," too. Nothing enforces this mechanically; reviewers do."]}]
