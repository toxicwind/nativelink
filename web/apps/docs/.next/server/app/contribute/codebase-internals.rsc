3b:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$23:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`spawn!` aborts when its guard is dropped"}],["$","p",null,{"children":["This is a feature (it makes cancellation the default) and a trap if you\nspawn work and then let the handle fall out of scope. If the task must\nsurvive, use ",["$","code",null,{"children":"background_spawn!"}]," and say why in a comment."]}]]}]]}]
3c:["$","p",null,{"children":["File I/O goes through ",["$","code",null,{"children":"forge_util::fs"}],", which serialises open file\ndescriptors behind a global semaphore (",["$","code",null,{"children":"DEFAULT_OPEN_FILE_LIMIT"}]," is 24576).\nOpening a file with ",["$","code",null,{"children":"std::fs"}]," or ",["$","code",null,{"children":"tokio::fs"}]," directly bypasses the limit and\nwill eventually exhaust the process's descriptors under load."]}]
