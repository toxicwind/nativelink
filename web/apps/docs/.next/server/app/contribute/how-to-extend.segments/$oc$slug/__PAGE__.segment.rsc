{"children":["Record it at the call site, using the pre-computed attribute struct\nwhere one exists (",["$","code",null,{"children":"CacheMetricAttrs"}]," / ",["$","code",null,{"children":"ExecutionMetricAttrs"}],") rather\nthan building attributes inline."]}]}],["$","li",null,{"children":["$","p",null,{"children":["Extend ",["$","code",null,{"children":"forge-util/tests/metrics_test.rs"}],"."]}]}]]}]
