2b:["$","p",null,{"children":["Config fields are documentation. The doc comment becomes the description in\nthe generated reference, and the ",["$","code",null,{"children":"```json"}]," fences in ",["$","code",null,{"children":"stores.rs"}]," are\nalso harvested into the examples file, which is why they have to be valid\nJSON rather than illustrative fragments."]}]
