30:["$","p",null,{"children":["To rename a field without breaking existing configs, add a shim in\n",["$","code",null,{"children":"backcompat.rs"}],"; both existing shims are ",["$","code",null,{"children":"#[serde(untagged)]"}]," enums that\naccept the old and new shapes and emit a ",["$","code",null,{"children":"tracing::warn!"}]," on the deprecated\none."]}]
