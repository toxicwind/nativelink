37:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":["$","p",null,{"children":["Declare the instrument in the appropriate ",["$","code",null,{"children":"LazyLock"}]," bundle in\n",["$","code",null,{"children":"forge-util/src/metrics.rs"}]," (",["$","code",null,{"children":"CACHE_METRICS"}],", ",["$","code",null,{"children":"EXECUTION_METRICS"}],",\n",["$","code",null,{"children":"WORKER_METRICS"}],", ",["$","code",null,{"children":"RPC_METRICS"}],", ",["$","code",null,{"children":"SCHEDULER_METRICS"}],",\n",["$","code",null,{"children":"STORE_TIER_METRICS"}],", ",["$","code",null,{"children":"HEALTH_METRICS"}]," or ",["$","code",null,{"children":"CONNECTION_METRICS"}],"). Use a\ndotted name, a ",["$","code",null,{"children":".with_description"}],", and a ",["$","code",null,{"children":".with_unit"}]," that is a UCUM\nunit (",["$","code",null,{"children":"\"By\""}],", ",["$","code",null,{"children":"\"s\""}],", ",["$","code",null,{"children":"\"ms\""}],") or a braced count such as ",["$","code",null,{"children":"\"{entry}\""}],".\nThen regenerate the metrics reference with\n",["$","code",null,{"children":"bun --filter @forge/docs gen:metrics-reference"}]," from ",["$","code",null,{"children":"web/"}],", which\nreads this file."]}]}],["$","li",null,{"children":["$","p",null,{"children":["Record it at the call site, using the pre-computed attribute struct\nwhere one exists (",["$","code",null,{"children":"CacheMetricAttrs"}]," / ",["$","code",null,{"children":"ExecutionMetricAttrs"}],") rather\nthan building attributes inline."]}]}],["$","li",null,{"children":["$","p",null,{"children":["Extend ",["$","code",null,{"children":"forge-util/tests/metrics_test.rs"}],"."]}]}]]}]
