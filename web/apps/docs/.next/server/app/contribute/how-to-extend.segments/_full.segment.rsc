26:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"The store examples file is generated from your doc comments"}],["$","p",null,{"children":[["$","code",null,{"children":"forge-config/examples/stores-config.json5"}]," is produced by the\n",["$","code",null,{"children":"generate-stores-config"}]," tool from the ",["$","code",null,{"children":"```json"}]," fenced blocks in\nthe doc comments in ",["$","code",null,{"children":"stores.rs"}],", via a pre-commit hook. And\n",["$","code",null,{"children":"tests/json5_test.rs"}]," parses every example, so a malformed JSON fence in a\ndoc comment is not a cosmetic problem; it breaks the build."]}]]}]]}]
