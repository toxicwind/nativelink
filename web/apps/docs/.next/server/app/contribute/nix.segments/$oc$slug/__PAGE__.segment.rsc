27:["$","$L36",null,{"type":"multiple","children":[["$","$L37",null,{"title":"What is Nix, in one sentence?","id":"what-is-nix-in-one-sentence","children":["$","p",null,{"children":["A package manager that builds every package in isolation and addresses\nthe result by a hash of all its inputs, which is why two machines\nrunning ",["$","code",null,{"children":"nix develop"}]," on this repo get bit-identical toolchains."]}]}],["$","$L37",null,{"title":"Is the dev shell required?","id":"is-the-dev-shell-required","children":["$","p",null,{"children":["Not for building or testing; Cargo and Bazel both stand on their own.\nIt is required for LRE work, and it is the only way to get the generated\n",["$","code",null,{"children":"bazelrc"}]," fragments, so a build outside it is configured differently from\nCI even when it is green."]}]}],["$","$L37",null,{"title":"My Bazel build behaves differently outside the shell.","id":"different-outside-shell","children":["$","p",null,{"children":["Almost certainly the ",["$","code",null,{"children":"try-import"}],"ed fragments. ",["$","code",null,{"children":"lre.bazelrc"}],",\n",["$","code",null,{"children":"forge.bazelrc"}],", ",["$","code",null,{"children":"nixos.bazelrc"}]," and ",["$","code",null,{"children":"darwin.bazelrc"}]," are generated\nby the shell hook and silently skipped when absent. Enter the shell, or\naccept that you are building without the LRE toolchains and without the\nread-only cache."]}]}],["$","$L37",null,{"title":"Do I have to re-enter the shell after switching branches?","id":"reenter-after-branch-switch","children":["$","p",null,{"children":["Yes, whenever the ",["$","code",null,{"children":".nix"}]," files change, which a branch switch can do\nwithout you noticing. This is the argument for ",["$","code",null,{"children":"direnv"}],": it re-enters\nautomatically on ",["$","code",null,{"children":"cd"}]," and on file changes."]}]}]]}]
