15:["$","p",null,{"children":["No ",["$","code",null,{"children":"ActionScheduler"}]," trait exists. The state layer is split into\n",["$","code",null,{"children":"ClientStateManager"}],", ",["$","code",null,{"children":"WorkerStateManager"}]," and ",["$","code",null,{"children":"MatchingEngineStateManager"}],"\nin\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-util/src/operation_state_manager.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-util/src/operation_state_manager.rs","data-source-ref":"v1.6.5","title":"forge-util/src/operation_state_manager.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"operation_state_manager.rs"]}],",\nplus ",["$","code",null,{"children":"WorkerScheduler"}],", ",["$","code",null,{"children":"KnownPlatformPropertyProvider"}]," and\n",["$","code",null,{"children":"AwaitedActionDb"}],". The split by ",["$","em",null,{"children":"caller"}]," is what allows the in-memory and\nRedis-backed implementations to be swapped wholesale. See\n",["$","$L49",null,{"href":"/explanations/scheduler-internals#there-is-no-actionscheduler-trait","children":"scheduler internals"}],"."]}]
