1a:["$","p",null,{"children":["Three macros do most of the work: ",["$","code",null,{"children":"make_err!"}],", ",["$","code",null,{"children":"make_input_err!"}]," and\n",["$","code",null,{"children":"error_if!"}],". ",["$","code",null,{"children":"ResultExt"}],", and therefore ",["$","code",null,{"children":"err_tip"}],", is implemented for\nboth ",["$","code",null,{"children":"Result"}]," and ",["$","code",null,{"children":"Option"}],", so an ",["$","code",null,{"children":"Option"}]," can become a well-described\nerror without an intermediate ",["$","code",null,{"children":"ok_or_else"}],"."]}]
