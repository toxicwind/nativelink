2e:["$","p",null,{"children":[["$","strong",null,{"children":["System A: ",["$","code",null,{"children":"forge-metric"}],"."]}]," A ",["$","code",null,{"children":"#[derive(MetricsComponent)]"}]," plus\n",["$","code",null,{"children":"#[metric(help = …, kind = …, group = …, handler = …)]"}]," on fields, with\n",["$","code",null,{"children":"RootMetricsComponent"}]," marking a tree root. Roughly 190 ",["$","code",null,{"children":"#[metric]"}],"\nattributes exist. Publishing a tree walks the live object graph and emits\none ",["$","code",null,{"children":"tracing"}]," span per component and one event per field, on the target\n",["$","code",null,{"children":"forge_metric"}],", so what it describes is the ",["$","em",null,{"children":"structure"}]," of a running\nprocess. Nothing in the v1.6.5 binary serves that tree over HTTP; the old\nmetrics collector went away with the OpenTelemetry migration, so today the\nderive is what keeps every store and scheduler describable, and the trait\nbound on ",["$","code",null,{"children":"StoreDriver"}]," is what forces new ones to be."]}]
2f:["$","p",null,{"children":[["$","strong",null,{"children":["System B: ",["$","code",null,{"children":"forge-util/src/metrics.rs"}],"."]}]," OpenTelemetry instruments\nin eight ",["$","code",null,{"children":"LazyLock"}]," bundles (",["$","code",null,{"children":"CACHE_METRICS"}],", ",["$","code",null,{"children":"EXECUTION_METRICS"}],",\n",["$","code",null,{"children":"WORKER_METRICS"}],", ",["$","code",null,{"children":"RPC_METRICS"}],", ",["$","code",null,{"children":"SCHEDULER_METRICS"}],", ",["$","code",null,{"children":"STORE_TIER_METRICS"}],",\n",["$","code",null,{"children":"HEALTH_METRICS"}],", ",["$","code",null,{"children":"CONNECTION_METRICS"}],"), wired up in\n",["$","code",null,{"children":"telemetry.rs::init_tracing"}]," and exported over OTLP (",["$","code",null,{"children":"NL_OTEL_ENDPOINT"}],"\noverrides the endpoint). Attribute sets for the hot paths are\n",["$","strong",null,{"children":"pre-computed"}]," into ",["$","code",null,{"children":"CacheMetricAttrs"}]," and ",["$","code",null,{"children":"ExecutionMetricAttrs"}]," structs\nspecifically to bound cardinality."]}]
30:["$","p",null,{"children":["Choose A when you are exposing the ",["$","em",null,{"children":"structure"}]," of a component: how many\nstores, which config, what state. Choose B when you want a number someone\nwill graph or alert on."]}]
31:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$f:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"Two hazards in the OTel path"}],["$","p",null,{"children":[["$","code",null,{"children":"forge-util/src/metrics.rs"}]," carries the ",["$","strong",null,{"children":"Business Source License"}],"\nheader, not the FSL header the rest of the crate uses; do not paste the\nwrong one in. And never attach a per-action or per-worker identifier to a\nhot instrument; the pre-computed attribute structs exist precisely to stop\nthat, and adding a high-cardinality dimension will take down a Prometheus\nbefore it takes down Forge."]}]]}]]}]
32:["$","p",null,{"children":["Instrument names are dotted OpenTelemetry style, with ",["$","code",null,{"children":".with_description"}],"\nand a ",["$","code",null,{"children":".with_unit"}]," that is either a UCUM unit (",["$","code",null,{"children":"\"By\""}],", ",["$","code",null,{"children":"\"s\""}],", ",["$","code",null,{"children":"\"ms\""}],") or a\nbraced count such as ",["$","code",null,{"children":"\"{entry}\""}],", ",["$","code",null,{"children":"\"{action}\""}]," or ",["$","code",null,{"children":"\"{worker}\""}],"."]}]
