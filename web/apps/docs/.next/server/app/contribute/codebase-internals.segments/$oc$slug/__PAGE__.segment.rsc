3a:["$","$L4e",null,{"type":"multiple","children":[["$","$L4f",null,{"title":"Why can't I use `tokio::spawn`?","id":"why-not-tokio-spawn","children":["$","p",null,{"children":["Because a bare spawn has no name, no tracing span, no OpenTelemetry\ncontext and no cancellation story. The three macros in\n",["$","code",null,{"children":"forge-util::task"}]," supply all four, and the clippy config makes the\nalternative a build failure rather than a review comment."]}]}],["$","$L4f",null,{"title":"Should my new metric be a derive or an OTel instrument?","id":"derive-or-otel","children":["$","p",null,{"children":["If it describes what a component ",["$","em",null,{"children":"is"}]," (its config, its children, its\ninternal counters as part of the object tree), derive; the\n",["$","code",null,{"children":"MetricsComponent"}]," bound on ",["$","code",null,{"children":"StoreDriver"}]," requires the impl anyway. If a\ndashboard would graph it or an alert would fire on it, OTel. A few things\nlegitimately want both; most want exactly one."]}]}],["$","$L4f",null,{"title":"My store compiles but panics at runtime about `inner_store`.","id":"inner-store-runtime-error","children":["$","p",null,{"children":["You returned something other than ",["$","code",null,{"children":"self"}]," from ",["$","code",null,{"children":"inner_store"}]," while\nadvertising an optimization your store cannot honour, or the reverse.\nA wrapper that changes the bytes on the way through must return ",["$","code",null,{"children":"self"}],";\na wrapper that only routes should forward to its inner store."]}]}],["$","$L4f",null,{"title":"Which license header do I put on a new file?","id":"which-license-header","children":["$","p",null,{"children":["Copy it from the file next to yours. FSL-1.1-Apache-2.0 is the default;\n",["$","code",null,{"children":"forge-util/src/metrics.rs"}]," and everything under\n",["$","code",null,{"children":"forge-worker/src/persistent_worker/"}]," are Business Source License,\nand a handful of files are Apache-2.0."]}]}],["$","$L4f",null,{"title":"`cargo fmt` keeps fighting with CI. Why?","id":"cargo-fmt-fights-ci","children":["$","p",null,{"children":["The formatting config uses nightly-only options. Stable ",["$","code",null,{"children":"cargo fmt"}],"\nsilently ignores them and produces different output. Run\n",["$","code",null,{"children":"bazel run --config=rustfmt @rules_rust//:rustfmt"}],", which is what CI runs."]}]}]]}]
