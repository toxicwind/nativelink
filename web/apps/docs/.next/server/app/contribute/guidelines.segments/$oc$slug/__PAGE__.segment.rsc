15:["$","p",null,{"children":[["$","strong",null,{"children":"Tests that match the change."}]," A bug fix wants a regression test; new\nbehaviour wants both unit and integration coverage. No coverage\npercentage gate; the question is whether the new path is exercised, not\nwhether a number moved."]}]
16:["$","p",null,{"children":[["$","strong",null,{"children":"Conventions followed rather than argued."}]," Most review feedback on a first\ncontribution is about the house rules: the task macros instead of\n",["$","code",null,{"children":"tokio::spawn"}],", ",["$","code",null,{"children":"#[expect(..., reason = \"…\")]"}]," rather than a bare ",["$","code",null,{"children":"#[allow]"}],",\nthe ",["$","code",null,{"children":"BUILD.bazel"}]," ",["$","code",null,{"children":"srcs"}]," entry. ",["$","$L2a",null,{"href":"/contribute/codebase-internals","children":"Codebase internals"}]," is the page that\ngets you past those in one read."]}]
