18:["$","p",null,{"children":["Your contribution is licensed under the license that applies to the file or\nmodule you change. Most of the repository is ",["$","code",null,{"children":"FSL-1.1-Apache-2.0"}],"; a handful\nof files are Apache-2.0; and two areas,\n",["$","code",null,{"children":"forge-util/src/metrics.rs"}]," and everything under\n",["$","code",null,{"children":"forge-worker/src/persistent_worker/"}],", are ",["$","strong",null,{"children":"Business Source\nLicense"}],". Copy the header from the file next to the one you are creating\nrather than from memory."]}]
19:["$","p",null,{"children":"Meaningful contributors may be eligible for license waivers on the Business\nSource License modules. Raise an issue or contact the maintainers before\ndepending on one."}]
