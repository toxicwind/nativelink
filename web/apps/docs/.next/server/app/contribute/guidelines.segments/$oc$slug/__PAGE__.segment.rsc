laim it by commenting first."}],"\nThat is the only mechanism preventing two people from writing the same patch."]}],"\n",["$","$L6",null,{"as":"h2","id":"git-setup","children":"Git setup, once"}],"\n",["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":["$L7","$L8","$L9"]}],"\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"]}],"$L1d"]}],["$L1e","$L1f"],"$L20"]}],"isPartial":"$@21","staleTime":"$22","varyParams":null},{"rsc":"$L23","isPartial":"$@24","staleTime":"$22","varyParams":null},{"rsc":"$L25","isPartial":"$@26","staleTime":"$22","varyParams":"$27"}],"isUpgradeableISRFallback":false,"a":"$@28","rootVaryParams":null,"needsRuntimeRequest":"$@29"}
