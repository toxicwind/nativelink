1b:["$","$L31",null,{"type":"multiple","children":[["$","$L32",null,{"title":"Which dev workflow should I pick?","id":"which-dev-workflow-should-i-pick","children":["$","p",null,{"children":[["$","$L2a",null,{"href":"/contribute/cargo","children":"Cargo"}]," for small localized changes, the fastest way\nin. ",["$","$L2a",null,{"href":"/contribute/bazel","children":"Bazel"}]," when you want exactly what CI runs.\n",["$","$L2a",null,{"href":"/contribute/nix","children":"Nix"}]," for the pinned shell, required for LRE work and\nfor the generated ",["$","code",null,{"children":"bazelrc"}]," fragments."]}]}],["$","$L32",null,{"title":"My Cargo tests pass but CI is red.","id":"cargo-green-ci-red","children":["$","p",null,{"children":["Two usual causes. A new source file missing from its crate's\n",["$","code",null,{"children":"BUILD.bazel"}]," ",["$","code",null,{"children":"srcs"}]," list, since Bazel enumerates where Cargo globs; or\nformatting, because ",["$","code",null,{"children":"bazel test"}]," attaches a rustfmt aspect and stable\n",["$","code",null,{"children":"cargo fmt"}]," produces different output."]}]}],["$","$L32",null,{"title":"Do I sign with `git commit -s`?","id":"do-i-sign-with-dash-s","children":["$","p",null,{"children":["No. That adds a DCO trailer, which this project does not use. Configure\n",["$","code",null,{"children":"commit.gpgsign = true"}]," with an SSH or GPG signing key so commits are\ncryptographically signed."]}]}],["$","$L32",null,{"title":"I need to change something after review started.","id":"change-after-review","children":["$","p",null,{"children":["Amend and force-push. ",["$","code",null,{"children":"git commit --amend && git push -f"}],". Reviewable\ntracks the diff between commit versions, so reviewers can see exactly\nwhat you changed without a follow-up commit polluting the history."]}]}],["$","$L32",null,{"title":"How long until someone looks at my PR?","id":"how-long-until-review","children":["$","p",null,{"children":"Every PR is reviewed by a core contributor, including PRs from core\ncontributors. No turnaround is published; if a PR goes quiet,\ncomment on it or ping in the Reviewable thread."}]}]]}]
