2c:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Symptom"}],["$","th",null,{"children":"Cause"}],["$","th",null,{"children":"Fix"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Namespace/worker tests fail on Ubuntu 24.04"}],["$","td",null,{"children":[["$","code",null,{"children":"kernel.apparmor_restrict_unprivileged_userns"}]," is on by default"]}],["$","td",null,{"children":"Disable it for the session, or skip those tests locally and let CI run them"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"Too many open files"}]}],["$","td",null,{"children":[["$","code",null,{"children":"ulimit -n"}]," too low for the store tests"]}],["$","td",null,{"children":"Raise it; Forge itself defaults to a 24576 fd budget"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"run_integration_tests.sh"}]," exits immediately"]}],["$","td",null,{"children":["Running as root, or Docker not reachable without ",["$","code",null,{"children":"sudo"}]]}],["$","td",null,{"children":"Run as a non-root user with Docker access"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"The Mongo store suite times out"}],["$","td",null,{"children":["It downloads a real ",["$","code",null,{"children":"mongod"}]," on a cold Bazel cache"]}],["$","td",null,{"children":"Give it network, and don't run it on a plane"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Two tests pass alone, fail together"}],["$","td",null,{"children":["Both touch process environment; they are marked ",["$","code",null,{"children":"#[serial(env)]"}]," for a reason"]}],["$","td",null,{"children":"Don't parallelise them, and mark new env-touching tests the same way"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"Non-redacted data in \"...\""}]}],["$","td",null,{"children":["The ",["$","code",null,{"children":"#[forge_test]"}]," log assertion caught new ",["$","code",null,{"children":"Debug"}]," output containing a buffer"]}],["$","td",null,{"children":"Redact the log line rather than the assertion"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["Formatting failures from ",["$","code",null,{"children":"bazel test"}]]}],["$","td",null,{"children":["Stable ",["$","code",null,{"children":"cargo fmt"}]," ignores the nightly-only rustfmt options"]}],["$","td",null,{"children":["$","code",null,{"children":"bazel run --config=rustfmt @rules_rust//:rustfmt"}]}]]}]]}]]}]}]
