2e:["$","$L3f",null,{"type":"multiple","children":[["$","$L40",null,{"title":"Do I have to run the whole suite before submitting?","id":"run-whole-suite","children":["$","p",null,{"children":["Run the crate you touched with Cargo while iterating, then\n",["$","code",null,{"children":"bazel test //..."}]," once before pushing. CI runs Bazel, and the aspects\nattached to ",["$","code",null,{"children":"bazel test"}]," catch formatting and clippy problems that a\nCargo run does not."]}]}],["$","$L40",null,{"title":"Why do doc examples need their own target?","id":"why-doctests","children":["$","p",null,{"children":["Doc comments in ",["$","code",null,{"children":"forge-config"}]," are the source text for the generated\n",["$","$L41",null,{"href":"/reference/forge-config","children":"configuration reference"}],", so their examples\nare user-facing documentation. ",["$","code",null,{"children":"bazel test doctests"}]," is what stops them\nrotting."]}]}],["$","$L40",null,{"title":"My test needs to wait for something. Should I sleep?","id":"should-i-sleep","children":["$","p",null,{"children":["No. Use ",["$","code",null,{"children":"#[forge_test(start_paused = true)]"}]," with Tokio's virtual\nclock, or ",["$","code",null,{"children":"MockInstantWrapped"}]," with ",["$","code",null,{"children":"MockClock::advance"}]," where a store's\nown clock is what matters. A real sleep makes the suite slower and\nflakier at the same time."]}]}],["$","$L40",null,{"title":"What coverage do I need for a PR to be accepted?","id":"coverage-requirement","children":["$","p",null,{"children":["No numeric gate exists. What reviewers ask for is a regression test for\na bug fix and both unit and integration coverage for new behaviour; see\n",["$","$L41",null,{"href":"/contribute/guidelines","children":"contribution guidelines"}],"."]}]}],["$","$L40",null,{"title":"Where do I add a new test file so Bazel sees it?","id":"new-test-file-bazel","children":["$","p",null,{"children":["In the crate's ",["$","code",null,{"children":"BUILD.bazel"}],", in the ",["$","code",null,{"children":"srcs"}]," list of its ",["$","code",null,{"children":"rust_test_suite"}],"\n(named ",["$","code",null,{"children":"integration"}],"). Cargo discovers ",["$","code",null,{"children":"tests/*.rs"}]," automatically, so a\ntest that runs locally and never runs in CI is usually this."]}]}]]}]
