25:["$","p",null,{"children":["It refuses to run as root, requires Bazel, Docker and ",["$","code",null,{"children":"sudo"}],", and waits for\nports 50051, 50052 and 50071 before starting. It drives\n",["$","code",null,{"children":"simple_cache_test.sh"}],", ",["$","code",null,{"children":"simple_remote_execution_test.sh"}],",\n",["$","code",null,{"children":"simple_tls_test.sh"}]," and ",["$","code",null,{"children":"chunking_cache_test.sh"}],". You can pass a pattern to\nrun one of them."]}]
26:["$","p",null,{"children":["Beyond those, ",["$","code",null,{"children":"integration_tests/"}]," also holds BuildStream, Buck2 and Mongo\nsuites driven from Nix, and ",["$","code",null,{"children":"forge-test/fuzz"}]," holds a single fuzz\ntarget (",["$","code",null,{"children":"cas_config.rs"}],") run by ClusterFuzzLite."]}]
