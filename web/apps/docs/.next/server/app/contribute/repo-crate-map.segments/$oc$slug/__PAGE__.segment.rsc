14:["$","p",null,{"children":[["$","strong",null,{"children":[["$","code",null,{"children":"forge-metric"}]," does not depend on ",["$","code",null,{"children":"forge-error"}],"."]}]," It cannot;\n",["$","code",null,{"children":"forge-error"}]," depends on ",["$","code",null,{"children":"forge-metric"}],", and the source carries a\ncomment explaining that the direction was chosen to break the cycle. A\nmetrics change that wants to return a ",["$","code",null,{"children":"forge_error::Error"}]," is a change\nthat needs rethinking."]}]
