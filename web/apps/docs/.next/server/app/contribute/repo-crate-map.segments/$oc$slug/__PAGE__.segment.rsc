12:["$","p",null,{"children":[["$","strong",null,{"children":"Worker bookkeeping lives in the scheduler."}]," ",["$","code",null,{"children":"worker.rs"}],",\n",["$","code",null,{"children":"worker_registry.rs"}]," and ",["$","code",null,{"children":"api_worker_scheduler.rs"}]," are in\n",["$","code",null,{"children":"forge-scheduler"}],". The scheduler's ",["$","em",null,{"children":"model"}]," of a worker (its\nproperties, its consumed resources, its liveness) belongs to the scheduler.\n",["$","code",null,{"children":"forge-worker"}]," is only the runtime that executes actions."]}]
