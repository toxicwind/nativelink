7:["$","p",null,{"children":["The version at the top of the root manifest is a ",["$","code",null,{"children":"[package]"}]," version, not\na ",["$","code",null,{"children":"[workspace.package]"}]," version. Nothing inherits it; every crate carries\nits own copy, which is why a release bump edits the version in fourteen\nfiles (seventeen once the two lock files and the changelog are counted).\nSee ",["$","$L2f",null,{"href":"/contribute/release-versioning","children":"releases and versioning"}],"."]}]
