1d:["$","$L2e",null,{"type":"multiple","children":[["$","$L2f",null,{"title":"Does a minor version bump mean no breaking changes?","id":"does-minor-mean-no-breaking","children":["$","p",null,{"children":["It is not guaranteed to. No SemVer policy is stated, and\n",["$","code",null,{"children":"compatibility_level = 0"}]," in ",["$","code",null,{"children":"MODULE.bazel"}]," explicitly asserts none. Read\nthe release notes, which do call out breaking changes and include\nmigration instructions."]}]}],["$","$L2f",null,{"title":"Why sign tags manually instead of automating it?","id":"why-manual-tags","children":["$","p",null,{"children":"A signed tag attests that a human made the release. Automating it would\nmove the signing key into CI, which is exactly what the signature is\nsupposed to rule out."}]}],["$","$L2f",null,{"title":"Can I depend on `forge-store` from my own crate?","id":"depend-on-crates","children":["$","p",null,{"children":"Not from crates.io; nothing is published there. You can path- or\ngit-depend on it, but with no compatibility policy you are pinning a\ncommit, not an interface."}]}],["$","$L2f",null,{"title":"A release shipped without signed assets. Can it be fixed?","id":"backfill-signed-assets","children":["$","p",null,{"children":["Yes. Re-run ",["$","code",null,{"children":"Signed release artifacts"}]," from the Actions tab with the tag\nas the input; it rebuilds, re-signs, and attaches the assets to the\nexisting release."]}]}],["$","$L2f",null,{"title":"Which version do the docs describe?","id":"which-version-do-docs-describe","children":["$","p",null,{"children":"The configuration reference is generated per release and version-switched\nin the UI. Everything else describes the most recent tagged version. If a\npage's claim and your binary disagree, the binary wins, and the page is\na bug worth reporting."}]}]]}]
