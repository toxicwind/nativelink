19:["$","p",null,{"children":["The reference pages under ",["$","code",null,{"children":"reference/forge-config/"}]," are generated from\nthe Rust config crate and must never be hand-edited. The chain is:\n",["$","code",null,{"children":"cargo run --bin build-schema --features dev-schema"}]," produces a JSON schema,\n",["$","code",null,{"children":"web/apps/docs/scripts/gen-config-reference.mjs"}]," and ",["$","code",null,{"children":"scripts/lib/schema-to-mdx.mjs"}],"\nturn it into MDX, and the whole thing is invoked as:"]}]
