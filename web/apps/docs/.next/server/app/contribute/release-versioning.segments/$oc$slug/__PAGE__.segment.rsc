14:["$","p",null,{"children":[["$","strong",null,{"children":"No SemVer or compatibility policy is stated anywhere in the\nrepository."}]," ",["$","code",null,{"children":"MODULE.bazel"}]," declares ",["$","code",null,{"children":"compatibility_level = 0"}],", which is\nBazel's way of saying no compatibility guarantee has been asserted. The\nsecurity policy states only that the most recent tagged version is\nsupported."]}]
15:["$","p",null,{"children":"In practice this means: read the release notes for breaking changes rather\nthan inferring from the version number; pin an exact version in production\nrather than a range; and treat a minor bump as something to test, not\nsomething to assume."}]
16:["$","p",null,{"children":[["$","strong",null,{"children":"Nothing is published to crates.io."}]," The crates exist for the workspace's\nown use. Consume Forge as a binary, a container image, or a Bazel\nmodule, not as a library dependency."]}]
17:["$","p",null,{"children":["Backward-compatible config changes do get shims: see the ",["$","code",null,{"children":"#[serde(untagged)]"}],"\nhelpers in ",["$","code",null,{"children":"forge-config"}],"'s ",["$","code",null,{"children":"backcompat.rs"}],", which accept the old shape\nand emit a deprecation warning. That is a convention, not a promise."]}]
