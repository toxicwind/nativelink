1f:["$","p",null,{"children":["Every key the scheduler declares as ",["$","code",null,{"children":"minimum"}]," or ",["$","code",null,{"children":"exact"}]," must appear here, or\nthis worker will never be matched for any action requesting it."]}]
20:["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/forge-config/src/cas_server.rs","target":"_blank","rel":"noreferrer","data-source-link":"forge-config/src/cas_server.rs","data-source-ref":"v1.6.5","title":"forge-config/src/cas_server.rs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"LocalWorkerConfig"]}]
21:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":["$","path",null,{"d":"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"}]}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"`upload_action_result` is one level, not two"}],["$","p",null,{"children":["The correct shape is ",["$","code",null,{"children":"upload_action_result: { ac_store: \"AC_MAIN_STORE\" }"}],".\nConfigs showing ",["$","code",null,{"children":"upload_action_result: { upload_action_result: { ... } }"}],"\nare wrong and will be rejected; ",["$","code",null,{"children":"ac_store"}]," is a direct field. Omitting the\nblock entirely is also valid, and means the worker runs actions but never\ncaches their results, which looks exactly like a broken cache."]}]]}]]}]
22:["$","$L7",null,{"as":"h2","id":"how-they-find-each-other","children":"How they find each other"}]
23:["$","p",null,{"children":"Nothing in the scheduler names a worker. Workers are not declared to the\nscheduler at all; they connect to it, announce their platform properties, and\nare added to the pool. Removing a worker means stopping it."}]
24:["$","p",null,{"children":"That is what the three pieces of wiring add up to:"}]
25:["$","ul",null,{"children":["\n",["$","li",null,{"children":["the ",["$","code",null,{"children":"execution"}]," service names the scheduler, so clients can submit actions;"]}],"\n",["$","li",null,{"children":["the ",["$","code",null,{"children":"worker_api"}]," service names the same scheduler, on a different port, so\nworkers can join;"]}],"\n",["$","li",null,{"children":["each worker names the ",["$","code",null,{"children":"worker_api"}]," address, so it knows where to join."]}],"\n"]}]
26:["$","p",null,{"children":["In a single-process config all three are the same process and the endpoint is\n",["$","code",null,{"children":"127.0.0.1"}],". In a fleet, the scheduler is its own deployment and that endpoint\nis a service address. The config shape does not change."]}]
27:["$","$L7",null,{"as":"h2","id":"the-fields-that-change-what-youll-notice","children":"The fields that change what you'll notice"}]
28:["$","p",null,{"children":[["$","code",null,{"children":"SimpleSpec"}]," has ten optional fields. Most can stay at their defaults\nforever. These four are the ones worth setting deliberately:"]}]
29:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"worker_timeout_s"}]}]," (default 10 s): how long a silent worker stays in the\npool. Any message from the worker counts, not only the heartbeat. Keep it at\nleast twice the worker's ",["$","code",null,{"children":"worker_api_endpoint.timeout"}],"; a worker evicted\nmid-action has every action it held re-queued, each with an attempt spent."]}]
2a:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"max_action_executing_timeout_s"}]}]," (default 0, disabled): caps how long an\naction can sit in ",["$","code",null,{"children":"Executing"}]," with no update, even from a worker that is\notherwise healthy. This is the setting that catches a worker stuck on one\nspecific action rather than dead. Without it, such an action hangs until a\nclient gives up."]}]
2b:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"max_job_retries"}]}]," (default 3): how many times an action that fails with\nan internal error is retried before the last error is returned to the client.\nIt exists to stop one poisonous action from cycling through and destabilising\nyour whole fleet. A lost worker and a memory escalation do not spend it."]}]
2c:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"max_worker_loss_retries"}]}]," (default 10): how many times an action whose\nworker was lost (disconnected, timed out, evicted, or OOM-killed as a whole)\nis queued again before the client gets a ",["$","code",null,{"children":"FAILED_PRECONDITION"}],". Losing a\nworker is not the action's failure, so this budget is separate and larger;\nit only stops an action that takes a worker down every time it runs."]}]
2d:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"retain_completed_for_s"}]}]," (default 60 s): how long a completed action's\nresult stays available for a late ",["$","code",null,{"children":"WaitExecution"}]," call. Clients that\ndisconnect and reconnect need this window to be longer than their reconnect\ntime."]}]
2e:["$","p",null,{"children":["On the worker side, ",["$","strong",null,{"children":["$","code",null,{"children":"max_inflight_tasks"}]}]," (default 0, meaning unlimited) is\nthe one to set on any real machine. Unlimited means the worker accepts every\naction the scheduler offers and lets the OS sort out the contention."]}]
2f:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"drain_on_shutdown"}]}]," (off by default) makes a worker announce that it is\ndraining the moment it gets ",["$","code",null,{"children":"SIGTERM"}],", so the scheduler stops dispatching to\nit while it finishes what it holds. It needs a scheduler that understands the\ndrain flag; an older one removes the worker on the spot and requeues its\nactions."]}]
30:["$","p",null,{"children":["Three bounds keep one action from taking the worker with it.\n",["$","strong",null,{"children":["$","code",null,{"children":"max_captured_output_bytes"}]}]," (default 0, unbounded) caps how much of an\naction's stdout or stderr the worker holds in memory; past it the output\nspills to a file under the action directory and is uploaded from disk, so a\ntool that prints gigabytes costs disk, not RAM. ",["$","strong",null,{"children":["$","code",null,{"children":"precondition_timeout_ms"}]}],"\n(default 30000) ends a hanging precondition script and refuses the action as\nbackpressure. ",["$","strong",null,{"children":["$","code",null,{"children":"orphan_sweep_interval_s"}]}]," (default 0, off) removes action\ndirectories under ",["$","code",null,{"children":"work_directory"}]," that no running action owns and that a\nfailed cleanup left behind; the directory is always purged at startup."]}]
31:["$","p",null,{"children":["When the worker ends an action, for a timeout or a scheduler cancel, the\nprocess group gets SIGTERM first and ",["$","strong",null,{"children":["$","code",null,{"children":"kill_grace_ms"}]}]," (default 5000) to\nwrite its own cleanup before SIGKILL follows; the memory reservation kill\nskips the grace. A killed action keeps the stdout and stderr it produced.\n",["$","strong",null,{"children":["$","code",null,{"children":"set_tmpdir"}]}]," (default true) gives every action its own ",["$","code",null,{"children":"TMPDIR"}]," under its\naction directory, so concurrent actions writing the same temporary file name\nno longer collide; a ",["$","code",null,{"children":"TMPDIR"}]," in the action's own environment still wins, and\ncode that hard-codes ",["$","code",null,{"children":"/tmp"}]," is unaffected. A timeout above ",["$","code",null,{"children":"max_action_timeout_s"}],"\nis clamped to it rather than rejected."]}]
32:["$","p",null,{"children":["When the action's own process has exited, anything it left running in its\nprocess group (a background job, a helper that daemonized) is killed, since\nit would otherwise hold the action's output pipes open and the action would\nsit there until its timeout; the pipes then get five seconds to drain, and\nwhat was read by then is kept. The worker also makes itself the parent of\nevery process an action leaves behind and reaps them on a timer, so a build\nwhose actions fork and do not wait no longer leaves hundreds of zombies on\nthe worker for the life of the pod. Under ",["$","code",null,{"children":"use_namespaces"}]," the stub does\nthe reaping inside the action's PID namespace."]}]
33:["$","p",null,{"children":["Every executed action reports its resource usage to the scheduler with an\n",["$","code",null,{"children":"outcome"}],": ",["$","code",null,{"children":"COMPLETED"}],", ",["$","code",null,{"children":"KILLED_MEMORY"}]," (the worker's reservation kill, or a\nSIGKILL from the kernel with the last memory sample within 10% of the limit),\n",["$","code",null,{"children":"KILLED_TIMEOUT"}]," or ",["$","code",null,{"children":"KILLED_EXTERNAL"}],", plus wall time and the reservation the\naction ran under. The scheduler logs every kill outcome with its mnemonic."]}]
34:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"resource_enforcement"}]}]," (off by default, Linux only) makes the worker hold an\naction to the memory reservation the scheduler placed it by. With\n",["$","code",null,{"children":"memory: soft"}]," the worker kills the action's process group once two\nconsecutive samples exceed ",["$","code",null,{"children":"memory_kb"}]," plus ",["$","code",null,{"children":"memory_headroom_percent"}],"\n(default 20), or one sample exceeds twice that, and fails it with\n",["$","code",null,{"children":"FAILED_PRECONDITION"}]," naming the reservation and the observed peak. Samples\nare 250 ms apart, so an action that allocates faster than the pod's whole\nlimit in half a second can still reach the cgroup limit first; the\nreservations admitted onto a worker must also sum to less than its limit\nwith the headroom included. Without it the kill comes from the pod's cgroup limit,\nand on cgroup v2 that kill takes the worker and every action on it, not just\nthe one that grew. The sample is the group's proportional set size, so a\nparent's pages shared with its forked children count once. Actions run\nthrough a persistent worker are not covered: that process outlives the action\nand serves others, so only the pod's limit bounds it. With enforcement on, the\nworker reads an action's properties from the scheduler's dispatch rather than\nthe client's request, so a reservation the scheduler placed the action by is\nthe one enforced and exported to the environment."]}]
35:["$","p",null,{"children":[["$","code",null,{"children":"disk: guard"}]," adds a check before any input is fetched: an action whose\n",["$","code",null,{"children":"disk_kb"}]," reservation exceeds the free space under the work directory, less\nwhat the actions already admitted reserved, is refused with ",["$","code",null,{"children":"RESOURCE_EXHAUSTED"}],", which the scheduler requeues without\ncounting an attempt and holds off this worker until its next keepalive,\ninstead of running the fetch into a full disk.\n",["$","code",null,{"children":"disk: soft"}]," is the guard plus a kill: every ten seconds the worker adds up\nthe files the action has written under its own directory (those modified\nsince its command started; inputs were materialized before that and are\nnot counted), and an action past its ",["$","code",null,{"children":"disk_kb"}]," reservation by\n",["$","code",null,{"children":"disk_headroom_percent"}]," is killed and fails with ",["$","code",null,{"children":"FAILED_PRECONDITION"}],", its\noutcome ",["$","code",null,{"children":"KILLED_DISK"}],". The walk runs on the blocking pool as its own task,\nso memory sampling carries on meanwhile. With either disk mode the action's\nusage report carries ",["$","code",null,{"children":"peak_disk_kb"}],", what it wrote, from one walk of the\naction directory at completion, which is the only walk ",["$","code",null,{"children":"guard"}]," pays. The\nfigure is reported and exported for now; the scheduler's sizing consumer\ncomes with the size ladder."]}]
36:["$","$L8",null,{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>","children":["$","$L9",null,{"children":["$","code",null,{"children":[["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"resource_enforcement\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": {"}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"memory\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"soft\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"memory_property_name\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"memory_kb\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"memory_headroom_percent\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"20"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"disk\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"soft\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"disk_property_name\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"\"disk_kb\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":","}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"  \"disk_headroom_percent\""}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"},"children":"20"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"}"}]}]]}]}]}]
37:["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"capacity"}]}]," makes the worker advertise CPU and memory from its own cgroup\nlimits instead of from ",["$","code",null,{"children":"platform_properties"}],": it reads ",["$","code",null,{"children":"cpu.max"}]," and\n",["$","code",null,{"children":"memory.max"}]," at its cgroup v2 root, keeps back ",["$","code",null,{"children":"overhead_cpu_millicores"}],"\n(thousandths of a core) and ",["$","code",null,{"children":"overhead_memory_kb"}]," for itself, divides the\nmemory by the enforcement headroom (",["$","code",null,{"children":"memory_headroom_percent"}],", which follows\n",["$","code",null,{"children":"resource_enforcement"}]," unless set), and sets the two properties to the\nresult at registration. The limit is the number the kernel enforces, so the\nnumber the scheduler packs against is derived from it rather than typed next\nto it. Where the cgroup cannot be read, hand-typed ",["$","code",null,{"children":"cpu_count"}]," and\n",["$","code",null,{"children":"memory_kb"}]," stand with a warning; with neither typed the worker refuses to\nstart, since it could take no action that asks for either. ",["$","code",null,{"children":"cpu_unit"}]," is the scale of the CPU\nproperty: ",["$","code",null,{"children":"cores"}]," by default, rounded down, the scale ",["$","code",null,{"children":"cpu_count: { query_cmd: \"nproc\" }"}]," and an action's ",["$","code",null,{"children":"cpu_count=1"}]," use; a fleet that\nadvertises and requests thousandths of a core sets ",["$","code",null,{"children":"millicores"}],". The\noverhead is always in thousandths of a core."]}]
