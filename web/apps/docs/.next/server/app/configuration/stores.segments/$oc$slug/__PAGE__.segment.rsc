33:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Type"}],["$","th",null,{"children":"What it does"}],["$","th",null,{"children":"Why you'd add it"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"filesystem"}]}],["$","td",null,{"children":"Stores blobs on disk"}],["$","td",null,{"children":"Durability across restarts"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"memory"}]}],["$","td",null,{"children":"Stores blobs in RAM"}],["$","td",null,{"children":"Speed, for small hot data"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"compression"}]}],["$","td",null,{"children":"Compresses around a backend"}],["$","td",null,{"children":"Disk savings on build artifacts"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"dedup"}]}],["$","td",null,{"children":"Splits blobs into chunks, stores each once"}],["$","td",null,{"children":"Large, similar artifacts"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"fast_slow"}]}],["$","td",null,{"children":["Reads from ",["$","code",null,{"children":"fast"}],", falls back to ",["$","code",null,{"children":"slow"}]]}],["$","td",null,{"children":"A RAM tier over a disk tier"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"size_partitioning"}]}],["$","td",null,{"children":"Routes by blob size to two stores"}],["$","td",null,{"children":"Keep small objects out of an index"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"verify"}]}],["$","td",null,{"children":"Checks hash and size on write"}],["$","td",null,{"children":"Catch corruption at the boundary"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"completeness_checking"}]}],["$","td",null,{"children":"Rejects AC entries whose blobs are gone"}],["$","td",null,{"children":"Correct action-cache results"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"existence_cache"}]}],["$","td",null,{"children":"Remembers what the backend already has"}],["$","td",null,{"children":"Skip redundant existence checks"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"ref_store"}]}],["$","td",null,{"children":"Names another top-level store"}],["$","td",null,{"children":"Sharing, instead of duplicating"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"shard"}]}],["$","td",null,{"children":"Spreads across weighted backends"}],["$","td",null,{"children":"Horizontal capacity"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","code",null,{"children":"noop"}]}],["$","td",null,{"children":"Discards everything"}],["$","td",null,{"children":"A required slot you don't want to fill"}]]}]]}]]}]}]
34:["$","p",null,{"children":["Two of these are load-bearing for correctness rather than performance.\n",["$","strong",null,{"children":["$","code",null,{"children":"verify"}]}]," with ",["$","code",null,{"children":"verify_hash: true"}]," catches a blob whose content doesn't\nmatch the digest it was uploaded under. ",["$","strong",null,{"children":["$","code",null,{"children":"completeness_checking"}]}]," wraps an\naction cache and checks the CAS still holds every blob a cached result refers\nto; without it, an eviction in the CAS turns cached results into builds that\nfail on a missing output."]}]
35:["$","p",null,{"children":["That's why most of the shipped backend examples (",["$","code",null,{"children":"filesystem_cas.json5"}],",\n",["$","code",null,{"children":"s3_backend_with_local_fast_cas.json5"}],", and the other object-storage examples)\nwrap the CAS in ",["$","code",null,{"children":"verify"}],", why ",["$","code",null,{"children":"redis.json5"}]," wraps the AC in\n",["$","code",null,{"children":"completeness_checking"}],", and why you should do both."]}]
36:["$","p",null,{"children":["The full list, with every field and default, is in the\n",["$","$L6",null,{"href":"/reference/forge-config/store-overview","children":"store reference"}],". Recipes for\nspecific backends (object storage, Redis, OCI registries) live in\n",["$","$L6",null,{"href":"/how-to","children":"How-to guides"}],"."]}]
37:["$","div",null,{"className":"my-6 flex gap-3 rounded-xl border px-5 py-4 border-amber-500/40 bg-amber-50/60 text-foreground dark:bg-amber-500/10","role":"alert","children":[["$","svg",null,{"width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"1.75","strokeLinecap":"round","strokeLinejoin":"round","className":"mt-0.5 shrink-0 text-amber-600 dark:text-amber-400","aria-hidden":"true","children":"$1f:props:children:0:props:children"}],["$","div",null,{"className":"flex-1 [&>p]:my-0 [&>p+p]:mt-2","children":[["$","p",null,{"className":"mb-1 font-mono text-xs font-semibold uppercase tracking-[0.12em]","children":"There is no `s3` store type"}],["$","p",null,{"children":["Cloud object storage is one store type, ",["$","code",null,{"children":"experimental_cloud_object_store"}],",\nwith a ",["$","code",null,{"children":"provider"}]," field selecting between ",["$","code",null,{"children":"aws"}],", ",["$","code",null,{"children":"gcs"}],", ",["$","code",null,{"children":"azure"}],", ",["$","code",null,{"children":"ontap"}],",\n",["$","code",null,{"children":"r2"}],", and ",["$","code",null,{"children":"oci"}],". Configs and older docs showing a top-level ",["$","code",null,{"children":"s3"}]," key predate\nthat consolidation and will not parse."]}]]}]]}]
