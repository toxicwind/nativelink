1d:["$","p",null,{"children":[["$","code",null,{"children":"content_path"}]," is where the bulk of the data lives. ",["$","code",null,{"children":"temp_path"}]," is a staging\narea for in-flight writes and deletes, and it must be ",["$","strong",null,{"children":"on the same block\ndevice"}]," as ",["$","code",null,{"children":"content_path"}]," so a completed write can be moved into place\natomically rather than copied. Everything in ",["$","code",null,{"children":"temp_path"}]," is deleted on every\nstartup."]}]
1e:["$","p",null,{"children":["On boot, ",["$","code",null,{"children":"content_path"}]," is scanned and every file found is added back to the\ncache; that scan is what makes the store durable across restarts."]}]
