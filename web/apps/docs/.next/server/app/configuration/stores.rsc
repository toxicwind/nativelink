4d:["$","p",null,{"children":["A store is content-addressed, so what goes in a key is the digest, and every\nserver, worker, and build client sharing a cache must compute that digest the\nsame way. SHA-256 and BLAKE3 produce different keys for identical bytes, so\nuploads made under one function are cache ",["$","em",null,{"children":"misses"}]," for clients using the\nother."]}]
4e:["$","p",null,{"children":["Forge defaults to SHA-256. Declare it explicitly anyway, in the ",["$","code",null,{"children":"global"}],"\nblock, so the file says what it depends on:"]}]
