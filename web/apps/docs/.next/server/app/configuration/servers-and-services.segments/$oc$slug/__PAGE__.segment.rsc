27:["$","p",null,{"children":["That pattern (the same store registered twice, once under the empty name and\nonce under ",["$","code",null,{"children":"main"}],") appears throughout the shipped examples, and it relies on\nthe sharing: clients differ in what they send, some omit the instance name\nentirely, and registering both means either kind of client works, against one\ncache, without a config change on their side."]}]
28:["$","p",null,{"children":["Pick one name per logical environment. ",["$","code",null,{"children":"main"}]," for the production cache,\n",["$","code",null,{"children":"<repo-name>"}]," for per-repo isolation, ",["$","code",null,{"children":"<something>-experiments"}]," for a sandbox\nthat shouldn't pollute the real cache, each pointed at its own store. Every\nclient targeting a given cache must use the same one."]}]
