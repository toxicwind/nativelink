0:{"buildId":"7afh9cBoHBO9HIwX4Lcyt","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#what-this-rung-adds","title":"What this section adds"},{"depth":2,"url":"#what-to-expect-the-first-time","title":"What to expect the first time"},{"depth":2,"url":"#the-pages-in-order","title":"The pages, in order"},{"depth":2,"url":"#start-here-or-skip-ahead","title":"Start here, or skip ahead"}],"children":[["$","$L3",null,{"children":"Remote execution"}],["$","$L4",null,{"children":"Workers that run the actions your cache misses."}],["$","$L5",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Who this is for:"}]," anyone with a working cache who wants the misses to stop\nrunning locally. ",["$","strong",null,{"children":"What you'll have at the end of this section:"}]," a scheduler,\nat least one worker, and a build whose cache misses execute on the farm\ninstead of on your machine. ",["$","strong",null,{"children":"Time:"}]," an hour for the first remote action,\nlonger if your toolchain isn't hermetic yet."]}],"\n",["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A cache serving hits to your build. If you don't have one yet, start with ",["$","$L6",null,{"href":"/getting-started","children":"Getting started"}],"."]}]}]]}],"\n",["$","$L7",null,{"as":"h2","id":"what-this-rung-adds","children":"What this section adds"}],"\n",["$","p",null,{"children":"A cache answers the question \"has this exact action already been run?\" When\nthe answer is no, something still has to run it, and with caching alone,\nthat something is your laptop. Remote execution changes the answer to that\nsecond question."}],"\n",["$","p",null,{"children":["Three things are new in the deployment: a ",["$","strong",null,{"children":"scheduler"}]," that decides which\nworker gets which action, at least one ",["$","strong",null,{"children":"worker"}]," that actually runs it, and\nthe ",["$","strong",null,{"children":"execution service"}]," on the server. One thing is new in your build\ninvocation: you tell the build tool where the executor is, and you declare\nwhat kind of machine your actions need. One thing is deliberately ",["$","em",null,{"children":"not"}]," new:\nyour CAS and action cache are exactly the ones Getting started left you with. That's\nwhy the sections are in this order."]}],"\n",["$","p",null,{"children":[["$","$L6",null,{"href":"/remote-execution/from-cache-to-execution","children":"From cache to execution"}]," is the\nlong version of that paragraph, and it's the page to read first."]}],"\n",["$","$L7",null,{"as":"h2","id":"what-to-expect-the-first-time","children":"What to expect the first time"}],"\n",["$","p",null,{"children":"The first remote action almost never works on the first try, and it's nearly\nalways one of two walls."}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Platform properties."}]," The scheduler only hands an action to a worker whose\nadvertised properties satisfy what the action asked for. When they don't line\nup, nothing errors: actions queue, indefinitely, which reads like a hang\nrather than a misconfiguration."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Toolchain hermeticity."}]," An action that runs on your machine because your\nmachine happens to have the right compiler will not run on a worker that\ndoesn't. Remote execution turns every implicit dependency on the local\nenvironment into a failure, which is uncomfortable the first time and\nextremely valuable afterwards."]}],"\n",["$","p",null,{"children":"Both walls get their own page here rather than a footnote, because everyone\nhits them."}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17"]}],"$L18"]}],["$L19","$L1a"],"$L1b"]}],"isPartial":"$@1c","staleTime":"$1d","varyParams":null},{"rsc":"$L1e","isPartial":"$@1f","staleTime":"$1d","varyParams":null},{"rsc":"$L20","isPartial":"$@21","staleTime":"$1d","varyParams":"$22"}],"isUpgradeableISRFallback":false,"a":"$@23","rootVaryParams":null,"needsRuntimeRequest":"$@24"}
