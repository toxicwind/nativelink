9:["$","ol",null,{"className":"[&>li]:list-none [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 my-8 ml-3 border-l-2 border-border pl-10 [counter-reset:step] [&>li]:relative [&>li]:mb-10 [&>li]:last:mb-0 [&>li]:[counter-increment:step] [&>li]:before:absolute [&>li]:before:left-[-57px] [&>li]:before:top-0 [&>li]:before:flex [&>li]:before:h-8 [&>li]:before:w-8 [&>li]:before:items-center [&>li]:before:justify-center [&>li]:before:rounded-full [&>li]:before:border-2 [&>li]:before:border-border [&>li]:before:bg-background [&>li]:before:content-[counter(step)] [&>li]:before:font-mono [&>li]:before:text-sm [&>li]:before:font-semibold [&>li]:before:text-brand [&>li_ul]:my-2 [&>li_ol]:my-2 [&>li_p]:my-2","children":[["$","li",null,{"children":[["$","p",null,{"children":[["$","strong",null,{"children":"Pick the storage backend."}]," The quickstart's ",["$","code",null,{"children":"basic_cas.json5"}]," keeps\neverything under ",["$","code",null,{"children":"/tmp"}]," on one machine, which is fine for a 10-minute\ndemo and useless for a team. Pick one before rolling out:"]}],["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Filesystem"}],": single-node clusters, sub-100GB caches."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Cloud object storage"}],": anything multi-node. The\n",["$","code",null,{"children":"experimental_cloud_object_store"}]," has providers for S3, R2, GCS,\nAzure Blob, ONTAP S3 and OCI; see\n",["$","$L6",null,{"href":"/how-to/stores/s3-and-compatible","children":"S3 and compatible"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Redis"}],": hot-key acceleration in front of the durable store.\nOptional but cheap latency wins."]}],"\n"]}]]}],["$","li",null,{"children":[["$","p",null,{"children":[["$","strong",null,{"children":"Pick the deployment substrate."}]," Most teams land on one of:"]}],["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Kubernetes"}],": Helm charts for Kubernetes ship with\n",["$","$L6",null,{"href":"https://enterprise.forge.com","children":"Forge Enterprise"}],"; the ",["$","code",null,{"children":"kubernetes/"}],"\ndirectory in this repository holds only Kustomize building blocks used\nby its own examples."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Bare VMs"}],": ",["$","code",null,{"children":"systemd"}]," units, one binary per role, with a load\nbalancer in front. See ",["$","$L6",null,{"href":"/operate/deploy-bare-metal","children":"Deploy on bare metal"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Docker Compose"}],": a reasonable starting point for a handful of\ndevelopers. See ",["$","$L6",null,{"href":"/operate/deploy-docker-compose","children":"Deploy with Docker Compose"}],"."]}],"\n"]}]]}],["$","li",null,{"children":[["$","p",null,{"children":[["$","strong",null,{"children":"Plan capacity."}]," Heuristics from production clusters:"]}],["$","ul",null,{"children":["\n",["$","li",null,{"children":"CAS storage: 5 to 20 GB per active developer, depending on\nlanguage. C++ skews high; Go skews low."}],"\n",["$","li",null,{"children":"Worker CPU: 1 vCPU per concurrent action. Headroom matters more\nthan peak."}],"\n",["$","li",null,{"children":"Network: cache reads are the hot path. Provision at least 1 Gbps\nbetween workers and CAS."}],"\n"]}]]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Set up TLS."}]," TLS on every listener, and client certificates where\nthe network is not trusted. The\n",["$","$L6",null,{"href":"/operate/production-config","children":"Production configuration"}]," page has the\ncertificate layout and ",["$","$L6",null,{"href":"/how-to/tls-and-auth","children":"TLS and auth"}]," the\nper-hop settings."]}]}],["$","li",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Wire up metrics."}]," Forge pushes OTLP metrics; there is no\nPrometheus scrape endpoint. Send them to an OpenTelemetry Collector\nand let Prometheus and Grafana read from there. See\n","$L24","."]}]}]]}]
