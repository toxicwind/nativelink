9:["$","li",null,{"children":["When a page states how the binary behaves, look for a source link: in the\npage source it is ",["$","code",null,{"children":"<SourceLink file=\"path/in/repo\" symbol=\"name\" />"}],", and\nin rendered HTML an ",["$","code",null,{"children":"<a data-source-link=\"path/in/repo\" data-source-ref=\"vX.Y.Z\">"}],".\nIt resolves to ",["$","code",null,{"children":"https://github.com/toxicwind/forge/blob/<ref>/<path>"}],".\nFollow it to check the claim against the code at that tag before you rely\non it."]}]
