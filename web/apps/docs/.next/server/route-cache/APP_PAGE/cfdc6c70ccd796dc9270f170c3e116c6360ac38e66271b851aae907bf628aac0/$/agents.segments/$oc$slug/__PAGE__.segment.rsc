25:["$","p",null,{"children":[["$","strong",null,{"children":"Redirects on every moved URL."}]," This site's structure changed\nsubstantially; agents hold cached URLs longer than humans hold bookmarks, so\nold paths redirect rather than 404. They live in\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/web/apps/docs/next.config.mjs","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/next.config.mjs","data-source-ref":"v1.6.5","title":"web/apps/docs/next.config.mjs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"next.config.mjs"]}],". Follow redirects rather\nthan treating a 301 as a failure."]}]
26:["$","p",null,{"children":[["$","strong",null,{"children":"Doc-to-source permalinks."}]," Behavioural claims carry a link to the code\nthat implements them, pinned to a release tag rather than to ",["$","code",null,{"children":"main"}],". A\npermalink that drifts is worse than no link, because the reader can't tell.\nThe pinned ref is a single constant in\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/web/apps/docs/lib/source-ref.ts","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/lib/source-ref.ts","data-source-ref":"v1.6.5","title":"web/apps/docs/lib/source-ref.ts at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"source-ref.ts"]}],"."]}]
27:["$","p",null,{"children":[["$","strong",null,{"children":"Generated reference."}]," The configuration reference, the metrics reference\nand the changelog are generated from the source of truth in the repo rather\nthan transcribed from it. An agent reading the docs and an agent reading the\ncode get the same answer by construction. Config snippets in narrative pages\nare checked against that generated reference by\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/web/apps/docs/scripts/lint-snippets.mjs","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/scripts/lint-snippets.mjs","data-source-ref":"v1.6.5","title":"web/apps/docs/scripts/lint-snippets.mjs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"lint-snippets.mjs"]}],", so a snippet\ncannot quietly reference a field that no longer exists."]}]
28:["$","p",null,{"children":[["$","strong",null,{"children":"Every internal link resolves, and every page on the path has a next step."}],"\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/web/apps/docs/scripts/lint-links.mjs","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/scripts/lint-links.mjs","data-source-ref":"v1.6.5","title":"web/apps/docs/scripts/lint-links.mjs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"lint-links.mjs"]}]," and\n",["$","a",null,{"href":"https://github.com/toxicwind/forge/blob/v1.6.5/web/apps/docs/scripts/lint-navigation.mjs","target":"_blank","rel":"noreferrer","data-source-link":"web/apps/docs/scripts/lint-navigation.mjs","data-source-ref":"v1.6.5","title":"web/apps/docs/scripts/lint-navigation.mjs at v1.6.5","className":"inline-flex items-center gap-1 rounded-md border border-border bg-surface-elevated px-1.5 py-0.5 align-middle font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-brand/50 hover:text-brand","children":[["$","svg",null,{"width":"12","height":"12","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","children":["$","path",null,{"d":"m16 18 6-6-6-6M8 6l-6 6 6 6"}]}],"lint-navigation.mjs"]}]," run on every\nchange, so a crawl never hits a dead internal link or a dead end."]}]
29:["$","p",null,{"children":[["$","strong",null,{"children":"Machine-detectable structure."}]," Verification blocks carry\n",["$","code",null,{"children":"data-verify-block"}],"; prerequisite blocks carry ",["$","code",null,{"children":"data-prerequisites"}],"; next\nsteps carry ",["$","code",null,{"children":"data-next-step"}],"; version badges carry ",["$","code",null,{"children":"data-min-version"}],"; source\nlinks carry ",["$","code",null,{"children":"data-source-link"}]," and ",["$","code",null,{"children":"data-source-ref"}],". Ordering and\nprovability are readable without parsing prose."]}]
