24:["$","p",null,{"children":"The CAS is the only stateful piece you can't trivially rebuild from\nclients. Snapshot strategy depends on the backend:"}]
25:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Filesystem"}],": ",["$","code",null,{"children":"rsync"}]," or your filesystem's snapshot facility\n(ZFS, Btrfs). Restore by stopping the CAS, swapping the directory,\nstarting again."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"S3-compatible"}],": versioning + lifecycle policies handle the\nprimary copy. For DR, cross-region replication."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Redis"}],": treat as ephemeral. Loss is a cache miss, not data loss."]}],"\n"]}]
