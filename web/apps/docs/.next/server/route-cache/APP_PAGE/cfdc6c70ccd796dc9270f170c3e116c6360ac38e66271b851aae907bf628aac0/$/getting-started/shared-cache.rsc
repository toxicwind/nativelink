f:["$","$L17",null,{"toc":[{"depth":2,"url":"#when-to-self-host","title":"When to self-host"},{"depth":2,"url":"#what-ships-in-the-box","title":"What ships in the box"},{"depth":2,"url":"#the-rollout-checklist","title":"The rollout checklist"},{"depth":2,"url":"#container-registry","title":"Container registry"},{"depth":2,"url":"#backups--recovery","title":"Backups & recovery"},{"depth":2,"url":"#faq","title":"FAQ"}],"full":"$undefined","children":[["$","$L18",null,{"children":"Shared cache"}],["$","$L19",null,{"children":"Self-host Forge on hardware you control, with the operational checklist a team rollout actually needs."}],["$","$L1a",null,{"children":[["$","div",null,{"data-prerequisites":true,"className":"my-6 rounded-xl border border-border bg-surface-elevated px-5 py-3","children":[["$","p",null,{"className":"my-0 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand","children":"Before you start"}],["$","div",null,{"className":"mt-1 text-sm text-muted-foreground [&>p]:my-0","children":["$","p",null,{"children":["A cache working on your own machine. The ",["$","$L1b",null,{"href":"/getting-started/quickstart","children":"Quickstart"}]," gets you there."]}]}]]}],"\n",["$","p",null,{"children":["The source-available release of Forge is designed to run on your\nown infrastructure. This page covers what changes between the\n",["$","$L1b",null,{"href":"/getting-started/quickstart","children":"10-minute quickstart"}]," and a deployment that\nserves your team without 3 AM pages."]}],"\n",["$","$L1c",null,{"as":"h2","id":"when-to-self-host","children":"When to self-host"}],"\n",["$","p",null,{"children":"Pick on-prem when one of these is true:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Data residency."}]," Build artifacts can carry source code,\ntoolchains, even credentials. Self-hosting keeps them in whatever\nregion or boundary you need (EU GDPR, US FedRAMP boundaries,\nair-gapped corp networks)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Specialised hardware."}]," GPU workers, ARM cross-compile fleets,\nin-house silicon. On-prem lets you use anything that can run a\nLinux binary."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"You already operate stateful services."}]," If your team owns\nKubernetes, Postgres, S3-compatible storage, adding Forge is\nmarginal work."]}],"\n"]}],"\n",["$","p",null,{"children":["If you'd rather not run it yourself, Enterprise offers a managed\ndeployment; see ",["$","$L1b",null,{"href":"/reference/oss-and-enterprise","children":"Open source and Enterprise"}],"."]}],"\n",["$","$L1c",null,{"as":"h2","id":"what-ships-in-the-box","children":"What ships in the box"}],"\n",["$","p",null,{"children":"A Forge deployment is composed of four roles. The same binary\nserves all of them; the JSON5 config decides which subset to run."}],"\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Role"}],["$","th",null,{"children":"What it does"}],["$","th",null,{"children":"Statefulness"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"CAS server"}]}],["$","td",null,{"children":"Stores and serves content-addressed blobs."}],["$","td",null,{"children":"Stateful"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"AC server"}]}],["$","td",null,{"children":["Maps ",["$","code",null,{"children":"Action"}]," digests to ",["$","code",null,{"children":"ActionResult"}],"s."]}],["$","td",null,{"children":"Stateful"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Scheduler"}]}],["$","td",null,{"children":["Receives ",["$","code",null,{"children":"Execute"}]," calls, dispatches to workers."]}],["$","td",null,{"children":"Queue in memory by default, or in Redis"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Worker"}]}],["$","td",null,{"children":"Runs the action in a per-action work directory, uploads outputs to CAS."}],["$","td",null,{"children":"Stateless"}]]}]]}]]}]}],"\n",["$","p",null,{"children":"A single binary can run all four. For anything beyond a single\ndeveloper, run them on separate processes so you can scale and restart\neach independently."}],"\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b"]}],"$L2c"]}]
