    "content": "Required"
  }, {
    "heading": "simplespec",
    "content": "Default"
  }, {
    "heading": "simplespec",
    "content": "Description"
  }, {
    "heading": "simplespec",
    "content": "`supported_platform_properties`"
  }, {
    "heading": "simplespec",
    "content": "map of string to PropertyType"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "A list of supported platform properties mapped to how these properties are used when the scheduler looks for worker nodes capable of running the task."
  }, {
    "heading": "simplespec",
    "content": "`retain_completed_for_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint32)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "60 (seconds)"
  }, {
    "heading": "simplespec",
    "content": "The amount of time to retain completed actions in memory for in case a `WaitExecution` is called after the action has completed."
  }, {
    "heading": "simplespec",
    "content": "`client_action_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "60 (seconds)"
  }, {
    "heading": "simplespec",
    "content": "Mark operations as completed with error if no client has updated them within this duration."
  }, {
    "heading": "simplespec",
    "content": "`worker_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "5 (seconds)"
  }, {
    "heading": "simplespec",
    "content": "Remove workers from pool once the worker has not responded in this amount of time in seconds."
  }, {
    "heading": "simplespec",
    "content": "`max_action_executing_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "0 (disabled)"
  }, {
    "heading": "simplespec",
    "content": "Maximum time (seconds) an action can stay in Executing state without any worker update before being timed out and re-queued. This applies regardless of worker keepalive status, catching cases where a worker is alive (sending keepalives) but stuck on a specific action. Set to 0 to disable (relies only on `worker_timeout_s`)."
  }, {
    "heading": "simplespec",
    "content": "`max_job_retries`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "3"
  }, {
    "heading": "simplespec",
    "content": "If a job returns an internal error or times out this many times when attempting to run on a worker the scheduler will return the last error to the client. Jobs will be retried and this configuration is to help prevent one rogue job from infinitely retrying and taking up a lot of resources when the task itself is the one causing the server to go into a bad state."
  }, {
    "heading": "simplespec",
    "content": "`allocation_strategy`"
  }, {
    "heading": "simplespec",
    "content": "WorkerAllocationStrategy"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "`\"least_recently_used\"`"
  }, {
    "heading": "simplespec",
    "content": "The strategy used to assign workers jobs."
  }, {
    "heading": "simplespec",
    "content": "`experimental_backend`"
  }, {
    "heading": "simplespec",
    "content": "ExperimentalSimpleSchedulerBackend"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
