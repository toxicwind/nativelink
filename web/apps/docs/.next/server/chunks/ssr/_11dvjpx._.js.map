export let structuredData = {
  "contents": [{
    "heading": undefined,
    "content": "**Who this is for:** anyone who has to answer \"are we allowed to run this?\",\nand anyone deciding between self-hosting and Forge Enterprise. &#x2A;*What you'll\nhave at the end:** an accurate picture of what is licensed how, what activates\nit, and what the open-source build does and does not restrict. &#x2A;*Time:** ten\nminutes."
  }, {
    "heading": undefined,
    "content": "Everything below is checkable against the source tree at the commit you are\nreading: file paths, licence headers, and the code that reaches them. None\nof it is legal advice, and the operative text is the\nlicence page and the `LICENSE` file in the\nrepository root, not this page. If your intended use is near a boundary,\nread those and ask."
  }, {
    "heading": "the-short-version",
    "content": "The whole of Forge is in the public repository. No separate\n\"enterprise build\", no stripped-down community edition, and no compile-time\nfeature flag that divides them. What differs between the free and paid product\nis the *licence you hold*, not the *code you run*."
  }, {
    "heading": "the-short-version",
