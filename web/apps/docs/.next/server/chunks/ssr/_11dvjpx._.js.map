    "heading": "localworkerconfig",
    "content": "Field"
  }, {
    "heading": "localworkerconfig",
    "content": "Type"
  }, {
    "heading": "localworkerconfig",
    "content": "Required"
  }, {
    "heading": "localworkerconfig",
    "content": "Default"
  }, {
    "heading": "localworkerconfig",
    "content": "Description"
  }, {
    "heading": "localworkerconfig",
    "content": "`name`"
  }, {
    "heading": "localworkerconfig",
    "content": "string"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "\\{Index position in the workers list}"
  }, {
    "heading": "localworkerconfig",
    "content": "Name of the worker. This is give a more friendly name to a worker for logging and metric publishing. This is also the prefix of the worker id (i.e. \"\\{name}\\{uuidv6}\")."
  }, {
    "heading": "localworkerconfig",
    "content": "`worker_api_endpoint`"
  }, {
    "heading": "localworkerconfig",
    "content": "EndpointConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "Yes"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Endpoint which the worker will connect to the scheduler's `WorkerApiService`."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_action_timeout_s`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "20 minutes"
  }, {
    "heading": "localworkerconfig",
    "content": "The maximum time an action is allowed to run. If a task requests for a timeout longer than this time limit, the task will be rejected. Value in seconds."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_upload_timeout_s`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "10 minutes"
  }, {
    "heading": "localworkerconfig",
    "content": "Maximum time allowed for uploading action results to CAS after execution completes. If upload takes longer than this, the action fails with `DeadlineExceeded` and may be retried by the scheduler. Value in seconds."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_download_timeout_s`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "10 minutes"
  }, {
    "heading": "localworkerconfig",
    "content": "Maximum time allowed for fetching an action's inputs into the worker's store and its directory before the command runs. A fetch that hangs (a store that never answers) otherwise holds the action's slot for good while the worker looks healthy; past this the action fails with `DeadlineExceeded` and may be retried by the scheduler, and a warning names the action every minute before that. Value in seconds."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_cleanup_wait_s`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "30 seconds"
  }, {
    "heading": "localworkerconfig",
    "content": "Maximum time to wait for action directory cleanup before timing out. Value in seconds."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_cleanup_backoff_ms`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "500 milliseconds"
  }, {
    "heading": "localworkerconfig",
    "content": "Maximum backoff duration for exponential backoff when waiting for cleanup. Value in milliseconds."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_inflight_tasks`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint64)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "0 (infinite tasks)"
  }, {
    "heading": "localworkerconfig",
    "content": "Maximum number of inflight tasks this worker can cope with."
  }, {
    "heading": "localworkerconfig",
    "content": "`single_use`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "false"
  }, {
    "heading": "localworkerconfig",
    "content": "Accept one action, upload its results, and exit the worker process. The worker advertises one execution slot and never accepts a second action, including after a scheduler disconnect. A launcher must create a fresh container and fresh writable volumes for its replacement. Use one local worker per process, with no scheduler or services other than health checks. Reusing the container or its writable volumes does not provide isolation from the previous action."
  }, {
    "heading": "localworkerconfig",
    "content": "`experimental_buck2_file_capture`"
  }, {
    "heading": "localworkerconfig",
    "content": "Buck2FileCaptureConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Capture full execution-container files for Buck2 builds only. Disabled when absent. Requires `single_use`; read the capture configuration's isolation requirements before enabling it for a worker pool."
  }, {
    "heading": "localworkerconfig",
    "content": "`timeout_handled_externally`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "false (`Forge` fully handles timeouts)"
  }, {
    "heading": "localworkerconfig",
    "content": "If timeout is handled in `entrypoint` or another wrapper script. If set to true `Forge` will not honor the timeout the action requested and instead will always force kill the action after `max_action_timeout` has been reached. If this is set to false, the smaller value of the action's timeout and `max_action_timeout` will be used to which `Forge` will kill the action."
  }, {
    "heading": "localworkerconfig",
    "content": "`drain_on_shutdown`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "false"
  }, {
    "heading": "localworkerconfig",
    "content": "On shutdown, tell the scheduler at once that this worker is draining so it stops dispatching here, then finish the running actions (up to `max_action_timeout_s`) and exit. Off, the worker finishes first and only then announces itself, while the scheduler keeps offering it work it has to refuse. Needs a scheduler that understands the drain flag (v1.7.3+); an older one removes the worker and requeues its actions as soon as the message arrives."
  }, {
    "heading": "localworkerconfig",
    "content": "`resource_enforcement`"
  }, {
    "heading": "localworkerconfig",
    "content": "ResourceEnforcementConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Kill an action that grows past its memory reservation before the pod's cgroup limit does. On cgroup v2 the container cgroup carries `memory.oom.group`, so the kernel's kill takes the worker and every action on it; this one takes only the offender and fails it with `FailedPrecondition`. Linux only; accepted and ignored elsewhere. Actions run through a persistent worker are not covered, since that process outlives the action and serves others. With either axis on, the worker reads an action's platform properties from the scheduler's `StartExecute` rather than the client's request, so a reservation the scheduler placed the action by is the one enforced and exported to the environment."
  }, {
    "heading": "localworkerconfig",
    "content": "`entrypoint`"
  }, {
    "heading": "localworkerconfig",
    "content": "string"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "\\{Use the command from the job request}"
  }, {
    "heading": "localworkerconfig",
    "content": "The command to execute on every execution request. This will be parsed as a command + arguments (not shell). Example: \"run.sh\" and a job with command: \"sleep 5\" will result in a command like: \"run.sh sleep 5\"."
  }, {
    "heading": "localworkerconfig",
    "content": "`experimental_precondition_script`"
  }, {
    "heading": "localworkerconfig",
    "content": "string"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "An optional script to run before every action is processed on the worker. The value should be the full path to the script to execute and will pause all actions on the worker if it returns an exit code other than 0. If not set, then the worker will never pause and will continue to accept jobs according to the scheduler configuration. This is useful, for example, if the worker should not take any more actions until there is enough resource available on the machine to handle them."
  }, {
    "heading": "localworkerconfig",
    "content": "`precondition_timeout_ms`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint64)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "30000"
  }, {
    "heading": "localworkerconfig",
    "content": "Milliseconds the precondition script may run before it counts as failed and the action is refused as backpressure. A script that hangs used to hold the action forever."
  }, {
    "heading": "localworkerconfig",
    "content": "`max_captured_output_bytes`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint64)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "0"
  }, {
    "heading": "localworkerconfig",
    "content": "Bytes of an action's stdout or stderr kept in memory. Past this the output spills to a file under the action directory and is uploaded from disk, so an action that prints gigabytes does not grow the worker by that much. 0 keeps everything in memory."
  }, {
    "heading": "localworkerconfig",
    "content": "`orphan_sweep_interval_s`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint64)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "0"
  }, {
    "heading": "localworkerconfig",
    "content": "Seconds between sweeps of `work_directory` for action directories no running action owns, left by a cleanup that failed. 0 disables the sweep; the directory is still purged at startup."
  }, {
    "heading": "localworkerconfig",
    "content": "`kill_grace_ms`"
  }, {
    "heading": "localworkerconfig",
    "content": "integer (uint64)"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "5000"
  }, {
    "heading": "localworkerconfig",
    "content": "Milliseconds between the SIGTERM a timed-out or cancelled action receives and the SIGKILL that follows if it is still running, so a tool that handles SIGTERM can write its own cleanup. The memory reservation kill skips the grace and sends SIGKILL at once. Linux only; elsewhere the kill is immediate. 0 takes the default."
  }, {
    "heading": "localworkerconfig",
    "content": "`set_tmpdir`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "true"
  }, {
    "heading": "localworkerconfig",
    "content": "Give every action its own `TMPDIR` under its action directory, removed with it, so concurrent actions writing the same file name under `$TMPDIR` no longer collide. A `TMPDIR` in the action's own environment still wins. Code that hard-codes `/tmp` is unaffected."
  }, {
    "heading": "localworkerconfig",
    "content": "`persistent_workers`"
  }, {
    "heading": "localworkerconfig",
    "content": "PersistentWorkersConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Bazel persistent workers: how an action whose platform properties carry `supports-workers=1` is run and how the pool of worker processes is sized. Unset takes every default below."
  }, {
    "heading": "localworkerconfig",
    "content": "`cas_fast_slow_store`"
  }, {
    "heading": "localworkerconfig",
    "content": "string"
  }, {
    "heading": "localworkerconfig",
    "content": "Yes"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Underlying CAS store that the worker will use to download CAS artifacts. This store must be a `FastSlowStore`. The `fast` store must be a `FileSystemStore` because it will use hardlinks when building out the files instead of copying the files. The slow store must eventually resolve to the same store the scheduler/client uses to send job requests."
  }, {
    "heading": "localworkerconfig",
    "content": "`upload_action_result`"
  }, {
    "heading": "localworkerconfig",
    "content": "UploadActionResultConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Configuration for uploading action results."
  }, {
    "heading": "localworkerconfig",
    "content": "`work_directory`"
  }, {
    "heading": "localworkerconfig",
    "content": "string"
  }, {
    "heading": "localworkerconfig",
    "content": "Yes"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "The directory work jobs will be executed from. This directory will be fully managed by the worker service and will be purged on startup. This directory and the directory referenced in `local_filesystem_store_ref`'s `stores::FilesystemStore::content_path` must be on the same filesystem. Hardlinks will be used when placing files that are accessible to the jobs that are sourced from `local_filesystem_store_ref`'s `content_path`."
  }, {
    "heading": "localworkerconfig",
    "content": "`platform_properties`"
  }, {
    "heading": "localworkerconfig",
    "content": "map of string to WorkerProperty"
  }, {
    "heading": "localworkerconfig",
    "content": "Yes"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Properties of this worker. This configuration will be sent to the scheduler and used to tell the scheduler to restrict what should be executed on this worker."
  }, {
    "heading": "localworkerconfig",
    "content": "`capacity`"
  }, {
    "heading": "localworkerconfig",
    "content": "CapacityConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Derive the CPU and memory properties from the worker's own cgroup limits instead of the values above; see `CapacityConfig`. When the cgroup cannot be read (not Linux, cgroup v1, no permission) the values above stand and a warning says so; if they carry neither property the worker refuses to start rather than register unable to take any action that asks for CPU or memory."
  }, {
    "heading": "localworkerconfig",
    "content": "`additional_environment`"
  }, {
    "heading": "localworkerconfig",
    "content": "map of string to EnvironmentSource"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "An optional mapping of environment names to set for the execution as well as those specified in the action itself. If set, will set each key as an environment variable before executing the job with the value of the environment variable being the value of the property of the action being executed of that name or the fixed value."
  }, {
    "heading": "localworkerconfig",
    "content": "`directory_cache`"
  }, {
    "heading": "localworkerconfig",
    "content": "DirectoryCacheConfig"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "Optional directory cache configuration for improving performance by caching reconstructed input directories and using hardlinks instead of rebuilding them from CAS for every action."
  }, {
    "heading": "localworkerconfig",
    "content": "`experimental_active_input_leases`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "false (eviction behavior is unchanged)"
  }, {
    "heading": "localworkerconfig",
    "content": "Optional and experimental: lease every digest in an active action's input Merkle closure in the worker's locally eviction-managed CAS tiers (the `cas_fast_slow_store`'s filesystem-backed stores) until the action has finished cleanup. This prevents `Lost inputs no longer available remotely` failures caused by local fast-tier eviction while inputs are being materialized under cache pressure."
  }, {
    "heading": "localworkerconfig",
    "content": "`use_namespaces`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "False"
  }, {
    "heading": "localworkerconfig",
    "content": "Whether to use namespaces to isolate the execution. This is only available on Linux. It is highly recommended as it avoids a number of issues with zombie processes and also provides additional hermeticity. If explicitly set to true and it is not supported the worker will exit with an error."
  }, {
    "heading": "localworkerconfig",
    "content": "`use_mount_namespace`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "False"
  }, {
    "heading": "localworkerconfig",
    "content": "Whether to use a mount namespace to isolate the worker root. This is only available on Linux and when `use_namespaces` is true. It is highly recommended provides additional hermeticity. If explicitly set to true and it is not supported or `use_namespaces` is not set to true the worker will exit with an error."
  }, {
    "heading": "localworkerconfig",
    "content": "`isolate_tmp`"
  }, {
    "heading": "localworkerconfig",
    "content": "boolean"
  }, {
    "heading": "localworkerconfig",
    "content": "—"
  }, {
    "heading": "localworkerconfig",
    "content": "True when `use_mount_namespace` is true and `/tmp` exists,"
  }, {
    "heading": "localworkerconfig",
    "content": "Whether to give each action a private `/tmp` inside its mount namespace: the action's own `tmp` directory (the one `TMPDIR` points at) is bound over `/tmp`, so tools that hardcode `/tmp` write there too. Concurrent actions no longer collide on predictable paths under `/tmp`, nothing leaks between actions through it, and what an action writes there is removed with the action."
  }, {
    "heading": "simplespec",
    "content": "Field"
  }, {
    "heading": "simplespec",
    "content": "Type"
  }, {
    "heading": "simplespec",
    "content": "Required"
  }, {
    "heading": "simplespec",
    "content": "Default"
  }, {
    "heading": "simplespec",
    "content": "Description"
  }, {
    "heading": "simplespec",
    "content": "`supported_platform_properties`"
  }, {
    "heading": "simplespec",
    "content": "map of string to PropertyType"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "A list of supported platform properties mapped to how these properties are used when the scheduler looks for worker nodes capable of running the task."
  }, {
    "heading": "simplespec",
    "content": "`retain_completed_for_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint32)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "60 seconds"
  }, {
    "heading": "simplespec",
    "content": "The amount of time to retain completed actions for in case a `WaitExecution` is called after the action has completed."
  }, {
    "heading": "simplespec",
    "content": "`client_action_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "60 seconds"
  }, {
    "heading": "simplespec",
    "content": "Mark operations as completed with error if no client has updated them within this duration."
  }, {
    "heading": "simplespec",
    "content": "`enable_active_action_count_metric`"
  }, {
    "heading": "simplespec",
    "content": "boolean"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "false"
  }, {
    "heading": "simplespec",
    "content": "Periodically count the actions in each stage and report them as the `execution.active.count` metric."
  }, {
    "heading": "simplespec",
    "content": "`worker_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "10 seconds (four default keepalive intervals)"
  }, {
    "heading": "simplespec",
    "content": "Remove workers from pool once the worker has not responded in this amount of time in seconds. Any message from the worker counts, not only keepalives. Eviction requeues everything the worker held, so keep this well above the longest pause a loaded worker can see."
  }, {
    "heading": "simplespec",
    "content": "`max_action_executing_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "0 (disabled)"
  }, {
    "heading": "simplespec",
    "content": "Maximum time (seconds) an action can stay in Executing state without any worker update before being timed out and re-queued. This applies regardless of worker keepalive status, catching cases where a worker is alive (sending keepalives) but stuck on a specific action. Set to 0 to disable (relies only on `worker_timeout_s`)."
  }, {
    "heading": "simplespec",
    "content": "`unacknowledged_kill_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "60 seconds"
  }, {
    "heading": "simplespec",
    "content": "Evict a worker that has not reported back on an operation it was told to kill within this many seconds. A healthy worker acknowledges a kill in moments; one that cannot is wedged, and its keepalives would otherwise keep `worker_timeout_s` from ever firing while the dead operation holds its slot. Eviction requeues the worker's other operations."
  }, {
    "heading": "simplespec",
    "content": "`dispatch_ack_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "unset (off)"
  }, {
    "heading": "simplespec",
    "content": "Requeue a dispatched action the worker has not acknowledged within this many seconds, untried and without counting an attempt, and pause the worker. The clock is the worker's own messages: a dispatch is dated by the worker's last message before it, and the check runs on each later message, so keep this above a few keepalive intervals. Workers from v1.7.3 acknowledge every dispatch; older workers never do, so leave this unset while any are connected or their every action would be requeued."
  }, {
    "heading": "simplespec",
    "content": "`unsatisfiable_action_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "0 (never fail)"
  }, {
    "heading": "simplespec",
    "content": "Fail a queued action once no connected worker has been able to run it for this many seconds, instead of leaving it queued forever. An action counts as impossible to run when no connected worker could take it even when idle: an `exact` value no worker has, a required key no worker declares, or a `minimum` larger than any worker's total. An action that is only waiting for a busy worker is never failed by this setting, and neither is any action while no workers are connected at all."
  }, {
    "heading": "simplespec",
    "content": "`no_worker_action_timeout_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "0 (never fail)"
  }, {
    "heading": "simplespec",
    "content": "Seconds a queued action waits while no worker at all is connected to this scheduler, nor, on a shared backend, to any peer, before it fails with `FailedPrecondition`. `unsatisfiable_action_timeout_s` only runs against workers that are there, so a pool that scales from zero is never failed on sight; but a provisioner that will not create a pod for a shape it cannot serve leaves such an action waiting for a fleet that never comes, and this is the bound on that. Keep it above the longest time a pool needs to bring up its first worker."
  }, {
    "heading": "simplespec",
    "content": "`max_job_retries`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "3"
  }, {
    "heading": "simplespec",
    "content": "If a job returns an internal error or times out this many times the scheduler completes it with `FailedPrecondition` carrying the last error, a code clients do not retry. This is to help prevent one rogue job from infinitely retrying and taking up a lot of resources when the task itself is the one causing the server to go into a bad state. A lost worker and a memory escalation are not the action's failures and have their own budgets: `max_worker_loss_retries` and `memory_escalation.max_steps`."
  }, {
    "heading": "simplespec",
    "content": "`max_worker_loss_retries`"
  }, {
    "heading": "simplespec",
    "content": "integer (uint)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "10"
  }, {
    "heading": "simplespec",
    "content": "How many times an action whose worker was lost (disconnected, timed out, evicted, or OOM-killed as a whole) is queued again before the scheduler completes it with `FailedPrecondition`. A lost worker is usually not the action's fault, so these do not spend `max_job_retries`; the cap only stops an action that takes a worker down every time it runs."
  }, {
    "heading": "simplespec",
    "content": "`allocation_strategy`"
  }, {
    "heading": "simplespec",
    "content": "WorkerAllocationStrategy"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "`\"least_recently_used\"`"
  }, {
    "heading": "simplespec",
    "content": "The strategy used to assign workers jobs."
  }, {
    "heading": "simplespec",
    "content": "`live_memory_veto`"
  }, {
    "heading": "simplespec",
    "content": "string"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "unset (off)"
  }, {
    "heading": "simplespec",
    "content": "The name of a `minimum` platform property, usually `memory_kb`, that the scheduler compares against the free memory each worker reports with its keepalive: a worker reporting less than the action asks for is skipped for that action, whatever the admission ledger says. The ledger only subtracts what actions declare; this catches the ones that declared too little. Workers older than v1.7.3 report nothing and are never vetoed."
  }, {
    "heading": "simplespec",
    "content": "`memory_escalation`"
  }, {
    "heading": "simplespec",
    "content": "MemoryEscalationSpec"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "unset (a memory kill fails the action)"
  }, {
    "heading": "simplespec",
    "content": "When a worker reports an action killed for memory (`KILLED_MEMORY`, by its own reservation enforcement or by the kernel), requeue the action with a larger reservation instead of failing it. Escalations have their own budget (`max_steps`) and do not spend `max_job_retries`. The reservation grows to the largest memory any connected worker advertises (or `max_kb`); the last step reserves that worker whole, memory and CPU, so the action runs alone, and only a kill there fails the action: nothing in the fleet could run it."
  }, {
    "heading": "simplespec",
    "content": "`experimental_backend`"
  }, {
    "heading": "simplespec",
    "content": "ExperimentalSimpleSchedulerBackend"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "memory"
  }, {
    "heading": "simplespec",
    "content": "The storage backend to use for the scheduler."
  }, {
    "heading": "simplespec",
    "content": "`worker_match_logging_interval_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (int64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "`10`"
  }, {
    "heading": "simplespec",
    "content": "Every N seconds, do logging of worker matching e.g. \"worker busy\", \"can't find any worker\" Defaults to 10s. Can be set to `-1` to disable"
  }, {
    "heading": "simplespec",
    "content": "`fallback_match_interval_s`"
  }, {
    "heading": "simplespec",
    "content": "integer (int64)"
  }, {
    "heading": "simplespec",
    "content": "—"
  }, {
    "heading": "simplespec",
    "content": "`5`"
  }, {
    "heading": "simplespec",
    "content": "Every N seconds, run a worker matching pass even if no task or worker change notification arrived. This is a safety net for missed notifications and for scheduler backends with eventually consistent searches (for example Redis), where an operation that was re-queued may not be visible to the search triggered by its own notification. Without this, such an operation can stay queued until an unrelated event triggers another matching pass. Defaults to 5s. Zero or any negative value disables it."
  }, {
    "heading": "schedulergrpcspec",
    "content": "A scheduler that forwards requests to an upstream scheduler. This\nis useful to use when doing some kind of local action cache or CAS away from\nthe main cluster of workers. In general, it's more efficient to point the\nbuild at the main scheduler directly though."
  }, {
