  }, {
    "heading": "evictionpolicy",
    "content": "—"
  }, {
    "heading": "evictionpolicy",
    "content": "0"
  }, {
    "heading": "evictionpolicy",
    "content": "Maximum number of bytes before eviction takes place. Zero means never evict based on size."
  }, {
    "heading": "evictionpolicy",
    "content": "`evict_bytes`"
  }, {
    "heading": "evictionpolicy",
    "content": "integer (uint)"
  }, {
    "heading": "evictionpolicy",
    "content": "—"
  }, {
    "heading": "evictionpolicy",
    "content": "0"
  }, {
    "heading": "evictionpolicy",
    "content": "When eviction starts based on hitting `max_bytes`, continue until `max_bytes - evict_bytes` is met to create a low watermark. This stops operations from thrashing when the store is close to the limit."
  }, {
    "heading": "evictionpolicy",
    "content": "`max_seconds`"
  }, {
    "heading": "evictionpolicy",
    "content": "integer (uint32)"
  }, {
    "heading": "evictionpolicy",
    "content": "—"
  }, {
    "heading": "evictionpolicy",
    "content": "0"
  }, {
    "heading": "evictionpolicy",
    "content": "Maximum number of seconds for an entry to live since it was last accessed before it is evicted. Zero means never evict based on time."
  }, {
