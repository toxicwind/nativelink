  }, {
    "heading": "fastslowspec",
    "content": "`fast`"
  }, {
    "heading": "fastslowspec",
    "content": "NamedStoreConfig"
  }, {
    "heading": "fastslowspec",
    "content": "Yes"
  }, {
    "heading": "fastslowspec",
    "content": "—"
  }, {
    "heading": "fastslowspec",
    "content": "Fast store that will be attempted to be contacted before reaching out to the `slow` store."
  }, {
    "heading": "fastslowspec",
    "content": "`fast_direction`"
  }, {
    "heading": "fastslowspec",
    "content": "StoreDirection"
  }, {
    "heading": "fastslowspec",
    "content": "—"
  }, {
    "heading": "fastslowspec",
    "content": "`\"both\"`"
  }, {
    "heading": "fastslowspec",
    "content": "How to handle the fast store. This can be useful to set to Get for worker nodes such that results are persisted to the slow store only."
  }, {
    "heading": "fastslowspec",
    "content": "`slow`"
  }, {
    "heading": "fastslowspec",
    "content": "NamedStoreConfig"
  }, {
    "heading": "fastslowspec",
    "content": "Yes"
  }, {
    "heading": "fastslowspec",
    "content": "—"
  }, {
    "heading": "fastslowspec",
    "content": "If the object does not exist in the `fast` store it will try to get it from this store."
  }, {
    "heading": "fastslowspec",
    "content": "`slow_direction`"
  }, {
    "heading": "fastslowspec",
    "content": "StoreDirection"
  }, {
    "heading": "fastslowspec",
    "content": "—"
  }, {
    "heading": "fastslowspec",
    "content": "`\"both\"`"
  }, {
    "heading": "fastslowspec",
    "content": "How to handle the slow store. This can be useful if creating a diode and you wish to have an upstream read only store."
  }, {
    "heading": "fastslowspec",
    "content": "`bypass_dedup_threshold_bytes`"
  }, {
    "heading": "fastslowspec",
    "content": "integer (uint64)"
  }, {
    "heading": "fastslowspec",
    "content": "—"
  }, {
    "heading": "fastslowspec",
    "content": "disabled (0)"
  }, {
    "heading": "fastslowspec",
    "content": "Reads of blobs at or above this size skip the leader/follower dedup map and stream straight from the slow store without populating the fast tier. `0` (the default) disables the bypass: every read goes through dedup, matching the prior behaviour. Enable it by setting a threshold — 256 MiB is a reasonable starting point for backends where large-blob dedup is a net loss (followers tend to time out anyway), but the right value is workload-dependent."
  }, {
