    "content": "Default"
  }, {
    "heading": "buck2filecaptureconfig",
    "content": "Description"
  }, {
    "heading": "buck2filecaptureconfig",
    "content": "`executable`"
  }, {
    "heading": "buck2filecaptureconfig",
    "content": "string"
  }, {
    "heading": "buck2filecaptureconfig",
    "content": "Yes"
