  }, {
    "heading": "redisspec",
    "content": "string"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "(Empty String / No Prefix)"
  }, {
    "heading": "redisspec",
    "content": "An optional prefix to prepend to all keys in this store."
  }, {
    "heading": "redisspec",
    "content": "`mode`"
  }, {
    "heading": "redisspec",
    "content": "RedisMode"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "standard,"
  }, {
    "heading": "redisspec",
    "content": "Set the mode Redis is operating in."
  }, {
    "heading": "redisspec",
    "content": "`broadcast_channel_capacity`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "`0`"
  }, {
    "heading": "redisspec",
    "content": "Deprecated as redis-rs doesn't use it"
  }, {
    "heading": "redisspec",
    "content": "`command_timeout_ms`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "10000 (10 seconds)"
  }, {
    "heading": "redisspec",
    "content": "The amount of time in milliseconds until the Redis store considers the command to be timed out. This will trigger a retry of the command and potentially a reconnection to the Redis server."
  }, {
