export let structuredData = {
  "contents": [{
    "heading": undefined,
    "content": "**Who this is for:** anyone writing a test, or trying to work out why a\ntest that passes in CI fails on their laptop. &#x2A;*What you'll have at the\nend:** the commands, the conventions, the fixtures that already exist, and\na diagnosis list for the local failures that are not your code's fault.\n&#x2A;*Time:** twenty minutes."
  }, {
    "heading": undefined,
    "content": "Forge has two test runners over the same tests. Cargo is faster to\niterate with; Bazel is what CI runs and what gates a merge. Both matter,\nand the vocabulary differs between them in a way that trips people up."
  }, {
    "heading": "the-commands",
    "content": "In this repository, `unit_test` means *tests written inside a source file*\nand `integration` means *tests in the crate's `tests/` directory*. Neither\nimplies anything about scope or about talking to a network. The\ngenuinely end-to-end suites are the shell scripts in `integration_tests/`,\nwhich are separate again."
  }, {
    "heading": "the-commands",
    "content": "`bazel test` also attaches rustfmt and clippy aspects, which is why a\nformatting mistake shows up as a test failure rather than a separate lint\nstep."
  }, {
    "heading": "where-tests-live",
    "content": "The convention is a separate `tests/` directory per crate, not inline\nmodules; only nine `mod tests` blocks exist in the whole tree."
  }, {
    "heading": "where-tests-live",
    "content": "Crate"
  }, {
    "heading": "where-tests-live",
    "content": "Test files under `tests/`"
  }, {
    "heading": "where-tests-live",
    "content": "`forge-store`"
