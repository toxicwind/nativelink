    }), "\n", _jsx(SourceLink, {
      file: "forge-config/src/cas_server.rs",
      symbol: "LocalWorkerConfig"
    }), "\n", _jsx(Callout, {
      type: "warn",
      title: "`upload_action_result` is one level, not two",
      children: _jsxs(_components.p, {
        children: ["The correct shape is ", _jsx(_components.code, {
          children: "upload_action_result: { ac_store: \"AC_MAIN_STORE\" }"
