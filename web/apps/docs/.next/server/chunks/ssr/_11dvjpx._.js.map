  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "10"
  }, {
    "heading": "redisspec",
    "content": "DEPRECATED: use `connection_timeout_ms`"
