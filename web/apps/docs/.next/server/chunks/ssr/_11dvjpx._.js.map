    "content": "Required"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "Default"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "Description"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "`memory`"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "MemoryEnforcement"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "—"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "soft"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "What to do with an action that exceeds its memory reservation."
  }, {
    "heading": "resourceenforcementconfig",
    "content": "`disk`"
  }, {
    "heading": "resourceenforcementconfig",
    "content": "DiskEnforcement"
  }, {
    "heading": "resourceenforcementconfig",
