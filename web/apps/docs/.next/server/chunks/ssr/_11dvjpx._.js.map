    "heading": "dedupspec",
    "content": "integer (uint32)"
  }, {
    "heading": "dedupspec",
    "content": "—"
  }, {
    "heading": "dedupspec",
    "content": "65536 (64k)"
  }, {
    "heading": "dedupspec",
    "content": "Minimum size that a chunk will be when slicing up the content. Note: This setting can be increased to improve performance because it will actually not check this number of bytes when deciding where to partition the data."
  }, {
    "heading": "dedupspec",
    "content": "`normal_size`"
  }, {
    "heading": "dedupspec",
    "content": "integer (uint32)"
  }, {
    "heading": "dedupspec",
    "content": "—"
  }, {
    "heading": "dedupspec",
    "content": "262144 (256k)"
  }, {
    "heading": "dedupspec",
    "content": "A best-effort attempt will be made to keep the average size of the chunks to this number. It is not a guarantee, but a slight attempt will be made."
  }, {
    "heading": "dedupspec",
