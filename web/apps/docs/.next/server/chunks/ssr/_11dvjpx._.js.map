export let frontmatter = {
  "title": "Security hardening",
  "description": "Open-source Forge has no inbound authentication on any service. What that means for your network, which ports must never be routable, how to configure mTLS, and why the worker sandbox is not a security boundary."
};
export let structuredData = {
  "contents": [{
    "heading": undefined,
    "content": "**Who this is for:** you are about to put Forge somewhere more than one\nperson can reach it. &#x2A;*What you'll have at the end:** a network layout where\nthe dangerous ports are unreachable, mTLS on the ports that must be reachable,\nand an accurate picture of the trust you are extending to anyone who can submit\nan action. &#x2A;*Time:** 45 minutes, plus however long your certificate authority\ntakes."
  }, {
    "heading": undefined,
