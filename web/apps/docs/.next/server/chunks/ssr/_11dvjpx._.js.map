  }, {
    "heading": "grpcspec",
    "content": "array of GrpcEndpoint"
  }, {
    "heading": "grpcspec",
    "content": "Yes"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "The endpoint of the grpc connection."
  }, {
    "heading": "grpcspec",
    "content": "`store_type`"
  }, {
    "heading": "grpcspec",
    "content": "StoreType"
  }, {
    "heading": "grpcspec",
    "content": "Yes"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "The type of the upstream store, this ensures that the correct server calls are made."
  }, {
    "heading": "grpcspec",
    "content": "`retry`"
  }, {
    "heading": "grpcspec",
    "content": "Retry"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "Retry configuration to use when a network request fails."
  }, {
    "heading": "grpcspec",
    "content": "`max_concurrent_requests`"
  }, {
    "heading": "grpcspec",
    "content": "integer (uint)"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "`0`"
  }, {
    "heading": "grpcspec",
    "content": "Limit the number of simultaneous upstream requests to this many. A value of zero is treated as unlimited. If the limit is reached the request is queued."
  }, {
    "heading": "grpcspec",
    "content": "`connections_per_endpoint`"
  }, {
    "heading": "grpcspec",
    "content": "integer (uint)"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "1"
  }, {
    "heading": "grpcspec",
    "content": "The number of connections to make to each specified endpoint to balance the load over multiple TCP connections."
  }, {
    "heading": "grpcspec",
    "content": "`rpc_timeout_s`"
  }, {
    "heading": "grpcspec",
    "content": "integer (uint64)"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "0 (disabled)"
  }, {
    "heading": "grpcspec",
    "content": "Maximum time (seconds) allowed for a single RPC request (e.g. a `ByteStream.Write` call) before it is cancelled."
  }, {
    "heading": "grpcspec",
    "content": "`use_legacy_resource_names`"
  }, {
    "heading": "grpcspec",
    "content": "boolean"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "false"
  }, {
    "heading": "grpcspec",
    "content": "Use legacy `ByteStream` resource name format, omitting the digest function component from the path."
  }, {
    "heading": "grpcspec",
    "content": "`headers`"
  }, {
    "heading": "grpcspec",
    "content": "map of string to string"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "Static headers to attach to every outgoing gRPC request sent to this store's upstream endpoints. Useful for fixed authentication tokens (e.g. `{\"authorization\": \"Bearer <token>\"}`) and other static metadata."
  }, {
    "heading": "grpcspec",
    "content": "`forward_headers`"
  }, {
    "heading": "grpcspec",
    "content": "array of string"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "Header names to forward from the incoming client request to every outgoing upstream request. The header value is taken from the client request that triggered this store operation. Use this to pass through dynamic credentials such as JWT tokens sent by build clients."
  }, {
    "heading": "grpcspec",
    "content": "`experimental_read_batching`"
  }, {
    "heading": "grpcspec",
    "content": "GrpcReadBatchingConfig"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "unset (disabled)"
  }, {
    "heading": "grpcspec",
    "content": "Optional and experimental: coalesce small-blob reads into `BatchReadBlobs` RPCs instead of issuing one `ByteStream` `Read` stream per blob. Each `ByteStream` read carries a fixed per-RPC cost, so batching many small reads into a single `BatchReadBlobs` request can dramatically reduce read latency for small blobs."
  }, {
    "heading": "grpcspec",
    "content": "`experimental_remote_cache_compression`"
  }, {
    "heading": "grpcspec",
    "content": "boolean"
  }, {
    "heading": "grpcspec",
    "content": "—"
  }, {
    "heading": "grpcspec",
    "content": "inherited from the process-wide zstd wire-compression intent"
  }, {
    "heading": "grpcspec",
    "content": "Compress this store's own blob transfers on the wire with REAPI `compressed-blobs/zstd`. Uploads and full-blob downloads of blobs at or above 64 KiB are zstd-compressed; smaller blobs and ranged reads keep the identity path."
  }, {
