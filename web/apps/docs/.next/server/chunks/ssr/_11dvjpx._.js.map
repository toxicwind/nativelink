export let frontmatter = {
  "title": "Glossary",
  "description": "The vocabulary you need to read the rest of the docs."
};
export let structuredData = {
  "contents": [{
    "heading": undefined,
    "content": "**Who this is for:** anyone reading the rest of these docs who hit a word that\nwas used as if it needed no explanation. &#x2A;*What you'll have at the end:** the one\nsentence you needed, and a link to the page that goes deeper. &#x2A;*Time:** use as\na lookup."
  }, {
    "heading": undefined,
    "content": "Terms are alphabetical. Every heading has a stable anchor, so a link to a\ndefinition keeps resolving even if the wording around it changes."
  }, {
    "heading": "action",
    "content": "A single unit of build work. Encodes a command line, input file\ndigests, the platform requirements, and the expected outputs. Hashing\nan action produces a stable identifier; identical actions have\nidentical hashes."
  }, {
    "heading": "action-cache-ac",
    "content": "A keyed store: `hash(Action) → ActionResult`. Cache hits skip the\nwork entirely."
  }, {
    "heading": "actionresult",
    "content": "What an action produces. Output file digests, exit code, captured\nstdout/stderr, timing metadata."
  }, {
    "heading": "awaited-action",
    "content": "The scheduler's record of one action between `Execute` and completion: its\ncurrent execution stage, its priority, and every client\nwaiting on it. Two identical actions submitted at the same time join the same\nawaited action instead of running twice. By default this record lives in the\nscheduler process's memory\n(),\nwhich is why two scheduler replicas behind a load balancer do not share\nin-flight work. See scheduler internals."
  }, {
    "heading": "bytestream-api",
    "content": "The streaming transport for blobs too large to move in a single\n`BatchUpdateBlobs` or `BatchReadBlobs` call, with the digest\nencoded in the resource name. Where the batch calls stop and this one starts\nis a server limit the Capabilities API advertises."
  }, {
    "heading": "capabilities-api",
    "content": "The RE-API service a client calls first, to learn which\ndigest functions the server accepts and what its size\nlimits are rather than assuming. See\nprotocol and API surface."
  }, {
    "heading": "cas--content-addressable-storage",
    "content": "Stores every blob (source file, intermediate output, final binary)\nunder the digest of its contents. The same byte sequence stored from anywhere\ncollapses to one entry."
  }, {
    "heading": "completeness-checking-store",
    "content": "An Action Cache wrapper that checks every output\ndigest still exists in the CAS before serving a hit. Without it a\nCAS eviction turns old cache entries into hits that reference blobs nobody can\ndownload, and the build fails while fetching outputs instead of quietly\nmissing the cache. Valid only on AC stores."
  }, {
    "heading": "dedup-store",
    "content": "A store that splits blobs into content-defined chunks with FastCDC\n() and stores each chunk\nonce, so two versions of a large file that differ in the middle share\neverything else. The cost is an index lookup per read. See\nthe store model."
  }, {
    "heading": "digest",
    "content": "A content hash plus a size. Used everywhere instead of file paths."
  }, {
    "heading": "digest-function",
    "content": "The hash a client and server agree on for digests: SHA-256 or\nBLAKE3, negotiated per request rather than fixed at build time\n().\nTwo clients using different functions produce different keys for the same\nbytes, so they do not share cache entries."
  }, {
    "heading": "eviction-policy",
    "content": "The limits a store evicts against: `max_bytes`, `max_seconds`, `max_count`,\nand the `evict_bytes` low watermark that stops eviction thrashing right at the\nlimit. Each defaults to `0`, which means *never evict on that dimension*: a\nstore configured without a policy grows until the disk does."
  }, {
    "heading": "execution-stage",
    "content": "Where an action is in its life: `CacheCheck`, `Queued`, `Executing`, then\n`Completed` or `CompletedFromCache`\n().\nAn action stuck in `Queued` has no free worker whose\nplatform properties match what it asked for.\n`CacheCheck` is declared but the scheduler never reports it, because the\ncache lookup happens in a wrapper in front of the scheduler."
  }, {
    "heading": "existence-cache-store",
    "content": "A store that remembers which digests it has already confirmed exist, so\nrepeated `FindMissingBlobs` calls stop re-querying the\nbackend. It answers the existence question only; reads pass through."
  }, {
    "heading": "fast-slow-store",
    "content": "A two-tier store. Reads try the fast backend, fall back to the slow one, and\ncopy what they find into the fast tier on the way back; writes mirror to both.\nIts one sharp edge: it never checks the slow tier for something the fast tier\nalready has, so a blob that reached the fast tier without reaching the slow one\nstays invisible to everything reading the slow tier directly."
  }, {
    "heading": "findmissingblobs",
    "content": "The CAS call that makes uploads incremental: the client offers a list of\ndigests, the server returns the ones it does not have, and the\nclient uploads only those. On a warm cache this and the AC\nlookup are most of what a client does."
  }, {
    "heading": "hermetic-build",
    "content": "A build whose outputs depend only on its declared inputs. Same\ninputs → same outputs, on any machine, any time. What Forge does\nand does not guarantee here is in\ncorrectness and hermeticity."
  }, {
    "heading": "input-root",
    "content": "The complete file tree an action is allowed to see, encoded as a Merkle tree\nof `Directory` messages that reference their files and each other by\ndigest. Its root digest is part of the action hash, so\nchanging one input file changes the cache key."
  }, {
    "heading": "instance-name",
    "content": "A namespace inside a Forge cluster. Each service entry maps an\ninstance name to a store or scheduler, so one cluster can serve multiple\nisolated environments, and the scheduler keys in-flight actions by instance\nname as well as digest. Two instance names that point at the same store share\nits contents."
  }, {
    "heading": "isolation",
    "content": "Keeping an action from seeing state outside its declared inputs.\nOn Linux, workers can isolate actions with kernel namespaces via\nthe `use_namespaces` and `use_mount_namespace` worker options,\nwhich also reap zombie processes and improve hermeticity.\nForge doesn't currently integrate external sandboxing tools\nlike `bwrap`, `landlock`, or `sandbox-exec`."
  }, {
    "heading": "json5",
    "content": "The dialect Forge's configuration file is written in: JSON plus\ncomments, trailing commas, and unquoted keys. Every example in\nthe configuration reference is JSON5."
  }, {
    "heading": "lre--local-remote-execution",
    "content": "Building your toolchain with Nix so that your local build and your\nremote workers invoke the *same* toolchain binaries, at the same\n`/nix/store` paths, which makes their action digests match and lets\nboth share one cache. No worker runs on your laptop. See\nLRE."
  }, {
    "heading": "operation",
    "content": "The handle a client holds on a running action, from\n`google.longrunning.Operation`. `Execute` returns one immediately and the\nclient watches it for stage changes; `WaitExecution`\nre-attaches to it after a disconnect, which is what stops a dropped connection\nfrom re-running the work."
  }, {
    "heading": "origin-events",
    "content": "An experimental stream of the requests and responses a server handled,\npublished to a store for an external consumer to read\n().\nOff unless `experimental_origin_events` is configured."
  }, {
    "heading": "platform-properties",
    "content": "Key/value tags attached to an action (\"this action needs Linux,\nx86\\_64, a GPU\") and to a worker (\"this worker has Linux, x86\\_64, a\nGPU\"). The scheduler matches them."
  }, {
    "heading": "priority",
    "content": "An integer on `ExecuteRequest`'s `execution_policy`; Forge dequeues\nthe highest value first when workers are scarce (the RE-API leaves the\ndirection to the server, and its suggested default is the reverse). It orders\nthe queue and nothing more; an action already executing is not interrupted for\na higher-priority one that arrives after it."
  }, {
    "heading": "remote-execution-api-re-api",
    "content": "The standard gRPC protocol every supported build system speaks.\nSpec."
  }, {
    "heading": "scheduler",
    "content": "The dispatcher. Receives `Execute` calls, picks workers, tracks\nin-flight actions."
  }, {
    "heading": "shard-store",
    "content": "A store that routes each key to one of several backends by digest hash, with\na `weight` per backend. It spreads capacity; it is not replication, so losing\none backend loses that backend's share of the data rather than none of it."
  }, {
    "heading": "store",
    "content": "Forge's unit of storage configuration: a named thing that gets and puts\nbytes under a key. Stores compose, because a store's backend is another store,\nso the CAS a server serves is usually a stack of wrappers over one real\nbackend. See the store model."
  }, {
    "heading": "toolchain",
    "content": "The bundle of binaries an action needs to run: compiler, linker,\nstandard library, etc. See\nhow toolchains are provided."
  }, {
    "heading": "verify-store",
    "content": "A wrapper that, depending on `verify_size` and `verify_hash`, checks a\nblob's size and re-hashes it on write, failing the upload when the bytes do\nnot match the digest they were offered under. It turns silent corruption into a write error. Both checks\nbelong on CAS stores and neither belongs on an AC store."
  }, {
    "heading": "worker",
    "content": "The process that runs an action. Fetches inputs from CAS, runs the\ncommand, uploads outputs to CAS."
  }, {
    "heading": "worker-api",
    "content": "Forge's own gRPC service, not part of the RE-API, over which a worker\nregisters with a scheduler and receives work\n().\nOne bidirectional `ConnectWorker` stream carries the whole conversation, which\nis what keeps a worker talking to the same scheduler instance even behind a\nload balancer."
  }],
