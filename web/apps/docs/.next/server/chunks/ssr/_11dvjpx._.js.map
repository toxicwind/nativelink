    "content": "`connection_timeout_ms`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "3000 (3 seconds)"
  }, {
    "heading": "redisspec",
    "content": "The amount of time in milliseconds until the Redis store considers the connection to unresponsive. This will trigger a reconnection to the Redis server."
  }, {
    "heading": "redisspec",
    "content": "`health_check_timeout_ms`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "4000 (4 seconds)"
  }, {
    "heading": "redisspec",
    "content": "Per-call ceiling for the `check_health` PING in milliseconds."
  }, {
    "heading": "redisspec",
    "content": "`read_chunk_size`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "64KiB"
  }, {
    "heading": "redisspec",
    "content": "The amount of data to read from the Redis server at a time. This is used to limit the amount of memory used when reading large objects from the Redis server as well as limiting the amount of time a single read operation can take."
  }, {
    "heading": "redisspec",
    "content": "`connection_pool_size`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "3"
  }, {
    "heading": "redisspec",
    "content": "The number of connections to keep open to the Redis servers."
  }, {
    "heading": "redisspec",
    "content": "`key_ttl_s`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "0 (keys never expire)"
  }, {
    "heading": "redisspec",
    "content": "Expire keys written by this store after this many seconds."
  }, {
    "heading": "redisspec",
    "content": "`max_chunk_uploads_per_update`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "10"
  }, {
    "heading": "redisspec",
    "content": "The maximum number of upload chunks to allow per update. This is used to limit the amount of memory used when uploading large objects to the Redis server. A good rule of thumb is to think of the data as: `AVAIL_MEMORY / (read_chunk_size * max_chunk_uploads_per_update) = THORETICAL_MAX_CONCURRENT_UPLOADS` (note: it's a good idea to divide `AVAIL_MAX_MEMORY` by \\~10 to account for other memory usage)"
  }, {
    "heading": "redisspec",
    "content": "`scan_count`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "10000"
  }, {
    "heading": "redisspec",
    "content": "The COUNT value passed when scanning keys in Redis. This is used to hint the amount of work that should be done per response."
  }, {
    "heading": "redisspec",
    "content": "`retry`"
  }, {
    "heading": "redisspec",
    "content": "Retry"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "Retry configuration to use when a network request fails."
  }, {
    "heading": "redisspec",
    "content": "`max_client_permits`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "500"
  }, {
    "heading": "redisspec",
    "content": "Maximum number of permitted actions to the Redis store at any one time This stops problems with timeouts due to many, many inflight actions"
  }, {
    "heading": "redisspec",
    "content": "`max_count_per_cursor`"
  }, {
    "heading": "redisspec",
    "content": "integer (uint64)"
  }, {
    "heading": "redisspec",
    "content": "—"
  }, {
    "heading": "redisspec",
    "content": "1500"
  }, {
    "heading": "redisspec",
    "content": "Maximum number of items returned per cursor for the search indexes May reduce thundering herd issues with worker provisioner at higher node counts,"
  }, {
