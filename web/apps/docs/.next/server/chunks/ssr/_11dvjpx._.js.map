    "heading": "filesystemspec",
    "content": "—"
  }, {
    "heading": "filesystemspec",
    "content": "A temporary location of where files that are being uploaded or deleted will be placed while the content cannot be guaranteed to be accurate. This location must be on the same block device as `content_path` so atomic moves can happen (i.e., move without copy). All files in this folder will be deleted on every startup."
  }, {
    "heading": "filesystemspec",
    "content": "`read_buffer_size`"
  }, {
    "heading": "filesystemspec",
    "content": "integer (uint32)"
  }, {
    "heading": "filesystemspec",
    "content": "—"
  }, {
    "heading": "filesystemspec",
    "content": "32k"
  }, {
    "heading": "filesystemspec",
    "content": "Buffer size to use when reading files. Generally this should be left to the default value except for testing."
