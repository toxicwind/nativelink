# Pick up system specific configs.
common --enable_platform_specific_config

# Don't inherit PATH and LD_LIBRARY_PATH.
build --incompatible_strict_action_env

# Forbid network access unless explicitly enabled.
build --sandbox_default_allow_network=false

# Use correct runfile locations.
build --nolegacy_external_runfiles

# Enable sandboxing for exclusive tests like GPU performance tests.
test --incompatible_exclusive_test_sandboxed

# Remote optimizations.
build --remote_download_minimal

# Smaller profiling. Careful. Disabling this might explode remote cache usage.
build --slim_profile
build --experimental_profile_include_target_label
build --noexperimental_profile_include_primary_output

# Generated by the LRE flake module.
try-import %workspace%/lre.bazelrc

# Use the container image specified in `platforms/BUILD.bazel`.
build --extra_execution_platforms=@//platforms:lre-cc

# Add user specific flags.
try-import %workspace%/user.bazelrc

# --- BuildBuddy (emergent 2026-11) -----------------------------------------
# Opt-in: `bazel build --config=buildbuddy ...` to use the Pens BuildBuddy /
# REAPI control plane (:25218) for BES + remote cache. Key via
# .bazelrc.user (--remote_header=x-buildbuddy-api-key=...), never committed.
build:buildbuddy --bes_backend=grpc://127.0.0.1:25218
build:buildbuddy --bes_results_url=http://127.0.0.1:25218/invocation/
common:buildbuddy --remote_cache=grpc://127.0.0.1:25218
build:buildbuddy --remote_cache_compression
build:buildbuddy --remote_downloader=grpc://127.0.0.1:25218
build:buildbuddy --remote_timeout=3600
build:buildbuddy --remote_upload_local_results=true
build:buildbuddy --remote_local_fallback
